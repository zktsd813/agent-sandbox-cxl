--- a/drivers/virtio/virtio_balloon.c
+++ b/drivers/virtio/virtio_balloon.c
@@ -19,6 +19,9 @@
 #include <linux/mm.h>
 #include <linux/page_reporting.h>
 
+#define CREATE_TRACE_POINTS
+#include <trace/events/pool_discard.h>
+
 /*
  * Balloon device works in 4K page units.  So each page is pointed to by
  * multiple balloon pages.  All memory counters in this driver are in balloon
@@ -119,6 +122,7 @@
 	/* Free page reporting device */
 	struct virtqueue *reporting_vq;
 	struct page_reporting_dev_info pr_dev_info;
+	u64 pool_report_seq; /* validation-only, report callback is serialized */
 };
 
 static const struct virtio_device_id id_table[] = {
@@ -164,7 +168,16 @@
 	struct virtio_balloon *vb =
 		container_of(pr_dev_info, struct virtio_balloon, pr_dev_info);
 	struct virtqueue *vq = vb->reporting_vq;
-	unsigned int unused, err;
+	unsigned int unused, err, i;
+	struct scatterlist *entry;
+	u64 seq = ++vb->pool_report_seq;
+
+	/* The page-reporting core has already isolated these free pages. */
+	trace_pool_free_report(seq, 0, 0, nents, 0, 0, 0);
+	for_each_sg(sg, entry, nents, i)
+		trace_pool_free_report(seq, 1, i, nents,
+				      page_to_phys(sg_page(entry)) + entry->offset,
+				      entry->length, 0);
 
 	/* We should always be able to add these buffers to an empty queue. */
 	err = virtqueue_add_inbuf(vq, sg, nents, vb, GFP_NOWAIT | __GFP_NOWARN);
@@ -174,13 +187,17 @@
 	 * are able to trigger an error we will simply display a warning
 	 * and exit without actually processing the pages.
 	 */
-	if (WARN_ON_ONCE(err))
+	if (WARN_ON_ONCE(err)) {
+		trace_pool_free_report(seq, 3, 0, nents, 0, 0, (int)err);
 		return err;
+	}
 
 	virtqueue_kick(vq);
 
 	/* When host has read buffer, this completes via balloon_ack */
 	wait_event(vb->acked, virtqueue_get_buf(vq, &unused));
+	/* ACK has been consumed; only after return can the core free them. */
+	trace_pool_free_report(seq, 2, 0, nents, 0, 0, 0);
 
 	return 0;
 }
--- a/include/trace/events/pool_discard.h
+++ b/include/trace/events/pool_discard.h
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#undef TRACE_SYSTEM
+#define TRACE_SYSTEM pool_discard
+#if !defined(_TRACE_POOL_DISCARD_H) || defined(TRACE_HEADER_MULTI_READ)
+#define _TRACE_POOL_DISCARD_H
+#include <linux/tracepoint.h>
+/* Validation-only events: no data or allocator behavior is changed. */
+TRACE_EVENT(pool_free_report,
+ TP_PROTO(u64 seq, unsigned int phase, unsigned int index, unsigned int nents,
+          u64 gpa, u64 bytes, int result),
+ TP_ARGS(seq, phase, index, nents, gpa, bytes, result),
+ TP_STRUCT__entry(
+  __field(u64, seq)
+  __field(unsigned int, phase)
+  __field(unsigned int, index)
+  __field(unsigned int, nents)
+  __field(u64, gpa)
+  __field(u64, bytes)
+  __field(int, result)
+ ),
+ TP_fast_assign(
+  __entry->seq = seq;
+  __entry->phase = phase;
+  __entry->index = index;
+  __entry->nents = nents;
+  __entry->gpa = gpa;
+  __entry->bytes = bytes;
+  __entry->result = result;
+ ),
+ TP_printk("seq=%llu phase=%u index=%u nents=%u gpa=%llu bytes=%llu result=%d",
+           __entry->seq, __entry->phase, __entry->index, __entry->nents,
+           __entry->gpa, __entry->bytes, __entry->result)
+);
+#endif
+#include <trace/define_trace.h>
