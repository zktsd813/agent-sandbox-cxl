+++ b/include/uapi/linux/kvm_prefault.h
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _UAPI_LINUX_KVM_PREFAULT_H
+#define _UAPI_LINUX_KVM_PREFAULT_H
+#include <linux/types.h>
+#include <linux/ioctl.h>
+
+/* Experimental x86 vCPU ABI, not the upstream KVM_PRE_FAULT_MEMORY ABI.
+ * The owner pauses its sole vCPU and freezes memslots while using it.
+ * QUERY observes current direct-MMU RAM leaves; capacity=0 returns count and
+ * ENOSPC. FILL takes count sorted nonoverlapping writable RAM ranges.
+ * FILL defaults to prefetch=true. ACTIVATE emulates a write access instead,
+ * avoiding access-tracking SPTEs, and requires guest async-PF disabled.
+ * EAGAIN means restart the whole operation. Other errors may be partial;
+ * processed_pages is informational, never permission to Resume on error.
+ */
+struct kvm_lab_mmu_range { __u64 gpa, bytes; };
+struct kvm_lab_mmu_request {
+	__u64 abi, operation, flags;
+	__u64 gpa, bytes, ranges, capacity, count;
+	__u64 processed_pages, elapsed_ns;
+};
+#define KVM_LAB_MMU_QUERY 1
+#define KVM_LAB_MMU_FILL 2
+#define KVM_LAB_MMU_ACTIVATE 1
+#define KVM_LAB_MMU_RANGE _IOWR(0xae, 0xee, struct kvm_lab_mmu_request)
+#endif
