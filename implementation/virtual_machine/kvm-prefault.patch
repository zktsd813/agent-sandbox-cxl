+
+/* Paused single-vCPU direct-MMU experiment; vcpu_load is held by x86 ioctl. */
+#define LAB_MAX_PAGES (1U << 20)
+static bool lab_ram_range(struct kvm_vcpu *vcpu, u64 gpa, u64 bytes)
+{
+	struct kvm_memory_slot *first, *last;
+	u64 end;
+	if (!bytes || ((gpa | bytes) & (PAGE_SIZE - 1)) ||
+	    check_add_overflow(gpa, bytes, &end) || end > BIT_ULL(52) ||
+	    (bytes >> PAGE_SHIFT) > LAB_MAX_PAGES)
+		return false;
+	first = kvm_vcpu_gfn_to_memslot(vcpu, gpa >> PAGE_SHIFT);
+	last = kvm_vcpu_gfn_to_memslot(vcpu, (end - 1) >> PAGE_SHIFT);
+	return first && first == last &&
+		!(first->flags & (KVM_MEMSLOT_INVALID | KVM_MEM_READONLY));
+}
+
+int kvm_mmu_lab_range(struct kvm_vcpu *vcpu, struct kvm_lab_mmu_request *q)
+{
+	struct kvm *kvm = vcpu->kvm;
+	struct kvm_lab_mmu_range *ranges = NULL;
+	u64 start = ktime_get_ns(), generation, sequence, count = 0;
+	u64 addr, end, previous = U64_MAX, pages = 0;
+	int idx, r = -EINVAL;
+	bool query = q->operation == KVM_LAB_MMU_QUERY;
+	BUILD_BUG_ON(sizeof(*q) != 80);
+	q->processed_pages = q->elapsed_ns = 0;
+	if (q->abi != 1 || (q->flags & ~KVM_LAB_MMU_ACTIVATE) ||
+	    (!query && q->operation != KVM_LAB_MMU_FILL) ||
+	    q->capacity > LAB_MAX_PAGES || q->count > LAB_MAX_PAGES ||
+	    (query && q->flags))
+		goto done;
+	if (atomic_read(&kvm->online_vcpus) != 1 || is_guest_mode(vcpu) ||
+	    ((q->flags & KVM_LAB_MMU_ACTIVATE) &&
+	     (vcpu->arch.apf.msr_en_val & KVM_ASYNC_PF_ENABLED))) {
+		r = -EOPNOTSUPP;
+		goto done;
+	}
+	if (query) {
+		if (q->capacity) {
+			ranges = kvcalloc(q->capacity, sizeof(*ranges), GFP_KERNEL);
+			if (!ranges) { r = -ENOMEM; goto done; }
+		}
+	} else if (q->count) {
+		ranges = vmemdup_user(u64_to_user_ptr(q->ranges),
+				     q->count * sizeof(*ranges));
+		if (IS_ERR(ranges)) { r = PTR_ERR(ranges); ranges = NULL; goto done; }
+		for (count = 0; count < q->count; count++) {
+			u64 stop;
+			if (!ranges[count].bytes ||
+			    check_add_overflow(ranges[count].gpa, ranges[count].bytes, &stop) ||
+			    ((ranges[count].gpa | ranges[count].bytes) & (PAGE_SIZE - 1)) ||
+			    (count && ranges[count].gpa < previous) ||
+			    (ranges[count].bytes >> PAGE_SHIFT) > LAB_MAX_PAGES - pages)
+				goto done;
+			pages += ranges[count].bytes >> PAGE_SHIFT;
+			previous = stop;
+		}
+	}
+	idx = srcu_read_lock(&kvm->srcu);
+	generation = kvm_vcpu_memslots(vcpu)->generation;
+	sequence = READ_ONCE(kvm->mmu_invalidate_seq);
+	if (generation & KVM_MEMSLOT_GEN_UPDATE_IN_PROGRESS) { r = -EAGAIN; goto unlock; }
+	r = kvm_mmu_reload(vcpu);
+	if (r) goto unlock;
+	if (!vcpu->arch.mmu->root_role.direct) { r = -EOPNOTSUPP; goto unlock; }
+	if (query) {
+		if (!lab_ram_range(vcpu, q->gpa, q->bytes)) { r = -EINVAL; goto unlock; }
+		end = q->gpa + q->bytes;
+		previous = U64_MAX;
+		count = 0;
+		for (addr = q->gpa; addr < end; ) {
+			struct kvm_shadow_walk_iterator it;
+			u64 next = addr + PAGE_SIZE;
+			bool present = false;
+			write_lock(&kvm->mmu_lock);
+			rcu_read_lock();
+			for_each_shadow_entry(vcpu, addr, it) {
+				u64 spte = READ_ONCE(*it.sptep);
+				u64 span = 1ULL << (PAGE_SHIFT + 9 * (it.level - 1));
+				if (!is_shadow_present_pte(spte) || is_last_spte(spte, it.level)) {
+					next = min(end, (addr & ~(span - 1)) + span);
+					present = is_shadow_present_pte(spte);
+					break;
+				}
+			}
+			rcu_read_unlock();
+			write_unlock(&kvm->mmu_lock);
+			if (present) {
+				if (previous != addr) {
+					count++;
+					if (count <= q->capacity)
+						ranges[count - 1] = (struct kvm_lab_mmu_range){addr, 0};
+				}
+				if (count <= q->capacity)
+					ranges[count - 1].bytes += next - addr;
+				q->processed_pages += (next - addr) >> PAGE_SHIFT;
+				previous = next;
+			} else previous = U64_MAX;
+			addr = next;
+			if (signal_pending(current)) { r = -EINTR; goto unlock; }
+			cond_resched();
+		}
+		q->count = count;
+		r = count > q->capacity ? -ENOSPC : 0;
+	} else {
+		for (count = 0; count < q->count; count++) {
+			if (!lab_ram_range(vcpu, ranges[count].gpa, ranges[count].bytes)) { r = -EINVAL; goto unlock; }
+			end = ranges[count].gpa + ranges[count].bytes;
+			for (addr = ranges[count].gpa; addr < end; addr += PAGE_SIZE) {
+				int retry;
+				for (retry = 0; retry < 8; retry++) {
+					r = kvm_mmu_do_page_fault(vcpu, addr, PFERR_WRITE_MASK | PFERR_USER_MASK,
+						!(q->flags & KVM_LAB_MMU_ACTIVATE), NULL);
+					if (r != RET_PF_RETRY) break;
+					cond_resched();
+				}
+				if (r != RET_PF_FIXED && r != RET_PF_SPURIOUS) {
+					r = r < 0 ? r : -EAGAIN;
+					goto unlock;
+				}
+				q->processed_pages++;
+				if (signal_pending(current)) { r = -EINTR; goto unlock; }
+				cond_resched();
+			}
+		}
+		r = 0;
+	}
+	if (generation != kvm_vcpu_memslots(vcpu)->generation ||
+	    sequence != READ_ONCE(kvm->mmu_invalidate_seq)) {
+		pr_info("kvm-lab-prefault: changed gen=%llu/%llu seq=%llu/%llu processed=%llu\n",
+			generation, kvm_vcpu_memslots(vcpu)->generation, sequence,
+			(u64)READ_ONCE(kvm->mmu_invalidate_seq), q->processed_pages);
+		r = -EAGAIN;
+		q->processed_pages = 0;
+	}
+	if (!r && query && q->count &&
+	    copy_to_user(u64_to_user_ptr(q->ranges), ranges, q->count * sizeof(*ranges)))
+		r = -EFAULT;
+unlock:
+	srcu_read_unlock(&kvm->srcu, idx);
+done:
+	if (r && r != -ENOSPC)
+		pr_info("kvm-lab-prefault: op=%llu ret=%d processed=%llu count=%llu\n",
+			q->operation, r, q->processed_pages, q->count);
+	kvfree(ranges);
+	q->elapsed_ns = ktime_get_ns() - start;
+	return r;
 }
 
