+/* Lab-only direct access for one fixed volatile decoder, without interleave. */
+static bool cxl_direct_ram_commit(CXLType3Dev *ct3d, int which, uint32_t ctrl)
+{
+    uint32_t *regs = ct3d->cxl_cstate.crb.cache_mem_registers;
+    uint64_t base, size, skip;
+    CXLFixedWindow *window = NULL;
+    GSList *windows, *item;
+    MemoryRegion *ram;
+
+    if (!ct3d->direct_ram) {
+        return true;
+    }
+    if (which || FIELD_EX32(ctrl, CXL_HDM_DECODER0_CTRL, IW)) {
+        return false;
+    }
+    base = ((uint64_t)ldl_le_p(regs + R_CXL_HDM_DECODER0_BASE_HI) << 32) |
+           (ldl_le_p(regs + R_CXL_HDM_DECODER0_BASE_LO) & 0xf0000000);
+    size = ((uint64_t)ldl_le_p(regs + R_CXL_HDM_DECODER0_SIZE_HI) << 32) |
+           (ldl_le_p(regs + R_CXL_HDM_DECODER0_SIZE_LO) & 0xf0000000);
+    skip = ((uint64_t)ldl_le_p(regs + R_CXL_HDM_DECODER0_DPA_SKIP_HI) << 32) |
+           (ldl_le_p(regs + R_CXL_HDM_DECODER0_DPA_SKIP_LO) & 0xf0000000);
+    ram = host_memory_backend_get_memory(ct3d->hostvmem);
+    if (!size || skip || size > memory_region_size(ram) ||
+        ct3d->direct_ram_parent) {
+        return false;
+    }
+    windows = cxl_fmws_get_all_sorted();
+    for (item = windows; item; item = item->next) {
+        CXLFixedWindow *fw = item->data;
+
+        if (fw->num_targets == 1 && !fw->enc_int_ways && base >= fw->base &&
+            base - fw->base <= fw->size && size <= fw->size - (base - fw->base)) {
+            window = fw;
+            break;
+        }
+    }
+    g_slist_free(windows);
+    if (!window) {
+        return false;
+    }
+    if (!ct3d->direct_ram_initialized) {
+        memory_region_init_alias(&ct3d->direct_ram_alias, OBJECT(ct3d),
+                                 "cxl-direct-ram", ram, 0, size);
+        ct3d->direct_ram_initialized = true;
+    } else {
+        memory_region_set_size(&ct3d->direct_ram_alias, size);
+    }
+    ct3d->direct_ram_parent = &window->mr;
+    memory_region_add_subregion_overlap(&window->mr, base - window->base,
+                                       &ct3d->direct_ram_alias, 1);
+    return true;
+}
+
+static void cxl_direct_ram_unmap(CXLType3Dev *ct3d)
+{
+    if (ct3d->direct_ram_parent) {
+        memory_region_del_subregion(ct3d->direct_ram_parent,
+                                    &ct3d->direct_ram_alias);
+        ct3d->direct_ram_parent = NULL;
+    }
+}
