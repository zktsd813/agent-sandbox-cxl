+static PARKED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+fn resident_token() -> &'static Mutex<Option<HandoffToken>> {
+    static TOKEN: std::sync::OnceLock<Mutex<Option<HandoffToken>>> = std::sync::OnceLock::new();
+    TOKEN.get_or_init(|| Mutex::new(None))
+}
+fn profiling() -> bool {
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var("FC_RESTORE_TIMING").as_deref() == Ok("1"))
+}
+pub(crate) fn resident_enabled() -> bool {
+    io_enabled() && std::env::var("FC_DAX_RESIDENT").as_deref() == Ok("1")
+}
+pub(crate) fn resident_parked() -> bool { PARKED.load(std::sync::atomic::Ordering::Acquire) }
+pub(crate) fn prepare_resident() -> io::Result<()> {
+    if !resident_enabled() { return Err(invalid("resident mode not enabled")); }
+    let start = std::time::Instant::now();
+    crate::devices::virtio::block::virtio::device::DiskProperties::prepare_direct().map_err(io::Error::other)?;
+    if profiling() {
+        crate::logger::info_unrestricted!("DIRECT_RESIDENT_JSON {}", serde_json::json!({
+            "event":"prepare", "pid":std::process::id(), "elapsed_ns":start.elapsed().as_nanos() as u64,
+            "guest_ram_access":false, "kernel_attach":false}));
+    }
+    Ok(())
+}
+
+pub(crate) fn io_enabled() -> bool {
+    std::env::var("FC_DAX_DIRECT_IO").as_deref() == Ok("1")
+        && std::env::var("FC_DAX_DIRECT").as_deref() == Ok("1")
+}
+
+pub(crate) fn import_enabled() -> bool {
+    io_enabled() && std::env::var_os("FC_DAX_DIRECT_IMPORT").is_some()
+}
