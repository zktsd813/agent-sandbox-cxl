+// SPDX-License-Identifier: Apache-2.0
+//! Opt-in single-process heap in device-DAX. No fallback after activation.
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::fs::OpenOptions;
+use std::io;
+use std::mem::size_of;
+use std::os::fd::AsRawFd;
+use std::os::unix::fs::FileTypeExt;
+use std::ptr;
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+
+const CONTROL_BYTES: usize = 4096;
+const MAGIC: usize = 0x4643444158484541;
+
+#[repr(C, align(64))]
+struct Control {
+    magic: usize,
+    base: usize,
+    length: usize,
+    head: AtomicUsize,
+    allocs: AtomicUsize,
+    frees: AtomicUsize,
+    live_bytes: AtomicUsize,
+    failures: AtomicUsize,
+    lock: AtomicBool,
+}
+
+#[repr(C)]
+struct FreeBlock {
+    bytes: usize,
+    next: usize,
+}
+
+#[repr(C)]
+struct Header {
+    start: usize,
+    bytes: usize,
+}
+
+struct DaxHeap {
+    base: AtomicUsize,
+}
+
+#[global_allocator]
+static HEAP: DaxHeap = DaxHeap {
+    base: AtomicUsize::new(0),
+};
+
+impl DaxHeap {
+    // SAFETY: caller owns an aligned writable mapping of at least two pages,
+    // and has not yet published it to allocator callers.
+    unsafe fn attach(&self, base: usize, length: usize) {
+        unsafe {
+            ptr::write(
+                base as *mut Control,
+                Control {
+                    magic: MAGIC,
+                    base,
+                    length,
+                    head: AtomicUsize::new(CONTROL_BYTES),
+                    allocs: AtomicUsize::new(0),
+                    frees: AtomicUsize::new(0),
+                    live_bytes: AtomicUsize::new(0),
+                    failures: AtomicUsize::new(0),
+                    lock: AtomicBool::new(false),
+                },
+            );
+            ptr::write(
+                (base + CONTROL_BYTES) as *mut FreeBlock,
+                FreeBlock {
+                    bytes: length - CONTROL_BYTES,
+                    next: 0,
+                },
+            );
+        }
+        self.base.store(base, Ordering::Release);
+    }
+
+    fn lock(control: &Control) {
+        while control
+            .lock
+            .compare_exchange_weak(false, true, Ordering::Acquire, Ordering::Relaxed)
+            .is_err()
+        {
+            std::hint::spin_loop();
+        }
+    }
+}
+
+// SAFETY: all free-list mutations are protected by the arena lock. Returned
+// allocations are disjoint and aligned; allocation metadata uses arena offsets.
+unsafe impl GlobalAlloc for DaxHeap {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        let base = self.base.load(Ordering::Acquire);
+        if base == 0 {
+            return unsafe { System.alloc(layout) };
+        }
+        // SAFETY: attach published an initialized, process-lifetime mapping.
+        let control = unsafe { &*(base as *const Control) };
+        Self::lock(control);
+        let mut previous = 0;
+        let mut current = control.head.load(Ordering::Relaxed);
+        while current != 0 {
+            // SAFETY: free-list offsets refer to owned blocks within the arena.
+            let block = unsafe { &mut *((base + current) as *mut FreeBlock) };
+            let align = layout.align().max(8);
+            let start = base + current + size_of::<Header>();
+            let user = match start.checked_add(align - 1) {
+                Some(v) => v & !(align - 1),
+                None => break,
+            };
+            let needed = match (user - base - current)
+                .checked_add(layout.size().max(1))
+                .and_then(|v| v.checked_add(7))
+            {
+                Some(v) => v & !7,
+                None => break,
+            };
+            if needed <= block.bytes {
+                let bytes = if block.bytes - needed >= size_of::<FreeBlock>() {
+                    let split = current + needed;
+                    unsafe {
+                        ptr::write(
+                            (base + split) as *mut FreeBlock,
+                            FreeBlock {
+                                bytes: block.bytes - needed,
+                                next: block.next,
+                            },
+                        );
+                    }
+                    needed
+                } else {
+                    block.bytes
+                };
