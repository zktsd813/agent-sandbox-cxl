+        value
+    }
+
+    #[test]
+    fn pool_discard_private_zero_preserves_canonical_peer_and_dirty_tracking() {
+        use std::os::unix::fs::FileExt;
+        use crate::vstate::memory::Bitmap;
+        use vmm_sys_util::tempfile::TempFile;
+        let mut file = TempFile::new().unwrap().into_file();
+        file.write_all(&vec![0x6a; PAGE]).unwrap();
+        let mem = discard_test_mem(3);
+        let peer = discard_test_mem(3);
+        for m in [&mem, &peer] {
+            m.write_slice(&vec![0x9c; 3 * PAGE], GuestAddress(0)).unwrap();
+            let hva = m.get_host_address(GuestAddress(PAGE as u64)).unwrap();
+            // SAFETY: test owns the live guest allocation and maps exactly one page.
+            assert_ne!(unsafe { libc::mmap(hva.cast(), PAGE, libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_PRIVATE | libc::MAP_FIXED, file.as_raw_fd(), 0) }, libc::MAP_FAILED);
+        }
+        assert_eq!(bytes(&mem, PAGE as u64), vec![0x6a; PAGE]);
+        let mut s = State::default();
+        s.pooled_gpas.insert(PAGE as u64);
+        mem.reset_dirty();
+        let (mapped, busy, _) = discard_with(&mem, &[range(0, 3)], &mut s, replace_private_zero).unwrap();
+        assert_eq!(mapped, vec![range(PAGE as u64, 1)]);
+        assert_eq!(busy, 0);
+        assert!(s.pooled_gpas.is_empty() && s.overlays && !s.mapping_failed);
+        assert_eq!(bytes(&mem, 0), vec![0x9c; PAGE]);
+        assert_eq!(bytes(&mem, PAGE as u64), vec![0; PAGE]);
+        assert_eq!(bytes(&mem, (2 * PAGE) as u64), vec![0x9c; PAGE]);
+        assert_eq!(bytes(&peer, PAGE as u64), vec![0x6a; PAGE]);
+        let region = mem.iter().next().unwrap();
+        assert!(!region.bitmap().dirty_at(0));
+        assert!(region.bitmap().dirty_at(PAGE));
+        assert!(!region.bitmap().dirty_at(2 * PAGE));
+        // Reuse the detached page; neither peer nor canonical backing changes.
+        mem.write_slice(&vec![0xdd; PAGE], GuestAddress(PAGE as u64)).unwrap();
+        assert_eq!(bytes(&peer, PAGE as u64), vec![0x6a; PAGE]);
+        let mut actual = vec![0; PAGE];
+        file.read_exact_at(&mut actual, 0).unwrap();
+        assert_eq!(actual, vec![0x6a; PAGE]);
+    }
+
+    #[test]
+    fn pool_discard_preflight_rejects_all_before_any_mapping() {
+        let mem = discard_test_mem(3);
+        let invalid = vec![vec![], vec![DiscardRange {gpa: 1, bytes: PAGE as u64}],
+            vec![DiscardRange {gpa: 0, bytes: 1}], vec![DiscardRange {gpa: 0, bytes: 0}],
+            vec![range(0, 2), range(PAGE as u64, 1)],
+            vec![range(0, 1), range((3 * PAGE) as u64, 1)],
+            vec![DiscardRange {gpa: u64::MAX - 4095, bytes: 4096}]];
+        for ranges in invalid {
+            let mut s = State::default();
+            s.pooled_gpas.extend([0, PAGE as u64]);
+            assert!(discard_with(&mem, &ranges, &mut s, |_, _| panic!("preflight mapped bytes")).is_err());
+            assert!(!s.mapping_failed && !s.overlays && s.pooled_gpas.len() == 2);
+        }
+    }
+
+    #[test]
+    fn pool_discard_coalesces_and_busy_partial_byte_defers_whole_page() {
+        let mem = discard_test_mem(4);
+        mem.write_slice(&vec![0x82; 4 * PAGE], GuestAddress(0)).unwrap();
+        let mut s = State::default();
+        s.pooled_gpas.extend([0, PAGE as u64, (2 * PAGE) as u64]);
+        s.pending_io.insert(77, vec![(2 * PAGE as u64 + 17, 2 * PAGE as u64 + 18)]);
+        for gpa in [0, PAGE as u64, 2 * PAGE as u64, 3 * PAGE as u64] {
+            s.hints.insert(gpa, Hint {gpa, image_id: "a".repeat(64), image_offset: gpa, sequence: 1});
+        }
+        let mut calls = 0;
+        let (mapped, busy, removed) = discard_with(&mem, &[range(0, 4)], &mut s, |hva, len| {
+            calls += 1; replace_private_zero(hva, len)
+        }).unwrap();
+        assert_eq!(calls, 1);
+        assert_eq!(mapped, vec![range(0, 2)]);
+        assert_eq!((busy, removed), (1, 3));
+        assert_eq!(bytes(&mem, 2 * PAGE as u64), vec![0x82; PAGE]);
+        assert_eq!(s.pooled_gpas, BTreeSet::from([2 * PAGE as u64]));
+        assert_eq!(s.hints.keys().copied().collect::<Vec<_>>(), vec![2 * PAGE as u64]);
+        s.pending_io.remove(&77);
+        let (mapped, busy, removed) = discard_with(&mem, &[range(2 * PAGE as u64, 1)], &mut s, replace_private_zero).unwrap();
+        assert_eq!(mapped, vec![range(2 * PAGE as u64, 1)]);
+        assert_eq!((busy, removed), (0, 1));
+    }
+
+    #[test]
+    fn pool_discard_mapping_failure_poison_prevents_further_use() {
+        let mem = discard_test_mem(3);
+        let mut s = State::default();
+        s.pooled_gpas.extend([0, 2 * PAGE as u64]);
+        let mut calls = 0;
+        assert!(discard_with(&mem, &[range(0, 3)], &mut s, |hva, len| {
+            calls += 1;
+            if calls == 2 { Err(io::Error::from_raw_os_error(libc::ENOMEM)) }
+            else { replace_private_zero(hva, len) }
+        }).is_err());
+        assert_eq!(calls, 2);
+        assert!(s.mapping_failed && s.overlays);
+        assert!(discard_with(&mem, &[range(0, 1)], &mut s, |_, _| panic!("poisoned mapping retried")).is_err());
+    }
+
+}
