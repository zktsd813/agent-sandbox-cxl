+/// A bounded local command channel serviced by the VMM event loop itself.
+/// Only resident send/receive are exposed; boot/configuration retain the API.
+struct ResidentControl {
+    listener: UnixListener,
+    stream: Option<UnixStream>,
+    request: Option<(u8, Vec<u8>)>,
+    input: Vec<u8>,
+}
+
+impl ResidentControl {
+    fn new() -> Option<Self> {
+        if std::env::var("FC_RESIDENT_NATIVE").as_deref() != Ok("1") { return None; }
+        assert_eq!(std::env::var("FC_DAX_RESIDENT").as_deref(), Ok("1"));
+        let export = PathBuf::from(std::env::var_os("FC_DAX_DIRECT_EXPORT").unwrap());
+        let listener = UnixListener::bind(export.parent().unwrap().join("resident.sock")).unwrap();
+        listener.set_nonblocking(true).unwrap();
+        Some(Self { listener, stream: None, request: None, input: Vec::new() })
+    }
+
+    fn dispatch(&mut self, controller: &mut RuntimeApiController, events: &mut EventManager, vmm: &Arc<Mutex<Vmm>>) {
+        let Some((command, input)) = self.request.take() else { return; };
+        let start = Instant::now();
+        let mut payload = Vec::new();
+        let status = match command {
+            0 => 0,
+            1 => {
+                let action = VmmAction::DirectSend;
+                match controller.handle_request(action, events) {
+                    Ok(_) => 0,
+                    Err(error) => { error_unrestricted!("Resident command failed: {error}"); libc::EIO as u64 }
+                }
+            }
+            3 | 4 => {
+                let mut vm = vmm.lock().unwrap();
+                let result = match command {
+                    3 => vm.send_resident_memory(events).map(|bytes| payload = bytes),
+                    _ => vm.receive_resident_memory(events, &input),
+                };
+                match result {
+                    Ok(()) => 0,
+                    Err(error) => { error_unrestricted!("Resident memory command failed: {error}"); libc::EIO as u64 }
+                }
+            }
+            _ => libc::EINVAL as u64,
+        };
+        let mut response = [0u8; 16];
+        response[..8].copy_from_slice(&status.to_le_bytes());
+        let value = if command == 3 { payload.len() as u64 } else { start.elapsed().as_nanos() as u64 };
+        response[8..].copy_from_slice(&value.to_le_bytes());
+        // This bounded reply must fit immediately; a stalled/broken controller
+        // must not block device dispatch or cause a partially completed retry.
+        let stream = self.stream.as_mut().unwrap();
+        if payload.is_empty() { stream.write_all(&response).expect("resident reply"); }
+        else {
+            // Publish header and body in one write, avoiding an early wakeup
+            // that makes the controller block again waiting for the payload.
+            let mut wire = Vec::with_capacity(response.len() + payload.len());
+            wire.extend_from_slice(&response);
+            wire.extend_from_slice(&payload);
+            stream.write_all(&wire).expect("resident payload reply");
+        }
+    }
+}
+
+impl MutEventSubscriber for ResidentControl {
+    fn init(&mut self, ops: &mut EventOps) {
+        ops.add(Events::new(&self.listener, EventSet::IN)).unwrap();
+    }
+
+    fn process(&mut self, event: Events, ops: &mut EventOps) {
+        if event.fd() == self.listener.as_raw_fd() {
+            if let Ok((stream, _)) = self.listener.accept() {
+                if self.stream.is_some() { return; }
+                stream.set_nonblocking(true).unwrap();
+                ops.add(Events::new(&stream, EventSet::IN)).unwrap();
+                self.stream = Some(stream);
+            }
+            return;
+        }
+        let Some(stream) = self.stream.as_mut() else { return; };
+        if event.fd() != stream.as_raw_fd() || self.request.is_some() { return; }
+        let mut buffer = [0u8; 8192];
+        let mut closed = false;
+        loop {
+            match stream.read(&mut buffer) {
+                Ok(0) => { closed = true; break; }
+                Ok(n) => {
+                    self.input.extend_from_slice(&buffer[..n]);
+                    if self.input.len() > 65540 { closed = true; break; }
+                }
+                Err(error) if error.kind() == std::io::ErrorKind::WouldBlock => break,
+                Err(error) if error.kind() == std::io::ErrorKind::Interrupted => continue,
+                Err(_) => { closed = true; break; }
+            }
+        }
+        if !closed && !self.input.is_empty() {
+            let command = self.input[0];
+            let (header, length) = if command != 4 { (1, 0) }
+                else if self.input.len() < 5 { return; }
+                else { (5, u32::from_le_bytes(self.input[1..5].try_into().unwrap()) as usize) };
+            if length >= 65536 || (command == 4 && length == 0) || self.input.len() > header + length {
+                closed = true;
+            } else if self.input.len() == header + length {
+                self.request = Some((command, self.input[header..].to_vec()));
+                self.input.clear();
+            }
+        }
+        if closed {
+            ops.remove(Events::new(stream, EventSet::IN)).unwrap();
+            self.stream = None;
+            self.input.clear();
+        }
+    }
+}
