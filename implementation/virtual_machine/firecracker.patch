+/// Optional fixed address contract shared by DAX, private RAM and mapper restore.
+pub(crate) fn fixed_hva() -> Result<Option<usize>, MemoryError> {
+    std::env::var("FC_DAX_FIXED_HVA").ok().map(|value| {
+        let parsed = if let Some(hex) = value.strip_prefix("0x") {
+            usize::from_str_radix(hex, 16)
+        } else { value.parse() };
+        parsed.map_err(|_| MemoryError::Dax("invalid FC_DAX_FIXED_HVA".into()))
+    }).transpose()
+}
