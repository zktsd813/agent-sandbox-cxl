+impl Vmm {
+    /// Transfer only device bindings and publish the retained kernel-object token.
+    /// Ordinary Pause intentionally retains ownership, so RAM tier changes can run first.
+    pub fn direct_export(&mut self, events: &mut EventManager) -> Result<(), VmmError> {
+        self.export_inner(events, false).map(|_| ())
+    }
+
+    /// Pause and publish bounded device/mapper state without filesystem staging.
+    pub fn send_resident_memory(&mut self, events: &mut EventManager) -> Result<Vec<u8>, VmmError> {
+        if !resident_enabled() || resident_parked() { return Err(VmmError::DaxPreflight("resident sender is not owner")); }
+        self.pause_vm()?;
+        self.export_inner(events, true)
+    }
+
+    fn export_inner(&mut self, events: &mut EventManager, memory_wire: bool) -> Result<Vec<u8>, VmmError> {
+        let mut timing = crate::persist::RestoreTiming::new("direct_export");
+        if !io_enabled()
+            || self.instance_info.state != VmState::Paused
+            || crate::pool_memory::mapping_failed()
+        {
+            return Err(VmmError::DaxPreflight(
+                "DirectExport requires opted-in paused owner",
+            ));
+        }
+        validate_live(self)?;
+        let vm = self
+            .vm
+            .as_kvm()
+            .ok_or(VmmError::DaxPreflight("KVM required"))?;
+        if vm.direct_is_detached() {
+            return Err(VmmError::DaxPreflight("direct owner already exported"));
+        }
+        let path = env_path("FC_DAX_DIRECT_EXPORT").map_err(VmmError::DaxHandoff)?;
+        // Reserve the output before mutating bindings. A previous generation is never overwritten.
+        let mut output = if memory_wire { None } else { Some(OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(&path)
+            .map_err(VmmError::DaxHandoff)?) };
+        let started = std::time::Instant::now();
+        timing.mark("validate_and_open");
+        let devices = self.device_manager.save(); // Drains async I/O and captures resulting used rings.
+        self.check_block_snapshot_preparation()
+            .map_err(|e| VmmError::DaxHandoff(io::Error::other(e.to_string())))?;
+        timing.mark("drain_and_save_devices");
+        if resident_enabled() {
+            let VirtioDevices::Mmio(mmio) = &mut self.device_manager.virtio_devices else { unreachable!() };
+            mmio.park_direct(events);
+        }
+        let mapper = if memory_wire {
+            Some(crate::pool_memory::seal_for_handoff_memory(vm.guest_memory()).map_err(VmmError::DaxHandoff)?)
+        } else {
+            crate::pool_memory::seal_for_handoff(vm.guest_memory()).map_err(VmmError::DaxHandoff)?;
+            None
+        };
+        timing.mark("seal_mapper");
+        let manifest = if memory_wire { Vec::new() } else {
+            bounded_read(&env_path("FC_POOL_MEMORY_MANIFEST").map_err(VmmError::DaxHandoff)?)
+                .map_err(VmmError::DaxHandoff)?
+        };
+        let mut state = DirectState {
+            schema: "direct-device-handoff-v2".into(),
+            token: HandoffToken::default(),
+            machine_config: self.machine_config.clone(),
+            boot_source: self.boot_source_config.clone(),
+            memory: vm.guest_memory().describe(),
+            memory_manifest_sha256: if memory_wire { String::new() } else { sha256(&manifest) },
+            devices,
+        };
+        timing.mark("read_manifest_and_build_state");
+        let result = (|| -> io::Result<Vec<u8>> {
+            let VirtioDevices::Mmio(mmio) = &self.device_manager.virtio_devices else {
+                unreachable!()
+            };
+            mmio.unbind_direct_ioevents(vm).map_err(io::Error::other)?;
+            timing.mark("unbind_ioevents");
+            vm.dax_direct_handoff(false)?;
+            timing.mark("export_detach_ioctls");
+            // PEEK is a read-only global metadata operation; source VM ioctls are now revoked.
+            if unsafe {
+                libc::ioctl(
+                    vm.kvm().fd.as_raw_fd(),
+                    (read_ioctl() | 4) as _,
+                    &mut state.token as *mut HandoffToken,
+                )
+            } < 0
+            {
+                return Err(io::Error::last_os_error());
+            }
+            timing.mark("peek_token");
+            if resident_enabled() {
+                crate::pool_memory::park_resident(vm.guest_memory())?;
+                *resident_token().lock().unwrap() = Some(state.token.clone());
+                PARKED.store(true, std::sync::atomic::Ordering::Release);
+                if profiling() {
+                    crate::logger::info_unrestricted!("DIRECT_RESIDENT_JSON {}", serde_json::json!({
+                        "event":"park", "pid":std::process::id(), "generation":state.token.generation,
+                        "ram_access_revoked":true, "io_drained":true, "devices_unsubscribed":true}));
+                }
+                timing.mark("park_resident");
+            }
+            let bytes = if let Some(mapper) = &mapper {
+                bitcode::serialize(&(3u32, &state.token, &state.devices, mapper)).map_err(io::Error::other)?
+            } else { serde_json::to_vec(&state).map_err(io::Error::other)? };
+            if bytes.len() >= 65536 { return Err(invalid("resident packet too large")); }
+            timing.mark("serialize_devices");
+            if let Some(output) = output.as_mut() { output.write_all(&bytes)?; }
+            timing.mark("write_devices");
+            Ok(bytes)
+        })();
+        let bytes = match result {
+            Ok(bytes) => bytes,
+            Err(error) => {
+                crate::logger::error_unrestricted!("DIRECT_HANDOFF_FATAL export: {error}");
+                std::process::abort(); // Never resume partially unbound or detached device state.
+            }
+        };
+        if profiling() {
+            crate::logger::info_unrestricted!(
+                "DIRECT_HANDOFF_JSON {}",
+                serde_json::json!({
+                    "event":"export", "token":state.token, "device_state_bytes":bytes.len(),
+                    "snapshot_bytes":0, "ram_transfer_bytes":0, "elapsed_ns":started.elapsed().as_nanos() as u64,
+                    "memory_manifest_sha256":state.memory_manifest_sha256,
+                })
+            );
+        }
+        timing.mark("log_receipt");
+        timing.finish();
+        Ok(bytes)
+    }
+
+
+}
+
+impl Vmm {
+    pub(crate) fn probe_resident(&self) -> Result<(), VmmError> {
+        use std::os::fd::AsRawFd;
+        if !resident_enabled() || !resident_parked() { return Err(VmmError::DaxPreflight("resident is not parked")); }
+        let token = resident_token().lock().unwrap().clone().unwrap();
+        let mut byte = 0u8;
+        let local = libc::iovec { iov_base: (&mut byte as *mut u8).cast(), iov_len: 1 };
+        let remote = libc::iovec { iov_base: token.ram_hva as *mut libc::c_void, iov_len: 1 };
+        // SAFETY: self-read syscall reports EFAULT for the revoked mapping, without dereferencing it in userspace.
+        let copied = unsafe { libc::process_vm_readv(libc::getpid(), &local, 1, &remote, 1, 0) };
+        let memory_errno = io::Error::last_os_error().raw_os_error();
+        if copied != -1 || memory_errno != Some(libc::EFAULT) { return Err(VmmError::DaxPreflight("parked RAM still accessible")); }
+        let handles = self.vm.as_kvm().unwrap().vcpus_handles();
+        let fd = handles[0].vcpu_fd.as_raw_fd();
+        let mut regs = [0u64; 18];
+        // SAFETY: KVM_GET_REGS is read-only and uses a 144-byte output. Stale-owner kernel gating must reject it.
+        let rc = unsafe { libc::ioctl(fd, 0x8090ae81u32 as _, regs.as_mut_ptr()) };
+        let kvm_errno = io::Error::last_os_error().raw_os_error();
+        if rc != -1 { return Err(VmmError::DaxPreflight("parked vCPU FD still authorized")); }
+        if profiling() {
+            crate::logger::info_unrestricted!("DIRECT_RESIDENT_PROBE_JSON {}", serde_json::json!({
+                "pid":std::process::id(), "generation":token.generation, "memory_errno":memory_errno,
+                "kvm_errno":kvm_errno, "vm_fd":self.vm.as_kvm().unwrap().fd().as_raw_fd(), "vcpu_fd":fd}));
+        }
+        Ok(())
+    }
+
+
+    /// Import the latest resident state and resume its single execution owner.
+    pub fn receive_resident_memory(&mut self, events: &mut EventManager, bytes: &[u8]) -> Result<(), VmmError> {
+        self.import_resident_inner(events, bytes)?;
+        self.resume_vm()
+    }
+    fn import_resident_inner(&mut self, events: &mut EventManager, bytes: &[u8]) -> Result<(), VmmError> {
+        let err = |e: io::Error| VmmError::DaxHandoff(e);
+        if !resident_enabled() || !resident_parked() || self.reuse_restore_failed {
+            return Err(VmmError::DaxPreflight("resident import requires a healthy parked owner"));
+        }
+        let mut timing = crate::persist::RestoreTiming::new("direct_resident_import");
+        let (_, token, devices, mapper) = decode_resident_packet(bytes).map_err(err)?;
+        let mut state = DirectState { schema: "direct-device-handoff-v2".into(), token, devices,
+            machine_config: self.machine_config.clone(), boot_source: self.boot_source_config.clone(),
+            memory: self.vm.as_kvm().unwrap().guest_memory().describe(), memory_manifest_sha256: String::new() };
+        validate_state(&state).map_err(err)?;
+        let previous = resident_token().lock().unwrap().clone().ok_or_else(|| err(invalid("resident token absent")))?;
+        validate_resident_token(&previous, &state.token).map_err(err)?;
+        if state.machine_config != self.machine_config || state.boot_source != self.boot_source_config {
+            return Err(err(invalid("resident machine contract changed")));
+        }
+        let local_acpi = self.device_manager.acpi_devices.save();
+        if local_acpi.vmgenid.addr != state.devices.acpi_state.vmgenid.addr
+            || local_acpi.vmgenid.gsi != state.devices.acpi_state.vmgenid.gsi
+            || local_acpi.vmclock.guest_address != state.devices.acpi_state.vmclock.guest_address
+            || local_acpi.vmclock.gsi != state.devices.acpi_state.vmclock.gsi {
+            return Err(err(invalid("resident ACPI layout changed")));
+        }
+        timing.mark("read_validate_metadata");
+        self.reuse_restore_failed = true; // Any failure from here is permanently fail-closed.
+        let vm = self.vm.as_kvm().ok_or(VmmError::NotSupported)?;
+        crate::pool_memory::import_resident_state(vm.guest_memory(), mapper).map_err(err)?;
+        timing.mark("import_mapper");
+        vm.attach_resident(&mut state.token).map_err(err)?;
+        timing.mark("attach");
+        let (VirtioDevices::Mmio(devices), VirtioDevicesState::Mmio(saved)) =
+            (&mut self.device_manager.virtio_devices, &state.devices.virtio_state) else { unreachable!() };
+        devices.restore_direct_resident(vm.guest_memory(), saved).map_err(|e| err(invalid(e)))?;
+        self.device_manager.legacy_devices.as_ref().unwrap().stdio_serial.lock().unwrap()
+            .restore_reused(&state.devices.serial_state.as_ref().ok_or_else(|| err(invalid("serial state absent")))?.into()).map_err(err)?;
+        self.device_manager.legacy_devices.as_ref().unwrap().i8042.lock().unwrap().reset_reused();
+        self.device_manager.acpi_devices.restore_direct_resident(&state.devices.acpi_state, vm.guest_memory())
+            .map_err(|e| err(io::Error::other(e)))?;
+        devices.rebind_direct(vm, events).map_err(|e| err(io::Error::other(e)))?;
+        timing.mark("restore_devices");
+        PARKED.store(false, std::sync::atomic::Ordering::Release);
+        self.reuse_restore_failed = false;
+        if profiling() {
+            crate::logger::info_unrestricted!("DIRECT_HANDOFF_JSON {}", serde_json::json!({
+                "event":"import", "token":state.token, "snapshot_bytes":0, "ram_transfer_bytes":0,
+                "memory_manifest_sha256":state.memory_manifest_sha256, "resident":true,
+                "pid":std::process::id(), "vm_fd":std::os::fd::AsRawFd::as_raw_fd(vm.fd()),
+                "vcpu_fd":std::os::fd::AsRawFd::as_raw_fd(&vm.vcpus_handles()[0].vcpu_fd),
+                "thread_creates":0, "disk_opens":0, "io_engine_creates":0,
+                "mapper":crate::pool_memory::manifest_for_profile()}));
+        }
+        timing.finish();
+        Ok(())
+    }
+}
+fn validate_resident_token(previous: &HandoffToken, next: &HandoffToken) -> io::Result<()> {
+    if next.generation <= previous.generation || next.vm_offset != previous.vm_offset
+        || next.vcpu_offset != previous.vcpu_offset || next.vmcs_offset != previous.vmcs_offset
+        || next.run_offset != previous.run_offset || next.ram_hva != previous.ram_hva
+        || next.ram_bytes != previous.ram_bytes || next.ept_root_offset != previous.ept_root_offset
+        || next.abi_version != previous.abi_version || next.vcpu_count != previous.vcpu_count
+        || next.vcpus != previous.vcpus || !valid_cpu_identities(next) {
+        return Err(invalid("stale or foreign resident token"));
+    }
+    Ok(())
+}
+
+fn valid_cpu_identities(t: &HandoffToken) -> bool {
+    if t.abi_version != ABI_VERSION || !(1..=u32::from(MAX_VCPUS)).contains(&t.vcpu_count) {
+        return false;
+    }
+    let count = t.vcpu_count as usize;
+    for (index, cpu) in t.vcpus[..count].iter().enumerate() {
+        if cpu.id != index as u32 || cpu.reserved != 0 || cpu.vcpu_offset == 0
+            || cpu.vmcs_offset == 0 || cpu.run_offset == 0 || cpu.ept_root_offset == 0
+            || cpu.vmcs_offset % 4096 != 0 || cpu.run_offset % 4096 != 0
+            || cpu.ept_root_offset % 4096 != 0 {
+            return false;
+        }
+        for previous in &t.vcpus[..index] {
+            if previous.vcpu_offset == cpu.vcpu_offset || previous.vmcs_offset == cpu.vmcs_offset
+                || previous.run_offset == cpu.run_offset { return false; }
+        }
+    }
+    t.vcpus[count..].iter().all(|cpu| *cpu == VcpuIdentity::default())
+        && t.vcpu_offset == t.vcpus[0].vcpu_offset && t.vmcs_offset == t.vcpus[0].vmcs_offset
+        && t.run_offset == t.vcpus[0].run_offset && t.ept_root_offset == t.vcpus[0].ept_root_offset
+}
+
+fn validate_state(state: &DirectState) -> io::Result<()> {
+    let t = &state.token;
+    if state.schema != "direct-device-handoff-v2"
+        || u32::from(state.machine_config.vcpu_count) != t.vcpu_count
+        || !valid_cpu_identities(t)
+        || state.machine_config.track_dirty_pages
+        || state.machine_config.huge_pages != HugePageConfig::None
+        || t.vm_creates != 1
+        || t.vcpu_creates != u64::from(t.vcpu_count)
+        || t.generation == 0
+        || t.vm_offset == 0
+        || t.flags != 2
+        || t.vcpu_offset == 0
+        || t.vmcs_offset == 0
+        || t.run_offset == 0
+        || t.ept_root_offset == 0
+        || t.ram_hva == 0
+        || t.ram_hva % 4096 != 0
+        || t.ram_bytes == 0
+        || t.ram_bytes % 4096 != 0
+        || t.ram_hva.checked_add(t.ram_bytes).is_none()
+        || state.memory.regions.len() != 1
+        || state.memory.regions[0].base_address != 0
+        || state.memory.regions[0].size as u64 != t.ram_bytes
+        || state.memory.regions[0].plugged != [true]
+        || (state.machine_config.mem_size_mib as u64).checked_mul(1024 * 1024) != Some(t.ram_bytes)
+        || state
+            .devices
+            .acpi_state
+            .vmgenid
+            .addr
+            .checked_add(16)
+            .is_none_or(|end| end > t.ram_bytes)
+        || state
+            .devices
+            .acpi_state
+            .vmclock
+            .guest_address
+            .checked_add(std::mem::size_of_val(&state.devices.acpi_state.vmclock.inner) as u64)
+            .is_none_or(|end| end > t.ram_bytes)
+    {
+        return Err(invalid("invalid direct handoff contract"));
+    }
+    let VirtioDevicesState::Mmio(devs) = &state.devices.virtio_state else {
+        return Err(invalid("direct requires MMIO"));
+    };
+    if !devs.net_devices.is_empty()
+        || devs.vsock_device.is_some()
+        || devs.entropy_device.is_some()
+        || devs.memory_device.is_some()
+        || !devs.pmem_devices.is_empty()
+        || devs.mmds.is_some()
+        || devs.block_devices.iter().any(|b| {
+            !matches!(&b.device_state,
+            BlockState::Virtio(b) if b.virtio_state.avail_features & (1 << 5) != 0)
+        })
+        || devs.balloon_device.is_some()
+    {
+        return Err(invalid("unsupported direct device state"));
+    }
+    Ok(())
+}
+
+pub(crate) fn build(
+    instance_info: &InstanceInfo,
+    resources: &VmResources,
+    events: &mut EventManager,
+    filters: &BpfThreadMap,
+) -> Result<Arc<Mutex<Vmm>>, StartMicrovmError> {
+    let mut timing = crate::persist::RestoreTiming::new("direct_import");
+    fn error(e: impl std::fmt::Display) -> StartMicrovmError {
+        StartMicrovmError::Internal(VmmError::DaxHandoff(io::Error::other(e.to_string())))
+    }
+    let mut state: DirectState = serde_json::from_slice(
+        &bounded_read(&env_path("FC_DAX_DIRECT_IMPORT").map_err(error)?).map_err(error)?,
+    )
+    .map_err(error)?;
+    validate_state(&state).map_err(error)?;
+    let manifest =
+        bounded_read(&env_path("FC_POOL_MEMORY_RESTORE").map_err(error)?).map_err(error)?;
+    if sha256(&manifest) != state.memory_manifest_sha256 {
+        return Err(error("direct memory manifest checksum mismatch"));
+    }
+    timing.mark("read_validate_metadata");
+    let dax = env_path("FC_DAX_RAM").map_err(error)?;
+    let offset = std::env::var("FC_DAX_OFFSET")
+        .unwrap_or_else(|_| "2097152".into())
+        .parse()
+        .map_err(error)?;
+    let regions = memory::devdax(
+        &[(GuestAddress(0), state.token.ram_bytes as usize)],
+        &dax,
+        offset,
+        false,
+        false,
+    )
+    .map_err(error)?;
+    if regions.len() != 1 || regions[0].as_ptr() as u64 != state.token.ram_hva {
+        return Err(error("direct destination HVA differs from retained slot"));
+    }
+    timing.mark("import_mapper");
+    let kvm = Kvm::new(Vec::new()).map_err(error)?;
+    timing.mark("kvm_capabilities");
+    let mut vm = KvmVm::attach_direct(kvm, &mut state.token).map_err(error)?;
+    timing.mark("attach_and_vm_wrapper");
+    vm.adopt_direct_memory(regions, &state.memory, &state.token)
+        .map_err(error)?;
+    timing.mark("adopt_memory");
+    let vcpus = vm.create_vcpus(state.machine_config.vcpu_count).map_err(error)?;
+    timing.mark("vcpu_wrapper");
+    let vm = Arc::new(vm);
+    let mut local_resources = VmResources::default();
+    local_resources.machine_config = state.machine_config.clone();
+    local_resources.boot_source.config = state.boot_source.clone();
+    local_resources.serial_out_path = resources.serial_out_path.clone();
+    local_resources.serial_rate_limiter_cfg = resources.serial_rate_limiter_cfg.clone();
+    let devices = DeviceManager::restore(
+        DeviceRestoreArgs {
+            mem: vm.guest_memory(),
+            vm: &vm,
+            event_manager: events,
+            vm_resources: &mut local_resources,
+            instance_id: &instance_info.id,
+            vcpus_exit_evt: vm.vcpus_exit_evt(),
+        },
+        &state.devices,
+    )
+    .map_err(error)?;
+    timing.mark("restore_devices");
+    let vmm = Vmm {
+        instance_info: InstanceInfo {
+            state: VmState::Paused,
+            ..instance_info.clone()
+        },
+        machine_config: state.machine_config,
+        boot_source_config: state.boot_source,
+        shutdown_exit_code: None,
+        reuse_restore_failed: false,
+        reuse_prepared: None,
+        vm: Vm::Kvm(vm.clone()),
+        device_manager: devices,
+    };
+    validate_live(&vmm).map_err(error)?;
+    timing.mark("validate_vmm");
+    vm.start_vcpus(
+        vcpus,
+        filters
+            .get("vcpu")
+            .ok_or(StartMicrovmError::MissingSeccompFilters("vcpu".into()))?
+            .clone(),
+    )
+    .map_err(error)?;
+    timing.mark("start_vcpu_thread");
+    let vmm = Arc::new(Mutex::new(vmm));
+    events.add_subscriber(vmm.clone());
+    timing.mark("register_events");
+    if profiling() {
+        crate::logger::info_unrestricted!(
+            "DIRECT_HANDOFF_JSON {}",
+            serde_json::json!({
+                "event":"import", "token":state.token, "snapshot_bytes":0, "ram_transfer_bytes":0,
+                "memory_manifest_sha256":state.memory_manifest_sha256,
+                "mapper":crate::pool_memory::manifest_for_profile(),
+            })
+        );
+    }
+    timing.mark("log_receipt");
+    timing.finish();
+    Ok(vmm)
+}
