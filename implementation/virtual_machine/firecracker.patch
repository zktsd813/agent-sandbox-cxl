+/// Promotion copies only paused, exclusively granted RAM.
+pub(crate) unsafe fn copy_non_temporal(source: *const u8, target: *mut u8, bytes: usize) {
+    assert_eq!((target as usize | bytes)&15,0);
+    unsafe {
+        for i in (0..bytes).step_by(16) {
+            let value=std::arch::x86_64::_mm_loadu_si128(source.add(i).cast());
+            std::arch::x86_64::_mm_stream_si128(target.add(i).cast(),value);
+        }
+        std::arch::x86_64::_mm_sfence();
+    }
+}
