+// SPDX-License-Identifier: Apache-2.0
+//! VM-private persistent CXL logical RAM and whole-RAM tier changes.
+//! Private controller plans assign exclusive frames. The kernel owns the mapping
+//! and epoch; handoff carries a bounded handle and never scans guest RAM.
+use std::fs::{File, OpenOptions};
+use std::io::{self, BufReader, BufWriter, Write};
+use std::os::fd::AsRawFd;
+use std::path::Path;
+use std::sync::{Arc, Mutex, OnceLock};
