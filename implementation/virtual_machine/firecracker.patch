+
+#[repr(C)]
+#[derive(Debug, Default, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct HandoffToken {
+    pub vm_offset: u64,
+    pub vcpu_offset: u64,
+    pub vmcs_offset: u64,
+    pub run_offset: u64,
+    pub generation: u64,
+    pub kernel_ns: u64,
+    pub pool_used: u64,
+    pub vm_creates: u64,
+    pub vcpu_creates: u64,
+    pub ram_hva: u64,
+    pub ram_bytes: u64,
+    pub node: u32,
+    pub flags: u32,
+    pub quiesce_ns: u64,
+    pub mmu_drain_ns: u64,
+    pub binding_ns: u64,
+    pub ept_root_offset: u64,
+    pub ept_page_count: u64,
+}
+
+#[derive(Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct DirectState {
+    schema: String,
+    token: HandoffToken,
+    machine_config: MachineConfig,
+    boot_source: BootSourceConfig,
+    memory: GuestMemoryState,
+    memory_manifest_sha256: String,
+    devices: DevicesState,
+}
+
+pub(crate) fn io_enabled() -> bool {
+    std::env::var("FC_DAX_DIRECT_IO").as_deref() == Ok("1")
+        && std::env::var("FC_DAX_DIRECT").as_deref() == Ok("1")
+}
+
+pub(crate) fn import_enabled() -> bool {
+    io_enabled() && std::env::var_os("FC_DAX_DIRECT_IMPORT").is_some()
+}
+
+fn invalid(message: impl Into<String>) -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidInput, message.into())
+}
+
+fn env_path(name: &str) -> io::Result<std::path::PathBuf> {
+    std::env::var_os(name)
+        .map(Into::into)
+        .ok_or_else(|| invalid(format!("missing {name}")))
+}
+
+fn bounded_read(path: &Path) -> io::Result<Vec<u8>> {
+    let mut bytes = Vec::new();
+    File::open(path)?
+        .take(32 * 1024 * 1024 + 1)
+        .read_to_end(&mut bytes)?;
+    if bytes.len() > 32 * 1024 * 1024 {
+        return Err(invalid("direct metadata exceeds 32 MiB"));
+    }
+    Ok(bytes)
+}
+
+fn sha256(bytes: &[u8]) -> String {
+    aws_lc_rs::digest::digest(&aws_lc_rs::digest::SHA256, bytes)
+        .as_ref()
+        .iter()
+        .map(|byte| format!("{byte:02x}"))
+        .collect()
+}
+
+fn read_ioctl() -> libc::c_ulong {
+    (0x8000_0000u64 | ((std::mem::size_of::<HandoffToken>() as u64) << 16) | 0xaef0) as _
+}
+
+pub(crate) fn attach_fd(kvm: &Kvm, token: &mut HandoffToken) -> io::Result<kvm_ioctls::VmFd> {
+    let original = token.clone();
+    // SAFETY: fixed repr(C) private ABI; kernel validates generation and ownership.
+    let fd = unsafe {
+        libc::ioctl(
+            kvm.fd.as_raw_fd(),
+            (read_ioctl() | 0x4000_0001) as _,
+            token as *mut HandoffToken,
+        )
+    };
+    if fd < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: ioctl returned a newly owned FD for the retained shared VM.
+    let vm = unsafe { kvm.fd.create_vmfd_from_rawfd(fd) }.map_err(io::Error::other)?;
+    if token.vm_offset != original.vm_offset
+        || token.vcpu_offset != original.vcpu_offset
+        || token.vmcs_offset != original.vmcs_offset
+        || token.run_offset != original.run_offset
+        || token.generation != original.generation
+        || token.ram_hva != original.ram_hva
+        || token.ram_bytes != original.ram_bytes
+        || token.ept_root_offset != original.ept_root_offset
+        || token.vm_creates != 1
+        || token.vcpu_creates != 1
+    {
+        crate::logger::error_unrestricted!("DIRECT_HANDOFF_FATAL attached identity mismatch");
+        std::process::abort();
+    }
+    Ok(vm)
+}
+
+pub(crate) fn validate_live(vmm: &Vmm) -> Result<(), VmmError> {
+    if vmm.machine_config.vcpu_count != 1
+        || vmm.machine_config.track_dirty_pages
+        || vmm.machine_config.huge_pages != HugePageConfig::None
+        || !matches!(vmm.device_manager.virtio_devices, VirtioDevices::Mmio(_))
+    {
+        return Err(VmmError::DaxPreflight(
+            "direct I/O requires 1 vCPU, 4 KiB untracked RAM and MMIO",
+        ));
+    }
+    let mut valid = true;
+    vmm.device_manager.for_each_virtio_device(|kind, dev| {
+        valid &= match kind {
+            VirtioDeviceType::Block => matches!(dev.as_any().downcast_ref::<Block>(), Some(Block::Virtio(b)) if b.read_only),
+            VirtioDeviceType::Balloon => crate::pool_cache::discard_enabled()
+                && dev.as_any().downcast_ref::<Balloon>().is_some_and(Balloon::pool_reporting_only),
+            _ => false,
+        };
+    });
+    if !valid {
+        return Err(VmmError::DaxPreflight(
+            "direct I/O permits read-only virtio block and opt-in reporting-only balloon",
+        ));
+    }
+    Ok(())
+}
+
+impl Vmm {
+    /// Transfer only device bindings and publish the retained kernel-object token.
+    /// Ordinary Pause intentionally retains ownership, so pooling can run first.
+    pub fn direct_export(&mut self) -> Result<(), VmmError> {
+        if !io_enabled()
+            || self.instance_info.state != VmState::Paused
+            || crate::pool_cache::mapping_failed()
+        {
+            return Err(VmmError::DaxPreflight(
+                "DirectExport requires opted-in paused owner",
+            ));
+        }
+        validate_live(self)?;
+        let vm = self
+            .vm
+            .as_kvm()
+            .ok_or(VmmError::DaxPreflight("KVM required"))?;
+        if vm.direct_is_detached() {
+            return Err(VmmError::DaxPreflight("direct owner already exported"));
+        }
+        let path = env_path("FC_DAX_DIRECT_EXPORT").map_err(VmmError::DaxHandoff)?;
+        // Reserve the output before mutating bindings. A previous generation is never overwritten.
+        let mut output = OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(&path)
+            .map_err(VmmError::DaxHandoff)?;
+        let started = std::time::Instant::now();
+        let devices = self.device_manager.save(); // Drains async I/O and captures resulting used rings.
+        self.check_block_snapshot_preparation()
+            .map_err(|e| VmmError::DaxHandoff(io::Error::other(e.to_string())))?;
+        crate::pool_memory::checkpoint_ready(vm.guest_memory()).map_err(VmmError::DaxHandoff)?;
+        let manifest =
+            bounded_read(&env_path("FC_POOL_MEMORY_MANIFEST").map_err(VmmError::DaxHandoff)?)
+                .map_err(VmmError::DaxHandoff)?;
+        let mut state = DirectState {
+            schema: "direct-device-handoff-v1".into(),
+            token: HandoffToken::default(),
+            machine_config: self.machine_config.clone(),
+            boot_source: self.boot_source_config.clone(),
+            memory: vm.guest_memory().describe(),
+            memory_manifest_sha256: sha256(&manifest),
+            devices,
+        };
+        let result = (|| -> io::Result<usize> {
+            let VirtioDevices::Mmio(mmio) = &self.device_manager.virtio_devices else {
+                unreachable!()
+            };
+            mmio.unbind_direct_ioevents(vm).map_err(io::Error::other)?;
+            vm.dax_direct_handoff(false)?;
+            // PEEK is a read-only global metadata operation; source VM ioctls are now revoked.
+            if unsafe {
+                libc::ioctl(
+                    vm.kvm().fd.as_raw_fd(),
+                    (read_ioctl() | 4) as _,
+                    &mut state.token as *mut HandoffToken,
+                )
+            } < 0
+            {
+                return Err(io::Error::last_os_error());
+            }
+            let bytes = serde_json::to_vec(&state).map_err(io::Error::other)?;
+            output.write_all(&bytes)?;
+            output.sync_all()?;
+            Ok(bytes.len())
+        })();
+        let bytes = match result {
+            Ok(bytes) => bytes,
+            Err(error) => {
+                crate::logger::error_unrestricted!("DIRECT_HANDOFF_FATAL export: {error}");
+                std::process::abort(); // Never resume partially unbound or detached device state.
+            }
+        };
+        crate::logger::info_unrestricted!(
+            "DIRECT_HANDOFF_JSON {}",
+            serde_json::json!({
+                "event":"export", "token":state.token, "device_state_bytes":bytes,
+                "snapshot_bytes":0, "ram_transfer_bytes":0, "elapsed_ns":started.elapsed().as_nanos() as u64,
+                "memory_manifest_sha256":state.memory_manifest_sha256,
+            })
+        );
+        Ok(())
+    }
+}
+
+fn validate_state(state: &DirectState) -> io::Result<()> {
+    let t = &state.token;
+    if state.schema != "direct-device-handoff-v1"
+        || state.machine_config.vcpu_count != 1
+        || state.machine_config.track_dirty_pages
+        || state.machine_config.huge_pages != HugePageConfig::None
+        || t.vm_creates != 1
+        || t.vcpu_creates != 1
+        || t.generation == 0
+        || t.vm_offset == 0
+        || t.flags != 2
+        || t.vcpu_offset == 0
+        || t.vmcs_offset == 0
+        || t.run_offset == 0
+        || t.ept_root_offset == 0
+        || t.ram_hva == 0
+        || t.ram_hva % 4096 != 0
+        || t.ram_bytes == 0
+        || t.ram_bytes % 4096 != 0
+        || t.ram_hva.checked_add(t.ram_bytes).is_none()
+        || state.memory.regions.len() != 1
+        || state.memory.regions[0].base_address != 0
+        || state.memory.regions[0].size as u64 != t.ram_bytes
+        || state.memory.regions[0].plugged != [true]
+        || (state.machine_config.mem_size_mib as u64).checked_mul(1024 * 1024) != Some(t.ram_bytes)
+        || state
+            .devices
+            .acpi_state
+            .vmgenid
+            .addr
+            .checked_add(16)
+            .is_none_or(|end| end > t.ram_bytes)
+        || state
+            .devices
+            .acpi_state
+            .vmclock
+            .guest_address
+            .checked_add(std::mem::size_of_val(&state.devices.acpi_state.vmclock.inner) as u64)
+            .is_none_or(|end| end > t.ram_bytes)
+    {
+        return Err(invalid("invalid direct handoff contract"));
+    }
+    let VirtioDevicesState::Mmio(devs) = &state.devices.virtio_state else {
+        return Err(invalid("direct requires MMIO"));
+    };
+    if !devs.net_devices.is_empty()
+        || devs.vsock_device.is_some()
+        || devs.entropy_device.is_some()
+        || devs.memory_device.is_some()
+        || !devs.pmem_devices.is_empty()
+        || devs.mmds.is_some()
+        || devs.block_devices.iter().any(|b| {
+            !matches!(&b.device_state,
+            BlockState::Virtio(b) if b.virtio_state.avail_features & (1 << 5) != 0)
+        })
+        || (devs.balloon_device.is_some() && !crate::pool_cache::discard_enabled())
+    {
+        return Err(invalid("unsupported direct device state"));
+    }
+    Ok(())
+}
