new file mode 100644
index 000000000..84fb71000
--- /dev/null
+++ b/src/firecracker/src/dax_heap.rs
@@ -0,0 +1,395 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Opt-in single-process heap in device-DAX. No fallback after activation.
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::fs::OpenOptions;
+use std::io;
+use std::mem::size_of;
+use std::os::fd::AsRawFd;
+use std::os::unix::fs::FileTypeExt;
+use std::ptr;
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+
+const CONTROL_BYTES: usize = 4096;
+const MAGIC: usize = 0x4643444158484541;
+
+#[repr(C, align(64))]
+struct Control {
+    magic: usize,
+    base: usize,
+    length: usize,
+    head: AtomicUsize,
+    allocs: AtomicUsize,
+    frees: AtomicUsize,
+    live_bytes: AtomicUsize,
+    failures: AtomicUsize,
+    lock: AtomicBool,
+}
+
+#[repr(C)]
+struct FreeBlock {
+    bytes: usize,
+    next: usize,
+}
+
+#[repr(C)]
+struct Header {
+    start: usize,
+    bytes: usize,
+}
+
+struct DaxHeap {
+    base: AtomicUsize,
+}
+
+#[global_allocator]
+static HEAP: DaxHeap = DaxHeap {
+    base: AtomicUsize::new(0),
+};
+
+impl DaxHeap {
+    // SAFETY: caller owns an aligned writable mapping of at least two pages,
+    // and has not yet published it to allocator callers.
+    unsafe fn attach(&self, base: usize, length: usize) {
+        unsafe {
+            ptr::write(
+                base as *mut Control,
+                Control {
+                    magic: MAGIC,
+                    base,
+                    length,
+                    head: AtomicUsize::new(CONTROL_BYTES),
+                    allocs: AtomicUsize::new(0),
+                    frees: AtomicUsize::new(0),
+                    live_bytes: AtomicUsize::new(0),
+                    failures: AtomicUsize::new(0),
+                    lock: AtomicBool::new(false),
+                },
+            );
+            ptr::write(
+                (base + CONTROL_BYTES) as *mut FreeBlock,
+                FreeBlock {
+                    bytes: length - CONTROL_BYTES,
+                    next: 0,
+                },
+            );
+        }
+        self.base.store(base, Ordering::Release);
+    }
+
+    fn lock(control: &Control) {
+        while control
+            .lock
+            .compare_exchange_weak(false, true, Ordering::Acquire, Ordering::Relaxed)
+            .is_err()
+        {
+            std::hint::spin_loop();
+        }
+    }
+}
+
+// SAFETY: all free-list mutations are protected by the arena lock. Returned
+// allocations are disjoint and aligned; allocation metadata uses arena offsets.
+unsafe impl GlobalAlloc for DaxHeap {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        let base = self.base.load(Ordering::Acquire);
+        if base == 0 {
+            return unsafe { System.alloc(layout) };
+        }
+        // SAFETY: attach published an initialized, process-lifetime mapping.
+        let control = unsafe { &*(base as *const Control) };
+        Self::lock(control);
+        let mut previous = 0;
+        let mut current = control.head.load(Ordering::Relaxed);
+        while current != 0 {
+            // SAFETY: free-list offsets refer to owned blocks within the arena.
+            let block = unsafe { &mut *((base + current) as *mut FreeBlock) };
+            let align = layout.align().max(8);
+            let start = base + current + size_of::<Header>();
+            let user = match start.checked_add(align - 1) {
+                Some(v) => v & !(align - 1),
+                None => break,
+            };
+            let needed = match (user - base - current)
+                .checked_add(layout.size().max(1))
+                .and_then(|v| v.checked_add(7))
+            {
+                Some(v) => v & !7,
+                None => break,
+            };
+            if needed <= block.bytes {
+                let bytes = if block.bytes - needed >= size_of::<FreeBlock>() {
+                    let split = current + needed;
+                    unsafe {
+                        ptr::write(
+                            (base + split) as *mut FreeBlock,
+                            FreeBlock {
+                                bytes: block.bytes - needed,
+                                next: block.next,
+                            },
+                        );
+                    }
+                    needed
+                } else {
+                    block.bytes
+                };
+                let next = if bytes == block.bytes {
+                    block.next
+                } else {
+                    current + bytes
+                };
+                if previous == 0 {
+                    control.head.store(next, Ordering::Relaxed);
+                } else {
+                    unsafe {
+                        (*((base + previous) as *mut FreeBlock)).next = next;
+                    }
+                }
+                unsafe {
+                    ptr::write(
+                        (user - size_of::<Header>()) as *mut Header,
+                        Header {
+                            start: current,
+                            bytes,
+                        },
+                    );
+                }
+                control.allocs.fetch_add(1, Ordering::Relaxed);
+                control.live_bytes.fetch_add(bytes, Ordering::Relaxed);
+                control.lock.store(false, Ordering::Release);
+                return user as *mut u8;
+            }
+            previous = current;
+            current = block.next;
+        }
+        control.failures.fetch_add(1, Ordering::Relaxed);
+        control.lock.store(false, Ordering::Release);
+        ptr::null_mut()
+    }
+
+    unsafe fn dealloc(&self, pointer: *mut u8, layout: Layout) {
+        let base = self.base.load(Ordering::Acquire);
+        if base == 0 {
+            unsafe {
+                System.dealloc(pointer, layout);
+            }
+            return;
+        }
+        let control = unsafe { &*(base as *const Control) };
+        if (pointer as usize) < base || pointer as usize - base >= control.length {
+            unsafe {
+                System.dealloc(pointer, layout);
+            }
+            return;
+        }
+        // SAFETY: GlobalAlloc requires a live pointer previously returned by alloc.
+        let header = unsafe { ptr::read(pointer.sub(size_of::<Header>()) as *const Header) };
+        Self::lock(control);
+        let mut previous = 0;
+        let mut current = control.head.load(Ordering::Relaxed);
+        while current != 0 && current < header.start {
+            previous = current;
+            current = unsafe { (*((base + current) as *const FreeBlock)).next };
+        }
+        let block = (base + header.start) as *mut FreeBlock;
+        unsafe {
+            ptr::write(
+                block,
+                FreeBlock {
+                    bytes: header.bytes,
+                    next: current,
+                },
+            );
+            if current != 0 && header.start + (*block).bytes == current {
+                let following = &*((base + current) as *const FreeBlock);
+                (*block).bytes += following.bytes;
+                (*block).next = following.next;
+            }
+            if previous == 0 {
+                control.head.store(header.start, Ordering::Relaxed);
+            } else {
+                let preceding = &mut *((base + previous) as *mut FreeBlock);
+                if previous + preceding.bytes == header.start {
+                    preceding.bytes += (*block).bytes;
+                    preceding.next = (*block).next;
+                } else {
+                    preceding.next = header.start;
+                }
+            }
+        }
+        control.frees.fetch_add(1, Ordering::Relaxed);
+        control
+            .live_bytes
+            .fetch_sub(header.bytes, Ordering::Relaxed);
+        control.lock.store(false, Ordering::Release);
+    }
+}
+
+pub fn init() -> io::Result<()> {
+    let Some(path) = std::env::var_os("FC_DAX_HEAP") else {
+        return Ok(());
+    };
+    let invalid = || io::Error::new(io::ErrorKind::InvalidInput, "invalid DAX heap allocation");
+    let offset: usize = std::env::var("FC_DAX_HEAP_OFFSET")
+        .unwrap_or_else(|_| "536870912".into())
+        .parse()
+        .map_err(|_| invalid())?;
+    let length: usize = std::env::var("FC_DAX_HEAP_BYTES")
+        .unwrap_or_else(|_| "67108864".into())
+        .parse()
+        .map_err(|_| invalid())?;
+    let path = std::path::Path::new(&path);
+    let name = path
+        .file_name()
+        .and_then(|v| v.to_str())
+        .ok_or_else(invalid)?;
+    let file = OpenOptions::new().read(true).write(true).open(path)?;
+    if !file.metadata()?.file_type().is_char_device() {
+        return Err(invalid());
+    }
+    let attr = |name_attr| -> io::Result<usize> {
+        std::fs::read_to_string(format!("/sys/bus/dax/devices/{name}/{name_attr}"))?
+            .trim()
+            .parse()
+            .map_err(|_| invalid())
+    };
+    let align = attr("align")?;
+    if !align.is_power_of_two()
+        || offset % align != 0
+        || length % align != 0
+        || length <= CONTROL_BYTES
+        || offset.checked_add(length).ok_or_else(invalid)? > attr("size")?
+    {
+        return Err(invalid());
+    }
+    let mapped = unsafe {
+        libc::mmap(
+            ptr::null_mut(),
+            length,
+            libc::PROT_READ | libc::PROT_WRITE,
+            libc::MAP_SHARED,
+            file.as_raw_fd(),
+            offset as libc::off_t,
+        )
+    };
+    if mapped == libc::MAP_FAILED {
+        return Err(io::Error::last_os_error());
+    }
+    // Cold boot only: initialize this exclusively reserved heap allocation.
+    unsafe {
+        HEAP.attach(mapped as usize, length);
+    }
+    eprintln!(
+        "DAX_HEAP path={} offset={} bytes={} base={:#x}",
+        path.display(),
+        offset,
+        length,
+        mapped as usize
+    );
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn alignment_reuse_coalescing_and_no_fallback() {
+        let length = 128 * 1024;
+        let base = unsafe {
+            libc::mmap(
+                ptr::null_mut(),
+                length,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_PRIVATE | libc::MAP_ANONYMOUS,
+                -1,
+                0,
+            )
+        };
+        assert_ne!(base, libc::MAP_FAILED);
+        let heap = DaxHeap {
+            base: AtomicUsize::new(0),
+        };
+        unsafe {
+            heap.attach(base as usize, length);
+        }
+        let mut allocations = Vec::new();
+        for align in [1, 8, 64, 4096] {
+            let layout = Layout::from_size_align(1003, align).unwrap();
+            let pointer = unsafe { heap.alloc(layout) };
+            assert!(!pointer.is_null());
+            assert_eq!(pointer as usize % align, 0);
+            unsafe {
+                ptr::write_bytes(pointer, 0x5a, layout.size());
+            }
+            allocations.push((pointer, layout));
+        }
+        for (pointer, layout) in allocations.into_iter().rev() {
+            assert!(
