@@ -0,0 +1,248 @@
+// SPDX-License-Identifier: Apache-2.0
+//! CXL RAM/EPT only. Semantic state enters an ordinary prepared KVM worker.
+use std::fs::OpenOptions;
+use std::io;
+use std::os::fd::AsRawFd;
+use std::sync::Mutex;
+use std::time::Instant;
+use serde::{Deserialize, Serialize};
+use vm_memory::{Bytes, GuestAddress};
+use crate::device_manager::{DevicesState, VirtioDevices, VirtioDevicesState};
+use crate::snapshot::Persist;
+use crate::persist::{MicrovmState, RestoreTiming, VmInfo};
+use crate::vmm_config::instance_info::VmState;
+use crate::{EventManager, Vmm};
+
+const BYTES: u64 = 16 << 20;
+const RELEASE: libc::c_ulong = 0xc048aefa;
+const ADOPT: libc::c_ulong = 0xc048aefb;
+#[repr(C)]
+#[derive(Default, Clone, Debug, Serialize, Deserialize)]
+struct Ept { base: u64, bump: u64, root: u64, data_base: u64, data_bytes: u64,
+    pages: [u64;3], role: u32, flags: u32 }
+#[derive(Serialize, Deserialize)]
+struct Packet { version: u32, ept: Ept, epoch: u64, state: MicrovmState,
+    mapper: crate::pool_memory::Manifest }
+static RECEIPT: Mutex<[u64;8]> = Mutex::new([0;8]);
+pub(crate) fn receipt() -> [u64;8] { *RECEIPT.lock().unwrap() }
+pub(crate) fn enabled() -> bool { std::env::var("FC_EPT_ADOPT").as_deref() == Ok("1") }
+pub(crate) fn retained() -> bool {enabled() && !baseline()}
+fn baseline() -> bool { std::env::var("FC_EPT_BASELINE").as_deref()==Ok("1") }
+fn invalid(s: impl ToString) -> io::Error { io::Error::other(s.to_string()) }
+fn number(name: &str) -> io::Result<u64> { std::env::var(name).map_err(invalid)?.parse().map_err(invalid) }
+fn packet_path() -> io::Result<String> { std::env::var("FC_EPT_PACKET").map_err(invalid) }
+fn ioctl(vm: &crate::vstate::vm::KvmVm, cmd: libc::c_ulong, ept: &mut Ept) -> io::Result<()> {
+    if unsafe { libc::ioctl(vm.fd().as_raw_fd(), cmd as _, ept) } < 0 { return Err(io::Error::last_os_error()); }
+    Ok(())
+}
+
+pub(crate) fn devices_ok(state: &DevicesState) -> bool {
+    if !enabled() { return false; }
+    let VirtioDevicesState::Mmio(s) = &state.virtio_state else {return false;};
+    s.net_devices.is_empty() && s.vsock_device.is_none() && s.balloon_device.is_none()
+        && s.entropy_device.is_none() && s.pmem_devices.is_empty() && s.memory_device.is_none()
+        && s.mmds.is_none() && s.block_devices.iter().all(|d| match &d.device_state {
+            crate::devices::virtio::block::persist::BlockState::Virtio(b) =>
+                b.virtio_state.avail_features & (1<<5) != 0 && b.virtio_state.activated,
+            _ => false,
+        })
+}
+
+pub(crate) fn init(vm: &crate::vstate::vm::KvmVm, wait: bool) -> io::Result<()> {
+    if !enabled() { return Ok(()); }
+    if std::env::var("FC_EPT_FAIL").is_ok_and(|v|!v.is_empty())
+        && std::env::var("FC_DIRTY_ORACLE").as_deref()!=Ok("1") {
+        return Err(invalid("EPT fault injection requires the independent lab oracle"));
+    }
+    let (phys,bytes)=crate::pool_memory::dax_geometry("/dev/dax0.0")?;
+    let offset=number("FC_EPT_OFFSET")?;
+    if offset>bytes || BYTES>bytes-offset || phys.checked_add(offset)!=Some(number("FC_EPT_PHYS")?) {
+        return Err(invalid("EPT maintenance mapping differs from the kernel extent"));
+    }
+    if !crate::noncoherent::enabled() {
+        return Err(invalid("EPT adoption requires dirty logging"));
+    }
+    if baseline() { let mut r=RECEIPT.lock().unwrap();r[6]=1;r[7]=1;return Ok(()); }
+    let mut q=Ept {base:number("FC_EPT_PHYS")?,data_base:number("FC_EPT_DATA_BASE")?,
+        data_bytes:number("FC_EPT_DATA_BYTES")?,flags:1|if wait {2} else {0},..Default::default()};
+    ioctl(vm,ADOPT,&mut q)
+}
+
+fn maintain(ept: &Ept, invalidate: bool) -> io::Result<()> {
+    if ept.bump==0 || ept.bump>BYTES || ept.bump%4096!=0 {return Err(invalid("EPT bump geometry"));}
+    if std::arch::x86_64::__cpuid_count(7,0).ebx & (3<<23) != 3<<23 {return Err(invalid("cache instructions absent"));}
+    let file=OpenOptions::new().read(true).write(true).open("/dev/dax0.0")?;
+    let offset=number("FC_EPT_OFFSET")?;
+    let address=unsafe {libc::mmap(std::ptr::null_mut(),BYTES as usize,libc::PROT_READ|libc::PROT_WRITE,
+        libc::MAP_SHARED,file.as_raw_fd(),offset as libc::off_t)};
+    if address==libc::MAP_FAILED {return Err(io::Error::last_os_error());}
+    let start=Instant::now();let mut emitted=0;
+    let skip=invalidate && std::env::var("FC_EPT_FAIL").as_deref()==Ok("ept-invalidate");
+    if !skip && crate::noncoherent::active() {
+        for byte in (0..ept.bump as usize).step_by(64) {
+            let p=unsafe {address.cast::<u8>().add(byte)};
+            unsafe {
+                if invalidate {std::arch::asm!("clflushopt [{p}]",p=in(reg)p,options(nostack,preserves_flags));}
+                else {std::arch::asm!("clwb [{p}]",p=in(reg)p,options(nostack,preserves_flags));}
+            }
+            emitted+=1;
+        }
+    }
+    unsafe {
+        if invalidate {std::arch::asm!("mfence",options(nostack,preserves_flags));}
+        else {std::arch::asm!("sfence",options(nostack,preserves_flags));}
+        libc::munmap(address,BYTES as usize);
+    }
+    let mut r=RECEIPT.lock().unwrap();let i=usize::from(invalidate);
+    r[i]=start.elapsed().as_nanos() as u64;r[2+i]=ept.bump;r[4+i]=emitted;r[6+i]=1;
+    crate::logger::info_unrestricted!("EPT_CACHE_JSON {}",serde_json::json!({"invalidate":invalidate,
+        "bytes":ept.bump,"lines":emitted,"ns":r[i]}));
+    // The independent L0 oracle checks this receipt before granting resume.
+    Ok(())
+}
+
+fn block_irqs(vmm: &Vmm, bind: bool) -> io::Result<()> {
+    let vm=vmm.vm.as_kvm().ok_or_else(||invalid("KVM absent"))?;
+    let VirtioDevices::Mmio(mmio)=&vmm.device_manager.virtio_devices else {return Err(invalid("MMIO required"));};
+    for d in mmio.virtio_devices.values() {
+        let t=d.inner.lock().unwrap();
+        let gsi=d.resources.gsi.ok_or_else(||invalid("block GSI absent"))?;
+        if bind {vm.fd().register_irqfd(&t.interrupt.irq_evt,gsi)}
+        else {vm.fd().unregister_irqfd(&t.interrupt.irq_evt,gsi)}.map_err(invalid)?;
+        if !bind {while t.interrupt.irq_evt.read().is_ok() {}}
+    }
+    Ok(())
+}
+
+impl Vmm {
+    /// Publish owner writes, or preinvalidate RAM on the prepared observer.
+    pub fn ept_clean(&mut self) -> io::Result<()> {
+        if !enabled() || self.worker_restore_failed {return Err(invalid("EPT clean unavailable"));}
+        if self.worker_prepared.is_some() {
+            let bytes=std::fs::read(std::env::var("FC_POOL_MEMORY_MANIFEST").map_err(invalid)?)?;
+            let manifest=serde_json::from_slice::<crate::pool_memory::Manifest>(&bytes).map_err(invalid)?;
+            return crate::noncoherent::preinvalidate_cold(&manifest);
+        }
+        if self.instance_info.state!=VmState::Running {return Err(invalid("EPT owner is not running"));}
+        let vm=self.vm.as_kvm().unwrap();
+        self.device_manager.mark_virtio_queue_memory_dirty(vm.guest_memory());
+        let ledger=crate::noncoherent::require(crate::noncoherent::collect(vm));
+        crate::noncoherent::require(crate::noncoherent::send(vm.guest_memory(),&ledger));
+        crate::noncoherent::cleaned(vm.guest_memory(),&ledger,false)
+    }
+
+    pub(crate) fn ept_prepare(&mut self, events: &mut EventManager) -> io::Result<()> {
+        if !enabled() || self.instance_info.state!=VmState::Paused || !self.machine_config.track_dirty_pages {
+            return Err(invalid("EPT prepare requires a paused dirty-logged worker"));
+        }
+        self.prepare_worker().map_err(invalid)?;
+        block_irqs(self,false)?;
+        let vm=self.vm.as_kvm().unwrap();
+        let VirtioDevices::Mmio(mmio)=&mut self.device_manager.virtio_devices else {unreachable!()};
+        mmio.unbind_worker_ioevents(vm).map_err(invalid)?;
+        mmio.suspend_events(events);
+        init(vm,true)
+    }
+
+    pub(crate) fn ept_export(&mut self, events: &mut EventManager) -> io::Result<()> {
+        let bytes=self.ept_send_memory(events)?;
+        std::fs::write(packet_path()?,bytes)
+    }
+
+    /// Export semantic CPU/device state and a retained EPT root to the existing worker transport.
+    pub fn ept_send_memory(&mut self, events: &mut EventManager) -> io::Result<Vec<u8>> {
+        if !enabled() || self.worker_prepared.is_some() || self.worker_restore_failed {return Err(invalid("EPT source unavailable"));}
+        self.pause_vm().map_err(invalid)?;
+        let mut timing=RestoreTiming::new("ept_export");
+        let devices=self.device_manager.save();
+        self.check_block_snapshot_preparation().map_err(invalid)?;
+        if !self.machine_config.track_dirty_pages || !devices_ok(&devices) {return Err(invalid("EPT device/dirty contract"));}
+        let vm=self.vm.as_kvm().unwrap();
+        if let Ok(gpa)=std::env::var("FC_BENCH_EPOCH_GPA") {
+            let gpa=gpa.parse::<u64>().map_err(invalid)?;
+            let old:u64=vm.guest_memory().read_obj(GuestAddress(gpa+16)).map_err(invalid)?;
+            vm.guest_memory().write_obj(if old==0 {number("FC_BENCH_INITIAL_EPOCH")?+1} else {old+1},GuestAddress(gpa+16)).map_err(invalid)?;
+        }
+        self.device_manager.mark_virtio_queue_memory_dirty(vm.guest_memory());
+        let ledger=crate::noncoherent::require(crate::noncoherent::collect(vm));
+        let epoch=crate::noncoherent::require(crate::noncoherent::send(vm.guest_memory(),&ledger));
+        timing.mark("ram_writeback_publish");
+        self.worker_restore_failed=true;
+        let mut ept=Ept::default();
+        if !baseline() {ioctl(vm,RELEASE,&mut ept)?;}
+        timing.mark("release");
+        if !baseline() {maintain(&ept,false)?;}
+        timing.mark("ept_writeback");
+        let state=MicrovmState {vm_info:VmInfo::from(&*self),device_states:devices,
+            vcpu_states:vm.save_vcpu_states_without_kick().map_err(invalid)?,
+            kvm_state:vm.kvm().save_state(),vm_state:vm.save_state().map_err(invalid)?};
+        timing.mark("get_state");
+        let mapper=crate::pool_memory::seal_for_handoff_memory(vm.guest_memory())?;
+        timing.mark("seal_mapper");
+        let bytes=bitcode::serialize(&Packet{version:1,ept:ept.clone(),epoch,state,mapper}).map_err(invalid)?;
+        if bytes.len()>=65536 {return Err(invalid("EPT packet exceeds mailbox"));}
+        timing.mark("serialize");
+        crate::noncoherent::require(crate::noncoherent::complete(vm.guest_memory(),&bytes,epoch,ept.bump,0,&ledger));
+        timing.mark("oracle_export");
+        // Only the local-EPT comparison retires its old translation context.
+        if baseline() {
+            let mut handles=vm.vcpus_handles();
+            for handle in handles.iter_mut() {
+                handle.prepare_worker_without_kick();
+                if !matches!(handle.response_receiver().recv_timeout(crate::RECV_TIMEOUT_SEC),
+                    Ok(crate::VcpuResponse::PreparedWorker)) {return Err(invalid("baseline EPT retirement failed"));}
+            }
+        }
+        // Prepare the retired local worker without touching architectural CPU state.
+        let irqfds=self.worker_irqfds().map_err(invalid)?;
+        vm.quiesce_worker_pit().map_err(invalid)?;
+        for (event,gsi) in &irqfds {vm.fd().unregister_irqfd(event,*gsi).map_err(invalid)?;while event.read().is_ok() {}}
+        block_irqs(self,false)?;
+        let VirtioDevices::Mmio(mmio)=&mut self.device_manager.virtio_devices else {unreachable!()};
+        mmio.unbind_worker_ioevents(vm).map_err(invalid)?;mmio.suspend_events(events);
+        crate::pool_memory::release_mapping(vm.guest_memory())?;
+        self.worker_prepared=Some(crate::worker::Prepared{irqfds,generation:epoch});
+        self.worker_restore_failed=false;
+        timing.finish();
+        Ok(bytes)
+    }
+
+    pub(crate) fn ept_import(&mut self, events: &mut EventManager) -> io::Result<()> {
+        let bytes=std::fs::read(packet_path()?)?;
+        self.ept_receive_memory(events,&bytes)
+    }
+
+    /// Import into a prepared local VM/vCPU. All KVM objects are local.
+    pub fn ept_receive_memory(&mut self, events: &mut EventManager, bytes: &[u8]) -> io::Result<()> {
+        if !enabled() || self.worker_prepared.is_none() || self.worker_restore_failed {return Err(invalid("EPT receiver unprepared"));}
+        let mut timing=RestoreTiming::new("ept_import");
+        if bytes.len()>=65536 {return Err(invalid("EPT packet too large"));}
+        let mut p:Packet=bitcode::deserialize(&bytes).map_err(invalid)?;
+        if p.version!=1 || (!baseline() && p.ept.base!=number("FC_EPT_PHYS")?) {return Err(invalid("foreign EPT packet"));}
+        let vm=self.vm.as_kvm().unwrap();
+        crate::noncoherent::require(crate::noncoherent::prepare(&p.mapper,&bytes,p.epoch));
+        crate::pool_memory::import_worker_mapping(vm.guest_memory(),p.mapper)?;
+        if !baseline() {maintain(&p.ept,true)?;}
+        // Kernel metadata is still absent. RAM and table invalidation precede ADOPT.
+        crate::noncoherent::require(crate::noncoherent::received(vm.guest_memory(),p.epoch,p.ept.bump,0));
+        timing.mark("invalidate");
+        match std::env::var("FC_EPT_FAIL").as_deref() {
+            Ok("outside")=>p.ept.root=BYTES,
+            Ok("bump")=>p.ept.bump=0,
+            _=>(),
+        }
+        if !baseline() {ioctl(vm,ADOPT,&mut p.ept)?;}
+        timing.mark("adopt");
+        crate::noncoherent::require(crate::noncoherent::adopted(vm.guest_memory(),p.ept.bump));
+        self.restore_worker_state(p.state).map_err(invalid)?;
+        timing.mark("set_state");
+        block_irqs(self,true)?;
+        let vm=self.vm.as_kvm().unwrap();
+        let VirtioDevices::Mmio(mmio)=&mut self.device_manager.virtio_devices else {unreachable!()};
+        mmio.resume_events(vm,events).map_err(invalid)?;
+        timing.mark("devices");
+        self.resume_vm().map_err(invalid)?;
+        timing.mark("resume");timing.finish();
+        Ok(())
+    }
+}
