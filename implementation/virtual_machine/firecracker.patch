+// SPDX-License-Identifier: Apache-2.0
+
+//! Opt-in, deliberately narrow semantic restore into an already-used KVM worker.
+//! RAM stays at the same DAX offset; this does not import kernel pointers or VMCS bytes.
+
+use std::os::fd::AsRawFd;
+use std::os::unix::fs::{FileTypeExt, MetadataExt};
+use std::path::Path;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+use kvm_bindings::{CpuId, KVM_MAX_CPUID_ENTRIES};
+use vm_memory::{GuestMemoryBackend, GuestMemoryRegion};
+
+use crate::device_manager::{DevicesState, VirtioDevicesState};
+use crate::devices::legacy::EventFdTrigger;
+use crate::persist::{
+    MicrovmState, RestoreTiming, VmInfo, dax_snapshot_offset, snapshot_state_from_file,
+};
+use crate::snapshot::Persist;
+use crate::vmm_config::instance_info::VmState;
+use crate::vmm_config::machine_config::HugePageConfig;
+use crate::vmm_config::snapshot::{LoadSnapshotParams, MemBackendType};
+use crate::vstate::memory::{GuestMemoryExtension, GuestMemoryMmap, GuestRegionType};
+use crate::{VcpuResponse, Vmm};
+
+static REUSE_SEQUENCE: AtomicU64 = AtomicU64::new(0);
+
+/// A single outstanding local preparation. Eventfd clones retain kernel identity across UART
+/// replacement. No snapshot bytes, guest RAM, or remote pointers are stored here.
+#[derive(Debug)]
+pub(crate) struct ReusePrepared {
+    irqfds: [(EventFdTrigger, u32); 4],
+    strict_irqfd: bool,
+    generation: u64,
+}
+
+/// Captured before first KVM_RUN. KVM forbids changing this CPU model after use;
+/// caching avoids loading the VMCS on the VMM thread just to read invariants.
+#[derive(Debug)]
+pub(crate) struct ReuseCpuContract {
+    cpuid: CpuId,
+    immutable_msrs: Vec<(u32, u64)>,
+    tsc_khz: Option<u32>,
+}
+
+fn immutable_msr(index: u32) -> bool {
+    matches!(index, 0x10a | 0x345 | 0xc0011029 | 0x480..=0x491)
+}
+
+impl ReuseCpuContract {
+    pub(crate) fn capture(vcpu: &crate::arch::KvmVcpu) -> Result<Self, String> {
+        let cpuid = vcpu
+            .fd
+            .get_cpuid2(KVM_MAX_CPUID_ENTRIES)
+            .map_err(|e| e.to_string())?;
+        ensure(
+            cpuid.as_slice().iter().all(|leaf| match leaf.function {
+                1 => leaf.ecx & (1 << 5) == 0,
+                0x80000001 => leaf.ecx & (1 << 2) == 0,
+                _ => true,
+            }),
+            "reuse worker CPU exposes nested virtualization",
+        )?;
+        let mut indices: Vec<_> = vcpu
+            .snapshot_msr_indices()
+            .into_iter()
+            .filter(|i| immutable_msr(*i))
+            .collect();
+        indices.dedup();
+        let immutable_msrs = if indices.is_empty() {
+            Vec::new()
+        } else {
+            vcpu.get_msr_chunk(indices.iter().copied(), indices.len())
+                .map_err(|e| e.to_string())?
+                .as_slice()
+                .iter()
+                .map(|entry| (entry.index, entry.data))
+                .collect()
+        };
+        Ok(Self {
+            cpuid: cpuid_contract(cpuid),
+            immutable_msrs,
+            tsc_khz: vcpu.fd.get_tsc_khz().ok(),
+        })
+    }
+
+    fn validate(&self, state: &crate::vstate::vcpu::VcpuState) -> Result<(), String> {
+        ensure(
+            self.cpuid == cpuid_contract(state.cpuid.clone()),
+            "reuse CPUID model mismatch",
+        )?;
+        ensure(
+            state
+                .saved_msrs
+                .iter()
+                .flat_map(|m| m.as_slice())
+                .filter(|m| immutable_msr(m.index))
+                .all(|msr| self.immutable_msrs.contains(&(msr.index, msr.data))),
+            "reuse immutable feature MSR mismatch",
+        )?;
+        ensure(
+            state.tsc_khz.is_none() || state.tsc_khz == self.tsc_khz,
+            "reuse TSC frequency mismatch",
+        )
+    }
+}
+
+fn ensure(ok: bool, reason: &str) -> Result<(), String> {
+    ok.then_some(()).ok_or_else(|| reason.to_owned())
+}
+
+/// Preparation and restore must retain the same shared physical DAX allocation.
+fn validate_dax_backing(
+    memory: &GuestMemoryMmap,
+    path: &Path,
+    mut offset: u64,
+) -> Result<(), String> {
+    let wanted = std::fs::metadata(path).map_err(|e| e.to_string())?;
+    ensure(
+        wanted.file_type().is_char_device(),
+        "reuse backing is not device DAX",
+    )?;
+    for region in memory.iter() {
+        let backing = region.file_offset().ok_or("reuse backing is anonymous")?;
+        let got = backing.file().metadata().map_err(|e| e.to_string())?;
+        ensure(
+            got.rdev() == wanted.rdev()
+                && backing.start() == offset
+                && region.flags() & libc::MAP_SHARED != 0,
+            "reuse DAX allocation mismatch",
+        )?;
+        offset = offset
+            .checked_add(region.len())
+            .ok_or("reuse DAX offset overflow")?;
+    }
+    Ok(())
+}
+
+fn diskless(state: &DevicesState) -> bool {
+    match &state.virtio_state {
+        VirtioDevicesState::Mmio(devices) => {
+            devices.block_devices.is_empty()
+                && devices.net_devices.is_empty()
+                && devices.vsock_device.is_none()
+                && devices.balloon_device.is_none()
+                && devices.mmds.is_none()
+                && devices.entropy_device.is_none()
+                && devices.pmem_devices.is_empty()
+                && devices.memory_device.is_none()
+        }
+        VirtioDevicesState::Pci(_) => false,
+    }
+}
+
+// These bits/lengths are rewritten by this kernel's __kvm_update_cpuid_runtime.
+// Comparing the remaining fields rejects CPU model changes before SET ioctls.
+fn cpuid_contract(mut cpuid: CpuId) -> CpuId {
+    cpuid.retain(|leaf| {
+        !(leaf.function == 0 && leaf.index == 0 && leaf.flags == 0 && leaf.eax == 0)
+    });
+    for leaf in cpuid.as_mut_slice() {
+        match (leaf.function, leaf.index) {
+            (1, _) => {
+                leaf.ecx &= !((1 << 27) | (1 << 3));
+                leaf.edx &= !(1 << 9);
+            }
+            (7, 0) => leaf.ecx &= !(1 << 4),
+            (0xd, 0 | 1) => leaf.ebx = 0,
+            _ => (),
+        }
+    }
+    cpuid
+}
+
+fn controlled_cpu(state: &crate::vstate::vcpu::VcpuState) -> bool {
+    state.sregs.cr4 & (1 << 13) == 0
+        && state.sregs.efer & (1 << 12) == 0
+        && state.sregs.efer & (1 << 10) != 0
+        && controlled_cpuid(&state.cpuid)
+}
+
+fn controlled_cpuid(cpuid: &CpuId) -> bool {
+    cpuid
+        .as_slice()
+        .iter()
+        .any(|leaf| leaf.function == 0x80000001 && leaf.edx & (1 << 20) != 0)
+        && cpuid.as_slice().iter().all(|leaf| match leaf.function {
+            1 => leaf.ecx & ((1 << 5) | (1 << 24)) == 0,
+            0x80000001 => leaf.ecx & (1 << 2) == 0,
+            0xa => leaf.eax == 0 && leaf.ebx == 0 && leaf.ecx == 0 && leaf.edx == 0,
+            0x40000001 => leaf.eax & !((1 << 0) | (1 << 1) | (1 << 3) | (1 << 24)) == 0,
+            _ => true,
+        })
+}
+
+impl Vmm {
+    fn reuse_irqfds(&self) -> Result<[(EventFdTrigger, u32); 4], String> {
+        let legacy = self
+            .device_manager
+            .legacy_devices
+            .as_ref()
+            .ok_or("reuse needs legacy UART")?;
+        Ok([
+            (
+                legacy
+                    .stdio_serial
+                    .lock()
+                    .unwrap()
+                    .serial
+                    .interrupt_evt()
+                    .try_clone()
+                    .map_err(|e| e.to_string())?,
+                4,
+            ),
+            (
+                EventFdTrigger::new(
+                    legacy
+                        .i8042
+                        .lock()
+                        .unwrap()
+                        .kbd_interrupt_evt
+                        .try_clone()
+                        .map_err(|e| e.to_string())?,
+                ),
+                1,
+            ),
+            (
+                self.device_manager
+                    .acpi_devices
+                    .vmgenid()
+                    .interrupt_evt
+                    .try_clone()
+                    .map_err(|e| e.to_string())?,
+                self.device_manager.acpi_devices.vmgenid().gsi,
+            ),
+            (
+                self.device_manager
+                    .acpi_devices
+                    .vmclock()
+                    .interrupt_evt
+                    .try_clone()
+                    .map_err(|e| e.to_string())?,
+                self.device_manager.acpi_devices.vmclock().gsi,
+            ),
+        ])
+    }
+
+    /// Coarse preparation can overlap source execution/save. It only retires local worker state:
+    /// no KVM_RUN, snapshot decode, guest-memory writes, or incoming CPU state are involved.
+    pub(crate) fn prepare_reused_worker(&mut self) -> Result<(), String> {
+        ensure(
+            std::env::var("FC_DAX_REUSE").as_deref() == Ok("1"),
+            "reuse not enabled",
+        )?;
+        ensure(
+            self.instance_info.state == VmState::Paused && !self.reuse_restore_failed,
+            "reuse preparation requires a healthy paused worker",
+        )?;
+        // A duplicate never toggles EFER back or queues another vCPU event.
+        if let Some(prepared) = &self.reuse_prepared {
+            crate::logger::info_unrestricted!(
+                "DAX_REUSE_PREPARED generation={} duplicate=true",
+                prepared.generation
+            );
+            return Ok(());
+        }
+        let mut timing = RestoreTiming::new("reuse_prepare");
+        ensure(
+            std::env::var("FC_DAX_NO_NESTED_GUEST").as_deref() == Ok("1")
+                && self.machine_config.vcpu_count == 1
+                && !self.machine_config.track_dirty_pages
+                && self.machine_config.huge_pages == HugePageConfig::None,
+            "reuse preparation requires the one-vCPU, no-nested, non-dirty DAX pool",
+        )?;
+        let vm = self.vm.as_kvm().ok_or("reuse requires KVM")?;
+        // Check the current PIT before clearing it; otherwise preparation could hide an
+        // unsupported active timer from the later snapshot compatibility check.
+        ensure(
+            crate::vstate::vm::KvmVm::reuse_pit_disabled(
+                &vm.save_state().map_err(|e| e.to_string())?,
+            ),
+            "reuse receiver previously used an active PIT",
+        )?;
+        let devices = self.device_manager.save();
+        ensure(
+            diskless(&devices),
+            "reuse supports diskless MMIO workers only",
+        )?;
+        let serial = self
+            .device_manager
+            .legacy_devices
+            .as_ref()
+            .ok_or("reuse needs legacy UART")?
+            .stdio_serial
+            .lock()
+            .expect("Poisoned lock");
+        ensure(serial.input.is_none(), "reuse requires output-only UART")?;
+        drop(serial);
+        let path =
+            std::env::var_os("FC_DAX_RAM").ok_or("reuse preparation needs configured DAX")?;
+        let path = Path::new(&path);
+        let offset = dax_snapshot_offset(path)
+            .map_err(|e| e.to_string())?
+            .ok_or("reuse preparation needs configured DAX")?;
+        ensure(
+            vm.guest_memory()
+                .describe()
+                .regions
+                .iter()
+                .all(|r| r.region_type == GuestRegionType::Dram),
+            "reuse preparation requires DRAM memslots",
+        )?;
+        validate_dax_backing(vm.guest_memory(), path, offset)?;
+        {
+            let handles = vm.vcpus_handles();
+            ensure(
+                handles.len() == 1
+                    && handles[0]
+                        .reuse_cpu_contract
+                        .as_ref()
+                        .is_some_and(|contract| controlled_cpuid(&contract.cpuid)),
+                "reuse preparation requires clock-only PV/no-PMU/no-nested CPU profile",
+            )?;
+        }
+        let irqfds = self.reuse_irqfds()?;
+        let strict_irqfd = std::env::var("FC_DAX_REUSE_QUIET_IRQFD").as_deref() != Ok("1");
+        timing.mark("validation");
+        self.reuse_restore_failed = true;
+        vm.quiesce_reused_pit().map_err(|e| e.to_string())?;
+        timing.mark("quiesce_old_timers");
+        if strict_irqfd {
+            for (event, gsi) in &irqfds {
+                vm.fd()
+                    .unregister_irqfd(event, *gsi)
+                    .map_err(|e| e.to_string())?;
+            }
+        }
+        timing.mark("irqfd_deassign");
+        for (event, _) in &irqfds {
+            while event.read().is_ok() {}
+        }
+        timing.mark("drain_old_events");
+        {
+            let mut handles = vm.vcpus_handles();
+            handles[0].prepare_reuse_without_kick();
+            match handles[0]
+                .response_receiver()
+                .recv_timeout(crate::RECV_TIMEOUT_SEC)
+            {
+                Ok(VcpuResponse::PreparedReuse) => (),
+                response => return Err(format!("reuse vCPU preparation failed: {response:?}")),
+            }
+        }
+        timing.mark("vcpu_prepare");
+        let generation = REUSE_SEQUENCE.fetch_add(1, Ordering::Relaxed);
+        self.reuse_prepared = Some(ReusePrepared {
+            irqfds,
+            strict_irqfd,
+            generation,
+        });
+        self.reuse_restore_failed = false;
+        crate::logger::info_unrestricted!(
+            "DAX_REUSE_PREPARED generation={} duplicate=false",
+            generation
+        );
+        timing.finish();
+        Ok(())
+    }
+
+    fn validate_reuse(
+        &self,
+        params: &LoadSnapshotParams,
+        state: &MicrovmState,
+    ) -> Result<(), String> {
+        ensure(
+            state.vcpu_states.len() == 1 && self.machine_config.vcpu_count == 1,
+            "reuse currently requires one vCPU",
+        )?;
+        crate::persist::snapshot_state_sanity_check(state).map_err(|e| e.to_string())?;
+        ensure(
+            std::env::var("FC_DAX_REUSE").as_deref() == Ok("1"),
+            "reuse not enabled",
+        )?;
+        ensure(
+            std::env::var("FC_DAX_NO_NESTED_GUEST").as_deref() == Ok("1"),
+            "reuse requires a pool booted without nested VMX/SVM",
+        )?;
+        ensure(
+            self.instance_info.state == VmState::Paused && !self.reuse_restore_failed,
+            "reuse requires a healthy paused worker",
+        )?;
+        let actual = VmInfo::from(self);
+        ensure(
+            actual.mem_size_mib == state.vm_info.mem_size_mib
+                && actual.smt == state.vm_info.smt
+                && actual.cpu_template == state.vm_info.cpu_template
+                && actual.huge_pages == state.vm_info.huge_pages
+                && actual.huge_pages == HugePageConfig::None
+                && params.huge_pages.resolve(state.vm_info.huge_pages) == HugePageConfig::None,
+            "reuse VM hardware configuration mismatch",
+        )?;
+        ensure(
+            !params.track_dirty_pages
+                && !self.machine_config.track_dirty_pages
+                && params.network_overrides.is_empty()
+                && params.vsock_override.is_none()
+                && params.mem_backend.backend_type == MemBackendType::File,
+            "reuse requires state-only DAX without dirty tracking or backend overrides",
+        )?;
+        let vm = self.vm.as_kvm().ok_or("reuse requires KVM")?;
+        ensure(
+            vm.guest_memory().describe() == state.vm_state.memory
+                && state
+                    .vm_state
+                    .memory
+                    .regions
+                    .iter()
+                    .all(|r| r.region_type == GuestRegionType::Dram),
+            "reuse memory layout mismatch",
+        )?;
+        ensure(
+            vm.kvm().save_state().kvm_cap_modifiers == state.kvm_state.kvm_cap_modifiers,
+            "reuse KVM capability mismatch",
+        )?;
+        ensure(
+            crate::vstate::vm::KvmVm::reuse_pit_disabled(&state.vm_state),
+            "reuse currently requires a disabled PIT",
+        )?;
+        ensure(
+            controlled_cpu(&state.vcpu_states[0]),
+            "reuse requires clock-only PV/no-PMU/no-nested CPU profile",
+        )?;
+        let offset = dax_snapshot_offset(&params.mem_backend.backend_path)
+            .map_err(|e| e.to_string())?
+            .ok_or("reuse requires the configured DAX backend")?;
+        validate_dax_backing(vm.guest_memory(), &params.mem_backend.backend_path, offset)?;
+        let devices = self.device_manager.save();
+        ensure(
+            diskless(&devices) && diskless(&state.device_states),
+            "reuse supports diskless MMIO workers only",
+        )?;
+        let old_acpi = &devices.acpi_state;
+        let new_acpi = &state.device_states.acpi_state;
+        ensure(
+            old_acpi.vmgenid.addr == new_acpi.vmgenid.addr
+                && old_acpi.vmgenid.gsi == new_acpi.vmgenid.gsi
+                && old_acpi.vmclock.guest_address == new_acpi.vmclock.guest_address
+                && old_acpi.vmclock.gsi == new_acpi.vmclock.gsi,
+            "reuse ACPI layout mismatch",
+        )?;
+        let serial = self
+            .device_manager
+            .legacy_devices
+            .as_ref()
+            .ok_or("reuse needs legacy UART")?
+            .stdio_serial
+            .lock()
+            .expect("Poisoned lock");
+        ensure(
+            serial.input.is_none()
+                && state
+                    .device_states
+                    .serial_state
+                    .as_ref()
+                    .is_some_and(|s| s.in_buffer.len() <= 64),
+            "reuse requires output-only UART with valid FIFO",
+        )?;
+        ensure(
+            bitcode::serialize(&vm.resource_allocator().save()).map_err(|e| e.to_string())?
+                == bitcode::serialize(&state.vm_state.resource_allocator)
+                    .map_err(|e| e.to_string())?,
+            "reuse resource allocation mismatch",
+        )?;
+        let handles = vm.vcpus_handles();
+        ensure(handles.len() == 1, "reuse worker vCPU handle mismatch")?;
+        let mut incoming_indices: Vec<_> = state.vcpu_states[0]
+            .saved_msrs
+            .iter()
+            .flat_map(|chunk| chunk.as_slice().iter().map(|msr| msr.index))
+            .collect();
+        incoming_indices.sort_unstable();
+        ensure(
+            incoming_indices == handles[0].reuse_msr_indices,
+            "reuse snapshot MSR index schema mismatch",
+        )?;
+        handles[0]
+            .reuse_cpu_contract
+            .as_ref()
+            .ok_or("reuse worker has no immutable CPU contract")?
+            .validate(&state.vcpu_states[0])?;
+        ensure(
+            crate::vstate::vm::KvmVm::reuse_pit_disabled(
+                &vm.save_state().map_err(|e| e.to_string())?,
+            ),
+            "reuse receiver previously used an active PIT",
+        )?;
+        Ok(())
+    }
+
+    pub(crate) fn restore_reused_snapshot(
+        &mut self,
+        params: &LoadSnapshotParams,
+    ) -> Result<(), String> {
+        let mut timing = RestoreTiming::new("reuse");
+        let mut state =
+            snapshot_state_from_file(&params.snapshot_path).map_err(|e| e.to_string())?;
+        timing.mark("state_file_deserialize");
+        self.validate_reuse(params, &state)?;
+        let was_prepared = self.reuse_prepared.is_some();
+        let (irqfds, strict_irqfd, sequence) = if let Some(prepared) = self.reuse_prepared.take() {
+            (prepared.irqfds, prepared.strict_irqfd, prepared.generation)
+        } else {
+            (
+                self.reuse_irqfds()?,
+                std::env::var("FC_DAX_REUSE_QUIET_IRQFD").as_deref() != Ok("1"),
+                REUSE_SEQUENCE.fetch_add(1, Ordering::Relaxed),
+            )
+        };
+        let legacy = self.device_manager.legacy_devices.as_ref().unwrap();
+        timing.mark("validation");
+        // Any subsequent failure leaves the worker paused and permanently blocks Resume.
+        self.reuse_restore_failed = true;
+        let vm = self.vm.as_kvm().unwrap();
+        let before_fd = vm.fd().as_raw_fd();
+        if !was_prepared {
+            vm.quiesce_reused_pit().map_err(|e| e.to_string())?;
+        }
+        timing.mark("quiesce_old_timers");
+        // KVM_IRQFD deassignment synchronizes its waitqueue and flushes injection work.
+        // Reading the eventfd counter alone cannot drain already-queued kernel work.
+        if strict_irqfd && !was_prepared {
+            for (event, gsi) in &irqfds {
+                vm.fd()
+                    .unregister_irqfd(event, *gsi)
+                    .map_err(|e| e.to_string())?;
+            }
+        }
+        timing.mark("irqfd_deassign");
+        // Drain stale notifications before overwriting the saved IRQ controller state.
+        if !was_prepared {
+            for (evt, _) in &irqfds {
+                while evt.read().is_ok() {}
+            }
+        }
+        timing.mark("drain_old_events");
+        {
+            let mut handles = vm.vcpus_handles();
+            handles[0].restore_without_kick(state.vcpu_states.pop().unwrap(), was_prepared);
+            match handles[0]
+                .response_receiver()
+                .recv_timeout(crate::RECV_TIMEOUT_SEC)
+            {
+                Ok(VcpuResponse::RestoredState) => (),
+                response => return Err(format!("reuse vCPU restore failed: {response:?}")),
+            }
+        }
+        timing.mark("vcpu_state_restore");
+        vm.restore_state(&state.vm_state, params.clock_realtime)
+            .map_err(|e| e.to_string())?;
+        self.device_manager
+            .acpi_devices
+            .replay_gsi_allocations(vm)
+            .map_err(|e| e.to_string())?;
+        timing.mark("vm_irq_clock_restore");
+        if strict_irqfd {
+            for (event, gsi) in &irqfds {
+                vm.fd()
+                    .register_irqfd(event, *gsi)
+                    .map_err(|e| e.to_string())?;
+            }
+        }
+        timing.mark("irqfd_register");
+        legacy
+            .stdio_serial
+            .lock()
+            .unwrap()
+            .restore_reused(&state.device_states.serial_state.as_ref().unwrap().into())
+            .map_err(|e| e.to_string())?;
+        legacy.i8042.lock().unwrap().reset_reused();
+        self.device_manager
+            .acpi_devices
+            .restore_reused(&state.device_states.acpi_state, vm.guest_memory())
+            .map_err(|e| e.to_string())?;
+        self.boot_source_config = state.vm_info.boot_source;
+        timing.mark("devices_restore");
+        let handles = vm.vcpus_handles();
+        crate::logger::info_unrestricted!(
+            "DAX_REUSE_IDENTITY {}",
+            serde_json::json!({
+                "sequence":sequence,"vm_fd":before_fd,"vm_ptr":format!("{:p}",vm.as_ref()),
+                "vcpu_fd":handles[0].vcpu_fd.as_raw_fd(),"ram_mapping_reused":true,
+                "strict_irqfd":strict_irqfd,
+                "receiver_prepared":was_prepared,
+                "prepare_generation":was_prepared.then_some(sequence),
+                "tlb_invalidation":"efer_nx_toggle",
+                "vm_creates":0,"vcpu_creates":0,"thread_creates":0,
+            })
+        );
+        drop(handles);
+        self.reuse_restore_failed = false;
+        timing.finish();
+        Ok(())
+    }
+}
