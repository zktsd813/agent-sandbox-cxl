+            meta.vm_offset,
+            meta.vcpu_offset,
+            meta.vmcs_offset,
+            meta.vm_creates,
+            meta.vcpu_creates,
+            meta.kernel_ns as f64 / 1000.0
+        );
+        Ok([start.elapsed().as_nanos() as u64 - irq_ns, irq_ns])
+    }
