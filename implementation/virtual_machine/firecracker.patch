+//! Experimental direct KVM ownership transfer with host-local virtio bindings.
+//! This record contains device bookkeeping, never CPU registers or guest RAM.
+
+use std::fs::{File, OpenOptions};
+use std::io::{self, Read, Write};
+use std::os::fd::AsRawFd;
+use std::path::Path;
