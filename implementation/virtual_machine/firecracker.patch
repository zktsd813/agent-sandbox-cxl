+#[cfg(test)]
+mod tests {
+    use super::*;
+    use kvm_bindings::kvm_cpuid_entry2;
+
+    #[test]
+    fn cpuid_contract_ignores_only_kernel_runtime_fields() {
+        let entries = [
+            kvm_cpuid_entry2 {
+                function: 1,
+                ecx: 1 << 26,
+                ..Default::default()
+            },
+            kvm_cpuid_entry2 {
+                function: 0xd,
+                index: 0,
+                eax: 7,
+                ebx: 512,
+                ..Default::default()
+            },
+        ];
+        let original = CpuId::from_entries(&entries).unwrap();
+        let mut runtime = original.clone();
+        runtime.as_mut_slice()[0].ecx |= 1 << 27;
+        runtime.as_mut_slice()[0].edx |= 1 << 9;
+        runtime.as_mut_slice()[1].ebx = 832;
+        assert_eq!(
+            cpuid_contract(original.clone()),
+            cpuid_contract(runtime.clone())
+        );
+        runtime.as_mut_slice()[0].ecx ^= 1 << 26;
+        assert_ne!(cpuid_contract(original), cpuid_contract(runtime));
+    }
+
+    #[test]
+    fn worker_rejects_nested_and_host_bound_features() {
+        let mut state = crate::vstate::vcpu::VcpuState::default();
+        state.sregs.efer = 1 << 10;
+        state.cpuid = CpuId::from_entries(&[
+            kvm_cpuid_entry2 {
+                function: 1,
+                ..Default::default()
+            },
+            kvm_cpuid_entry2 {
+                function: 0x40000001,
+                eax: 1 << 3,
+                ..Default::default()
+            },
+            kvm_cpuid_entry2 {
+                function: 0x80000001,
+                edx: 1 << 20,
+                ..Default::default()
+            },
+        ])
+        .unwrap();
+        assert!(controlled_cpu(&state));
+        state.cpuid.as_mut_slice()[0].ecx |= 1 << 5;
+        assert!(!controlled_cpu(&state));
+        state.cpuid.as_mut_slice()[0].ecx = 0;
+        state.cpuid.as_mut_slice()[1].eax |= 1 << 5; // APF
+        assert!(!controlled_cpu(&state));
+        state.cpuid.as_mut_slice()[1].eax = 1 << 3;
+        state.sregs.cr4 |= 1 << 13;
+        assert!(!controlled_cpu(&state));
+        state.sregs.cr4 = 0;
+        state.cpuid.as_mut_slice()[2].edx = 0;
+        assert!(!controlled_cpu(&state));
+    }
+
+    #[test]
+    fn diskless_contract_rejects_pci_and_devices() {
+        let mut state = DevicesState::default();
+        assert!(diskless(&state));
+        if let VirtioDevicesState::Mmio(devices) = &mut state.virtio_state {
+            devices.mmds = Some(crate::device_manager::persist::MmdsState {
+                version: crate::mmds::data_store::MmdsVersion::V2,
+                imds_compat: false,
+            });
+        }
+        assert!(!diskless(&state));
+        state.virtio_state = VirtioDevicesState::Pci(Default::default());
+        assert!(!diskless(&state));
+    }
+
+    #[test]
+    fn cached_contract_rejects_immutable_values_and_frequency_changes() {
+        let mut state = crate::vstate::vcpu::VcpuState::default();
+        state.saved_msrs = vec![
+            kvm_bindings::Msrs::from_entries(&[kvm_bindings::kvm_msr_entry {
+                index: 0x10a,
+                data: 7,
+                ..Default::default()
+            }])
+            .unwrap(),
+        ];
+        state.tsc_khz = Some(3_000_000);
+        let contract = ReuseCpuContract {
+            cpuid: cpuid_contract(state.cpuid.clone()),
+            immutable_msrs: vec![(0x10a, 7)],
+            tsc_khz: state.tsc_khz,
+        };
+        assert!(contract.validate(&state).is_ok());
+        state.saved_msrs[0].as_mut_slice()[0].data = 8;
+        assert!(contract.validate(&state).is_err());
+        state.saved_msrs[0].as_mut_slice()[0].data = 7;
+        state.tsc_khz = Some(2_000_000);
+        assert!(contract.validate(&state).is_err());
+    }
+}
