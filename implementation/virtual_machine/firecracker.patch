+/// Opt-in laboratory control: one persistent local connection, no HTTP/API thread.
+/// The pause loop also freezes device event dispatch, like the normal API adapter.
+struct DaxControl {
+    listener: UnixListener,
+    stream: Option<UnixStream>,
+    vmm: Arc<Mutex<Vmm>>,
+}
+
+impl DaxControl {
+    fn new(vmm: Arc<Mutex<Vmm>>) -> Option<Self> {
+        let path = std::env::var("FC_DAX_CONTROL").ok()?;
+        assert_eq!(std::env::var("FC_DAX_DIRECT").as_deref(), Ok("1"));
+        let listener = UnixListener::bind(path).expect("DAX control bind");
+        listener.set_nonblocking(true).expect("DAX control nonblocking");
+        Some(Self { listener, stream: None, vmm })
+    }
+}
+
+impl MutEventSubscriber for DaxControl {
+    fn init(&mut self, ops: &mut EventOps) {
+        ops.add(Events::new(&self.listener, EventSet::IN)).expect("DAX control epoll");
+    }
+
+    fn process(&mut self, event: Events, ops: &mut EventOps) {
+        if event.fd() == self.listener.as_raw_fd() {
+            let (stream, _) = self.listener.accept().expect("DAX control accept");
+            assert!(self.stream.is_none(), "Only one DAX controller is supported");
+            stream.set_write_timeout(Some(Duration::from_secs(60))).unwrap();
+            ops.add(Events::new(&stream, EventSet::IN)).expect("DAX stream epoll");
+            self.stream = Some(stream);
+            return;
+        }
+        let stream = self.stream.as_mut().expect("DAX control stream");
+        let mut paused = false;
+        // A stopped microVM must not dispatch its device callbacks while B owns it.
+        loop {
+            let mut command = [0u8; 1];
+            if let Err(error) = stream.read_exact(&mut command) {
+                if error.kind() == std::io::ErrorKind::UnexpectedEof {
+                    assert!(!paused, "DAX controller disconnected while detached");
+                    ops.remove(Events::new(stream, EventSet::IN)).unwrap();
+                    self.stream = None;
+                    return;
+                }
+                panic!("DAX control read: {error}");
+            }
+            let start = Instant::now();
+            let result = match command[0] {
+                1 => self.vmm.lock().unwrap().pause_vm(),
+                2 => self.vmm.lock().unwrap().resume_vm(),
+                _ => panic!("Invalid DAX control command"),
+            };
+            // Fixed native-endian record, local same-host socket only.
+            let status = if result.is_ok() { 0u64 } else { libc::EIO as u64 };
+            paused = command[0] == 1;
+            let mut response = [0u8; 40];
+            response[..8].copy_from_slice(&status.to_ne_bytes());
+            response[8..16].copy_from_slice(&(start.elapsed().as_nanos() as u64).to_ne_bytes());
+            for (i, value) in vmm::DAX_CONTROL_TIMINGS.iter().enumerate() {
+                response[16+i*8..24+i*8].copy_from_slice(&value.load(std::sync::atomic::Ordering::Relaxed).to_ne_bytes());
+            }
+            stream.write_all(&response).expect("DAX control response");
+            result.expect("DAX handoff failed");
+            if command[0] == 2 {
+                return;
+            }
+        }
+    }
+}
