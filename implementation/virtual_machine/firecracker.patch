+pub(crate) fn checkpoint_ready(mem: &GuestMemoryMmap) -> io::Result<()> {
+    let mut guard = state().lock().unwrap();
+    let a = guard
+        .as_mut()
+        .ok_or_else(|| invalid("no persistent CXL pool mapping"))?;
+    query(a)?;
+    validate_geometry(&a.manifest, &geometry(mem))?;
+    a.manifest.state_sha256 = None;
+    write_json(&env("FC_POOL_MEMORY_MANIFEST")?, &a.manifest)
+}
+
+pub(crate) fn bind_state(path: &Path) -> io::Result<()> {
+    let bytes = std::fs::read(path)?;
+    let hash: String = digest(&bytes).iter().map(|b| format!("{b:02x}")).collect();
+    let mut guard = state().lock().unwrap();
+    let a = guard
+        .as_mut()
+        .ok_or_else(|| invalid("state binding without active pool"))?;
+    a.manifest.state_sha256 = Some(hash);
+    write_json(&env("FC_POOL_MEMORY_MANIFEST")?, &a.manifest)
+}
+pub(crate) fn verify_state(path: &Path) -> io::Result<()> {
+    if let Ok(manifest) = std::env::var("FC_POOL_MEMORY_RESTORE") {
+        let m: Manifest = read_json(&manifest)?;
+        let hash: String = digest(&std::fs::read(path)?)
+            .iter()
+            .map(|b| format!("{b:02x}"))
+            .collect();
+        if m.state_sha256.as_deref() != Some(hash.as_str()) {
+            return Err(invalid("state/placement manifest mismatch"));
+        }
+    }
+    Ok(())
+}
+
+pub(crate) fn restore(
+    regions: &[(GuestAddress, usize)],
+    dirty: bool,
+) -> Result<Option<Vec<GuestRegionMmap>>, MemoryError> {
+    let Ok(path) = std::env::var("FC_POOL_MEMORY_RESTORE") else {
+        return Ok(None);
+    };
+    let load = || -> io::Result<(Arc<File>, Manifest)> {
+        if !enabled() || active() {
+            return Err(invalid("pool restore configuration"));
+        }
+        let m: Manifest = read_json(&path)?;
+        if m.vm_id != env("FC_POOL_VM_ID")? {
+            return Err(invalid("pool restore VM identity"));
+        }
+        let old: u64 = m.run_epoch.parse().map_err(io::Error::other)?;
+        let new: u64 = env("FC_POOL_RUN_EPOCH")?
+            .parse()
+            .map_err(io::Error::other)?;
+        let lease: u64 = env("FC_POOL_MEMORY_LEASE")?
+            .parse()
+            .map_err(io::Error::other)?;
+        if old.checked_add(1) != Some(new)
+            || m.allocation_generation == 0
+            || lease != m.allocation_generation
+        {
+            return Err(invalid("stale placement epoch or allocation lease"));
+        }
+        validate_geometry(&m, regions)?;
+        let file = configure(&m)?;
+        Ok((file, m))
+    };
+    let (file, mut m) = load().map_err(|e| MemoryError::Dax(e.to_string()))?;
+    let mut offset = 0;
+    let mut fixed = std::env::var("FC_DAX_FIXED_HVA")
+        .ok()
+        .map(|s| {
+            if let Some(h) = s.strip_prefix("0x") {
+                usize::from_str_radix(h, 16)
+            } else {
+                s.parse()
+            }
+        })
+        .transpose()
+        .map_err(|e| MemoryError::Dax(e.to_string()))?;
+    let mut out = Vec::new();
+    for &(gpa, size) in regions {
+        out.push(GuestRegionMmap::allocate_at(
+            gpa,
+            size,
+            libc::PROT_READ | libc::PROT_WRITE,
+            libc::MAP_SHARED,
+            Some(FileOffset::from_arc(file.clone(), offset)),
+            dirty,
+            fixed,
+        )?);
+        offset += size as u64;
+        fixed = fixed.map(|p| p + size);
+    }
+    m.run_epoch = env("FC_POOL_RUN_EPOCH").map_err(|e| MemoryError::Dax(e.to_string()))?;
+    crate::pool_cache::set_pool_lineage(m.mappings.iter().filter(|p| p.shared).map(|p| p.gpa));
+    *state().lock().unwrap() = Some(Active { file, manifest: m });
+    Ok(Some(out))
+}
+
+struct View {
+    ptr: *mut libc::c_void,
+    bytes: usize,
+}
+impl Drop for View {
+    fn drop(&mut self) {
+        if self.bytes != 0 {
+            unsafe {
+                libc::munmap(self.ptr, self.bytes);
+            }
+        }
+    }
+}
+fn view(file: &File, bytes: usize) -> io::Result<View> {
+    // SAFETY: a new VMA over the validated DAX capacity; lifetime tied to View.
+    let ptr = unsafe {
+        libc::mmap(
+            std::ptr::null_mut(),
+            bytes,
+            libc::PROT_READ | libc::PROT_WRITE,
+            libc::MAP_SHARED,
+            file.as_raw_fd(),
+            0,
+        )
+    };
+    if ptr == libc::MAP_FAILED {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(View { ptr, bytes })
+}
+
+fn dram_evidence(mem: &GuestMemoryMmap) -> io::Result<Vec<serde_json::Value>> {
+    let text = std::fs::read_to_string("/proc/self/maps")?;
+    let mut result = Vec::new();
+    for region in mem.iter() {
+        let start = region.as_ptr() as u64;
+        let end = start
+            .checked_add(region.len())
+            .ok_or_else(|| invalid("RAM HVA overflow"))?;
+        let mut covered = start;
+        let mut maps = Vec::new();
+        for line in text.lines() {
+            let fields: Vec<_> = line.split_whitespace().collect();
+            if fields.len() < 5 {
+                return Err(invalid("invalid proc maps"));
+            }
+            let (a, b) = fields[0]
+                .split_once('-')
+                .ok_or_else(|| invalid("invalid VMA range"))?;
+            let a = u64::from_str_radix(a, 16).map_err(io::Error::other)?;
+            let b = u64::from_str_radix(b, 16).map_err(io::Error::other)?;
+            if b <= start || a >= end {
+                continue;
+            }
+            if a > covered || fields[1] != "rw-p" || fields[4] != "0" || line.contains("/dev/") {
+                return Err(invalid(
+                    "demotion did not detach CXL into private anonymous RAM",
+                ));
+            }
+            covered = covered.max(b.min(end));
+            maps.push(line.to_owned());
+        }
+        if covered != end {
+            return Err(invalid("demotion VMA coverage incomplete"));
+        }
+        result.push(serde_json::json!({"gpa":region.start_addr().raw_value(),"hva":start,"bytes":region.len(),"maps":maps}));
+    }
+    Ok(result)
+}
+
+pub(crate) fn apply(mem: &GuestMemoryMmap) -> io::Result<()> {
+    let p: Plan = read_json(&env("FC_POOL_MEMORY_PLAN")?)?;
+    if p.vm_id != env("FC_POOL_VM_ID")? || p.run_epoch != env("FC_POOL_RUN_EPOCH")? {
+        return Err(invalid("pool plan VM/epoch mismatch"));
+    }
+    let mut copied = 0u64;
+    let mut shared = 0u64;
+    let mut registration_status_hex = None::<String>;
+    let mut dram_vmas = Vec::new();
+    match p.operation.as_str() {
+        "promote" => {
+            if active() {
+                return Err(invalid("promote requires private DRAM backing"));
+            }
+            if p.allocation_generation == 0 {
+                return Err(invalid(
+                    "promotion requires controller allocation generation",
+                ));
+            }
+            let status = validate_registration(mem, &p)?;
+            registration_status_hex = Some(status.iter().map(|b| format!("{b:02x}")).collect());
+            let (phys_base, device_bytes) = dax_geometry(&p.pool_path)?;
+            let m = Manifest {
+                version: 1,
+                vm_id: p.vm_id.clone(),
+                run_epoch: p.run_epoch.clone(),
+                pool_path: p.pool_path.clone(),
+                phys_base,
+                device_bytes,
+                canonical_start: p.canonical_start,
+                canonical_bytes: p.canonical_bytes,
+                mappings: p.mappings.clone(),
+                credits: p.credits.clone(),
+                generation: 1,
+                cow_pages: 0,
+                discard_pages: 0,
+                faults: 0,
+                exhausted: 0,
+                state_sha256: None,
+                allocation_generation: p.allocation_generation,
+            };
+            validate_geometry(&m, &geometry(mem))?;
+            let file = configure(&m)?; // structural/duplicate allocation preflight before copying
+            let dax = OpenOptions::new()
+                .read(true)
+                .write(true)
+                .open(&m.pool_path)?;
+            let target = view(&dax, device_bytes as usize)?;
+            for page in &m.mappings {
+                if page.shared {
+                    shared += PAGE;
+                    continue;
+                }
+                let source = mem
+                    .get_host_address(GuestAddress(page.gpa))
+                    .map_err(io::Error::other)?;
+                // SAFETY: source is paused logical RAM; destination is a validated
+                // exclusive private CXL allocation and cannot overlap source DRAM.
+                unsafe {
+                    std::ptr::copy_nonoverlapping(
+                        source,
+                        target.ptr.cast::<u8>().add(page.offset as usize),
+                        PAGE as usize,
+                    );
+                }
+                copied += PAGE;
+            }
+            let mut offset = 0;
+            for region in mem.iter() {
+                crate::pool_cache::set_mapping_failed(true);
+                // SAFETY: paused VM, drained devices, same HVA/geometry, complete
+                // private copies and canonical registration validated above.
+                let mapped = unsafe {
+                    libc::mmap(
+                        region.as_ptr().cast(),
+                        region.len() as usize,
+                        libc::PROT_READ | libc::PROT_WRITE,
+                        libc::MAP_SHARED | libc::MAP_FIXED,
+                        file.as_raw_fd(),
+                        offset,
+                    )
+                };
+                if mapped == libc::MAP_FAILED {
+                    return Err(io::Error::last_os_error());
+                }
+                offset += region.len() as i64;
+            }
+            crate::pool_cache::set_mapping_failed(false);
+            crate::pool_cache::set_pool_lineage(
+                m.mappings.iter().filter(|p| p.shared).map(|p| p.gpa),
+            );
+            *state().lock().unwrap() = Some(Active { file, manifest: m });
+            checkpoint_ready(mem)?;
+        }
+        "export" => {
+            checkpoint_ready(mem)?;
+        }
+        "audit" => {
+            if p.registration.is_some() {
+                let status = validate_registration(mem, &p)?;
+                registration_status_hex = Some(status.iter().map(|b| format!("{b:02x}")).collect());
+            }
+            let mut guard = state().lock().unwrap();
+            let a = guard
+                .as_mut()
+                .ok_or_else(|| invalid("audit requires CXL mapping"))?;
+            query(a)?;
+            let mut rows = Vec::new();
+            for region in mem.iter() {
+                let mut ptes = vec![Pte::default(); region.len() as usize / PAGE as usize];
+                let mut request = Audit {
+                    address: region.as_ptr() as u64,
+                    count: ptes.len() as u64,
+                    ptes: ptes.as_mut_ptr() as u64,
+                };
+                ioctl(&a.file, 0x74, true, &mut request)?;
+                rows.extend(ptes);
+            }
+            let evidence: Vec<_> = a
+                .manifest
+                .mappings
+                .iter()
+                .zip(rows)
+                .map(|(m, pte)| {
+                    serde_json::json!({
+                "gpa":m.gpa,"offset":m.offset,"shared":m.shared,"actual_pfn":pte.pfn,
+                "present":pte.flags&1!=0,"writable":pte.flags&2!=0})
+                })
+                .collect();
+            return write_json(
+                &env("FC_POOL_MEMORY_REPORT")?,
+                &serde_json::json!({"version":1,"operation":"audit",
+                "vm_id":p.vm_id,"run_epoch":p.run_epoch,"phys_base":a.manifest.phys_base,"pages":evidence,
+                "registration_status_hex":registration_status_hex,"result":"passed"}),
+            );
+        }
+        "grow" => {
+            let mut guard = state().lock().unwrap();
+            let a = guard
+                .as_mut()
+                .ok_or_else(|| invalid("grow requires CXL mapping"))?;
+            let mut c = Credits {
+                count: p.credits.len() as u64,
+                offsets: p.credits.as_ptr() as u64,
+            };
+            ioctl(&a.file, 0x73, false, &mut c)?;
+            query(a)?;
+            write_json(&env("FC_POOL_MEMORY_MANIFEST")?, &a.manifest)?;
+        }
+        "demote" => {
+            checkpoint_ready(mem)?;
+            let mut copies = Vec::new();
+            for region in mem.iter() {
+                let bytes = region.len() as usize;
+                // SAFETY: fresh private DRAM mapping; all source bytes stable.
+                let ptr = unsafe {
+                    libc::mmap(
+                        std::ptr::null_mut(),
+                        bytes,
+                        libc::PROT_READ | libc::PROT_WRITE,
+                        libc::MAP_PRIVATE | libc::MAP_ANONYMOUS,
+                        -1,
+                        0,
+                    )
+                };
+                if ptr == libc::MAP_FAILED {
+                    return Err(io::Error::last_os_error());
+                }
+                let copy = View { ptr, bytes };
+                unsafe {
+                    std::ptr::copy_nonoverlapping(region.as_ptr(), ptr.cast::<u8>(), bytes);
+                }
+                copies.push((copy, region.as_ptr()));
+                copied += bytes as u64;
+            }
+            for (mut copy, target) in copies {
+                crate::pool_cache::set_mapping_failed(true);
+                // SAFETY: prepared private bytes replace precisely the paused
+                // logical region; mremap performs MMU notifier invalidation.
+                let result = unsafe {
+                    libc::mremap(
+                        copy.ptr,
+                        copy.bytes,
+                        copy.bytes,
+                        libc::MREMAP_MAYMOVE | libc::MREMAP_FIXED,
+                        target,
+                    )
+                };
+                if result == libc::MAP_FAILED {
+                    return Err(io::Error::last_os_error());
+                }
+                copy.bytes = 0; // ownership moved into the existing GuestMemory VMA
+            }
+            *state().lock().unwrap() = None;
+            crate::pool_cache::set_pool_lineage(std::iter::empty());
+            crate::pool_cache::set_mapping_failed(false);
+            dram_vmas = dram_evidence(mem)?;
+        }
+        _ => return Err(invalid("unknown pool memory operation")),
+    }
+    let summary=state().lock().unwrap().as_ref().map(|a|serde_json::json!({
+        "generation":a.manifest.generation,"cow_pages":a.manifest.cow_pages,
+        "discard_pages":a.manifest.discard_pages,"credit_pages":a.manifest.credits.len(),
+        "shared_pages":a.manifest.mappings.iter().filter(|p|p.shared).count(),"exhausted":a.manifest.exhausted}));
+    write_json(
+        &env("FC_POOL_MEMORY_REPORT")?,
+        &serde_json::json!({"version":1,"operation":p.operation,
+        "vm_id":p.vm_id,"run_epoch":p.run_epoch,"copied_private_bytes":copied,"shared_bytes":shared,
+        "file_page_compare_bytes":0,"ram_snapshot_bytes":0,"module":summary,
+        "registration_status_hex":registration_status_hex,"dram_vmas":dram_vmas,"result":"passed"}),
+    )
+}
+
+pub(crate) fn discard(gpa: u64, address: usize, bytes: u64) -> io::Result<bool> {
+    let guard = state().lock().unwrap();
+    let Some(a) = guard.as_ref() else {
+        return Ok(false);
+    };
+    let first = a
+        .manifest
+        .mappings
+        .binary_search_by_key(&gpa, |p| p.gpa)
+        .map_err(|_| invalid("discard GPA"))?;
+    let mut range = Range {
+        address: address as u64,
+        first: first as u64,
+        count: bytes / PAGE,
+    };
+    ioctl(&a.file, 0x72, false, &mut range)?;
+    Ok(true)
+}
