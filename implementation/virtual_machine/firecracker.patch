+pub(crate) fn build(
+    instance_info: &InstanceInfo,
+    resources: &VmResources,
+    events: &mut EventManager,
+    filters: &BpfThreadMap,
+) -> Result<Arc<Mutex<Vmm>>, StartMicrovmError> {
+    fn error(e: impl std::fmt::Display) -> StartMicrovmError {
+        StartMicrovmError::Internal(VmmError::DaxHandoff(io::Error::other(e.to_string())))
+    }
+    let mut state: DirectState = serde_json::from_slice(
+        &bounded_read(&env_path("FC_DAX_DIRECT_IMPORT").map_err(error)?).map_err(error)?,
+    )
+    .map_err(error)?;
+    validate_state(&state).map_err(error)?;
+    let manifest =
+        bounded_read(&env_path("FC_POOL_MEMORY_RESTORE").map_err(error)?).map_err(error)?;
+    if sha256(&manifest) != state.memory_manifest_sha256 {
+        return Err(error("direct memory manifest checksum mismatch"));
+    }
+    let dax = env_path("FC_DAX_RAM").map_err(error)?;
+    let offset = std::env::var("FC_DAX_OFFSET")
+        .unwrap_or_else(|_| "2097152".into())
+        .parse()
+        .map_err(error)?;
+    let regions = memory::devdax(
+        &[(GuestAddress(0), state.token.ram_bytes as usize)],
+        &dax,
+        offset,
+        false,
+        false,
+    )
+    .map_err(error)?;
+    if regions.len() != 1 || regions[0].as_ptr() as u64 != state.token.ram_hva {
+        return Err(error("direct destination HVA differs from retained slot"));
+    }
+    let kvm = Kvm::new(Vec::new()).map_err(error)?;
+    let mut vm = KvmVm::attach_direct(kvm, &mut state.token).map_err(error)?;
+    vm.adopt_direct_memory(regions, &state.memory, &state.token)
+        .map_err(error)?;
+    let vcpus = vm.create_vcpus(1).map_err(error)?;
+    let vm = Arc::new(vm);
+    let mut local_resources = VmResources::default();
+    local_resources.machine_config = state.machine_config.clone();
+    local_resources.boot_source.config = state.boot_source.clone();
+    local_resources.serial_out_path = resources.serial_out_path.clone();
+    local_resources.serial_rate_limiter_cfg = resources.serial_rate_limiter_cfg.clone();
+    let devices = DeviceManager::restore(
+        DeviceRestoreArgs {
+            mem: vm.guest_memory(),
+            vm: &vm,
+            event_manager: events,
+            vm_resources: &mut local_resources,
+            instance_id: &instance_info.id,
+            vcpus_exit_evt: vm.vcpus_exit_evt(),
+        },
+        &state.devices,
+    )
+    .map_err(error)?;
+    let vmm = Vmm {
+        instance_info: InstanceInfo {
+            state: VmState::Paused,
+            ..instance_info.clone()
+        },
+        machine_config: state.machine_config,
+        boot_source_config: state.boot_source,
+        shutdown_exit_code: None,
+        reuse_restore_failed: false,
+        reuse_prepared: None,
+        vm: Vm::Kvm(vm.clone()),
+        device_manager: devices,
+    };
+    validate_live(&vmm).map_err(error)?;
+    vm.start_vcpus(
+        vcpus,
+        filters
+            .get("vcpu")
+            .ok_or(StartMicrovmError::MissingSeccompFilters("vcpu".into()))?
+            .clone(),
+    )
+    .map_err(error)?;
+    let vmm = Arc::new(Mutex::new(vmm));
+    events.add_subscriber(vmm.clone());
+    crate::logger::info_unrestricted!(
+        "DIRECT_HANDOFF_JSON {}",
+        serde_json::json!({
+            "event":"import", "token":state.token, "snapshot_bytes":0, "ram_transfer_bytes":0,
+            "memory_manifest_sha256":state.memory_manifest_sha256,
+        })
+    );
+    Ok(vmm)
+}
