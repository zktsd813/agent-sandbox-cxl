+pub(crate) fn apply(mem: &GuestMemoryMmap) -> io::Result<()> {
+    let p: Plan = read_json(&env("FC_POOL_MEMORY_PLAN")?)?;
+    if p.vm_id != env("FC_POOL_VM_ID")? || p.run_epoch != env("FC_POOL_RUN_EPOCH")? {
+        return Err(invalid("pool plan VM/epoch mismatch"));
+    }
+    let mut copied = 0u64;
+    match p.operation.as_str() {
+        "promote" => {
+            if active() {
+                return Err(invalid("promote requires private DRAM backing"));
+            }
+            if p.allocation_generation == 0 {
+                return Err(invalid(
+                    "promotion requires controller allocation generation",
+                ));
+            }
+            let (phys_base, device_bytes) = dax_geometry(&p.pool_path)?;
+            let mut m = Manifest {
+                version: 4,
+                handle: None,
+                vm_id: p.vm_id.clone(),
+                run_epoch: p.run_epoch.clone(),
+                pool_path: p.pool_path.clone(),
+                phys_base,
+                device_bytes,
+                reserved: [0; 2],
+                mappings: p.mappings.clone(),
+                generation: 1,
+                faults: 0,
+                exhausted: 0,
+                allocation_generation: p.allocation_generation,
+            };
+            validate_geometry(&m, &geometry(mem))?;
+            let file = configure(&mut m)?; // structural/duplicate allocation preflight before copying
+            let dax = OpenOptions::new()
+                .read(true)
+                .write(true)
+                .open(&m.pool_path)?;
+            let target = view(&dax, device_bytes as usize)?;
+            let mut index = 0;
+            while index < m.mappings.len() {
+                let page = &m.mappings[index];
+                let mut end = index + 1;
+                while end < m.mappings.len()
+                    && m.mappings[end].offset == page.offset + (end-index) as u64*PAGE {
+                    end += 1;
+                }
+                let bytes = (end-index)*PAGE as usize;
+                mem.get_slice(GuestAddress(page.gpa), bytes).map_err(io::Error::other)?;
+                let source = mem.get_host_address(GuestAddress(page.gpa)).map_err(io::Error::other)?;
+                // SAFETY: the admitted exclusive extent and paused logical region
+                // cover this run; no payload comparison or per-page syscall.
+                unsafe {
+                    let destination=target.ptr.cast::<u8>().add(page.offset as usize);
+                    if crate::noncoherent::active() { crate::noncoherent::copy_non_temporal(source,destination,bytes); }
+                    else {std::ptr::copy_nonoverlapping(source,destination,bytes);}
+                }
+                copied += bytes as u64;
+                index = end;
+            }
+            let mut offset = 0;
+            for region in mem.iter() {
+                set_mapping_failed(true);
+                // SAFETY: paused VM, drained devices, same HVA/geometry, complete
+                // private copies validated above.
+                let mapped = unsafe {
+                    libc::mmap(
+                        region.as_ptr().cast(),
+                        region.len() as usize,
+                        libc::PROT_READ | libc::PROT_WRITE,
+                        libc::MAP_SHARED | libc::MAP_FIXED,
+                        file.as_raw_fd(),
+                        offset,
+                    )
+                };
+                if mapped == libc::MAP_FAILED {
+                    return Err(io::Error::last_os_error());
+                }
+                offset += region.len() as i64;
+            }
+            set_mapping_failed(false);
+            *state().lock().unwrap() = Some(Active { file, manifest: m });
+            // Remapping preserves the bitmap object, but bypassed writes need explicit marks.
+            for region in mem.iter() { region.bitmap().mark_dirty(0, region.len() as usize); }
+            checkpoint_ready(mem)?;
+            crate::noncoherent::require(crate::noncoherent::boundary(mem, 1, 0, None));
+        }
+        "export" => {
+            checkpoint_ready(mem)?;
+        }
+
+
+        _ => return Err(invalid("unknown pool memory operation")),
+    }
+    let summary=state().lock().unwrap().as_ref().map(|a|serde_json::json!({
+        "generation":a.manifest.generation,
+        "exhausted":a.manifest.exhausted}));
+    write_json(
+        &env("FC_POOL_MEMORY_REPORT")?,
+        &serde_json::json!({"version":1,"operation":p.operation,
+        "vm_id":p.vm_id,"run_epoch":p.run_epoch,"copied_private_bytes":copied,
+        "ram_snapshot_bytes":0,"module":summary,
+        "result":"passed"}),
+    )
+}
