+fn ioctl<T>(file: &File, nr: u8, read: bool, value: &mut T) -> io::Result<()> {
+    let command = 0x4000_0000u64
+        | if read { 0x8000_0000 } else { 0 }
+        | ((std::mem::size_of::<T>() as u64) << 16)
+        | (u64::from(b'P') << 8)
+        | u64::from(nr);
+    // SAFETY: each call uses the matching fixed-width UAPI structure; referenced
+    // buffers remain alive and immutable for this synchronous ioctl.
+    if unsafe { libc::ioctl(file.as_raw_fd(), command as _, value) } < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(())
+}
