+// SPDX-License-Identifier: Apache-2.0
+//! Opt-in dirty ledger and a stopped-boundary lab oracle. Never enabled by default.
+use std::fs::{File, OpenOptions};
+use std::io::{self, Write};
+use std::os::fd::AsRawFd;
+use std::sync::{Mutex, OnceLock};
+use std::time::{Duration, Instant};
+use vm_memory::{GuestMemoryBackend, GuestMemoryRegion};
+use crate::vstate::memory::GuestMemoryMmap;
+use crate::vstate::vm::KvmVm;
+
+pub(crate) fn enabled() -> bool { std::env::var_os("FC_DIRTY_LEDGER").is_some() }
+pub(crate) fn active() -> bool { std::env::var("FC_NONCOHERENT").as_deref() == Ok("1") }
+pub(crate) fn require<T>(result: io::Result<T>) -> T {
+    result.unwrap_or_else(|error| {
+        crate::logger::error_unrestricted!("NONCOHERENT_FATAL {error}");
+        std::process::abort()
+    })
+}
+
+fn invalid(s: impl ToString) -> io::Error { io::Error::other(s.to_string()) }
+pub(crate) struct Ledger { pub kvm: Vec<u64>, pub device: Vec<u64>, pub union: Vec<u64>, pub collect_ns: u64 }
+
+
+pub(crate) fn collect(vm: &KvmVm) -> io::Result<Ledger> {
+    let start = Instant::now();
+    let mem = vm.guest_memory();
+    if mem.num_regions() != 1 { return Err(invalid("ledger requires one RAM region")); }
+    let region = mem.iter().next().unwrap();
+    let bitmap = (**region).bitmap().as_ref().ok_or_else(|| invalid("dirty tracking absent"))?;
+    let mut kernel = vm.get_dirty_bitmap().map_err(invalid)?;
+    let kvm = kernel.remove(&0).ok_or_else(|| invalid("dirty slot 0 absent"))?;
+    let pages = region.len() as usize / 4096;
+    if !kernel.is_empty() || kvm.len() != pages.div_ceil(64) { return Err(invalid("dirty log geometry")); }
+    // AtomicBitmap uses one atomic u64 per 64 GPA pages. The exchange is
+    // also the reset: a concurrent mark falls in this snapshot or the next.
+    let device = bitmap.get_and_reset();
+    if device.len()!=kvm.len() {return Err(invalid("device bitmap geometry"));}
+    let union = kvm.iter().zip(&device).map(|(k,d)| k | d).collect();
+    let collect_ns=start.elapsed().as_nanos() as u64;
+
+    Ok(Ledger { kvm, device, union, collect_ns })
+}
+
+// A lab-only gate in unused mapper metadata. Header words 0..7 belong to the
+// stopped owner. Words 8..15 belong to L0. The final cache line holds owner receipts.
+// The hashing executable opens backing RO.
+// Metadata map entries end below +17MiB even for the maximum supported 4GiB RAM.
+const GATE_BYTES: usize = 1024 * 1024;
+const MIB: usize = 1024 * 1024;
+const LOG: usize = 32 * MIB;
+const MAILBOX: usize = 48 * MIB;
+const LOG_MAGIC: u64 = 0x4e43484c4f473031;
+const MAIL_MAGIC: u64 = 0x4e434d424f583031;
+const K: u64 = 8;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Identity {
+    pub cookie: [u64; 2], pub metadata: u64, pub phys_base: u64, pub device_bytes: u64, pub pages: usize,
+}
+struct Shared {
+    address: usize, _file: File, observer: File, id: Identity, consumed: u64, control_seen: bool,
+    epoch: u64, inv_from: u64, inv_to: u64,
+    wb: Vec<u64>, inv_requested: Vec<u64>, inv: Vec<u64>,
+    ram_wb_lines: std::cell::Cell<u64>, ram_inv_lines: std::cell::Cell<u64>,
+    init_control_inv_lines: std::cell::Cell<u64>,
+    wb_ns: u64, log_ns: u64, read_ns: u64, inv_ns: u64, control_ns: u64, log_lines: u64, read_lines: u64, control_lines: u64, kernel: [u64; 8],
+}
+unsafe impl Send for Shared {} // Mapping accessed only under the process-local mutex.
+impl Drop for Shared {
+    fn drop(&mut self) { unsafe { libc::munmap(self.address as *mut libc::c_void, 64*MIB); } }
+}
+fn fence(invalidate: bool) {
+    unsafe {
+        if invalidate { std::arch::asm!("mfence", options(nostack, preserves_flags)); }
+        else { std::arch::asm!("sfence", options(nostack, preserves_flags)); }
+    }
+}
+fn lines(address: usize, bytes: usize, invalidate: bool) -> u64 {
+    let first = address & !63;
+    let end = (address + bytes + 63) & !63;
+    for p in (first..end).step_by(64) {
+        // SAFETY: caller owns a checked, mapped range. CPUID is checked before use.
+        unsafe {
+            if invalidate { std::arch::asm!("clflushopt [{p}]", p=in(reg)p, options(nostack,preserves_flags)); }
+            else { std::arch::asm!("clwb [{p}]", p=in(reg)p, options(nostack,preserves_flags)); }
+        }
+    }
+    ((end-first)/64) as u64
+}
+fn full(pages: usize) -> Vec<u64> {
+    let mut result = vec![u64::MAX; pages.div_ceil(64)];
+    if pages%64 != 0 { *result.last_mut().unwrap() = (1u64 << (pages%64))-1; }
+    result
+}
+
+fn replay_records(pages: usize, consumed: u64, last: u64,
+    mut load: impl FnMut(u64)->io::Result<(u64,u64,Vec<u64>)>) -> io::Result<Vec<u64>> {
+    if consumed>last { return Err(invalid("future consumed epoch")); }
+    if last-consumed>K { return Ok(full(pages)); }
+    let mut result=vec![0u64;pages.div_ceil(64)];
+    let allowed=full(pages);
+    for epoch in consumed+1..=last {
+        let (actual,count,words)=load(epoch)?;
+        if actual!=epoch || words.len()!=result.len()
+            || count!=words.iter().map(|b|b.count_ones() as u64).sum::<u64>()
+            || words.iter().zip(&allowed).any(|(b,a)|b & !a !=0) {
+            return Err(invalid("missing/corrupt log record"));
+        }
+        for (r,b) in result.iter_mut().zip(words) { *r|=b; }
+    }
+    Ok(result)
+}
+impl Shared {
+    fn new(id: Identity) -> io::Result<Self> {
+        let features = std::arch::x86_64::__cpuid_count(7,0).ebx;
+        if features & (3 << 23) != 3 << 23 { return Err(invalid("CLWB/CLFLUSHOPT unavailable")); }
+        let configured: u64 = std::env::var("FC_POOL_MEMORY_METADATA_OFFSET").map_err(invalid)?.parse().map_err(invalid)?;
+        if id.metadata != configured || id.metadata%4096 != 0 || id.pages == 0 || id.pages > 1<<20
+            || id.device_bytes < 64*MIB as u64 || id.metadata > id.device_bytes-64*MIB as u64 {
+            return Err(invalid("noncoherent metadata reservation"));
+        }
+        let file = OpenOptions::new().read(true).write(true).open("/dev/dax0.0")?;
+        let p = unsafe { libc::mmap(std::ptr::null_mut(),64*MIB,libc::PROT_READ|libc::PROT_WRITE,
+            libc::MAP_SHARED,file.as_raw_fd(),id.metadata as libc::off_t) };
+        if p == libc::MAP_FAILED { return Err(io::Error::last_os_error()); }
+        let observer=OpenOptions::new().read(true).write(true).open("/dev/cxl_pool")?;
+        let mut result = Self { address:p as usize,_file:file,observer,id,consumed:0,control_seen:false,
+            epoch:0,inv_from:0,inv_to:0,wb:vec![],inv_requested:vec![],inv:vec![],
+            ram_wb_lines: std::cell::Cell::new(0),ram_inv_lines: std::cell::Cell::new(0),
+            init_control_inv_lines: std::cell::Cell::new(0),
+            wb_ns:0,log_ns:0,read_ns:0,inv_ns:0,control_ns:0,log_lines:0,read_lines:0,control_lines:0,kernel:[0;8] };
+        match std::fs::read(result.consumed_path()) {
+            Ok(bytes) if bytes.len()==8 => result.consumed=u64::from_le_bytes(bytes.try_into().unwrap()),
+            Ok(_) => return Err(invalid("invalid host-local consumed epoch")),
+            Err(e) if e.kind()==io::ErrorKind::NotFound => {},
+            Err(e) => return Err(e),
+        }
+        result.maintain(&vec![0;id.pages.div_ceil(64)],true)?;
+        let mut initial = 0u64;
+        if unsafe {libc::ioctl(result.observer.as_raw_fd(),0x80085081u32 as _,&mut initial)}<0 {
+            return Err(io::Error::last_os_error());
+        }
+        result.init_control_inv_lines.set(initial);
+        crate::logger::info_unrestricted!("NONCOHERENT_INIT_JSON {}",serde_json::json!({"control_invalidate_lines":initial}));
+        Ok(result)
+    }
+    fn cache_metadata(&self, offset: usize, bytes: usize, invalidate: bool) -> u64 {
+        let mut q=[self.id.phys_base,self.id.device_bytes,self.id.metadata,self.id.cookie[0],
+            self.id.cookie[1],self.id.pages as u64,offset as u64,bytes as u64,u64::from(invalidate),0,0,0];
+        if unsafe {libc::ioctl(self.observer.as_raw_fd(),0xc0605080u32 as _,q.as_mut_ptr())}<0 {
+            require::<()>(Err(io::Error::last_os_error()));
+        }
+        q[9]
+    }
+    fn consumed_path(&self) -> String {
+        format!("/run/noncoherent-{:016x}-{:016x}.epoch",self.id.cookie[0],self.id.cookie[1])
+    }
+    fn consume(&mut self, epoch: u64) -> io::Result<()> {
+        let path=self.consumed_path();
+        std::fs::write(format!("{path}.new"),epoch.to_le_bytes())?;
+        std::fs::rename(format!("{path}.new"),path)?;
+        self.consumed=epoch;
+        Ok(())
+    }
+    fn read(&self, offset: usize) -> u64 { unsafe { ((self.address+offset) as *const u64).read_volatile() } }
+    fn write(&self, offset: usize, value: u64) { unsafe { ((self.address+offset) as *mut u64).write_volatile(value); } }
+    fn stride(&self) -> usize { (16+self.id.pages.div_ceil(64)*8+63)&!63 }
+    fn slot(&self, epoch: u64) -> usize { LOG+64+((epoch-1)%K) as usize*self.stride() }
+    fn header(&self) -> io::Result<u64> {
+        if self.read(LOG)!=LOG_MAGIC || self.read(LOG+8)!=1 || self.read(LOG+16)!=self.id.cookie[0]
+            || self.read(LOG+24)!=self.id.cookie[1] || self.read(LOG+32)!=self.id.pages as u64
+            || self.read(LOG+48)!=K || self.read(LOG+56)!=self.stride() as u64 || self.read(LOG+40)==0 {
+            return Err(invalid("noncoherent log identity/geometry"));
+        }
+        Ok(self.read(LOG+40))
+    }
+    fn publish(&mut self, bitmap: &[u64], initialize: bool) -> io::Result<u64> {
+        if initialize {
+            for (i,value) in [LOG_MAGIC,1,self.id.cookie[0],self.id.cookie[1],self.id.pages as u64,1,K,self.stride() as u64].iter().enumerate() {
+                self.write(LOG+i*8,*value);
+            }
+        }
+        let epoch=self.header()?;
+        let next=epoch.checked_add(1).ok_or_else(||invalid("log epoch overflow"))?;
+        let slot=self.slot(epoch);
+        self.write(slot,epoch);
+        self.write(slot+8,bitmap.iter().map(|b|b.count_ones() as u64).sum());
+        unsafe { std::ptr::copy_nonoverlapping(bitmap.as_ptr(),(self.address+slot+16) as *mut u64,bitmap.len()); }
+        self.log_lines=self.cache_metadata(slot,self.stride(),false); fence(false);
+        self.write(LOG+40,next);
+        self.log_lines+=self.cache_metadata(LOG,64,false); fence(false);
+        self.consume(epoch)?;
+        self.epoch=epoch;
+        Ok(epoch)
+    }
+    fn control(&mut self, invalidate: bool) -> u64 {
+        let bytes=if self.control_seen {4096} else {4096+self.id.pages*16};
+        let n=self.cache_metadata(0,bytes,invalidate); fence(invalidate);
+        self.control_seen=true;
+        n
+    }
+    fn mailbox_write(&self, bytes: &[u8], epoch: u64) -> io::Result<u64> {
+        if bytes.is_empty() || bytes.len()>=65536 { return Err(invalid("mailbox packet size")); }
+        unsafe { std::ptr::copy_nonoverlapping(bytes.as_ptr(),(self.address+MAILBOX+64) as *mut u8,bytes.len()); }
+        let emitted=self.cache_metadata(MAILBOX+64,bytes.len(),false); fence(false);
+        for (i,v) in [MAIL_MAGIC,epoch,bytes.len() as u64,self.id.cookie[0],self.id.cookie[1]].iter().enumerate() {
+            self.write(MAILBOX+i*8,*v);
+        }
+        let emitted=emitted+self.cache_metadata(MAILBOX,64,false); fence(false);
+        Ok(emitted)
+    }
+    fn mailbox_read(&self, bytes: &[u8], epoch: u64) -> io::Result<u64> {
+        let emitted=self.cache_metadata(MAILBOX,64,true); fence(true);
+        if epoch==0 || self.read(MAILBOX)!=MAIL_MAGIC || self.read(MAILBOX+8)!=epoch
+            || self.read(MAILBOX+16)!=bytes.len() as u64 || bytes.len()>=65536
+            || self.read(MAILBOX+24)!=self.id.cookie[0] || self.read(MAILBOX+32)!=self.id.cookie[1] {
+            return Err(invalid("stale/foreign handoff mailbox"));
+        }
+        let emitted=emitted+self.cache_metadata(MAILBOX+64,bytes.len(),true); fence(true);
+        let stored=unsafe { std::slice::from_raw_parts((self.address+MAILBOX+64) as *const u8,bytes.len()) };
+        if stored!=bytes { return Err(invalid("handoff mailbox/token mismatch")); }
+        Ok(emitted)
+    }
+    fn replay(&mut self, last: u64) -> io::Result<Vec<u64>> {
+        // A packet can arrive before a remote header becomes observable. Each
+        // retry discards the old line. Never resume on a future packet epoch.
+        let future=u64::from(std::env::var("FC_NONCOHERENT_FAIL").as_deref()==Ok("epoch"));
+        let expected=last.checked_add(1+future).ok_or_else(||invalid("epoch overflow"))?;
+        let mut observed=0;
+        self.read_lines=0;
+        for _ in 0..4 {
+            self.read_lines+=self.cache_metadata(LOG,64,true); fence(true);
+            observed=self.header()?;
+            if observed>=expected { break; }
+            std::thread::yield_now();
+        }
+        if observed!=expected || self.consumed>last {
+            return Err(invalid("log epoch is not the handoff packet epoch after retries"));
+        }
+        replay_records(self.id.pages,self.consumed,last,|epoch| {
+            let slot=self.slot(epoch);
+            self.read_lines+=self.cache_metadata(slot,self.stride(),true); fence(true);
+            let words=unsafe { std::slice::from_raw_parts((self.address+slot+16) as *const u64,self.id.pages.div_ceil(64)) }.to_vec();
+            let corrupt=u64::from(std::env::var("FC_NONCOHERENT_FAIL").as_deref()==Ok("record"));
+            Ok((self.read(slot)+corrupt,self.read(slot+8),words))
+        })
+    }
+    fn maintain(&self, bitmap: &[u64], invalidate: bool) -> io::Result<Vec<u64>> {
+        if bitmap.len()!=self.id.pages.div_ceil(64) { return Err(invalid("invalidate bitmap geometry")); }
+        let mut covered=vec![0u64;bitmap.len()];
+        if invalidate && crate::ept_adopt::enabled()
+            && std::env::var("FC_EPT_FAIL").as_deref()==Ok("ram-invalidate")
+            && bitmap.iter().any(|word|*word!=0) {
+            self.ram_inv_lines.set(0); return Ok(covered);
+        }
+        let skip=std::env::var("FC_NONCOHERENT_SKIP_PAGE").ok().and_then(|s|s.parse::<u64>().ok()).unwrap_or(u64::MAX);
+        let mut request=[self.id.phys_base,self.id.device_bytes,self.id.metadata,self.id.cookie[0],
+            self.id.cookie[1],self.id.pages as u64,bitmap.as_ptr() as u64,covered.as_mut_ptr() as u64,0,0,skip,0];
+        // CPM_CACHE: independent observer, immutable GPA table, kernel direct map.
+        if unsafe {libc::ioctl(self.observer.as_raw_fd(),(if invalidate {0xc060507bu32} else {0xc060507eu32}) as _,request.as_mut_ptr())}<0 {
+            return Err(io::Error::last_os_error());
+        }
+        if covered!=bitmap || request[8]!=bitmap.iter().map(|b|b.count_ones() as u64*64).sum::<u64>() {
+            return Err(invalid("kernel guest maintenance receipt mismatch"));
+        }
+        if invalidate {self.ram_inv_lines.set(request[8]);} else {self.ram_wb_lines.set(request[8]);}
+        Ok(covered)
+    }
+
+}
+fn with_shared<T>(id: Identity, f: impl FnOnce(&mut Shared)->io::Result<T>) -> io::Result<T> {
+    static SHARED: OnceLock<Mutex<Option<Shared>>> = OnceLock::new();
+    let mut guard=SHARED.get_or_init(||Mutex::new(None)).lock().unwrap();
+    if guard.as_ref().is_none_or(|s|s.id!=id) { *guard=Some(Shared::new(id)?); }
+    f(guard.as_mut().unwrap())
+}
+fn identity() -> io::Result<Identity> {
+    crate::pool_memory::manifest_for_profile().ok_or_else(||invalid("shared RAM absent"))?.noncoherent_identity()
+}
+fn kernel_stats(_fd: i32, _invalidate: bool, _arena: u64) -> io::Result<[u64;8]> { Ok(crate::ept_adopt::receipt()) }
+pub(crate) fn send(_mem: &GuestMemoryMmap, ledger: &Ledger) -> io::Result<u64> {
+    if !active() { return Ok(0); }
+    if std::env::var("FC_NONCOHERENT_FAIL").as_deref()==Ok("writeback") {return Err(invalid("injected writeback failure after harvest"));}
+    with_shared(identity()?,|s| {
+        let start=Instant::now();
+        s.wb=s.maintain(&ledger.union,false)?;
+        s.wb_ns=start.elapsed().as_nanos() as u64;
+
+        let start=Instant::now(); let epoch=s.publish(&ledger.union,false)?;
+        s.log_ns=start.elapsed().as_nanos() as u64;
+        Ok(epoch)
+    })
+}
+static BULK_RESET: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+pub(crate) fn take_bulk_reset() -> bool { BULK_RESET.swap(false,std::sync::atomic::Ordering::AcqRel) }
+fn bulk(_mem: &GuestMemoryMmap) -> io::Result<()> {
+    with_shared(identity()?,|s| {
+        let bitmap=full(s.id.pages);
+        let start=Instant::now(); s.wb=s.maintain(&bitmap,false)?;
+        s.wb_ns=start.elapsed().as_nanos() as u64;
+        let start=Instant::now(); s.publish(&bitmap,true)?;
+        s.log_ns=start.elapsed().as_nanos() as u64;
+        s.control_lines=s.control(false);
+        Ok(())
+    })?;
+    BULK_RESET.store(true,std::sync::atomic::Ordering::Release);
+    Ok(())
+}
+pub(crate) fn prepare(manifest: &crate::pool_memory::Manifest, bytes: &[u8], epoch: u64) -> io::Result<()> {
+    if !active() { return Ok(()); }
+    with_shared(manifest.noncoherent_identity()?,|s| {
+        let start=Instant::now(); s.control_lines=s.mailbox_read(bytes,epoch)?; s.control_lines+=s.control(true);
+        s.control_ns=start.elapsed().as_nanos() as u64; Ok(())
+    })
+}
+pub(crate) fn received(_mem: &GuestMemoryMmap, epoch: u64, arena: u64, fd: i32) -> io::Result<()> {
+    if !active() { return Ok(()); }
+    let stats=kernel_stats(fd,true,arena)?;
+    with_shared(identity()?,|s| {
+        s.kernel=stats;
+        s.inv_from=s.consumed; s.inv_to=epoch; s.epoch=epoch;
+        let start=Instant::now(); s.inv_requested=s.replay(epoch)?;
+        s.read_ns=start.elapsed().as_nanos() as u64;
+        let start=Instant::now(); s.inv=s.maintain(&s.inv_requested,true)?;
+        s.inv_ns=start.elapsed().as_nanos() as u64;
+        let consumed_started=Instant::now(); s.consume(epoch)?;
+        s.read_ns+=consumed_started.elapsed().as_nanos() as u64;
+        crate::logger::info_unrestricted!("NONCOHERENT_JSON {}",serde_json::json!({
+            "event":"import","epoch":epoch,"log_read_ns":s.read_ns,"invalidate_ns":s.inv_ns,
+            "lines":s.inv.iter().map(|b|b.count_ones() as u64*64).sum::<u64>(),"kernel":s.kernel,"control_ns":s.control_ns,"read_lines":s.read_lines,"control_lines":s.control_lines}));
+        Ok(())
+    })?;
+    Ok(())
+}
+pub(crate) fn adopted(mem: &GuestMemoryMmap, arena: u64) -> io::Result<()> {
+    boundary(mem,3,arena,None)
+}
+pub(crate) fn cleaned(mem: &GuestMemoryMmap, ledger: &Ledger, stopped: bool) -> io::Result<()> {
+    with_shared(identity()?,|s| {
+        crate::logger::info_unrestricted!("NONCOHERENT_JSON {}",serde_json::json!({
+            "event":"clean","epoch":s.epoch,"pages":ledger.union.iter().map(|b|b.count_ones() as u64).sum::<u64>(),
+            "collect_ns":ledger.collect_ns,"writeback_ns":s.wb_ns,"publish_ns":s.log_ns,"stopped":stopped,
+            "ram_lines":s.ram_wb_lines.get(),"publish_lines":s.log_lines}));
+        Ok(())
+    })?;
+    boundary(mem,if stopped {6} else {4},0,Some(ledger))
+}
+fn preinvalidate_identity(id: Identity, hva: u64) -> io::Result<()> {
+    with_shared(id,|s| {
+        let header_lines=s.cache_metadata(LOG,64,true); fence(true);
+        let epoch=s.header()?-1;
+        s.inv_from=s.consumed; s.inv_to=epoch; s.epoch=epoch;
+        let start=Instant::now(); s.inv_requested=s.replay(epoch)?;
+        s.read_ns=start.elapsed().as_nanos() as u64;
+        let start=Instant::now(); s.inv=s.maintain(&s.inv_requested,true)?;
+        s.inv_ns=start.elapsed().as_nanos() as u64;
+        s.read_lines+=header_lines;
+        s.consume(epoch)?;
+        crate::logger::info_unrestricted!("NONCOHERENT_JSON {}",serde_json::json!({
+            "event":"preinvalidate","epoch":epoch,"from":s.inv_from,"log_read_ns":s.read_ns,"invalidate_ns":s.inv_ns,
+            "pages":s.inv.iter().map(|b|b.count_ones() as u64).sum::<u64>()}));
+        Ok(())
+    })?;
+    boundary_identity(id,id.pages,hva,5,0,None)
+}
+
+pub(crate) fn preinvalidate_cold(manifest: &crate::pool_memory::Manifest) -> io::Result<()> {
+    preinvalidate_identity(manifest.noncoherent_identity()?,0)
+}
+pub(crate) fn complete(mem: &GuestMemoryMmap, bytes: &[u8], epoch: u64, arena: u64, fd: i32, ledger: &Ledger) -> io::Result<()> {
+    if active() {
+        let stats=kernel_stats(fd,false,arena)?;
+        with_shared(identity()?,|s| {
+            s.kernel=stats; let start=Instant::now(); s.control_lines=s.control(false); s.control_lines+=s.mailbox_write(bytes,epoch)?;
+            s.control_ns=start.elapsed().as_nanos() as u64;
+            crate::logger::info_unrestricted!("NONCOHERENT_JSON {}",serde_json::json!({
+                "event":"export","epoch":epoch,"collect_ns":ledger.collect_ns,"writeback_ns":s.wb_ns,
+                "publish_ns":s.log_ns,"lines":s.wb.iter().map(|b|b.count_ones() as u64*64).sum::<u64>(),"kernel":s.kernel,
+                "control_ns":s.control_ns,"publish_lines":s.log_lines,"control_lines":s.control_lines}));
+            Ok(())
+        })?;
+    }
+    boundary(mem,2,arena,Some(ledger))
+}
