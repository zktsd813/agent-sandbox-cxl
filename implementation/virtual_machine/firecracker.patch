+// Copyright 2026
+// SPDX-License-Identifier: Apache-2.0
+
+//! Experimental immutable block-data pooling. Hints are I/O history, not guest
+//! page-cache residency. The controller owns immutable image identity, the
+//! approximate Bloom directory and frozen CXL frame lifetime. Admission runs only
+//! with vCPUs paused and all device writes drained, and validates every byte.
+//! Private devDAX mappings require the lab kernel's opt-in CoW extension.
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::fs::{File, OpenOptions};
+use std::io::{self, BufReader, BufWriter, Write};
+use std::os::fd::AsRawFd;
+use std::os::unix::fs::{FileTypeExt, MetadataExt};
+use std::sync::{Mutex, OnceLock};
+use std::time::Instant;
+
+use serde::{Deserialize, Serialize};
+use vm_memory::{GuestMemoryBackend, GuestMemoryRegion};
+
+use crate::vstate::memory::{Bytes, GuestAddress, GuestMemoryExtension, GuestMemoryMmap};
+
+const PAGE: usize = 4096;
+// serde_json performs small reads/writes; buffering is essential when a
+// checkpoint sidecar lives on an NFS mount with attribute-cache validation.
+const JSON_BUFFER: usize = 64 * 1024;
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct Hint {
+    pub gpa: u64,
+    pub image_id: String,
+    pub image_offset: u64,
+    pub sequence: u64,
+}
+
+#[derive(Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+struct HintFile {
+    version: u32,
+    vm_id: String,
+    run_epoch: String,
+    hints: Vec<Hint>,
+}
+
+#[derive(Debug, Default)]
+struct State {
+    hints: BTreeMap<u64, Hint>,
+    sequence: u64,
+    overlays: bool,
+    pooled_gpas: BTreeSet<u64>,
+    pending_io: BTreeMap<u64, Vec<(u64, u64)>>,
+    next_io: u64,
+    discard_sequence: u64,
+    mapping_failed: bool,
+    restore_error: Option<String>,
+}
+
+fn invalid(message: impl Into<String>) -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidInput, message.into())
+}
+
+fn required(name: &str) -> io::Result<String> {
+    std::env::var(name)
+        .ok()
+        .filter(|v| !v.is_empty())
+        .ok_or_else(|| invalid(format!("{name} is required")))
+}
+
+fn valid_identity(id: &str) -> bool {
+    id.len() == 64 && id.bytes().all(|b| b.is_ascii_hexdigit())
+}
+
+fn state() -> &'static Mutex<State> {
+    static STATE: OnceLock<Mutex<State>> = OnceLock::new();
+    STATE.get_or_init(|| {
+        let mut s = State::default();
+        if let Ok(path) = std::env::var("FC_POOL_HINTS_RESTORE") {
+            let result = (|| -> io::Result<()> {
+                let saved: HintFile = serde_json::from_reader(BufReader::with_capacity(
+                    JSON_BUFFER,
+                    File::open(path)?,
+                ))?;
+                let image_id = required("FC_POOL_IMAGE_ID")?;
+                if saved.version != 1
+                    || saved.vm_id != required("FC_POOL_VM_ID")?
+                    || !valid_identity(&image_id)
+                {
+                    return Err(invalid("restored pool hint identity/version mismatch"));
+                }
+                for h in saved.hints {
+                    if h.gpa % PAGE as u64 != 0
+                        || h.image_offset % PAGE as u64 != 0
+                        || h.image_id != image_id
+                        || s.hints.contains_key(&h.gpa)
+                    {
+                        return Err(invalid("invalid restored pool hint"));
+                    }
+                    s.sequence = s.sequence.max(h.sequence);
+                    s.hints.insert(h.gpa, h);
+                }
+                Ok(())
+            })();
+            if let Err(error) = result {
+                s.hints.clear();
+                s.restore_error = Some(error.to_string());
+            }
+        }
+        Mutex::new(s)
+    })
+}
+
+/// Only an explicitly identified read-only drive can contribute hints.
+pub(crate) fn disk_identity(path: &str, read_only: bool) -> Option<String> {
+    if !read_only || std::env::var("FC_POOL_IMAGE_PATH").as_deref() != Ok(path) {
+        return None;
+    }
+    let id = std::env::var("FC_POOL_IMAGE_ID").ok()?;
+    if !valid_identity(&id)
+        || required("FC_POOL_VM_ID").is_err()
+        || required("FC_POOL_RUN_EPOCH").is_err()
+    {
+        return None;
+    }
+    Some(id)
+}
+
+/// Call only after a complete successful read and before used-ring publication.
+pub(crate) fn observe(image_id: &str, gpa: u64, image_offset: u64, length: u32) {
+    if gpa % PAGE as u64 != 0 || image_offset % PAGE as u64 != 0 {
+        return;
+    }
+    let mut s = state().lock().expect("pool state poisoned");
+    for delta in (0..u64::from(length) / PAGE as u64).map(|n| n * PAGE as u64) {
+        let Some(address) = gpa.checked_add(delta) else {
+            break;
+        };
+        let Some(offset) = image_offset.checked_add(delta) else {
+            break;
+        };
+        s.sequence += 1;
+        let sequence = s.sequence;
+        s.hints.insert(
+            address,
+            Hint {
+                gpa: address,
+                image_id: image_id.to_owned(),
+                image_offset: offset,
+                sequence,
+            },
+        );
+    }
+}
+
+pub(crate) fn dump_hints() -> io::Result<()> {
+    let Ok(path) = std::env::var("FC_POOL_HINTS") else {
+        return Ok(());
+    };
+    let s = state().lock().expect("pool state poisoned");
+    if let Some(error) = &s.restore_error {
+        return Err(invalid(error));
+    }
+    let hints = HintFile {
+        version: 1,
+        vm_id: required("FC_POOL_VM_ID")?,
+        run_epoch: required("FC_POOL_RUN_EPOCH")?,
+        hints: s.hints.values().cloned().collect(),
+    };
+    let temporary = format!("{path}.new");
+    let mut writer = BufWriter::with_capacity(JSON_BUFFER, File::create(&temporary)?);
+    serde_json::to_writer(&mut writer, &hints)?;
+    writer.flush()?;
+    std::fs::rename(temporary, path)
+}
+
+pub(crate) fn mapping_failed() -> bool {
+    state().lock().expect("pool state poisoned").mapping_failed
+}
+
+pub(crate) fn set_mapping_failed(value: bool) {
+    state().lock().expect("pool state poisoned").mapping_failed = value;
+}
+
+pub(crate) fn set_pool_lineage(gpas: impl Iterator<Item=u64>) {
+    let mut s=state().lock().expect("pool state poisoned");
+    s.pooled_gpas=gpas.collect();
+    s.overlays=true;
+}
+
+pub(crate) fn has_overlays() -> bool {
+    state().lock().expect("pool state poisoned").overlays
+}
+
+/// Explicitly opt into the reporting-only guest/host discard handshake.
+pub(crate) fn discard_enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var("FC_POOL_DISCARD").as_deref() == Ok("1"))
+}
+
+/// RAII ownership covers io_uring pins until completion/cancellation releases
+/// the PendingRequest. A report overlapping an active buffer is acknowledged as
+/// a conservative no-op: the original CoW mapping remains available.
+#[derive(Debug)]
+pub(crate) struct IoGuard(u64);
+impl Drop for IoGuard {
+    fn drop(&mut self) {
+        state().lock().expect("pool state poisoned").pending_io.remove(&self.0);
+    }
+}
+
+pub(crate) fn protect_io(gpa: u64, bytes: u32, status: u64) -> Option<IoGuard> {
+    if !discard_enabled() {
+        return None;
+    }
+    let mut s = state().lock().expect("pool state poisoned");
+    s.next_io = s.next_io.checked_add(1).expect("pool I/O sequence exhausted");
+    let id = s.next_io;
+    // Overflow is conservatively protected through the top of the address space.
+    s.pending_io.insert(id, vec![(gpa, gpa.saturating_add(u64::from(bytes))),
+                                (status, status.saturating_add(1))]);
+    Some(IoGuard(id))
+}
+
+#[derive(Clone, Debug, Serialize, PartialEq, Eq)]
+pub(crate) struct DiscardRange {
+    pub gpa: u64,
+    pub bytes: u64,
+}
+
+#[derive(Debug, Serialize)]
+pub(crate) struct DiscardReport {
+    pub phase: &'static str,
+    vm_id: String,
+    run_epoch: String,
+    pub batch: u64,
+    pub queue_head: u16,
+    pub requested: Vec<DiscardRange>,
+    pub discarded: Vec<DiscardRange>,
+    pub requested_pages: u64,
+    pub discarded_pages: u64,
+    pub skipped_busy_pages: u64,
+    pub hints_removed: u64,
+    pub copied_bytes: u64,
+    pub host_work_ns: u64,
+}
+
+fn overlaps(a: (u64, u64), b: (u64, u64)) -> bool {
+    a.0 < b.1 && b.0 < a.1
+}
+
+fn checked_report_ranges(mem: &GuestMemoryMmap, ranges: &[DiscardRange]) -> io::Result<()> {
+    if ranges.is_empty() || ranges.len() > 256 {
+        return Err(invalid("discard descriptor count must be 1..256"));
+    }
+    let mut intervals = Vec::with_capacity(ranges.len());
+    for r in ranges {
+        let end = r.gpa.checked_add(r.bytes).ok_or_else(|| invalid("discard address overflow"))?;
+        let length = usize::try_from(r.bytes).map_err(|_| invalid("discard length overflow"))?;
+        if r.bytes == 0 || r.gpa % PAGE as u64 != 0 || r.bytes % PAGE as u64 != 0 {
+            return Err(invalid("discard must cover complete aligned nonempty pages"));
+        }
+        mem.get_slice(GuestAddress(r.gpa), length).map_err(|_| invalid("discard outside a contiguous guest RAM region"))?;
+        intervals.push((r.gpa, end));
+    }
+    intervals.sort_unstable();
+    if intervals.windows(2).any(|w| w[0].1 > w[1].0) {
+        return Err(invalid("overlapping discard descriptors"));
+    }
+    Ok(())
+}
+
+fn discard_with(
+    mem: &GuestMemoryMmap,
+    ranges: &[DiscardRange],
+    s: &mut State,
+    mut replace: impl FnMut(*mut u8, usize) -> io::Result<()>,
+) -> io::Result<(Vec<DiscardRange>, u64, u64)> {
+    checked_report_ranges(mem, ranges)?;
+    if s.mapping_failed || s.restore_error.is_some() {
+        return Err(invalid("pool state is not usable"));
+    }
+    let mut selected = BTreeSet::new();
+    let mut busy = 0;
+    for r in ranges {
+        for &gpa in s.pooled_gpas.range(r.gpa..r.gpa + r.bytes) {
+            if s.pending_io.values().flatten().any(|&v| overlaps((gpa, gpa + PAGE as u64), v)) {
+                busy += 1;
+            } else {
+                selected.insert(gpa);
+            }
+        }
+    }
+    let mut mapped: Vec<DiscardRange> = Vec::new();
+    for &gpa in &selected {
+        if let Some(last) = mapped.last_mut()
+            && last.gpa + last.bytes == gpa {
+                last.bytes += PAGE as u64;
+                continue;
+            }
+        mapped.push(DiscardRange { gpa, bytes: PAGE as u64 });
+    }
+    // Resolve every target before any MAP_FIXED. Guest reporting quarantines all
+    // listed pages until used-ring publication; pending device buffers are skipped.
+    let targets: Vec<_> = mapped.iter().map(|r| {
+        mem.get_slice(GuestAddress(r.gpa), r.bytes as usize)
+            .map_err(|_| invalid("discard target crosses guest region"))?;
+        mem.get_host_address(GuestAddress(r.gpa)).map(|hva| (hva, r))
+            .map_err(|_| invalid("discard target has no host address"))
+    }).collect::<io::Result<_>>()?;
+    for (hva, r) in targets {
+        s.mapping_failed = true; // MAP_FIXED failure can leave the old VMA unmapped.
+        if !crate::pool_memory::discard(r.gpa, hva as usize, r.bytes)? {
+            replace(hva, r.bytes as usize)?;
+        }
+        s.mapping_failed = false;
+        s.overlays = true; // Anonymous zero backing still invalidates DAX-only snapshots.
+        mem.mark_dirty(GuestAddress(r.gpa), r.bytes as usize);
+    }
+    for gpa in selected {
+        s.pooled_gpas.remove(&gpa);
+    }
+    let stale: Vec<_> = ranges.iter().flat_map(|r| s.hints.range(r.gpa..r.gpa + r.bytes).map(|(&gpa, _)| gpa))
+        .filter(|&gpa| !s.pending_io.values().flatten().any(|&v| overlaps((gpa, gpa + PAGE as u64), v)))
+        .collect();
+    let removed = stale.len() as u64;
+    for gpa in stale { s.hints.remove(&gpa); }
+    Ok((mapped, busy, removed))
+}
+
+fn replace_private_zero(hva: *mut u8, bytes: usize) -> io::Result<()> {
+    // SAFETY: caller validates and owns the entire target range and guarantees
+    // no access until return. Anonymous backing never reads the canonical file.
+    let mapped = unsafe { libc::mmap(hva.cast(), bytes, libc::PROT_READ | libc::PROT_WRITE,
+        libc::MAP_PRIVATE | libc::MAP_ANONYMOUS | libc::MAP_FIXED | libc::MAP_NORESERVE, -1, 0) };
+    if mapped == libc::MAP_FAILED { Err(io::Error::last_os_error()) } else { Ok(()) }
+}
+
+/// No canonical bytes are read or written. The guest driver owns/quarantines
+/// these pages until the caller publishes the used-ring ACK. This function only
+/// detaches previously installed pool aliases, not every free DAX RAM page.
+pub(crate) fn discard_reported(mem: &GuestMemoryMmap, queue_head: u16,
+                              requested: Vec<DiscardRange>) -> io::Result<DiscardReport> {
+    let start = Instant::now();
+    let vm_id = required("FC_POOL_VM_ID")?;
+    let run_epoch = required("FC_POOL_RUN_EPOCH")?;
+    let mut s = state().lock().expect("pool state poisoned");
+    let (discarded, skipped_busy_pages, hints_removed) =
+        discard_with(mem, &requested, &mut s, replace_private_zero)?;
+    s.discard_sequence = s.discard_sequence.checked_add(1).expect("discard sequence exhausted");
+    Ok(DiscardReport { phase: "mapped", vm_id, run_epoch, batch: s.discard_sequence, queue_head,
+        requested_pages: requested.iter().map(|r| r.bytes / PAGE as u64).sum(),
+        discarded_pages: discarded.iter().map(|r| r.bytes / PAGE as u64).sum(),
+        requested, discarded, skipped_busy_pages, hints_removed, copied_bytes: 0,
+        host_work_ns: start.elapsed().as_nanos().try_into().unwrap_or(u64::MAX) })
+}
+
+pub(crate) fn log_discard(report: &DiscardReport) {
+    // Native timing stops before serialization/log output. Exact coalesced ranges
+    // support independent guest submit/ACK and host PFN correlation.
+    static TRACE: OnceLock<bool> = OnceLock::new();
+    if *TRACE.get_or_init(|| std::env::var("FC_POOL_DISCARD_TRACE").as_deref() == Ok("1")) {
+        // Lab-only lossless evidence: ordinary rate-limited info would suppress
+        // descriptor transactions and make submit/ACK joins incomplete.
+        crate::logger::info_unrestricted!("POOL_DISCARD_JSON {}", serde_json::to_string(report).expect("discard report serialization"));
+    }
+}
+
+/// The snapshot caller and reporting callbacks share one event loop. This last
+/// batch is therefore the exact cut represented by saved queue state and RAM;
+/// later paused-source reports are outside the checkpoint.
+pub(crate) fn log_discard_snapshot(snapshot_path: &std::path::Path,
+                                   mem_file_path: &std::path::Path) {
+    if std::env::var("FC_POOL_DISCARD_TRACE").as_deref() != Ok("1") {
+        return;
+    }
+    let discard_sequence = state().lock().expect("pool state poisoned").discard_sequence;
+    let marker = serde_json::json!({
+        "version": 1,
+        "phase": "complete",
+        "vm_id": std::env::var("FC_POOL_VM_ID").ok(),
+        "run_epoch": std::env::var("FC_POOL_RUN_EPOCH").ok(),
+        "discard_sequence": discard_sequence,
+        "snapshot_path": snapshot_path,
+        "mem_file_path": mem_file_path,
+    });
+    crate::logger::info_unrestricted!("POOL_DISCARD_SNAPSHOT_JSON {}", marker);
+}
