+
+    fn valid_state() -> DirectState {
+        DirectState {
+            schema: "direct-device-handoff-v1".into(),
+            token: HandoffToken {
+                vm_offset: 4096,
+                vcpu_offset: 8192,
+                vmcs_offset: 12288,
+                run_offset: 16384,
+                generation: 1,
+                vm_creates: 1,
+                vcpu_creates: 1,
+                flags: 2,
+                ram_hva: 0x400000000000,
+                ram_bytes: 128 * 1024 * 1024,
+                ept_root_offset: 20480,
+                ..Default::default()
+            },
+            machine_config: MachineConfig {
+                mem_size_mib: 128,
+                ..Default::default()
+            },
+            boot_source: BootSourceConfig::default(),
+            memory: GuestMemoryState {
+                regions: vec![GuestMemoryRegionState {
+                    base_address: 0,
+                    size: 128 * 1024 * 1024,
+                    region_type: GuestRegionType::Dram,
+                    plugged: vec![true],
+                }],
+            },
+            memory_manifest_sha256: sha256(b"mapping"),
+            devices: DevicesState::default(),
+        }
+    }
+
+    #[test]
+    fn direct_contract_accepts_only_detached_same_graph_geometry() {
+        let state = valid_state();
+        assert!(validate_state(&state).is_ok());
+        for mutate in [
+            |s: &mut DirectState| s.token.flags = 1,
+            |s: &mut DirectState| s.token.generation = 0,
+            |s: &mut DirectState| s.token.vm_creates = 2,
+            |s: &mut DirectState| s.token.vcpu_creates = 2,
+            |s: &mut DirectState| s.token.ram_hva += 1,
+            |s: &mut DirectState| s.token.ram_hva = u64::MAX - 4095,
+            |s: &mut DirectState| s.token.ram_bytes -= 4096,
+            |s: &mut DirectState| s.memory.regions[0].plugged = vec![false],
+            |s: &mut DirectState| s.machine_config.mem_size_mib = usize::MAX,
+            |s: &mut DirectState| s.machine_config.track_dirty_pages = true,
+            |s: &mut DirectState| s.machine_config.vcpu_count = 2,
+            |s: &mut DirectState| s.devices.acpi_state.vmgenid.addr = u64::MAX,
+            |s: &mut DirectState| s.devices.acpi_state.vmclock.guest_address = u64::MAX,
+        ] {
+            let mut invalid = valid_state();
+            mutate(&mut invalid);
+            assert!(validate_state(&invalid).is_err(), "{invalid:?}");
+        }
+    }
+
+    #[test]
+    fn direct_metadata_has_no_cpu_or_ram_payload() {
+        let value = serde_json::to_value(valid_state()).unwrap();
+        assert!(value.get("vcpu_states").is_none());
+        assert!(value.get("vm_state").is_none());
+        assert!(value.get("ram").is_none());
+        assert!(value.get("devices").is_some());
+        assert!(value.get("memory_manifest_sha256").is_some());
+        let restored: DirectState = serde_json::from_value(value.clone()).unwrap();
+        assert!(validate_state(&restored).is_ok());
+        let mut unknown = value;
+        unknown["vcpu_states"] = serde_json::json!([]);
+        assert!(serde_json::from_value::<DirectState>(unknown).is_err());
+    }
+
+    #[test]
+    fn direct_manifest_digest_is_content_bound() {
+        assert_eq!(
+            sha256(b"abc"),
+            "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
+        );
+        assert_ne!(
+            sha256(b"mapping generation 1"),
+            sha256(b"mapping generation 2")
+        );
+        assert_eq!(std::mem::size_of::<HandoffToken>(), 136);
+    }
+}
