+/// Map shared device-DAX RAM, optionally clearing it for a cold boot.
+/// Restoring requires the old owner to be paused and uses `initialize = false`.
+pub fn devdax(
+    regions: &[(GuestAddress, usize)],
+    path: &Path,
+    offset: u64,
+    track_dirty_pages: bool,
+    initialize: bool,
+) -> Result<Vec<GuestRegionMmap>, MemoryError> {
+    let dax_error = |e: io::Error| MemoryError::Dax(e.to_string());
+    let file = OpenOptions::new()
+        .read(true)
+        .write(true)
+        .open(path)
+        .map_err(dax_error)?;
+    if !file
+        .metadata()
+        .map_err(dax_error)?
+        .file_type()
+        .is_char_device()
+    {
+        return Err(MemoryError::Dax("expected a character device".into()));
+    }
+    let name = path
+        .file_name()
+        .and_then(|n| n.to_str())
+        .filter(|n| n.starts_with("dax") && n[3..].chars().all(|c| c.is_ascii_digit() || c == '.'))
+        .ok_or_else(|| MemoryError::Dax("expected /dev/daxX.Y".into()))?;
+    let attribute = |attr: &str| -> Result<u64, MemoryError> {
+        std::fs::read_to_string(format!("/sys/bus/dax/devices/{name}/{attr}"))
+            .map_err(dax_error)?
+            .trim()
+            .parse()
+            .map_err(|_| MemoryError::Dax(format!("invalid {attr}")))
+    };
+    let align = attribute("align")?;
+    let capacity = attribute("size")?;
+    if !align.is_power_of_two() || align > GUEST_MEMORY_ALIGNMENT as u64 || offset % align != 0 {
+        return Err(MemoryError::Dax(
+            "unsupported DAX alignment or offset".into(),
+        ));
+    }
+    let mut end = offset;
+    for &(gpa, size) in regions {
+        if size == 0 || size as u64 % align != 0 || gpa.raw_value() % align != 0 {
+            return Err(MemoryError::Dax("unaligned guest RAM region".into()));
+        }
+        end = end
+            .checked_add(size as u64)
+            .ok_or(MemoryError::OffsetTooLarge)?;
+    }
+    if end > capacity {
+        return Err(MemoryError::Dax("allocation exceeds DAX capacity".into()));
+    }
+    let file = Arc::new(file);
+    let mut next = offset;
+    // Optional lab contract for comparing independent semantic restores at one HVA.
+    // Guest GVA/GPA page tables remain unchanged regardless; this does not retain EPT.
+    let mut fixed_address = std::env::var("FC_DAX_FIXED_HVA")
+        .ok()
+        .map(|value| {
+            let parsed = if let Some(hex) = value.strip_prefix("0x") {
+                usize::from_str_radix(hex, 16)
+            } else {
+                value.parse()
+            };
+            parsed.map_err(|_| MemoryError::Dax("invalid FC_DAX_FIXED_HVA".into()))
+        })
+        .transpose()?;
+    regions
+        .iter()
+        .map(|&(gpa, size)| {
+            let region = GuestRegionMmap::allocate_at(
+                gpa,
+                size,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_SHARED,
+                Some(FileOffset::from_arc(Arc::clone(&file), next)),
+                track_dirty_pages,
+                fixed_address,
+            )?;
+            if initialize {
+                // SAFETY: the caller exclusively owns this cold-boot allocation.
+                unsafe {
+                    std::ptr::write_bytes(region.as_ptr(), 0, size);
+                }
+            }
+            crate::logger::info!(
+                "DAX_RAM path={} offset={} gpa={} bytes={} initialize={} hva={:#x}",
+                path.display(),
+                next,
+                gpa.raw_value(),
+                size,
+                initialize,
+                region.as_ptr() as usize
+            );
+            next += size as u64;
+            fixed_address = fixed_address
+                .map(|address| address.checked_add(size).ok_or(MemoryError::OffsetTooLarge))
+                .transpose()?;
+            Ok(region)
+        })
+        .collect()
+}
