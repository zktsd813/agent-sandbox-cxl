+                            heap.dealloc(pointer, layout);
+                        }
+                    }
+                });
+            }
+        });
+        assert_eq!(control.live_bytes.load(Ordering::Relaxed), 0);
+        assert_eq!(
+            control.allocs.load(Ordering::Relaxed),
+            control.frees.load(Ordering::Relaxed)
+        );
+        assert_eq!(
+            unsafe { (*((base as usize + CONTROL_BYTES) as *const FreeBlock)).bytes },
+            length - CONTROL_BYTES
+        );
+        unsafe {
+            libc::munmap(base, length);
+        }
+    }
