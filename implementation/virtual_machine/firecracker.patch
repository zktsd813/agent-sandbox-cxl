+struct OracleState { receipts:[u64;8],words:[u64;16], wb:Vec<u64>, requested:Vec<u64>, inv:Vec<u64> }
+fn oracle_state(id: Identity, words: usize) -> io::Result<OracleState> {
+    with_shared(id,|s| {
+        let mut wb=s.wb.clone(); wb.resize(words,0);
+        let mut requested=s.inv_requested.clone(); requested.resize(words,0);
+        let mut inv=s.inv.clone(); inv.resize(words,0);
+        Ok(OracleState { receipts:[s.ram_wb_lines.get(),s.ram_inv_lines.get(),s.log_lines,s.read_lines,s.control_lines,2,s.init_control_inv_lines.replace(0),0],words:[s.epoch,s.inv_from,s.inv_to,s.wb_ns,s.log_ns,s.read_ns,s.inv_ns,
+            s.kernel[0],s.kernel[1],s.kernel[2],s.kernel[3],s.kernel[4],s.kernel[5],s.kernel[6],s.kernel[7],s.control_ns],
+            wb,requested,inv })
+    })
+}
+struct Gate { address: usize, _file: File }
+unsafe impl Send for Gate {} // Serialized by the mutex; no reference escapes.
+impl Gate {
+    fn new() -> io::Result<Self> {
+        let base: u64 = std::env::var("FC_POOL_MEMORY_METADATA_OFFSET").map_err(invalid)?.parse().map_err(invalid)?;
+        let file = OpenOptions::new().read(true).write(true).open("/dev/dax0.0")?;
+        // SAFETY: this opt-in experiment reserves +40MiB..+41MiB in a 64MiB metadata extent.
+        let p = unsafe { libc::mmap(std::ptr::null_mut(), GATE_BYTES, libc::PROT_READ | libc::PROT_WRITE,
+            libc::MAP_SHARED, file.as_raw_fd(), (base + 40 * 1024 * 1024) as libc::off_t) };
+        if p == libc::MAP_FAILED { return Err(io::Error::last_os_error()); }
+        Ok(Self { address: p as usize, _file: file })
+    }
+    fn read(&self, word: usize) -> u64 { unsafe { (self.address as *const u64).add(word).read_volatile() } }
+    fn write(&self, word: usize, v: u64) { unsafe { (self.address as *mut u64).add(word).write_volatile(v); } }
+}
+pub(crate) fn boundary(mem: &GuestMemoryMmap, phase: u64, arena: u64, ledger: Option<&Ledger>) -> io::Result<()> {
+    if !enabled() { return Ok(()); }
+    if phase==1 && active() { bulk(mem)?; }
+    if std::env::var("FC_DIRTY_ORACLE").as_deref() != Ok("1") { return Ok(()); }
+    let region = mem.iter().next().ok_or_else(|| invalid("oracle RAM absent"))?;
+    boundary_identity(identity()?,region.len() as usize/4096,region.as_ptr() as u64,phase,arena,ledger)
+}
+fn boundary_identity(id: Identity, pages: usize, hva: u64, phase: u64, arena: u64, ledger: Option<&Ledger>) -> io::Result<()> {
+    if std::env::var("FC_DIRTY_ORACLE").as_deref() != Ok("1") {return Ok(());}
+    let oracle_started=Instant::now();
+    static GATE: OnceLock<Mutex<Option<Gate>>> = OnceLock::new();
+    let mut guard = GATE.get_or_init(|| Mutex::new(None)).lock().unwrap();
+    if guard.is_none() { *guard = Some(Gate::new()?); }
+    let gate = guard.as_ref().unwrap();
+    let words = pages.div_ceil(64);
+    if 256 + words * 8 * 6 > GATE_BYTES-64 { return Err(invalid("oracle bitmap too large")); }
+    let sequence = gate.read(0).checked_add(1).ok_or_else(|| invalid("oracle sequence overflow"))?;
+    let full = full(pages);
+    let empty = vec![0u64; words];
+    let nc=if active() { Some(oracle_state(id,words)?) } else { None };
+    let imported=nc.as_ref().filter(|_|phase==3 || phase==5).map(|s|&s.requested).unwrap_or(&full);
+    let (union, kernel, device) = ledger.map(|l| (&l.union, &l.kvm, &l.device)).unwrap_or((imported, &empty, imported));
+    for (index, bitmap) in [union, kernel, device].iter().enumerate() {
+        // SAFETY: each bitmap is exactly words u64 and the checked gate is exclusively owned.
+        unsafe { std::ptr::copy_nonoverlapping(bitmap.as_ptr(),
+            (gate.address as *mut u8).add((if active() {256} else {128}) + index * words * 8).cast::<u64>(), words); }
+    }
+    if let Some(nc)=&nc {
+        for (i,value) in nc.receipts.iter().enumerate() { gate.write((GATE_BYTES-64)/8+i,*value); }
+        for (i,value) in nc.words.iter().enumerate() { gate.write(16+i,*value); }
+        for (index,bitmap) in [&nc.wb,&nc.requested,&nc.inv].iter().enumerate() {
+            unsafe { std::ptr::copy_nonoverlapping(bitmap.as_ptr(),
+                (gate.address as *mut u8).add(256+(index+3)*words*8).cast::<u64>(),words); }
+        }
+    }
+    gate.write(6,u64::from(active()));
+    gate.write(7,std::env::var("FC_NONCOHERENT_NODE").ok().and_then(|s|s.parse::<u64>().ok()).unwrap_or(0));
+    gate.write(1, phase); gate.write(2, pages as u64); gate.write(3, hva);
+    gate.write(4, arena); gate.write(5, ledger.map_or(0, |l|l.collect_ns));
+    std::sync::atomic::fence(std::sync::atomic::Ordering::SeqCst);
+    gate.write(0, sequence);
+    if active() { lines(gate.address,256+6*words*8,false); lines(gate.address+GATE_BYTES-64,64,false); fence(false); }
+    let start = Instant::now();
+    while gate.read(8) != sequence {
+        if start.elapsed() > Duration::from_secs(120) { return Err(invalid("oracle timeout; remain stopped")); }
+        std::thread::sleep(Duration::from_millis(1));
+    }
+    if gate.read(9) != 1 { return Err(invalid("oracle found missing pages; remain stopped")); }
+    if let Some(l) = ledger {
+        let count = |b: &Vec<u64>| b.iter().map(|w|w.count_ones() as u64).sum::<u64>();
+        crate::logger::info_unrestricted!("DIRTY_LEDGER_JSON {}", serde_json::json!({
+            "sequence":sequence,"pages":count(&l.union),"kvm_pages":count(&l.kvm),
+            "device_pages":count(&l.device),"collect_ns":l.collect_ns,"arena_bytes":arena}));
+        if let Ok(path) = std::env::var("FC_DIRTY_OUTPUT") {
+            let mut file = File::create(format!("{path}-{sequence}.bitmap"))?;
+            for bitmap in [&l.union, &l.kvm, &l.device] { for word in bitmap { file.write_all(&word.to_le_bytes())?; } }
+        }
+    }
