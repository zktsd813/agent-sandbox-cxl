+
+    #[test]
+    fn direct_contract_accepts_only_detached_same_graph_geometry() {
+        let state = valid_state();
+        assert!(validate_state(&state).is_ok());
+        for mutate in [
+            |s: &mut DirectState| s.token.flags = 1,
+            |s: &mut DirectState| s.token.generation = 0,
+            |s: &mut DirectState| s.token.vm_creates = 2,
+            |s: &mut DirectState| s.token.vcpu_creates = 2,
+            |s: &mut DirectState| s.token.ram_hva += 1,
+            |s: &mut DirectState| s.token.ram_hva = u64::MAX - 4095,
+            |s: &mut DirectState| s.token.ram_bytes -= 4096,
+            |s: &mut DirectState| s.memory.regions[0].plugged = vec![false],
+            |s: &mut DirectState| s.machine_config.mem_size_mib = usize::MAX,
+            |s: &mut DirectState| s.machine_config.track_dirty_pages = true,
+            |s: &mut DirectState| s.machine_config.vcpu_count = 2,
+            |s: &mut DirectState| s.devices.acpi_state.vmgenid.addr = u64::MAX,
+            |s: &mut DirectState| s.devices.acpi_state.vmclock.guest_address = u64::MAX,
+        ] {
+            let mut invalid = valid_state();
+            mutate(&mut invalid);
+            assert!(validate_state(&invalid).is_err(), "{invalid:?}");
+        }
+    }
+
+    #[test]
+    fn smp_contract_checks_every_cpu_and_the_fixed_abi() {
+        let mut state = valid_state();
+        state.machine_config.vcpu_count = 2;
+        state.token.vcpu_count = 2;
+        state.token.vcpu_creates = 2;
+        state.token.vcpus[1] = VcpuIdentity { id: 1, reserved: 0, vcpu_offset: 24576,
+            vmcs_offset: 28672, run_offset: 32768, ept_root_offset: 20480 };
+        assert!(validate_state(&state).is_ok());
+        let original = state.token.clone();
+        let mut attached = original.clone(); attached.flags = 1;
+        assert!(attached_identity(&original, &attached));
+        attached.vcpus[1].vmcs_offset += 4096;
+        assert!(!attached_identity(&original, &attached));
+        for mutate in [
+            |t: &mut HandoffToken| t.abi_version = 1,
+            |t: &mut HandoffToken| t.vcpu_count = 1,
+            |t: &mut HandoffToken| t.vcpus[1].id = 0,
+            |t: &mut HandoffToken| t.vcpus[1].reserved = 1,
+            |t: &mut HandoffToken| t.vcpus[1].vmcs_offset = t.vcpus[0].vmcs_offset,
+            |t: &mut HandoffToken| t.vcpus[1].run_offset = 0,
+            |t: &mut HandoffToken| t.vcpus[1].ept_root_offset += 1,
+            |t: &mut HandoffToken| t.vcpus[2].id = 2,
+        ] {
+            state.token = original.clone(); mutate(&mut state.token);
+            assert!(validate_state(&state).is_err());
+        }
+    }
+
+    #[test]
+    fn direct_metadata_has_no_cpu_or_ram_payload() {
+        let value = serde_json::to_value(valid_state()).unwrap();
+        assert!(value.get("vcpu_states").is_none());
+        assert!(value.get("vm_state").is_none());
+        assert!(value.get("ram").is_none());
+        assert!(value.get("devices").is_some());
+        assert!(value.get("memory_manifest_sha256").is_some());
+        let restored: DirectState = serde_json::from_value(value.clone()).unwrap();
+        assert!(validate_state(&restored).is_ok());
+        let mut unknown = value;
+        unknown["vcpu_states"] = serde_json::json!([]);
+        assert!(serde_json::from_value::<DirectState>(unknown).is_err());
+    }
+
+    #[test]
+    fn attach_output_must_keep_identity_and_activate_owner() {
+        let original = valid_state().token;
+        let mut attached = original.clone(); attached.flags = 1;
+        assert!(attached_identity(&original, &attached));
+        assert!(!attached_identity(&original, &original));
+        attached.generation += 1;
+        assert!(!attached_identity(&original, &attached));
+    }
+
+    #[test]
+    fn resident_rejects_replays_and_foreign_graphs() {
+        let first = valid_state().token;
+        let mut next = first.clone(); next.generation += 2;
+        assert!(validate_resident_token(&first, &next).is_ok());
+        assert!(validate_resident_token(&first, &first).is_err());
+        for mutate in [
+            |t: &mut HandoffToken| t.generation = 0,
+            |t: &mut HandoffToken| t.vm_offset += 4096,
+            |t: &mut HandoffToken| t.vcpu_offset += 4096,
+            |t: &mut HandoffToken| t.vmcs_offset += 4096,
+            |t: &mut HandoffToken| t.run_offset += 4096,
+            |t: &mut HandoffToken| t.ram_hva += 4096,
+            |t: &mut HandoffToken| t.ram_bytes += 4096,
+            |t: &mut HandoffToken| t.ept_root_offset += 4096,
+        ] {
+            let mut bad = next.clone(); mutate(&mut bad);
+            assert!(validate_resident_token(&first, &bad).is_err());
+        }
+    }
+
+    #[test]
+    fn private_resident_packet_roundtrip_rejects_old_version_and_truncation() {
+        let state = valid_state();
+        let mapper: crate::pool_memory::Manifest = serde_json::from_value(serde_json::json!({
+            "version":4,"vm_id":"1","run_epoch":"1","pool_path":"unused","phys_base":0,
+            "device_bytes":1<<30,"reserved":[0,0],"generation":1,"faults":0,"exhausted":0,
+            "allocation_generation":1
+        })).unwrap();
+        let bytes = bitcode::serialize(&(3u32, &state.token, &state.devices, &mapper)).unwrap();
+        let packet = decode_resident_packet(&bytes).unwrap();
+        assert_eq!(packet.1, state.token);
+        assert_eq!(serde_json::to_value(packet.3).unwrap(), serde_json::to_value(&mapper).unwrap());
+        for end in 0..bytes.len() { assert!(decode_resident_packet(&bytes[..end]).is_err()); }
+        let old = bitcode::serialize(&(1u32, &state.token, &state.devices, &mapper)).unwrap();
+        assert!(decode_resident_packet(&old).is_err());
+    }
+
+    #[test]
+    #[ignore = "requires a completed disposable VM trial via CXL_RESIDENT_TRIAL"]
+    fn resident_binary_evidence_matches_wire_and_rejects_truncation() {
+        let path = std::path::PathBuf::from(std::env::var_os("CXL_RESIDENT_TRIAL").expect("trial report"));
+        let report: serde_json::Value = serde_json::from_slice(&std::fs::read(&path).unwrap()).unwrap();
+        assert_eq!(report["result"], "passed");
+        let root = path.parent().unwrap();
+        let mut checked = 0;
+        for hop in report["hops"].as_array().unwrap() {
+            let Some(packet_path) = hop["packet_file"].as_str() else { continue; };
+            let bytes = std::fs::read(root.join(packet_path)).unwrap();
+            let (_, token, devices, mapper) = decode_resident_packet(&bytes).unwrap();
+            let state: DirectState = serde_json::from_slice(&std::fs::read(root.join(hop["state_file"].as_str().unwrap())).unwrap()).unwrap();
+            let expected: serde_json::Value = serde_json::from_slice(&std::fs::read(root.join(hop["sealed_file"].as_str().unwrap())).unwrap()).unwrap();
+            assert_eq!(token, state.token);
+            assert_eq!(serde_json::to_value(devices).unwrap(), serde_json::to_value(state.devices).unwrap());
+            assert_eq!(serde_json::to_value(mapper).unwrap(), expected);
+            for end in 0..bytes.len() { assert!(decode_resident_packet(&bytes[..end]).is_err(), "accepted truncated packet {end}"); }
+            let mut trailing = bytes; trailing.push(0);
+            assert!(decode_resident_packet(&trailing).is_err());
+            checked += 1;
+        }
+        assert!(checked >= 3, "insufficient binary handoffs");
+    }
+
+    #[test]
+    fn direct_manifest_digest_is_content_bound() {
+        assert_eq!(
+            sha256(b"abc"),
+            "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
+        );
+        assert_ne!(
+            sha256(b"mapping generation 1"),
+            sha256(b"mapping generation 2")
+        );
+        assert_eq!(std::mem::size_of::<HandoffToken>(), 464);
+    }
