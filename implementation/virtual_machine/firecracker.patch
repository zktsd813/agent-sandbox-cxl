+// SPDX-License-Identifier: Apache-2.0
+//! Guest-authorized pooling and persistent CXL logical RAM. Control plans are
+//! private, trusted controller files. Only the kernel-owned ACTIVE registration
+//! grants permission to replace a current lower file page without comparing its
+//! bytes. The CXL mapper performs CPU and device-write CoW into private CXL.
+use std::collections::{BTreeMap, BTreeSet};
+use std::fs::{File, OpenOptions};
+use std::io::{self, BufReader, BufWriter, Write};
+use std::os::fd::AsRawFd;
+use std::path::Path;
+use std::sync::{Arc, Mutex, OnceLock};
+
+use crate::vstate::memory::{GuestMemoryMmap, GuestRegionMmap, MemoryError};
+use serde::{Deserialize, Serialize};
+use vm_memory::{Address, Bytes, FileOffset, GuestAddress, GuestMemoryBackend, GuestMemoryRegion};
+
+const PAGE: u64 = 4096;
+const MAX_PAGES: usize = 1 << 20;
+const SHARED: u64 = 1;
+fn invalid(s: impl Into<String>) -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidInput, s.into())
+}
+fn env(s: &str) -> io::Result<String> {
+    std::env::var(s).map_err(|_| invalid(format!("{s} required")))
+}
+fn read_json<T: serde::de::DeserializeOwned>(path: &str) -> io::Result<T> {
+    let file = File::open(path)?;
+    if file.metadata()?.len() > 256 * 1024 * 1024 {
+        return Err(invalid("pool metadata too large"));
+    }
+    serde_json::from_reader(BufReader::with_capacity(65536, file)).map_err(io::Error::other)
+}
+fn write_json<T: Serialize>(path: &str, value: &T) -> io::Result<()> {
+    let temporary = format!("{path}.new");
+    let mut file = BufWriter::with_capacity(65536, File::create(&temporary)?);
+    serde_json::to_writer(&mut file, value)?;
+    file.flush()?;
+    std::fs::rename(temporary, path)
+}
+fn digest(bytes: &[u8]) -> [u8; 32] {
+    aws_lc_rs::digest::digest(&aws_lc_rs::digest::SHA256, bytes)
+        .as_ref()
+        .try_into()
+        .unwrap()
+}
+fn unhex<const N: usize>(s: &str) -> io::Result<[u8; N]> {
+    if s.len() != N * 2 || !s.is_ascii() {
+        return Err(invalid("invalid hexadecimal length"));
+    }
+    let mut out = [0; N];
+    for (i, b) in out.iter_mut().enumerate() {
+        *b = u8::from_str_radix(&s[2 * i..2 * i + 2], 16)
+            .map_err(|_| invalid("invalid hexadecimal value"))?;
+    }
+    Ok(out)
+}
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default)]
+struct Entry {
+    offset: u64,
+    flags: u64,
+}
+#[repr(C)]
+struct Config {
+    abi: u64,
+    phys_base: u64,
+    device_bytes: u64,
+    canonical_start: u64,
+    canonical_bytes: u64,
+    count: u64,
+    entries: u64,
+    credit_count: u64,
+    credits: u64,
+}
+#[repr(C)]
+#[derive(Debug, Default)]
+struct Query {
+    count: u64,
+    entries: u64,
+    credit_count: u64,
+    credits: u64,
+    generation: u64,
+    cow_pages: u64,
+    discard_pages: u64,
+    faults: u64,
+    exhausted: u64,
+}
+#[repr(C)]
+struct Range {
+    address: u64,
+    first: u64,
+    count: u64,
+}
+#[repr(C)]
+struct Credits {
+    count: u64,
+    offsets: u64,
