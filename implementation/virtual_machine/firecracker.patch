+#[cfg(all(test, target_arch = "x86_64"))]
+mod tests {
+
+    use super::*;
+
+    #[test]
+    fn resident_control_reassembles_fragments_and_rejects_oversized_frames() {
+        let directory = vmm_sys_util::tempdir::TempDir::new().unwrap();
+        let path = directory.as_path().join("resident.sock");
+        let listener = UnixListener::bind(&path).unwrap();
+        listener.set_nonblocking(true).unwrap();
+        let control = Arc::new(Mutex::new(ResidentControl {
+            listener, stream: None, request: None, input: Vec::new(),
+        }));
+        let mut events = EventManager::new().unwrap();
+        events.add_subscriber(control.clone());
+        let mut client = UnixStream::connect(path).unwrap();
+        events.run_with_timeout(100).unwrap();
+        client.write_all(&[10, 3]).unwrap();
+        events.run_with_timeout(100).unwrap();
+        assert!(control.lock().unwrap().request.is_none());
+        client.write_all(&[0, 0, 0, b'x', b'y']).unwrap();
+        events.run_with_timeout(100).unwrap();
+        assert!(control.lock().unwrap().request.is_none());
+        client.write_all(b"z").unwrap();
+        events.run_with_timeout(100).unwrap();
+        assert_eq!(control.lock().unwrap().request.take(), Some((10, b"xyz".to_vec())));
+        client.write_all(&[10, 0, 0, 1, 0]).unwrap(); // 65536 exceeds the bound.
+        events.run_with_timeout(100).unwrap();
+        assert!(control.lock().unwrap().stream.is_none());
+        assert!(control.lock().unwrap().request.is_none());
+    }
+
+
+}
