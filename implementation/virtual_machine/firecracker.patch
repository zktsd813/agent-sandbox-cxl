+impl RestoreTiming {
+    pub(crate) fn new(scope: &'static str) -> Self {
+        let start = (std::env::var("FC_RESTORE_TIMING").as_deref() == Ok("1")).then(Instant::now);
+        Self {
+            scope,
+            start,
+            last: start,
+            stages: Vec::new(),
+        }
+    }
+
+    pub(crate) fn mark(&mut self, stage: &'static str) {
+        if let Some(last) = self.last {
+            let now = Instant::now();
+            self.stages
+                .push((stage, now.duration_since(last).as_secs_f64() * 1e6));
+            self.last = Some(now);
+        }
+    }
+
+    pub(crate) fn finish(self) {
+        if let Some(start) = self.start {
+            let total_us = start.elapsed().as_secs_f64() * 1e6;
+            let stages_us: serde_json::Map<String, serde_json::Value> = self
+                .stages
+                .into_iter()
+                .map(|(name, us)| (name.to_owned(), serde_json::json!(us)))
+                .collect();
+            crate::logger::info_unrestricted!(
+                "RESTORE_TIMING {}",
+                serde_json::json!({
+                    "scope": self.scope, "total_us": total_us, "stages_us": stages_us,
+                })
+            );
+        }
+    }
