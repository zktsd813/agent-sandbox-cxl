+fn registration_bytes(r: &Registration) -> io::Result<Vec<u8>> {
+    if r.files.is_empty() || r.files.len() > 16 || r.records.len() > 65536 {
+        return Err(invalid("registration bounds"));
+    }
+    let mut b = b"GPOOL_RECORDS_V1".to_vec();
+    b.extend(1u32.to_le_bytes());
+    b.extend((r.files.len() as u32).to_le_bytes());
+    for n in [
+        r.records.len() as u64,
+        r.session_cookie,
+        r.vm_epoch,
+        r.plan_generation,
+    ] {
+        b.extend(n.to_le_bytes());
+    }
+    b.extend(unhex::<32>(&r.image_id)?);
+    for (slot, f) in r.files.iter().enumerate() {
+        if f.file_slot as usize != slot {
+            return Err(invalid("registration file order"));
+        }
+        for n in [f.inode, f.file_bytes, f.start_page, f.page_count] {
+            b.extend(n.to_le_bytes());
+        }
+        b.extend(f.inode_generation.to_le_bytes());
+        b.extend(f.file_slot.to_le_bytes());
+        b.extend(unhex::<16>(&f.fs_uuid)?);
+        b.extend(f.dev_major.to_le_bytes());
+        b.extend(f.dev_minor.to_le_bytes());
+    }
+    let mut gpas = BTreeSet::new();
+    let mut last = None;
+    for p in &r.records {
+        let f = r
+            .files
+            .get(p.file_slot as usize)
+            .ok_or_else(|| invalid("record file slot"))?;
+        if p.flags != 63
+            || p.gpa % PAGE != 0
+            || p.disk_offset % PAGE != 0
+            || !gpas.insert(p.gpa)
+            || p.file_page < f.start_page
+            || p.file_page - f.start_page >= f.page_count
+            || p.file_page >= f.file_bytes / PAGE
+            || last.is_some_and(|x| x >= (p.file_slot, p.file_page))
+        {
+            return Err(invalid("invalid guest registration record"));
+        }
+        last = Some((p.file_slot, p.file_page));
+        b.extend(p.file_slot.to_le_bytes());
+        b.extend(p.flags.to_le_bytes());
+        for n in [p.file_page, p.gpa, p.disk_offset] {
+            b.extend(n.to_le_bytes());
+        }
+    }
+    Ok(b)
+}
+
+fn validate_registration(mem: &GuestMemoryMmap, plan: &Plan) -> io::Result<[u8; 208]> {
+    validate_registration_for_image(mem, plan, &env("FC_POOL_IMAGE_ID")?)
+}
+fn validate_registration_for_image(
+    mem: &GuestMemoryMmap,
+    plan: &Plan,
+    image: &str,
+) -> io::Result<[u8; 208]> {
+    let r = plan
+        .registration
+        .as_ref()
+        .ok_or_else(|| invalid("promotion requires current guest registration"))?;
+    if r.image_id != image
+        || r.vm_epoch.to_string() != plan.run_epoch
+        || r.status_gpa % PAGE != 0
+        || r.session_cookie == 0
+    {
+        return Err(invalid("registration identity/epoch"));
+    }
+    let bytes = registration_bytes(r)?;
+    let mut status = [0u8; 208];
+    mem.read_slice(&mut status, GuestAddress(r.status_gpa))
+        .map_err(io::Error::other)?;
+    let u64_at = |i| u64::from_le_bytes(status[i..i + 8].try_into().unwrap());
+    let u32_at = |i| u32::from_le_bytes(status[i..i + 4].try_into().unwrap());
+    if u64_at(0) != 0x47504f4f4c535431
+        || u32_at(8) != 2
+        || u32_at(12) != 1
+        || u64_at(16) != r.session_cookie
+        || u64_at(24) != r.vm_epoch
+        || u64_at(32) != r.plan_generation
+        || u64_at(40) != r.records.len() as u64
+        || u32_at(48) != r.files.len() as u32
+        || u32_at(52) != 32
+        || status[56..88] != unhex::<32>(&r.image_id)?
+        || status[88..120] != digest(&bytes)
+        || status[144..].iter().any(|x| *x != 0)
+    {
+        return Err(invalid(
+            "guest registration no longer ACTIVE or digest mismatch",
+        ));
+    }
+    let by_gpa: BTreeMap<_, _> = r.records.iter().map(|x| (x.gpa, x.disk_offset)).collect();
+    for p in plan.mappings.iter().filter(|p| p.shared) {
+        if p.gpa == r.status_gpa
+            || by_gpa
+                .get(&p.gpa)
+                .and_then(|o| plan.canonical_start.checked_add(*o))
+                != Some(p.offset)
+        {
+            return Err(invalid("shared mapping lacks registered lower page"));
+        }
+    }
+    Ok(status)
+}
+
+fn geometry(mem: &GuestMemoryMmap) -> Vec<(GuestAddress, usize)> {
+    mem.iter()
+        .map(|r| (r.start_addr(), r.len() as usize))
+        .collect()
+}
+fn validate_geometry(m: &Manifest, regions: &[(GuestAddress, usize)]) -> io::Result<()> {
+    if regions.len() != 1 {
+        return Err(invalid(
+            "pool mapper v1 requires one contiguous logical RAM region",
+        ));
+    }
+    if m.version != 1 || m.mappings.len() > MAX_PAGES || m.credits.len() > MAX_PAGES {
+        return Err(invalid("manifest version/size"));
+    }
+    let mut expected = Vec::new();
+    for (base, size) in regions {
+        if size % PAGE as usize != 0 {
+            return Err(invalid("unaligned RAM region"));
+        }
+        expected.extend(
+            (0..*size as u64)
+                .step_by(PAGE as usize)
+                .map(|n| base.raw_value() + n),
+        );
+    }
+    if expected.len() != m.mappings.len()
+        || expected.iter().zip(&m.mappings).any(|(g, p)| *g != p.gpa)
+    {
+        return Err(invalid("manifest does not cover exact RAM geometry"));
+    }
+    Ok(())
+}
+fn dax_geometry(path: &str) -> io::Result<(u64, u64)> {
+    let name = Path::new(path)
+        .file_name()
+        .and_then(|s| s.to_str())
+        .ok_or_else(|| invalid("DAX name"))?;
+    if !name.starts_with("dax") || !name[3..].chars().all(|c| c.is_ascii_digit() || c == '.') {
+        return Err(invalid("DAX path required"));
+    }
+    let base = format!("/sys/bus/dax/devices/{name}");
+    let parse = |p: &str| -> io::Result<u64> {
+        let text = std::fs::read_to_string(p)?;
+        let t = text.trim();
+        if let Some(h) = t.strip_prefix("0x") {
+            u64::from_str_radix(h, 16)
+        } else {
+            t.parse()
+        }
+        .map_err(io::Error::other)
+    };
+    if parse(&format!("{base}/align"))? != PAGE {
+        return Err(invalid("pool requires 4K DAX"));
+    }
+    Ok((
+        parse(&format!("{base}/resource"))?,
+        parse(&format!("{base}/size"))?,
+    ))
+}
+fn configure(m: &Manifest) -> io::Result<Arc<File>> {
+    if dax_geometry(&m.pool_path)? != (m.phys_base, m.device_bytes) {
+        return Err(invalid("DAX physical geometry changed"));
+    }
+    let file =
+        Arc::new(OpenOptions::new().read(true).write(true).open(
+            std::env::var("FC_POOL_MEMORY_DEVICE").unwrap_or_else(|_| "/dev/cxl_pool".into()),
+        )?);
+    let entries: Vec<_> = m
+        .mappings
+        .iter()
+        .map(|p| Entry {
+            offset: p.offset,
+            flags: if p.shared { SHARED } else { 0 },
+        })
+        .collect();
+    let mut config = Config {
+        abi: 1,
+        phys_base: m.phys_base,
+        device_bytes: m.device_bytes,
+        canonical_start: m.canonical_start,
+        canonical_bytes: m.canonical_bytes,
+        count: entries.len() as u64,
+        entries: entries.as_ptr() as u64,
+        credit_count: m.credits.len() as u64,
+        credits: m.credits.as_ptr() as u64,
+    };
+    ioctl(&file, 0x70, false, &mut config)?;
+    Ok(file)
+}
+fn query(a: &mut Active) -> io::Result<()> {
+    let mut entries = vec![Entry::default(); a.manifest.mappings.len()];
+    let mut credits = vec![0u64; MAX_PAGES];
+    let mut q = Query {
+        count: entries.len() as u64,
+        entries: entries.as_mut_ptr() as u64,
+        credit_count: credits.len() as u64,
+        credits: credits.as_mut_ptr() as u64,
+        ..Default::default()
+    };
+    ioctl(&a.file, 0x71, true, &mut q)?;
+    for (p, e) in a.manifest.mappings.iter_mut().zip(entries) {
+        p.offset = e.offset;
+        p.shared = e.flags & SHARED != 0;
+    }
+    credits.truncate(q.credit_count as usize);
+    a.manifest.credits = credits;
+    a.manifest.generation = q.generation;
+    a.manifest.cow_pages = q.cow_pages;
+    a.manifest.discard_pages = q.discard_pages;
+    a.manifest.faults = q.faults;
+    a.manifest.exhausted = q.exhausted;
+    Ok(())
+}
