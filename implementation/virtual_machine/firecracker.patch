+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct PlanPage {
+    gpa: u64,
+    image_id: String,
+    image_offset: u64,
+    pool_offset: u64,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Plan {
+    vm_id: String,
+    run_epoch: String,
+    pool_path: String,
+    pages: Vec<PlanPage>,
+}
+
+#[derive(Debug, Serialize)]
+struct MappedPage {
+    gpa: u64,
+    pool_offset: u64,
+    hva: u64,
+}
+
+#[derive(Debug, Default, Serialize)]
+struct Report {
+    version: u32,
+    vm_id: String,
+    run_epoch: String,
+    requested: usize,
+    mapped: usize,
+    rejected_hint: usize,
+    rejected_content: usize,
+    mapped_bytes: usize,
+    mapped_gpas: Vec<u64>,
+    mapped_pages: Vec<MappedPage>,
+}
+
+/// A temporary read-only view of canonical CXL bytes. Drop does not release the
+/// controller's frame pin; the prototype freezes all published frames forever.
+struct View(*mut libc::c_void);
+impl Drop for View {
+    fn drop(&mut self) {
+        // SAFETY: this object owns exactly one page-long mmap.
+        unsafe {
+            libc::munmap(self.0, PAGE);
+        }
+    }
+}
+
+fn view(file: &File, offset: u64) -> io::Result<View> {
+    let offset = libc::off_t::try_from(offset).map_err(|_| invalid("pool offset overflow"))?;
+    // SAFETY: a fresh read-only page mapping; file and bounds were validated.
+    let ptr = unsafe {
+        libc::mmap(
+            std::ptr::null_mut(),
+            PAGE,
+            libc::PROT_READ,
+            libc::MAP_SHARED,
+            file.as_raw_fd(),
+            offset,
+        )
+    };
+    if ptr == libc::MAP_FAILED {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(View(ptr))
+}
+
+fn key_matches(hint: Option<&Hint>, p: &PlanPage) -> bool {
+    hint.is_some_and(|h| h.image_id == p.image_id && h.image_offset == p.image_offset)
+}
+
+/// Caller guarantees a paused VM, a drained device manager, and no concurrent
+/// host writes. mmap's MMU notifier invalidates KVM translations before return.
+pub(crate) fn apply(mem: &GuestMemoryMmap) -> io::Result<()> {
+    if crate::pool_memory::enabled() {
+        return crate::pool_memory::apply(mem);
+    }
+    dump_hints()?;
+    let plan: Plan = serde_json::from_reader(BufReader::with_capacity(
+        JSON_BUFFER,
+        File::open(required("FC_POOL_PLAN")?)?,
+    ))?;
+    let vm_id = required("FC_POOL_VM_ID")?;
+    let epoch = required("FC_POOL_RUN_EPOCH")?;
+    if plan.vm_id != vm_id || plan.run_epoch != epoch {
+        return Err(invalid("pool plan VM identity/run epoch mismatch"));
+    }
+    let mut report = Report {
+        version: 1,
+        vm_id,
+        run_epoch: epoch,
+        requested: plan.pages.len(),
+        ..Report::default()
+    };
+    if !plan.pages.is_empty() {
+        if std::fs::read_to_string("/sys/module/device_dax/parameters/pool_cow")?.trim() != "Y" {
+            return Err(invalid("lab devDAX pool CoW support is not enabled"));
+        }
+        let image_id = required("FC_POOL_IMAGE_ID")?;
+        if !valid_identity(&image_id) {
+            return Err(invalid("invalid immutable image identity"));
+        }
+        let file = OpenOptions::new().read(true).open(&plan.pool_path)?;
+        if !file.metadata()?.file_type().is_char_device() {
+            return Err(invalid("pool backing must be a devDAX character device"));
+        }
+        let name = std::path::Path::new(&plan.pool_path)
+            .file_name()
+            .and_then(|s| s.to_str())
+            .ok_or_else(|| invalid("invalid pool path"))?;
+        if !name.starts_with("dax") || !name[3..].chars().all(|c| c.is_ascii_digit() || c == '.') {
+            return Err(invalid("pool backing must be /dev/daxX.Y"));
+        }
+        let attribute = |attr: &str| -> io::Result<u64> {
+            std::fs::read_to_string(format!("/sys/bus/dax/devices/{name}/{attr}"))?
+                .trim()
+                .parse()
+                .map_err(|_| invalid("invalid devDAX attribute"))
+        };
+        if attribute("align")? != PAGE as u64 {
+            return Err(invalid("pool requires 4 KiB devDAX alignment"));
+        }
+        let capacity = attribute("size")?;
+        let dev = std::fs::read_to_string(format!("/sys/bus/dax/devices/{name}/dev"))?;
+        let (major, minor) = dev
+            .trim()
+            .split_once(':')
+            .ok_or_else(|| invalid("invalid devDAX device number"))?;
+        let major: u32 = major.parse().map_err(|_| invalid("invalid devDAX major"))?;
+        let minor: u32 = minor.parse().map_err(|_| invalid("invalid devDAX minor"))?;
+        let rdev = file.metadata()?.rdev();
+        if rdev != libc::makedev(major, minor) {
+            return Err(invalid(
+                "opened pool backing does not match devDAX sysfs identity",
+            ));
+        }
+        let pool_base: u64 = required("FC_POOL_OFFSET")?
+            .parse()
+            .map_err(|_| invalid("invalid FC_POOL_OFFSET"))?;
+        let pool_size: u64 = required("FC_POOL_BYTES")?
+            .parse()
+            .map_err(|_| invalid("invalid FC_POOL_BYTES"))?;
+        let pool_end = pool_base
+            .checked_add(pool_size)
+            .ok_or_else(|| invalid("pool allocation overflow"))?;
+        if pool_base % PAGE as u64 != 0
+            || pool_size == 0
+            || pool_size % PAGE as u64 != 0
+            || pool_end > capacity
+        {
+            return Err(invalid("invalid frozen pool allocation bounds"));
+        }
+        for region in mem.iter() {
+            if let Some(backing) = region.file_offset() {
+                let metadata = backing.file().metadata()?;
+                if metadata.file_type().is_char_device() && metadata.rdev() == rdev {
+                    let ram_end = backing
+                        .start()
+                        .checked_add(region.len())
+                        .ok_or_else(|| invalid("RAM allocation overflow"))?;
+                    if pool_base < ram_end && backing.start() < pool_end {
+                        return Err(invalid(
+                            "frozen pool allocation overlaps this VM's mutable RAM reservation",
+                        ));
+                    }
+                }
+            }
+        }
+        let mut unique = BTreeSet::new();
+        // Complete structural preflight before replacing any mapping.
+        for p in &plan.pages {
+            if p.gpa % PAGE as u64 != 0
+                || p.image_offset % PAGE as u64 != 0
+                || p.pool_offset % PAGE as u64 != 0
+                || p.image_id != image_id
+                || p.pool_offset < pool_base
+                || p.pool_offset
+                    .checked_add(PAGE as u64)
+                    .is_none_or(|end| end > pool_end)
+                || !unique.insert(p.gpa)
+            {
+                return Err(invalid(
+                    "unaligned, duplicate, out-of-range or wrong-image pool page",
+                ));
+            }
+            mem.get_slice(GuestAddress(p.gpa), PAGE)
+                .map_err(|e| invalid(e.to_string()))?;
+        }
+        let mut s = state().lock().expect("pool state poisoned");
+        if let Some(error) = &s.restore_error {
+            return Err(invalid(error));
+        }
+        for p in plan.pages {
+            if !key_matches(s.hints.get(&p.gpa), &p) {
+                report.rejected_hint += 1;
+                continue;
+            }
+            let canonical = view(&file, p.pool_offset)?;
+            let mut current = [0u8; PAGE];
+            mem.read_slice(&mut current, GuestAddress(p.gpa))
+                .map_err(|e| invalid(e.to_string()))?;
+            // SAFETY: canonical is a valid immutable read-only page until dropped.
+            let expected = unsafe { std::slice::from_raw_parts(canonical.0.cast::<u8>(), PAGE) };
+            if current != expected {
+                report.rejected_content += 1;
+                continue;
+            }
+            let destination = mem
+                .get_host_address(GuestAddress(p.gpa))
+                .map_err(|e| invalid(e.to_string()))?;
+            // SAFETY: the whole destination page belongs to paused guest RAM;
+            // all I/O has drained, contents match exactly, and the pool remains
+            // immutable. Kernel private CoW covers later CPU and host writes.
+            s.mapping_failed = true; // MAP_FIXED may unmap before a later failure.
+            let ptr = unsafe {
+                libc::mmap(
+                    destination.cast(),
+                    PAGE,
+                    libc::PROT_READ | libc::PROT_WRITE,
+                    libc::MAP_PRIVATE | libc::MAP_FIXED,
+                    file.as_raw_fd(),
+                    p.pool_offset as libc::off_t,
+                )
+            };
+            if ptr == libc::MAP_FAILED {
+                return Err(io::Error::last_os_error());
+            }
+            s.mapping_failed = false;
+            s.overlays = true;
+            s.pooled_gpas.insert(p.gpa);
+            report.mapped += 1;
+            report.mapped_bytes += PAGE;
+            report.mapped_gpas.push(p.gpa);
+            report.mapped_pages.push(MappedPage {
+                gpa: p.gpa,
+                pool_offset: p.pool_offset,
+                hva: destination as u64,
+            });
+        }
+    }
+    let mut writer =
+        BufWriter::with_capacity(JSON_BUFFER, File::create(required("FC_POOL_REPORT")?)?);
+    serde_json::to_writer(&mut writer, &report)?;
+    writer.flush()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn candidate_key_is_not_just_gpa() {
+        let h = Hint {
+            gpa: 4096,
+            image_id: "a".repeat(64),
+            image_offset: 8192,
+            sequence: 7,
+        };
+        let mut p = PlanPage {
+            gpa: 4096,
+            image_id: "a".repeat(64),
+            image_offset: 8192,
+            pool_offset: 0,
+        };
+        assert!(key_matches(Some(&h), &p));
+        p.image_offset += 4096;
+        assert!(!key_matches(Some(&h), &p));
+        p.image_offset = 8192;
+        p.image_id = "b".repeat(64);
+        assert!(!key_matches(Some(&h), &p));
+        assert!(!key_matches(None, &p));
+    }
