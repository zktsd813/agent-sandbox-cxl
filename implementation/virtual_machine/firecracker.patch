+        }
+        let control = unsafe { &*(base as *const Control) };
+        if (pointer as usize) < base || pointer as usize - base >= control.length {
+            unsafe {
+                System.dealloc(pointer, layout);
+            }
+            return;
+        }
+        // SAFETY: GlobalAlloc requires a live pointer previously returned by alloc.
+        let header = unsafe { ptr::read(pointer.sub(size_of::<Header>()) as *const Header) };
+        Self::lock(control);
+        let mut previous = 0;
+        let mut current = control.head.load(Ordering::Relaxed);
+        while current != 0 && current < header.start {
+            previous = current;
+            current = unsafe { (*((base + current) as *const FreeBlock)).next };
+        }
+        let block = (base + header.start) as *mut FreeBlock;
+        unsafe {
+            ptr::write(
+                block,
+                FreeBlock {
+                    bytes: header.bytes,
+                    next: current,
+                },
+            );
+            if current != 0 && header.start + (*block).bytes == current {
+                let following = &*((base + current) as *const FreeBlock);
+                (*block).bytes += following.bytes;
+                (*block).next = following.next;
+            }
+            if previous == 0 {
+                control.head.store(header.start, Ordering::Relaxed);
+            } else {
+                let preceding = &mut *((base + previous) as *mut FreeBlock);
+                if previous + preceding.bytes == header.start {
+                    preceding.bytes += (*block).bytes;
+                    preceding.next = (*block).next;
+                } else {
+                    preceding.next = header.start;
+                }
+            }
+        }
+        control.frees.fetch_add(1, Ordering::Relaxed);
+        control
+            .live_bytes
+            .fetch_sub(header.bytes, Ordering::Relaxed);
+        control.lock.store(false, Ordering::Release);
+    }
+}
+
+pub fn init() -> io::Result<()> {
+    let Some(path) = std::env::var_os("FC_DAX_HEAP") else {
+        return Ok(());
+    };
+    let invalid = || io::Error::new(io::ErrorKind::InvalidInput, "invalid DAX heap allocation");
+    let offset: usize = std::env::var("FC_DAX_HEAP_OFFSET")
+        .unwrap_or_else(|_| "536870912".into())
+        .parse()
+        .map_err(|_| invalid())?;
+    let length: usize = std::env::var("FC_DAX_HEAP_BYTES")
+        .unwrap_or_else(|_| "67108864".into())
+        .parse()
+        .map_err(|_| invalid())?;
+    let path = std::path::Path::new(&path);
+    let name = path
+        .file_name()
+        .and_then(|v| v.to_str())
+        .ok_or_else(invalid)?;
+    let file = OpenOptions::new().read(true).write(true).open(path)?;
+    if !file.metadata()?.file_type().is_char_device() {
+        return Err(invalid());
+    }
+    let attr = |name_attr| -> io::Result<usize> {
+        std::fs::read_to_string(format!("/sys/bus/dax/devices/{name}/{name_attr}"))?
+            .trim()
+            .parse()
+            .map_err(|_| invalid())
+    };
+    let align = attr("align")?;
+    if !align.is_power_of_two()
+        || offset % align != 0
+        || length % align != 0
+        || length <= CONTROL_BYTES
+        || offset.checked_add(length).ok_or_else(invalid)? > attr("size")?
+    {
+        return Err(invalid());
+    }
+    let mapped = unsafe {
+        libc::mmap(
+            ptr::null_mut(),
+            length,
+            libc::PROT_READ | libc::PROT_WRITE,
+            libc::MAP_SHARED,
+            file.as_raw_fd(),
+            offset as libc::off_t,
+        )
+    };
+    if mapped == libc::MAP_FAILED {
+        return Err(io::Error::last_os_error());
+    }
+    // Cold boot only: initialize this exclusively reserved heap allocation.
+    unsafe {
+        HEAP.attach(mapped as usize, length);
+    }
+    eprintln!(
+        "DAX_HEAP path={} offset={} bytes={} base={:#x}",
+        path.display(),
+        offset,
+        length,
+        mapped as usize
+    );
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn alignment_reuse_coalescing_and_no_fallback() {
+        let length = 128 * 1024;
+        let base = unsafe {
+            libc::mmap(
+                ptr::null_mut(),
+                length,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_PRIVATE | libc::MAP_ANONYMOUS,
+                -1,
+                0,
+            )
+        };
+        assert_ne!(base, libc::MAP_FAILED);
+        let heap = DaxHeap {
+            base: AtomicUsize::new(0),
+        };
+        unsafe {
+            heap.attach(base as usize, length);
+        }
+        let mut allocations = Vec::new();
+        for align in [1, 8, 64, 4096] {
+            let layout = Layout::from_size_align(1003, align).unwrap();
+            let pointer = unsafe { heap.alloc(layout) };
+            assert!(!pointer.is_null());
+            assert_eq!(pointer as usize % align, 0);
+            unsafe {
+                ptr::write_bytes(pointer, 0x5a, layout.size());
+            }
+            allocations.push((pointer, layout));
+        }
+        for (pointer, layout) in allocations.into_iter().rev() {
+            assert!(
+                unsafe { std::slice::from_raw_parts(pointer, layout.size()) }
+                    .iter()
+                    .all(|v| *v == 0x5a)
+            );
+            unsafe {
+                heap.dealloc(pointer, layout);
+            }
+        }
+        let control = unsafe { &*(base as *const Control) };
+        assert_eq!(control.live_bytes.load(Ordering::Relaxed), 0);
+        let free = unsafe { &*((base as usize + CONTROL_BYTES) as *const FreeBlock) };
+        assert_eq!(free.bytes, length - CONTROL_BYTES);
+        assert_eq!(free.next, 0);
+        assert!(unsafe { heap.alloc(Layout::from_size_align(length, 8).unwrap()) }.is_null());
+        std::thread::scope(|scope| {
+            for worker in 0..4usize {
+                let heap = &heap;
+                scope.spawn(move || {
+                    let mut seed = worker + 1;
+                    let mut live = Vec::new();
+                    for _ in 0..1000 {
+                        seed = seed.wrapping_mul(1664525).wrapping_add(1013904223);
+                        if !live.is_empty() && (seed & 3 == 0 || live.len() > 12) {
+                            let index = seed % live.len();
+                            let (pointer, layout): (*mut u8, Layout) = live.swap_remove(index);
+                            assert!(
+                                unsafe { std::slice::from_raw_parts(pointer, layout.size()) }
+                                    .iter()
+                                    .all(|byte| *byte == worker as u8)
+                            );
+                            unsafe {
+                                heap.dealloc(pointer, layout);
+                            }
+                        } else {
+                            let layout =
+                                Layout::from_size_align(1 + seed % 1024, 1 << (seed % 10)).unwrap();
+                            let pointer = unsafe { heap.alloc(layout) };
+                            if !pointer.is_null() {
+                                assert_eq!(pointer as usize % layout.align(), 0);
+                                unsafe {
+                                    ptr::write_bytes(pointer, worker as u8, layout.size());
+                                }
+                                live.push((pointer, layout));
+                            }
+                        }
+                    }
+                    for (pointer, layout) in live {
+                        unsafe {
+                            heap.dealloc(pointer, layout);
+                        }
+                    }
+                });
+            }
+        });
+        assert_eq!(control.live_bytes.load(Ordering::Relaxed), 0);
+        assert_eq!(
+            control.allocs.load(Ordering::Relaxed),
+            control.frees.load(Ordering::Relaxed)
+        );
+        assert_eq!(
+            unsafe { (*((base as usize + CONTROL_BYTES) as *const FreeBlock)).bytes },
+            length - CONTROL_BYTES
+        );
+        unsafe {
+            libc::munmap(base, length);
+        }
+    }
+}
