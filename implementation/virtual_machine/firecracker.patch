+    pool_path: String,
+    phys_base: u64,
+    device_bytes: u64,
+    reserved: [u64; 2],
+    #[serde(default)]
+    mappings: Vec<Mapping>,
+    #[serde(default)]
+    handle: Option<Handle>,
+    generation: u64,
+    faults: u64,
+    exhausted: u64,
+    allocation_generation: u64,
+    #[serde(default)]
+    state_sha256: Option<String>,
+}
+struct Active {
+    file: Arc<File>,
+    manifest: Manifest,
+}
+static MAPPING_FAILED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+pub(crate) fn mapping_failed() -> bool {
+    MAPPING_FAILED.load(std::sync::atomic::Ordering::Acquire)
+}
+fn set_mapping_failed(value: bool) {
+    MAPPING_FAILED.store(value, std::sync::atomic::Ordering::Release);
+}
+fn state() -> &'static Mutex<Option<Active>> {
+    static STATE: OnceLock<Mutex<Option<Active>>> = OnceLock::new();
+    STATE.get_or_init(|| Mutex::new(None))
+}
+pub(crate) fn enabled() -> bool {
+    std::env::var("FC_POOL_MEMORY").as_deref() == Ok("1")
+}
+pub(crate) fn active() -> bool {
+    state().lock().unwrap().is_some()
+}
+pub(crate) fn backing_matches(path: &Path) -> bool {
+    state()
+        .lock()
+        .unwrap()
+        .as_ref()
+        .is_some_and(|a| Path::new(&a.manifest.pool_path) == path)
+}
+
+fn geometry(mem: &GuestMemoryMmap) -> Vec<(GuestAddress, usize)> {
+    mem.iter()
+        .map(|r| (r.start_addr(), r.len() as usize))
+        .collect()
+}
+fn validate_geometry(m: &Manifest, regions: &[(GuestAddress, usize)]) -> io::Result<()> {
+    if regions.len() != 1 {
+        return Err(invalid(
+            "private mapper requires one contiguous logical RAM region",
+        ));
+    }
+    if m.version != 4 || m.mappings.len() > MAX_PAGES {
+        return Err(invalid("manifest version/size"));
+    }
+    let (base, size) = regions[0];
+    if base.raw_value() != 0 || size % PAGE as usize != 0 || size/PAGE as usize != m.mappings.len()
+        || m.mappings.iter().enumerate().any(|(i,p)|p.gpa != i as u64*PAGE) {
+        return Err(invalid("manifest does not cover exact RAM geometry"));
+    }
+    Ok(())
+}
+fn dax_geometry(path: &str) -> io::Result<(u64, u64)> {
+    let name = Path::new(path)
+        .file_name()
+        .and_then(|s| s.to_str())
+        .ok_or_else(|| invalid("DAX name"))?;
+    if !name.starts_with("dax") || !name[3..].chars().all(|c| c.is_ascii_digit() || c == '.') {
+        return Err(invalid("DAX path required"));
+    }
+    let base = format!("/sys/bus/dax/devices/{name}");
+    let parse = |p: &str| -> io::Result<u64> {
+        let text = std::fs::read_to_string(p)?;
+        let t = text.trim();
+        if let Some(h) = t.strip_prefix("0x") {
+            u64::from_str_radix(h, 16)
+        } else {
+            t.parse()
+        }
+        .map_err(io::Error::other)
+    };
+    if parse(&format!("{base}/align"))? != PAGE {
+        return Err(invalid("pool requires 4K DAX"));
+    }
+    Ok((
+        parse(&format!("{base}/resource"))?,
+        parse(&format!("{base}/size"))?,
+    ))
+}
+fn configure(m: &mut Manifest) -> io::Result<Arc<File>> {
+    if dax_geometry(&m.pool_path)? != (m.phys_base, m.device_bytes) {
+        return Err(invalid("DAX physical geometry changed"));
+    }
+    let file =
+        Arc::new(OpenOptions::new().read(true).write(true).open(
+            std::env::var("FC_POOL_MEMORY_DEVICE").unwrap_or_else(|_| "/dev/cxl_pool".into()),
+        )?);
+    let entries: Vec<_> = m
+        .mappings
+        .iter()
+        .map(|p| Entry {
+            offset: p.offset,
+            flags: 0,
+        })
+        .collect();
+    let config = Config {
+        abi: 4,
+        phys_base: m.phys_base,
+        device_bytes: m.device_bytes,
+        reserved: [0; 2],
+        count: entries.len() as u64,
+        entries: entries.as_ptr() as u64,
+    };
+    let mut create = Create { config,
+        metadata_offset: env("FC_POOL_MEMORY_METADATA_OFFSET")?.parse().map_err(io::Error::other)?,
+        metadata_bytes: 64 * 1024 * 1024,
+        owner_epoch: m.run_epoch.parse().map_err(io::Error::other)?,
+        allocation_generation: m.allocation_generation,
+    };
+    ioctl(&file, 0x75, false, &mut create)?;
+    let mut handle = Handle::default();
+    ioctl(&file, 0x76, true, &mut handle)?;
+    m.handle = Some(handle);
+    Ok(file)
+}
+fn query(a: &mut Active) -> io::Result<()> {
+    let mut h = a.manifest.handle.ok_or_else(|| invalid("persistent handle required"))?;
+    ioctl(&a.file, 0x76, true, &mut h)?;
+    a.manifest.generation = h.generation;
+    a.manifest.faults = h.faults;
+    a.manifest.exhausted = h.exhausted;
+    a.manifest.handle = Some(h);
+    Ok(())
+}
+fn full_query(a: &mut Active) -> io::Result<()> {
+    if std::env::var("FC_POOL_FULL_AUDIT").as_deref() != Ok("1") {
+        return Err(invalid("full mapping scan requires explicit audit opt-in"));
+    }
+    query(a)?;
+    let h = a.manifest.handle.unwrap();
+    let mut entries = vec![Entry::default(); h.count as usize];
+    let mut q = Query { count:h.count, entries:entries.as_mut_ptr() as u64,
+        ..Default::default() };
+    ioctl(&a.file, 0x71, true, &mut q)?;
+    a.manifest.mappings = entries.into_iter().enumerate().map(|(i,e)| Mapping {
+        gpa:i as u64*PAGE, offset:e.offset }).collect();
+    Ok(())
+}
+fn validate_handle_geometry(m: &Manifest, regions: &[(GuestAddress, usize)]) -> io::Result<()> {
+    let h = m.handle.ok_or_else(|| invalid("persistent mapping handle missing"))?;
+    if m.version != 4 || m.reserved != [0; 2] || h.abi != 4 || h.reserved != [0; 4] || h.count == 0 || h.count > MAX_PAGES as u64 ||
+        h.phys_base != m.phys_base || h.device_bytes != m.device_bytes ||
+        h.allocation_generation != m.allocation_generation ||
+        regions.len() != 1 || regions[0].0.raw_value() != 0 || regions[0].1 as u64 != h.count*PAGE {
+        return Err(invalid("persistent mapping geometry/lease"));
+    }
+    Ok(())
+}
+fn checkpoint(mem: &GuestMemoryMmap, seal: bool) -> io::Result<()> {
+    checkpoint_inner(mem, seal, true)
+}
+fn checkpoint_inner(mem: &GuestMemoryMmap, seal: bool, publish: bool) -> io::Result<()> {
+    let mut guard = state().lock().unwrap();
+    let Some(a) = guard.as_mut() else { return Ok(()); };
+    query(a)?;
+    validate_handle_geometry(&a.manifest, &geometry(mem))?;
+    if seal {
+        let mut h = a.manifest.handle.unwrap();
+        ioctl(&a.file, 0x77, true, &mut h)?;
+        a.manifest.handle = Some(h);
+    }
+    // Full evidence is explicit. Drop the allocation as well as its contents;
+    // a 2GiB VM must not retain a spare 524288-entry userspace table.
+    a.manifest.mappings = Vec::new();
+    a.manifest.state_sha256 = None;
+    if publish { write_json(&env("FC_POOL_MEMORY_MANIFEST")?, &a.manifest)?; }
+    Ok(())
+}
+/// Revoke every local RAM access after KVM detach, including already present PTEs.
+/// This changes VMAs, not guest contents, and performs no per-page userspace scan.
+pub(crate) fn park_resident(mem: &GuestMemoryMmap) -> io::Result<()> {
+    for region in mem.iter() {
+        // SAFETY: vCPUs paused, I/O drained, event subscribers removed, KVM detached.
+        let p = unsafe { libc::mmap(region.as_ptr().cast(), region.len() as usize, libc::PROT_NONE,
+            libc::MAP_PRIVATE | libc::MAP_ANONYMOUS | libc::MAP_FIXED, -1, 0) };
+        if p == libc::MAP_FAILED { return Err(io::Error::last_os_error()); }
+    }
+    Ok(())
+}
+
+
+pub(crate) fn import_resident_state(mem: &GuestMemoryMmap, mut m: Manifest) -> io::Result<()> {
+    if !enabled() || m.vm_id != env("FC_POOL_VM_ID")? { return Err(invalid("resident mapper VM mismatch")); }
+    validate_handle_geometry(&m, &geometry(mem))?;
+    let old: u64 = m.run_epoch.parse().map_err(io::Error::other)?;
+    let new = old.checked_add(1).ok_or_else(|| invalid("owner epoch overflow"))?;
+    let mut guard = state().lock().unwrap();
+    if let Some(previous) = guard.as_ref() {
+        let prev_epoch: u64 = previous.manifest.run_epoch.parse().map_err(io::Error::other)?;
+        if old <= prev_epoch || m.allocation_generation < previous.manifest.allocation_generation {
+            return Err(invalid("resident mapper stale epoch/lease"));
+        }
+    }
+    // The resident process pins the fixed DAX device for its lifetime. Reuse
+    // the established geometry instead of opening three sysfs files each hop.
+    // A new allocation/lease is still checked by CPM_IMPORT below.
+    if let Some(previous) = guard.as_ref() {
+        if m.pool_path != previous.manifest.pool_path || m.phys_base != previous.manifest.phys_base
+            || m.device_bytes != previous.manifest.device_bytes {
+            return Err(invalid("resident DAX geometry changed"));
+        }
+    } else if dax_geometry(&m.pool_path)? != (m.phys_base, m.device_bytes) {
+        return Err(invalid("resident DAX geometry changed"));
+    }
+    let file = Arc::new(OpenOptions::new().read(true).write(true).open(env("FC_POOL_MEMORY_DEVICE")?)?);
+    let mut h = m.handle.unwrap();
+    if h.owner_epoch != old || h.state != 2 { return Err(invalid("resident unsealed mapper")); }
+    ioctl(&file, 0x78, true, &mut h)?;
+    if h.owner_epoch != new { return Err(invalid("resident mapper epoch mismatch")); }
+    let mut offset = 0;
+    for region in mem.iter() {
+        // SAFETY: detached resident retains its logical region at exactly this HVA.
+        let p = unsafe { libc::mmap(region.as_ptr().cast(), region.len() as usize,
+            libc::PROT_READ | libc::PROT_WRITE, libc::MAP_SHARED | libc::MAP_FIXED, file.as_raw_fd(), offset) };
+        if p == libc::MAP_FAILED { return Err(io::Error::last_os_error()); }
+        offset += region.len() as i64;
+    }
+    m.handle = Some(h); m.run_epoch = new.to_string();
+    m.mappings = Vec::new();
+    RESIDENT_EPOCH.store(new, std::sync::atomic::Ordering::Release);
+    *guard = Some(Active {file, manifest:m});
+    Ok(())
+}
+
+pub(crate) fn check_execution_owner() -> io::Result<()> {
+    let mut guard = state().lock().unwrap();
+    if let Some(a) = guard.as_mut() {
+        query(a)?;
+        if a.manifest.handle.unwrap().state != 1 {
+            return Err(invalid("sealed mapper cannot resume on the source"));
+        }
+    }
+    Ok(())
+}
+pub(crate) fn checkpoint_ready(mem: &GuestMemoryMmap) -> io::Result<()> { checkpoint(mem, false) }
+pub(crate) fn seal_for_handoff(mem: &GuestMemoryMmap) -> io::Result<()> { checkpoint(mem, true) }
+pub(crate) fn seal_for_handoff_memory(mem: &GuestMemoryMmap) -> io::Result<Manifest> {
+    checkpoint_inner(mem, true, false)?;
+    manifest_for_profile().ok_or_else(|| invalid("missing sealed mapper"))
+}
+/// Existing metadata for optional experiment logs; no query or RAM walk.
+pub(crate) fn manifest_for_profile() -> Option<Manifest> {
+    state().lock().unwrap().as_ref().map(|a| a.manifest.clone())
+}
+
+pub(crate) fn bind_state(path: &Path) -> io::Result<()> {
+    let bytes = std::fs::read(path)?;
+    let hash: String = digest(&bytes).iter().map(|b| format!("{b:02x}")).collect();
+    let mut guard = state().lock().unwrap();
+    let a = guard
+        .as_mut()
+        .ok_or_else(|| invalid("state binding without active pool"))?;
+    a.manifest.state_sha256 = Some(hash);
+    write_json(&env("FC_POOL_MEMORY_MANIFEST")?, &a.manifest)
+}
+pub(crate) fn verify_state(path: &Path) -> io::Result<()> {
+    if let Ok(manifest) = std::env::var("FC_POOL_MEMORY_RESTORE") {
+        let m: Manifest = read_json(&manifest)?;
+        let hash: String = digest(&std::fs::read(path)?)
+            .iter()
+            .map(|b| format!("{b:02x}"))
+            .collect();
+        if m.state_sha256.as_deref() != Some(hash.as_str()) {
+            return Err(invalid("state/placement manifest mismatch"));
+        }
+    }
+    Ok(())
+}
+
+pub(crate) fn restore(
+    regions: &[(GuestAddress, usize)],
+    dirty: bool,
+) -> Result<Option<Vec<GuestRegionMmap>>, MemoryError> {
+    let Ok(path) = std::env::var("FC_POOL_MEMORY_RESTORE") else {
+        return Ok(None);
+    };
+    let load = || -> io::Result<(Arc<File>, Manifest)> {
+        if !enabled() || active() {
+            return Err(invalid("pool restore configuration"));
+        }
+        let mut m: Manifest = read_json(&path)?;
+        if m.vm_id != env("FC_POOL_VM_ID")? {
+            return Err(invalid("pool restore VM identity"));
+        }
+        let old: u64 = m.run_epoch.parse().map_err(io::Error::other)?;
+        let new: u64 = env("FC_POOL_RUN_EPOCH")?
+            .parse()
+            .map_err(io::Error::other)?;
+        let lease: u64 = env("FC_POOL_MEMORY_LEASE")?
+            .parse()
+            .map_err(io::Error::other)?;
+        if old.checked_add(1) != Some(new)
+            || m.allocation_generation == 0
+            || lease != m.allocation_generation
+        {
+            return Err(invalid("stale placement epoch or allocation lease"));
+        }
+        validate_handle_geometry(&m, regions)?;
+        if dax_geometry(&m.pool_path)? != (m.phys_base, m.device_bytes) {
+            return Err(invalid("DAX physical geometry changed"));
+        }
+        let file = Arc::new(OpenOptions::new().read(true).write(true)
+            .open(env("FC_POOL_MEMORY_DEVICE")?)?);
+        let mut h = m.handle.unwrap();
+        if h.owner_epoch != old || h.state != 2 { return Err(invalid("unsealed/stale mapper")); }
+        ioctl(&file, 0x78, true, &mut h)?;
+        if h.owner_epoch != new { return Err(invalid("mapper owner epoch mismatch")); }
+        m.handle = Some(h);
+        m.mappings = Vec::new();
+        Ok((file, m))
+    };
+    let (file, mut m) = load().map_err(|e| MemoryError::Dax(e.to_string()))?;
+    let mut offset = 0;
+    let mut fixed = crate::vstate::memory::fixed_hva()?;
+    let mut out = Vec::new();
+    for &(gpa, size) in regions {
+        out.push(GuestRegionMmap::allocate_at(
+            gpa,
+            size,
+            libc::PROT_READ | libc::PROT_WRITE,
+            libc::MAP_SHARED,
+            Some(FileOffset::from_arc(file.clone(), offset)),
+            dirty,
+            fixed,
+        )?);
+        offset += size as u64;
+        fixed = fixed.map(|p| p + size);
+    }
+    m.run_epoch = env("FC_POOL_RUN_EPOCH").map_err(|e| MemoryError::Dax(e.to_string()))?;
+    *state().lock().unwrap() = Some(Active { file, manifest: m });
+    Ok(Some(out))
+}
+
+struct View {
+    ptr: *mut libc::c_void,
+    bytes: usize,
+}
+impl Drop for View {
+    fn drop(&mut self) {
+        if self.bytes != 0 {
+            unsafe {
+                libc::munmap(self.ptr, self.bytes);
+            }
+        }
+    }
+}
+fn view(file: &File, bytes: usize) -> io::Result<View> {
+    // SAFETY: a new VMA over the validated DAX capacity; lifetime tied to View.
+    let ptr = unsafe {
+        libc::mmap(
+            std::ptr::null_mut(),
+            bytes,
+            libc::PROT_READ | libc::PROT_WRITE,
+            libc::MAP_SHARED,
+            file.as_raw_fd(),
+            0,
+        )
+    };
+    if ptr == libc::MAP_FAILED {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(View { ptr, bytes })
+}
+
+fn dram_evidence(mem: &GuestMemoryMmap) -> io::Result<Vec<serde_json::Value>> {
+    let text = std::fs::read_to_string("/proc/self/maps")?;
+    let mut result = Vec::new();
+    for region in mem.iter() {
+        let start = region.as_ptr() as u64;
+        let end = start
+            .checked_add(region.len())
+            .ok_or_else(|| invalid("RAM HVA overflow"))?;
+        let mut covered = start;
+        let mut maps = Vec::new();
+        for line in text.lines() {
+            let fields: Vec<_> = line.split_whitespace().collect();
+            if fields.len() < 5 {
+                return Err(invalid("invalid proc maps"));
+            }
+            let (a, b) = fields[0]
+                .split_once('-')
+                .ok_or_else(|| invalid("invalid VMA range"))?;
+            let a = u64::from_str_radix(a, 16).map_err(io::Error::other)?;
+            let b = u64::from_str_radix(b, 16).map_err(io::Error::other)?;
+            if b <= start || a >= end {
+                continue;
+            }
+            if a > covered || fields[1] != "rw-p" || fields[4] != "0" || line.contains("/dev/") {
+                return Err(invalid(
+                    "demotion did not detach CXL into private anonymous RAM",
+                ));
+            }
+            covered = covered.max(b.min(end));
+            maps.push(line.to_owned());
+        }
+        if covered != end {
+            return Err(invalid("demotion VMA coverage incomplete"));
+        }
+        result.push(serde_json::json!({"gpa":region.start_addr().raw_value(),"hva":start,"bytes":region.len(),"maps":maps}));
+    }
+    Ok(result)
+}
+
+pub(crate) fn apply(mem: &GuestMemoryMmap) -> io::Result<()> {
+    let p: Plan = read_json(&env("FC_POOL_MEMORY_PLAN")?)?;
+    if p.vm_id != env("FC_POOL_VM_ID")? || p.run_epoch != env("FC_POOL_RUN_EPOCH")? {
+        return Err(invalid("pool plan VM/epoch mismatch"));
+    }
+    let mut copied = 0u64;
+    let mut dram_vmas = Vec::new();
+    match p.operation.as_str() {
+        "promote" => {
+            if active() {
+                return Err(invalid("promote requires private DRAM backing"));
+            }
+            if p.allocation_generation == 0 {
+                return Err(invalid(
+                    "promotion requires controller allocation generation",
+                ));
+            }
+            let (phys_base, device_bytes) = dax_geometry(&p.pool_path)?;
+            let mut m = Manifest {
+                version: 4,
+                handle: None,
+                vm_id: p.vm_id.clone(),
+                run_epoch: p.run_epoch.clone(),
+                pool_path: p.pool_path.clone(),
+                phys_base,
+                device_bytes,
+                reserved: [0; 2],
+                mappings: p.mappings.clone(),
+                generation: 1,
+                faults: 0,
+                exhausted: 0,
+                state_sha256: None,
+                allocation_generation: p.allocation_generation,
+            };
+            validate_geometry(&m, &geometry(mem))?;
+            let file = configure(&mut m)?; // structural/duplicate allocation preflight before copying
+            let dax = OpenOptions::new()
+                .read(true)
+                .write(true)
+                .open(&m.pool_path)?;
+            let target = view(&dax, device_bytes as usize)?;
+            let mut index = 0;
+            while index < m.mappings.len() {
+                let page = &m.mappings[index];
+                let mut end = index + 1;
+                while end < m.mappings.len()
+                    && m.mappings[end].offset == page.offset + (end-index) as u64*PAGE {
+                    end += 1;
+                }
+                let bytes = (end-index)*PAGE as usize;
+                mem.get_slice(GuestAddress(page.gpa), bytes).map_err(io::Error::other)?;
+                let source = mem.get_host_address(GuestAddress(page.gpa)).map_err(io::Error::other)?;
+                // SAFETY: the admitted exclusive extent and paused logical region
+                // cover this run; no payload comparison or per-page syscall.
+                unsafe { std::ptr::copy_nonoverlapping(source,
+                    target.ptr.cast::<u8>().add(page.offset as usize), bytes); }
+                copied += bytes as u64;
+                index = end;
+            }
+            let mut offset = 0;
+            for region in mem.iter() {
+                set_mapping_failed(true);
+                // SAFETY: paused VM, drained devices, same HVA/geometry, complete
+                // private copies validated above.
+                let mapped = unsafe {
+                    libc::mmap(
+                        region.as_ptr().cast(),
+                        region.len() as usize,
+                        libc::PROT_READ | libc::PROT_WRITE,
+                        libc::MAP_SHARED | libc::MAP_FIXED,
+                        file.as_raw_fd(),
+                        offset,
+                    )
+                };
+                if mapped == libc::MAP_FAILED {
+                    return Err(io::Error::last_os_error());
+                }
+                offset += region.len() as i64;
+            }
+            set_mapping_failed(false);
+            *state().lock().unwrap() = Some(Active { file, manifest: m });
+            checkpoint_ready(mem)?;
+        }
+        "export" => {
+            checkpoint_ready(mem)?;
+        }
+        "audit" => {
+            let mut guard = state().lock().unwrap();
+            let a = guard
+                .as_mut()
+                .ok_or_else(|| invalid("audit requires CXL mapping"))?;
+            full_query(a)?;
+            let mut rows = Vec::new();
+            for region in mem.iter() {
+                let mut ptes = vec![Pte::default(); region.len() as usize / PAGE as usize];
+                let mut request = Audit {
+                    address: region.as_ptr() as u64,
+                    count: ptes.len() as u64,
+                    ptes: ptes.as_mut_ptr() as u64,
+                };
+                ioctl(&a.file, 0x74, true, &mut request)?;
+                rows.extend(ptes);
+            }
+            let evidence: Vec<_> = a
+                .manifest
+                .mappings
+                .iter()
+                .zip(rows)
+                .map(|(m, pte)| {
+                    serde_json::json!({
+                "gpa":m.gpa,"offset":m.offset,"actual_pfn":pte.pfn,
+                "present":pte.flags&1!=0,"writable":pte.flags&2!=0})
+                })
+                .collect();
+            a.manifest.mappings = Vec::new();
+
+            return write_json(
+                &env("FC_POOL_MEMORY_REPORT")?,
+                &serde_json::json!({"version":1,"operation":"audit",
+                "vm_id":p.vm_id,"run_epoch":p.run_epoch,"phys_base":a.manifest.phys_base,"pages":evidence,
+                "result":"passed"}),
+            );
+        }
+        "demote" => {
+            checkpoint_ready(mem)?;
+            let mut copies = Vec::new();
+            for region in mem.iter() {
+                let bytes = region.len() as usize;
+                // SAFETY: fresh private DRAM mapping; all source bytes stable.
+                let ptr = unsafe {
+                    libc::mmap(
+                        std::ptr::null_mut(),
+                        bytes,
+                        libc::PROT_READ | libc::PROT_WRITE,
+                        libc::MAP_PRIVATE | libc::MAP_ANONYMOUS,
+                        -1,
+                        0,
+                    )
+                };
+                if ptr == libc::MAP_FAILED {
+                    return Err(io::Error::last_os_error());
+                }
+                let copy = View { ptr, bytes };
+                unsafe {
+                    std::ptr::copy_nonoverlapping(region.as_ptr(), ptr.cast::<u8>(), bytes);
+                }
+                copies.push((copy, region.as_ptr()));
+                copied += bytes as u64;
+            }
+            for (mut copy, target) in copies {
+                set_mapping_failed(true);
+                // SAFETY: prepared private bytes replace precisely the paused
+                // logical region; mremap performs MMU notifier invalidation.
+                let result = unsafe {
+                    libc::mremap(
+                        copy.ptr,
+                        copy.bytes,
+                        copy.bytes,
+                        libc::MREMAP_MAYMOVE | libc::MREMAP_FIXED,
+                        target,
+                    )
+                };
+                if result == libc::MAP_FAILED {
+                    return Err(io::Error::last_os_error());
+                }
+                copy.bytes = 0; // ownership moved into the existing GuestMemory VMA
+            }
+            {
+                let mut guard = state().lock().unwrap();
+                let a = guard.as_ref().ok_or_else(||invalid("demote without mapper"))?;
+                let mut h = a.manifest.handle.unwrap();
+                ioctl(&a.file, 0x7a, true, &mut h)?;
+                *guard = None;
+            }
+            set_mapping_failed(false);
+            dram_vmas = dram_evidence(mem)?;
+        }
+        _ => return Err(invalid("unknown pool memory operation")),
+    }
+    let summary=state().lock().unwrap().as_ref().map(|a|serde_json::json!({
+        "generation":a.manifest.generation,
+        "exhausted":a.manifest.exhausted}));
+    write_json(
+        &env("FC_POOL_MEMORY_REPORT")?,
+        &serde_json::json!({"version":1,"operation":p.operation,
+        "vm_id":p.vm_id,"run_epoch":p.run_epoch,"copied_private_bytes":copied,
+        "ram_snapshot_bytes":0,"module":summary,
+        "dram_vmas":dram_vmas,"result":"passed"}),
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn manifest() -> Manifest {
+        Manifest { version: 4, vm_id: "1".into(), run_epoch: "2".into(), pool_path: "unused".into(),
+            phys_base: 0, device_bytes: 4096*PAGE, reserved: [0; 2],
+            mappings: vec![Mapping { gpa: 0, offset: PAGE }, Mapping { gpa: PAGE, offset: 2*PAGE }],
+            handle: Some(Handle { abi: 4, count: 2, device_bytes: 4096*PAGE,
+                allocation_generation: 7, ..Default::default() }),
+            generation: 1, faults: 0, exhausted: 0, allocation_generation: 7, state_sha256: None }
+    }
+    #[test]
+    fn private_promotion_needs_exact_ram_coverage() {
+        let mut m = manifest();
+        validate_geometry(&m, &[(GuestAddress(0), 2*PAGE as usize)]).unwrap();
+        m.mappings[1].gpa = 0;
+        assert!(validate_geometry(&m, &[(GuestAddress(0), 2*PAGE as usize)]).is_err());
+        m = manifest(); m.mappings.pop();
+        assert!(validate_geometry(&m, &[(GuestAddress(0), 2*PAGE as usize)]).is_err());
+    }
+    #[test]
+    fn persistent_handle_rejects_old_abi_and_foreign_lease() {
+        let mut m = manifest(); let geometry = [(GuestAddress(0), 2*PAGE as usize)];
+        validate_handle_geometry(&m, &geometry).unwrap();
+        m.handle.as_mut().unwrap().abi = 2;
+        assert!(validate_handle_geometry(&m, &geometry).is_err());
+        m = manifest(); m.handle.as_mut().unwrap().allocation_generation += 1;
+        assert!(validate_handle_geometry(&m, &geometry).is_err());
+        m = manifest(); m.handle.as_mut().unwrap().reserved[0] = 1;
+        assert!(validate_handle_geometry(&m, &geometry).is_err());
+    }
+    #[test]
+    fn uapi_sizes_match_private_mapper() {
+        assert_eq!(std::mem::size_of::<Config>(), 56);
+        assert_eq!(std::mem::size_of::<Handle>(), 152);
+        assert_eq!(std::mem::size_of::<Query>(), 56);
+    }
+}
