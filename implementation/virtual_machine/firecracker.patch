+    struct DeviceEventProbe {
+        event: EventFd,
+        dispatched: Arc<AtomicUsize>,
+    }
+
+    impl MutEventSubscriber for DeviceEventProbe {
+        fn init(&mut self, ops: &mut EventOps) {
+            ops.add(Events::new(&self.event, EventSet::IN)).unwrap();
+        }
+
+        fn process(&mut self, _: Events, _: &mut EventOps) {
+            self.event.read().unwrap();
+            self.dispatched.fetch_add(1, Ordering::SeqCst);
+        }
+    }
+
+    fn device_probe(event_manager: &mut EventManager) -> (EventFd, Arc<AtomicUsize>) {
+        let event = EventFd::new(libc::EFD_NONBLOCK).unwrap();
+        let dispatched = Arc::new(AtomicUsize::new(0));
+        event_manager.add_subscriber(Arc::new(Mutex::new(DeviceEventProbe {
+            event: event.try_clone().unwrap(),
+            dispatched: dispatched.clone(),
+        })));
+        (event, dispatched)
+    }
