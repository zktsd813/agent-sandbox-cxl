+        // Set the opt-in environment in a child process, without racing other tests
+        // or mutating the environment after the vCPU threads have started.
+        const CHILD: &str = "FC_TEST_REJECTED_PAUSE_CHILD";
+        if std::env::var(CHILD).as_deref() != Ok("1") {
+            assert!(std::process::Command::new(std::env::current_exe().unwrap())
+                .args(["--exact", "api_server_adapter::tests::test_rejected_pause_returns_to_device_event_dispatch", "--test-threads=1"])
+                .env(CHILD, "1")
+                .env("FC_DAX_DIRECT", "1")
+                .status().unwrap().success());
+            return;
+        }
+        let (vmm, mut event_manager) = vmm::test_utils::default_vmm_no_boot(None);
+        vmm.lock().unwrap().machine_config.vcpu_count = 9;
+        let state_before = vmm.lock().unwrap().instance_info.state.clone();
+        let (to_vmm, from_api) = channel();
+        let (to_api, from_vmm) = channel();
+        let api_event = EventFd::new(libc::EFD_NONBLOCK).unwrap();
+        let adapter = Arc::new(Mutex::new(ApiServerAdapter {
