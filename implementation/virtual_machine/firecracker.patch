+// Copyright 2026 Amazon.com, Inc. or its affiliates. All Rights Reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Opt-in, deliberately narrow semantic restore into an already-used KVM worker.
+//! RAM stays at the same DAX offset; this does not import kernel pointers or VMCS bytes.
+
+use std::os::fd::AsRawFd;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+use kvm_bindings::{CpuId, KVM_MAX_CPUID_ENTRIES};
+
+use crate::device_manager::VirtioDevicesState;
+use crate::devices::legacy::EventFdTrigger;
+use crate::persist::{
+    MicrovmState, RestoreTiming, VmInfo,
+};
+use crate::snapshot::Persist;
+use crate::vmm_config::instance_info::VmState;
+use crate::vmm_config::machine_config::HugePageConfig;
+use crate::vstate::memory::{GuestMemoryExtension, GuestRegionType};
+use crate::{VcpuResponse, Vmm};
+
+static WORKER_SEQUENCE: AtomicU64 = AtomicU64::new(0);
+
+/// A single outstanding local preparation. Eventfd clones retain kernel identity across UART
+/// replacement. No snapshot bytes, guest RAM, or remote pointers are stored here.
+#[derive(Debug)]
+pub(crate) struct Prepared {
+    pub(crate) irqfds: [(EventFdTrigger, u32); 4],
+    pub(crate) generation: u64,
+}
+
+/// Captured before first KVM_RUN. KVM forbids changing this CPU model after use;
+/// caching avoids loading the VMCS on the VMM thread just to read invariants.
+#[derive(Debug)]
+pub(crate) struct CpuContract {
+    cpuid: CpuId,
+    immutable_msrs: Vec<(u32, u64)>,
+    tsc_khz: Option<u32>,
+}
+
+fn immutable_msr(index: u32) -> bool {
+    matches!(index, 0x10a | 0x345 | 0xc0011029 | 0x480..=0x491)
+}
+
+impl CpuContract {
+    pub(crate) fn capture(vcpu: &crate::arch::KvmVcpu) -> Result<Self, String> {
+        let cpuid = vcpu
+            .fd
+            .get_cpuid2(KVM_MAX_CPUID_ENTRIES)
+            .map_err(|e| e.to_string())?;
+        ensure(
+            cpuid.as_slice().iter().all(|leaf| match leaf.function {
+                1 => leaf.ecx & (1 << 5) == 0,
+                0x80000001 => leaf.ecx & (1 << 2) == 0,
+                _ => true,
+            }),
+            "EPT worker CPU exposes nested virtualization",
+        )?;
+        let mut indices: Vec<_> = vcpu
+            .snapshot_msr_indices()
+            .into_iter()
+            .filter(|i| immutable_msr(*i))
+            .collect();
+        indices.dedup();
+        let immutable_msrs = if indices.is_empty() {
+            Vec::new()
+        } else {
+            vcpu.get_msr_chunk(indices.iter().copied(), indices.len())
+                .map_err(|e| e.to_string())?
+                .as_slice()
+                .iter()
+                .map(|entry| (entry.index, entry.data))
+                .collect()
+        };
+        Ok(Self {
+            cpuid: cpuid_contract(cpuid),
+            immutable_msrs,
+            tsc_khz: vcpu.fd.get_tsc_khz().ok(),
+        })
+    }
+
+    pub(crate) fn validate(&self, state: &crate::vstate::vcpu::VcpuState) -> Result<(), String> {
+        ensure(
+            self.cpuid == cpuid_contract(state.cpuid.clone()),
+            "worker CPUID model mismatch",
+        )?;
+        ensure(
+            state
+                .saved_msrs
+                .iter()
+                .flat_map(|m| m.as_slice())
+                .filter(|m| immutable_msr(m.index))
+                .all(|msr| self.immutable_msrs.contains(&(msr.index, msr.data))),
+            "worker immutable feature MSR mismatch",
+        )?;
+        ensure(
+            state.tsc_khz.is_none() || state.tsc_khz == self.tsc_khz,
+            "worker TSC frequency mismatch",
+        )
+    }
+}
+
+fn ensure(ok: bool, reason: &str) -> Result<(), String> {
+    ok.then_some(()).ok_or_else(|| reason.to_owned())
+}
+
+
+
+// These bits/lengths are rewritten by this kernel's __kvm_update_cpuid_runtime.
+// Comparing the remaining fields rejects CPU model changes before SET ioctls.
+fn cpuid_contract(mut cpuid: CpuId) -> CpuId {
+    cpuid.retain(|leaf| {
+        !(leaf.function == 0 && leaf.index == 0 && leaf.flags == 0 && leaf.eax == 0)
+    });
+    for leaf in cpuid.as_mut_slice() {
+        match (leaf.function, leaf.index) {
+            (1, _) => {
+                leaf.ecx &= !((1 << 27) | (1 << 3));
+                leaf.edx &= !(1 << 9);
+            }
+            (7, 0) => leaf.ecx &= !(1 << 4),
+            (0xd, 0 | 1) => leaf.ebx = 0,
+            _ => (),
+        }
+    }
+    cpuid
+}
+
+pub(crate) fn controlled_cpu(state: &crate::vstate::vcpu::VcpuState) -> bool {
+    state.sregs.cr4 & (1 << 13) == 0
+        && state.sregs.efer & (1 << 12) == 0
+        && state.sregs.efer & (1 << 10) != 0
+        && controlled_cpuid(&state.cpuid)
+}
+
+fn controlled_cpuid(cpuid: &CpuId) -> bool {
+    cpuid
+        .as_slice()
+        .iter()
+        .any(|leaf| leaf.function == 0x80000001 && leaf.edx & (1 << 20) != 0)
+        && cpuid.as_slice().iter().all(|leaf| match leaf.function {
+            1 => leaf.ecx & ((1 << 5) | (1 << 24)) == 0,
+            0x80000001 => leaf.ecx & (1 << 2) == 0,
+            0xa => leaf.eax == 0 && leaf.ebx == 0 && leaf.ecx == 0 && leaf.edx == 0,
+            0x40000001 => leaf.eax & !((1 << 0) | (1 << 1) | (1 << 3) | (1 << 24)) == 0,
+            _ => true,
+        })
+}
+
+impl Vmm {
+    pub(crate) fn worker_irqfds(&self) -> Result<[(EventFdTrigger, u32); 4], String> {
+        let legacy = self
+            .device_manager
+            .legacy_devices
+            .as_ref()
+            .ok_or("worker needs legacy UART")?;
+        Ok([
+            (
+                legacy
+                    .stdio_serial
+                    .lock()
+                    .unwrap()
+                    .serial
+                    .interrupt_evt()
+                    .try_clone()
+                    .map_err(|e| e.to_string())?,
+                4,
+            ),
+            (
+                EventFdTrigger::new(
+                    legacy
+                        .i8042
+                        .lock()
+                        .unwrap()
+                        .kbd_interrupt_evt
+                        .try_clone()
+                        .map_err(|e| e.to_string())?,
+                ),
+                1,
+            ),
+            (
+                self.device_manager
+                    .acpi_devices
+                    .vmgenid()
+                    .interrupt_evt
+                    .try_clone()
+                    .map_err(|e| e.to_string())?,
+                self.device_manager.acpi_devices.vmgenid().gsi,
+            ),
+            (
+                self.device_manager
+                    .acpi_devices
+                    .vmclock()
+                    .interrupt_evt
+                    .try_clone()
+                    .map_err(|e| e.to_string())?,
+                self.device_manager.acpi_devices.vmclock().gsi,
+            ),
+        ])
+    }
+
+    /// Coarse preparation can overlap source execution/save. It only retires local worker state:
+    /// no KVM_RUN, snapshot decode, guest-memory writes, or incoming CPU state are involved.
+    pub(crate) fn prepare_worker(&mut self) -> Result<(), String> {
+        ensure(
+            crate::ept_adopt::enabled(),
+            "worker not enabled",
+        )?;
+        ensure(
+            self.instance_info.state == VmState::Paused && !self.worker_restore_failed,
+            "worker preparation requires a healthy paused worker",
+        )?;
+        // A duplicate never toggles EFER back or queues another vCPU event.
+        if let Some(prepared) = &self.worker_prepared {
+            crate::logger::info_unrestricted!(
+                "EPT_WORKER_PREPARED generation={} duplicate=true",
+                prepared.generation
+            );
+            return Ok(());
+        }
+        let mut timing = RestoreTiming::new("worker_prepare");
+        ensure(
+            crate::ept_adopt::enabled()
+                && (1..=8).contains(&self.machine_config.vcpu_count)
+                && self.machine_config.track_dirty_pages
+                && self.machine_config.huge_pages == HugePageConfig::None,
+            "worker preparation requires the dirty-logged local worker without nested guests",
+        )?;
+        let vm = self.vm.as_kvm().ok_or("worker requires KVM")?;
+        // Check the current PIT before clearing it; otherwise preparation could hide an
+        // unsupported active timer from the later snapshot compatibility check.
+        ensure(
+            crate::vstate::vm::KvmVm::worker_pit_disabled(
+                &vm.save_state().map_err(|e| e.to_string())?,
+            ),
+            "worker receiver previously used an active PIT",
+        )?;
+        let devices = self.device_manager.save();
+        ensure(
+            crate::ept_adopt::devices_ok(&devices),
+            "worker supports read-only block MMIO workers only",
+        )?;
+
+
+        {
+            let handles = vm.vcpus_handles();
+            ensure(
+                !handles.is_empty()
+                    && handles.len() <= 8
+                    && handles.iter().all(|h| h.worker_cpu_contract.as_ref()
+                        .is_some_and(|contract| controlled_cpuid(&contract.cpuid))),
+                "worker preparation requires clock-only PV/no-PMU/no-nested CPU profile",
+            )?;
+        }
+        let irqfds = self.worker_irqfds()?;
+        timing.mark("validation");
+        self.worker_restore_failed = true;
+        vm.quiesce_worker_pit().map_err(|e| e.to_string())?;
+        timing.mark("quiesce_old_timers");
+        {
+            for (event, gsi) in &irqfds {
+                vm.fd()
+                    .unregister_irqfd(event, *gsi)
+                    .map_err(|e| e.to_string())?;
+            }
+        }
+        timing.mark("irqfd_deassign");
+        for (event, _) in &irqfds {
+            while event.read().is_ok() {}
+        }
+        timing.mark("drain_old_events");
+        {
+            let mut handles = vm.vcpus_handles();
+            for handle in handles.iter_mut() {
+                handle.prepare_worker_without_kick();
+                match handle.response_receiver().recv_timeout(crate::RECV_TIMEOUT_SEC) {
+                    Ok(VcpuResponse::PreparedWorker) => (),
+                    response => return Err(format!("worker vCPU preparation failed: {response:?}")),
+                }
+            }
+        }
+        timing.mark("vcpu_prepare");
+        let generation = WORKER_SEQUENCE.fetch_add(1, Ordering::Relaxed);
+        self.worker_prepared = Some(Prepared {
+            irqfds,
+            generation,
+        });
+        self.worker_restore_failed = false;
+        crate::logger::info_unrestricted!(
+            "EPT_WORKER_PREPARED generation={} duplicate=false",
+            generation
+        );
+        timing.finish();
+        Ok(())
+    }
+
+    fn validate_worker(
+        &self,
+        state: &MicrovmState,
+    ) -> Result<(), String> {
+        ensure(
+            state.vcpu_states.len() == self.machine_config.vcpu_count as usize
+                && (1..=8).contains(&state.vcpu_states.len()),
+            "worker requires matching vCPU counts",
+        )?;
+        crate::persist::snapshot_state_sanity_check(state).map_err(|e| e.to_string())?;
+        ensure(
+            crate::ept_adopt::enabled(),
+            "worker not enabled",
+        )?;
+        ensure(
+            crate::ept_adopt::enabled(),
+            "worker requires a pool booted without nested VMX/SVM",
+        )?;
+        ensure(
+            self.instance_info.state == VmState::Paused && !self.worker_restore_failed,
+            "worker requires a healthy paused worker",
+        )?;
+        let actual = VmInfo::from(self);
+        ensure(
+            actual.mem_size_mib == state.vm_info.mem_size_mib
+                && actual.smt == state.vm_info.smt
+                && actual.cpu_template == state.vm_info.cpu_template
+                && actual.huge_pages == state.vm_info.huge_pages
+                && actual.huge_pages == HugePageConfig::None
+,
+            "worker VM hardware configuration mismatch",
+        )?;
+        let vm = self.vm.as_kvm().ok_or("worker requires KVM")?;
+        ensure(
+            vm.guest_memory().describe() == state.vm_state.memory
+                && state
+                    .vm_state
+                    .memory
+                    .regions
+                    .iter()
+                    .all(|r| r.region_type == GuestRegionType::Dram),
+            "worker memory layout mismatch",
+        )?;
+        ensure(
+            vm.kvm().save_state().kvm_cap_modifiers == state.kvm_state.kvm_cap_modifiers,
+            "worker KVM capability mismatch",
+        )?;
+        ensure(
+            crate::vstate::vm::KvmVm::worker_pit_disabled(&state.vm_state),
+            "worker currently requires a disabled PIT",
+        )?;
+        ensure(
+            state.vcpu_states.iter().all(controlled_cpu),
+            "worker requires clock-only PV/no-PMU/no-nested CPU profile",
+        )?;
+        ensure(crate::pool_memory::active(), "EPT worker has no imported RAM")?;
+        crate::pool_memory::check_execution_owner().map_err(|e|e.to_string())?;
+        let devices = self.device_manager.save();
+        ensure(
+            crate::ept_adopt::devices_ok(&devices) && crate::ept_adopt::devices_ok(&state.device_states),
+            "worker supports read-only block MMIO workers only",
+        )?;
+        let old_acpi = &devices.acpi_state;
+        let new_acpi = &state.device_states.acpi_state;
+        ensure(
+            old_acpi.vmgenid.addr == new_acpi.vmgenid.addr
+                && old_acpi.vmgenid.gsi == new_acpi.vmgenid.gsi
+                && old_acpi.vmclock.guest_address == new_acpi.vmclock.guest_address
+                && old_acpi.vmclock.gsi == new_acpi.vmclock.gsi,
+            "worker ACPI layout mismatch",
+        )?;
+        ensure(
+            state
+                    .device_states
+                    .serial_state
+                    .as_ref()
+                    .is_some_and(|s| s.in_buffer.len() <= 64),
+            "worker requires output-only UART with valid FIFO",
+        )?;
+        ensure(
+            bitcode::serialize(&vm.resource_allocator().save()).map_err(|e| e.to_string())?
+                == bitcode::serialize(&state.vm_state.resource_allocator)
+                    .map_err(|e| e.to_string())?,
+            "worker resource allocation mismatch",
+        )?;
+        let handles = vm.vcpus_handles();
+        ensure(handles.len() == state.vcpu_states.len(), "EPT worker vCPU handle mismatch")?;
+        for (handle, incoming) in handles.iter().zip(&state.vcpu_states) {
+        let mut incoming_indices: Vec<_> = incoming
+            .saved_msrs
+            .iter()
+            .flat_map(|chunk| chunk.as_slice().iter().map(|msr| msr.index))
+            .collect();
+        incoming_indices.sort_unstable();
+        ensure(
+            incoming_indices == handle.worker_msr_indices,
+            "worker snapshot MSR index schema mismatch",
+        )?;
+        handle
+            .worker_cpu_contract
+            .as_ref()
+            .ok_or("EPT worker has no immutable CPU contract")?
+            .validate(&incoming)?;
+        }
+        ensure(
+            crate::vstate::vm::KvmVm::worker_pit_disabled(
+                &vm.save_state().map_err(|e| e.to_string())?,
+            ),
+            "worker receiver previously used an active PIT",
+        )?;
+        Ok(())
+    }
+
+
+
+    pub(crate) fn restore_worker_state(&mut self,
+        mut state: MicrovmState) -> Result<(), String> {
+        let mut timing = RestoreTiming::new("worker");
+        self.validate_worker(&state)?;
+        let prepared=self.worker_prepared.take().ok_or("EPT receiver is not prepared")?;
+        let (irqfds,sequence)=(prepared.irqfds,prepared.generation);
+        let legacy = self.device_manager.legacy_devices.as_ref().unwrap();
+        timing.mark("validation");
+        // Any subsequent failure leaves the worker paused and permanently blocks Resume.
+        self.worker_restore_failed = true;
+        let vm = self.vm.as_kvm().unwrap();
+        let before_fd = vm.fd().as_raw_fd();
+
+        timing.mark("quiesce_old_timers");
+        // KVM_IRQFD deassignment synchronizes its waitqueue and flushes injection work.
+        // Reading the eventfd counter alone cannot drain already-queued kernel work.
+
+        timing.mark("irqfd_deassign");
+        // Drain stale notifications before overwriting the saved IRQ controller state.
+
+        timing.mark("drain_old_events");
+        {
+            let mut handles = vm.vcpus_handles();
+            for (handle, incoming) in handles.iter_mut().zip(state.vcpu_states.drain(..)) {
+                handle.restore_without_kick(incoming);
+                match handle.response_receiver().recv_timeout(crate::RECV_TIMEOUT_SEC) {
+                    Ok(VcpuResponse::RestoredState) => (),
+                    response => return Err(format!("worker vCPU restore failed: {response:?}")),
+                }
+            }
+        }
+        timing.mark("vcpu_state_restore");
+        vm.restore_state(&state.vm_state, false)
+            .map_err(|e| e.to_string())?;
+        self.device_manager
+            .acpi_devices
+            .replay_gsi_allocations(vm)
+            .map_err(|e| e.to_string())?;
+        timing.mark("vm_irq_clock_restore");
+        {
+            for (event, gsi) in &irqfds {
+                vm.fd()
+                    .register_irqfd(event, *gsi)
+                    .map_err(|e| e.to_string())?;
+            }
+        }
+        timing.mark("irqfd_register");
+        legacy
+            .stdio_serial
+            .lock()
+            .unwrap()
+            .restore_worker(&state.device_states.serial_state.as_ref().unwrap().into())
+            .map_err(|e| e.to_string())?;
+        legacy.i8042.lock().unwrap().reset_worker();
+
+            // CPU-neutral device queue/clock restore, used by EPT workers.
+            self.device_manager.acpi_devices.restore_worker(
+                &state.device_states.acpi_state, vm.guest_memory()).map_err(|e| e.to_string())?;
+            let (crate::device_manager::VirtioDevices::Mmio(mmio),
+                VirtioDevicesState::Mmio(saved)) = (&mut self.device_manager.virtio_devices,
+                    &state.device_states.virtio_state) else { unreachable!() };
+            mmio.restore_worker(vm.guest_memory(), saved)?;
+
+        self.boot_source_config = state.vm_info.boot_source;
+        timing.mark("devices_restore");
+        let handles = vm.vcpus_handles();
+        crate::logger::info_unrestricted!(
+            "EPT_WORKER_IDENTITY {}",
+            serde_json::json!({
+                "sequence":sequence,"vm_fd":before_fd,"vm_ptr":format!("{:p}",vm.as_ref()),
+                "vcpu_fd":handles[0].vcpu_fd.as_raw_fd(),"ram_mapping_preserved":true,
+                "strict_irqfd":true,
+                "receiver_prepared":true,
+                "prepare_generation":Some(sequence),
+                "tlb_invalidation":if crate::ept_adopt::retained() {"retained_ept_invept"} else {"efer_nx_toggle"},
+                "vm_creates":0,"vcpu_creates":0,"thread_creates":0,
+            })
+        );
+        drop(handles);
+        self.worker_restore_failed = false;
+        timing.finish();
+        Ok(())
+    }
+}
