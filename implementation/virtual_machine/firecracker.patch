+// Experimental state-only checkpoint: the memory path names the existing DAX
+// allocation, rather than a dump file. No snapshot format or API change.
+pub(crate) fn dax_snapshot_offset(path: &Path) -> Result<Option<u64>, MemoryError> {
+    if crate::pool_memory::enabled() && crate::pool_memory::backing_matches(path) {
+        return Ok(Some(0)); // logical RAM is already resident in persistent CXL
+    }
+    if std::env::var("FC_DAX_SNAPSHOT").as_deref() != Ok("1")
+        || std::env::var_os("FC_DAX_RAM").as_deref() != Some(path.as_os_str())
+    {
+        return Ok(None);
+    }
+    std::env::var("FC_DAX_OFFSET")
+        .unwrap_or_else(|_| "2097152".into())
+        .parse()
+        .map(Some)
+        .map_err(|_| MemoryError::Dax("invalid FC_DAX_OFFSET".into()))
+}
