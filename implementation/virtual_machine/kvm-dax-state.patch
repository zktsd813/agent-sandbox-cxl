+		kvfree(ptr);
+}
+
+static inline void *kvm_dax_kmalloc(size_t size, gfp_t flags, const char *kind)
+{
+	if (kvm_dax_enabled())
+		return kvm_dax_alloc(size, 64, kind);
+	return kmalloc(size, flags);
+}
+
+static inline void *kvm_dax_kcalloc(size_t n, size_t size, gfp_t flags,
+				  const char *kind)
+{
+	if (kvm_dax_enabled())
+		return kvm_dax_alloc(array_size(n, size), 64, kind);
+	return kcalloc(n, size, flags);
+}
+
+static inline void *kvm_dax_kvmalloc_array(size_t n, size_t size, gfp_t flags,
+					 const char *kind)
+{
+	if (kvm_dax_enabled())
+		return kvm_dax_alloc(array_size(n, size), 64, kind);
+	return kvmalloc_array(n, size, flags);
+}
+
+static inline void *kvm_dax_kvzalloc(size_t size, gfp_t flags, const char *kind)
+{
+	if (kvm_dax_enabled())
+		return kvm_dax_alloc(size, 64, kind);
+	return kvzalloc(size, flags);
+}
+
+static inline void *kvm_dax_cache_alloc(struct kmem_cache *cache, gfp_t flags,
+				      const char *kind)
+{
+	if (kvm_dax_enabled())
+		return kvm_dax_alloc(kmem_cache_size(cache), 64, kind);
+	return kmem_cache_alloc(cache, flags);
+}
+
+static inline void kvm_dax_cache_free(struct kmem_cache *cache, void *ptr)
+{
+	if (!kvm_dax_free(ptr))
+		kmem_cache_free(cache, ptr);
+}
+
+static inline void *kvm_dax_cache_zalloc(struct kmem_cache *cache, gfp_t flags,
+				       const char *kind)
+{
+	if (kvm_dax_enabled())
+		return kvm_dax_alloc(kmem_cache_size(cache), 64, kind);
+	return kmem_cache_zalloc(cache, flags);
+}
+
+static inline unsigned long kvm_dax_get_page(gfp_t flags, const char *kind)
+{
+	if (kvm_dax_enabled())
+		return (unsigned long)kvm_dax_alloc(PAGE_SIZE, PAGE_SIZE, kind);
+	return get_zeroed_page(flags);
+}
+
+static inline void kvm_dax_put_page(unsigned long addr)
+{
+	if (!kvm_dax_free((void *)addr))
+		free_page(addr);
+}
+
+static inline struct page *kvm_dax_page(gfp_t flags, const char *kind)
+{
+	void *addr;
+
+	if (!kvm_dax_enabled())
+		return alloc_page(flags);
+	addr = kvm_dax_alloc(PAGE_SIZE, PAGE_SIZE, kind);
+	return addr ? virt_to_page(addr) : NULL;
+}
+
+static inline void kvm_dax_free_page(struct page *page)
+{
+	if (page && !kvm_dax_free(page_address(page)))
+		__free_page(page);
+}
+
+#endif
