+static long kvm_dax_vm_ioctl_locked(struct kvm *kvm, unsigned int cmd,
+		unsigned long arg, struct kvm_vcpu **vcpus, unsigned int nr)
+{
+	struct kvm_dax_shared *s = kvm_dax_shared();
+	struct kvm_dax_handoff out;
+	struct kvm_vcpu *vcpu = vcpus[0];
+	struct pid *pid;
+	unsigned int i;
+	u64 start = ktime_get_ns();
+	u64 profile_last = start;
+	struct kvm_dax_profile *profile;
+	u64 binding_start;
+	int r;
+
+	if (!capable(CAP_SYS_ADMIN) || !s || !kvm_dax_contains(kvm) ||
+	    !vcpu || !nr || nr > KVM_DAX_MAX_VCPUS || !kvm_dax_contains(vcpu))
+		return -EOPNOTSUPP;
+	profile = (void *)s + KVM_DAX_PROFILE_OFFSET;
+	if (cmd == KVM_DAX_VCPU) {
+		if (arg >= nr)
+			return -EINVAL;
+		vcpu = vcpus[arg];
+		kvm_get_kvm(kvm);
+		r = create_vcpu_fd(vcpu);
+		if (r < 0)
+			kvm_put_kvm_no_destroy(kvm);
+		return r;
+	}
+	if (cmd == KVM_DAX_LOCAL_RAM) {
+		if (!dax_scattered || arg > 1 || !kvm_dax_enabled() ||
+		    (s->state != KVM_DAX_EMPTY &&
+		     (s->vm != (unsigned long)kvm || s->state != KVM_DAX_OWNED)))
+			return -EPERM;
+		for (i = 0; i < nr; i++)
+			if (vcpus[i]->arch.complete_userspace_io)
+				return -EBUSY;
+		WRITE_ONCE(s->local_ram, arg);
+		return 0;
+	}
+	if (s->local_ram)
+		return -EOPNOTSUPP;
