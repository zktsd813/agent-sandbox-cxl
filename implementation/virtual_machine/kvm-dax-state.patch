+void kvm_mmu_dax_rebind(struct kvm_vcpu *vcpu)
+{
+	/* Objects in these caches are shared, slab allocator anchors are not. */
+	vcpu->arch.mmu_pte_list_desc_cache.kmem_cache = pte_list_desc_cache;
+	vcpu->arch.mmu_page_header_cache.kmem_cache = mmu_page_header_cache;
+	vcpu->kvm->arch.split_page_header_cache.kmem_cache = mmu_page_header_cache;
+	vcpu->kvm->arch.split_desc_cache.kmem_cache = pte_list_desc_cache;
+}
+
+int kvm_mmu_dax_ept_rebind(struct kvm_vcpu *vcpu, bool attach)
+{
+	/* Native metadata is stable in this kernel for never-reused DAX pages. */
+	static u64 seen_head;
+	struct kvm_dax_shared *s = kvm_dax_shared();
+	struct kvm_mmu_page *sp;
+	u64 p, count = 0;
+
+	if (!tdp_mmu_enabled || !VALID_PAGE(vcpu->arch.mmu->root.hpa) ||
+	    !kvm_dax_contains(__va(vcpu->arch.mmu->root.hpa)))
+		return -EOPNOTSUPP;
+	/* EXPORT captured this PFN; ATTACH checks current->mm before rebinding.
+	 * The cooperative ABI forbids VMA changes while this graph is exported.
+	 * Do not repeat GUP/PFN resolution during both detach and arch attach. */
+	for (p = s->ept_pages; p && (attach ? p != seen_head : !s->ept_validated);
+	     p = sp->dax_next) {
+		unsigned int i;
+		sp = (void *)(unsigned long)p;
+		if (++count > s->ept_page_count || !kvm_dax_contains(sp) ||
+		    !kvm_dax_contains(sp->spt) || !sp->tdp_mmu_page)
+			return -EXDEV;
+		if (attach) {
+			set_page_private(virt_to_page(sp->spt), (unsigned long)sp);
+			continue;
+		}
+		/* Refuse a retained translation to any source-private RAM. */
+		for (i = 0; i < SPTE_ENT_PER_PAGE; i++) {
+			u64 entry = READ_ONCE(sp->spt[i]);
+			kvm_pfn_t pfn = spte_to_pfn(entry);
+			if (!is_shadow_present_pte(entry))
+				continue;
+			if (is_last_spte(entry, sp->role.level)) {
+				u64 pages = KVM_PAGES_PER_HPAGE(sp->role.level);
+				if (!kvm_dax_data_pfn_valid(s, pfn, pages))
+					return -EXDEV;
+			} else if (!kvm_dax_contains(__va(pfn << PAGE_SHIFT))) {
+				return -EXDEV;
+			}
+		}
+	}
+	if (attach)
+		seen_head = s->ept_pages;
+	else
+		s->ept_validated = 1;
+	s->ept_root_hpa = vcpu->arch.mmu->root.hpa;
+	if (attach)
+		kvm_make_request(KVM_REQ_TLB_FLUSH_CURRENT, vcpu);
+	return 0;
+}
+
+void kvm_mmu_dax_invalidate(struct kvm *kvm)
+{
+	/* Zapping leaves alone retains the TDP MMU's root reference. Its
+	 * struct-page reverse mapping is node-local, so release roots too. */
+	if (!tdp_mmu_enabled)
+		return;
+	write_lock(&kvm->mmu_lock);
+	kvm_tdp_mmu_invalidate_all_roots(kvm);
+	write_unlock(&kvm->mmu_lock);
+	kvm_tdp_mmu_zap_invalidated_roots(kvm);
+	WARN_ON(atomic64_read(&kvm->arch.tdp_mmu_pages));
+	WARN_ON(!list_empty(&kvm->arch.tdp_mmu_roots));
+	/* The shared bump allocator never reuses retired EPT/header memory.
+	 * The RCU callback touches only that retired allocation, not @kvm.
+	 * Keep normal RCU retirement, but do not wait for callback execution. */
+	if (kvm_dax_shared()->handoff_mode < 2)
+		rcu_barrier();
+}
+#endif
 
