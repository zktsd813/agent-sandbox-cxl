+#ifdef CONFIG_KVM_DAX_POOL_TEST
+/* No full RAM resolution in the handoff path. Only a kernel-owned persistent
+ * mapping provider can prove scattered backing. Unknown providers fail closed. */
+static DEFINE_MUTEX(dax_mapping_provider_lock);
+static const struct vm_operations_struct *dax_mapping_ops;
+static int (*dax_mapping_identity)(struct vm_area_struct *, struct kvm_dax_mapping_identity *);
+int kvm_dax_register_mapping_provider(const struct vm_operations_struct *ops,
+    int (*identity)(struct vm_area_struct *, struct kvm_dax_mapping_identity *))
+{
+    int ret = 0;
+    if (!ops || !identity) return -EINVAL;
+    mutex_lock(&dax_mapping_provider_lock);
+    if (dax_mapping_ops) ret = -EBUSY;
+    else { dax_mapping_ops = ops; dax_mapping_identity = identity; }
+    mutex_unlock(&dax_mapping_provider_lock);
+    return ret;
+}
+EXPORT_SYMBOL_GPL(kvm_dax_register_mapping_provider);
+void kvm_dax_unregister_mapping_provider(const struct vm_operations_struct *ops)
+{
+    mutex_lock(&dax_mapping_provider_lock);
+    if (dax_mapping_ops == ops) { dax_mapping_ops = NULL; dax_mapping_identity = NULL; }
+    mutex_unlock(&dax_mapping_provider_lock);
+}
+EXPORT_SYMBOL_GPL(kvm_dax_unregister_mapping_provider);
+static int kvm_dax_data_map(struct kvm_dax_shared *s, bool check)
+{
+    struct kvm_dax_mapping_identity id, *old = &s->mapping_identity;
+    struct vm_area_struct *vma;
+    int ret = -EXDEV;
+    if (!s->scattered) return 0;
+    mmap_read_lock(current->mm);
+    mutex_lock(&dax_mapping_provider_lock);
+    vma = find_vma(current->mm, s->ram_hva);
+    if (!dax_mapping_ops || !vma || vma->vm_ops != dax_mapping_ops ||
+        vma->vm_start != s->ram_hva || vma->vm_end - vma->vm_start != s->ram_bytes ||
+        vma->vm_pgoff != 0) goto out;
+    ret = dax_mapping_identity(vma, &id);
+    if (ret) goto out;
+    if (id.ram_bytes != s->ram_bytes || !id.allocation_generation ||
+        (!check && !id.sealed) || (check && id.sealed)) { ret = -ESTALE; goto out; }
+    if (check) {
+        if (old->owner_epoch == U64_MAX || id.owner_epoch != old->owner_epoch + 1 ||
+            id.descriptor != old->descriptor || id.cookie_lo != old->cookie_lo ||
+            id.cookie_hi != old->cookie_hi || id.generation != old->generation ||
+            id.allocation_generation != old->allocation_generation) ret = -ESTALE;
+    } else *old = id;
+out:
+    mutex_unlock(&dax_mapping_provider_lock);
+    mmap_read_unlock(current->mm);
+    if (!ret) pr_info("KVM_DAX_MAP_PROOF attach=%d full_scan_pages=0 generation=%llu epoch=%llu\n",
+        check, id.generation, id.owner_epoch);
+    return ret;
+}
