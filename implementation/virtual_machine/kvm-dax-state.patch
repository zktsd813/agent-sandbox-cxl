+	if (kvm_dax_shared()->handoff_mode == 3) {
+		r = kvm_mmu_dax_ept_rebind(vcpu, false);
+		if (r)
+			return r;
+	} else {
+		vcpu_load(vcpu);
+		/* Unload destination-dependent EPT; retain VM/vCPU/VMCS. */
+		kvm_mmu_unload(vcpu);
+		vcpu_put(vcpu);
+	}
+	kvm_gpc_deactivate(&vcpu->arch.pv_time);
+	if (vcpu->vcpu_idx + 1 == kvm_dax_shared()->vcpu_count &&
+	    kvm_dax_shared()->handoff_mode != 3)
+		kvm_mmu_dax_invalidate(kvm);
+	kvm_dax_shared()->mmu_drain_ns += ktime_get_ns() - drained;
+	r = kvm_x86_ops.dax_handoff(vcpu, false);
+	return r;
+}
+EXPORT_SYMBOL_GPL(kvm_arch_dax_handoff);
