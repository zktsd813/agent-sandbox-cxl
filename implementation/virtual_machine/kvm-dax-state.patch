+retry_pool_write:
+#endif
 	r = follow_pte(vma->vm_mm, addr, &ptep, &ptl);
 	if (r) {
 		/*
@@ -2642,6 +2646,24 @@
 	pte = ptep_get(ptep);
 
 	if (write_fault && !pte_write(pte)) {
+#ifdef CONFIG_KVM_EPT_ADOPT
+		/* Opt-in CXL mapper owns pfn_mkwrite CoW. GUP cannot invoke it for
+		 * PFNMAP, and a read-populated canonical PTE needs an explicit
+		 * write fault before KVM can install a writable private CXL leaf.
+		 * Never call a sleeping fault handler while holding the PTE lock. */
+		if (!cow_retried && (vma->vm_flags & VM_WRITE) &&
+		    vma->vm_ops && vma->vm_ops->pfn_mkwrite) {
+			bool unlocked = false;
+			pte_unmap_unlock(ptep, ptl);
+			r = fixup_user_fault(current->mm, addr, FAULT_FLAG_WRITE, &unlocked);
+			if (unlocked)
+				return -EAGAIN;
+			if (r)
+				return r;
+			cow_retried = true;
+			goto retry_pool_write;
+		}
+#endif
 		pfn = KVM_PFN_ERR_RO_FAULT;
 		goto out;
 	}
@@ -6264,3 +6286,61 @@
 
 	return init_context.err;
 }
+
+#ifdef CONFIG_KVM_EPT_ADOPT
+/* Validate the live RAM mapper lease without walking guest PFNs. */
+static DEFINE_MUTEX(dax_mapping_provider_lock);
+static const struct vm_operations_struct *dax_mapping_ops;
+static int (*dax_mapping_identity)(struct vm_area_struct *, struct kvm_dax_mapping_identity *);
+int kvm_dax_register_mapping_provider(const struct vm_operations_struct *ops,
+    int (*identity)(struct vm_area_struct *, struct kvm_dax_mapping_identity *))
+{
+    int ret = 0;
+    if (!ops || !identity) return -EINVAL;
+    mutex_lock(&dax_mapping_provider_lock);
+    if (dax_mapping_ops) ret = -EBUSY;
+    else { dax_mapping_ops = ops; dax_mapping_identity = identity; }
+    mutex_unlock(&dax_mapping_provider_lock);
+    return ret;
+}
+EXPORT_SYMBOL_GPL(kvm_dax_register_mapping_provider);
+void kvm_dax_unregister_mapping_provider(const struct vm_operations_struct *ops)
+{
+    mutex_lock(&dax_mapping_provider_lock);
+    if (dax_mapping_ops == ops) { dax_mapping_ops = NULL; dax_mapping_identity = NULL; }
+    mutex_unlock(&dax_mapping_provider_lock);
+}
+EXPORT_SYMBOL_GPL(kvm_dax_unregister_mapping_provider);
+/* EPT-only admission: the current RAM VMA must be the registered persistent
+ * mapper, with a live local lease. No shared KVM graph or direct ioctl. */
+int kvm_ept_adopt_mapped(struct kvm *kvm)
+{
+    struct kvm_memory_slot *slot;
+    struct kvm_dax_mapping_identity id;
+    struct vm_area_struct *vma;
+    int bkt, count = 0, ret = -EXDEV;
+    mmap_read_lock(current->mm);
+    mutex_lock(&dax_mapping_provider_lock);
+    kvm_for_each_memslot(slot, bkt, kvm_memslots(kvm)) {
+        /* A later invalid VMA must not retain the previous slot's success. */
+        ret = -EXDEV;
+        count++;
+        vma = find_vma(current->mm, slot->userspace_addr);
+        if (!dax_mapping_ops || !vma || vma->vm_ops != dax_mapping_ops ||
+            vma->vm_start != slot->userspace_addr || vma->vm_pgoff ||
+            vma->vm_end - vma->vm_start != slot->npages * PAGE_SIZE)
+            goto out;
+        ret = dax_mapping_identity(vma, &id);
+        if (ret) goto out;
+        if (id.sealed || !id.allocation_generation || id.ram_bytes != slot->npages * PAGE_SIZE) {
+            ret = -ESTALE; goto out;
+        }
+    }
+    ret = count == 1 ? 0 : -EXDEV;
+out:
+    mutex_unlock(&dax_mapping_provider_lock);
+    mmap_read_unlock(current->mm);
+    return ret;
+}
+
+#endif
