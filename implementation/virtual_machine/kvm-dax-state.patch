+static int ept_adopt_init(struct kvm *kvm, struct kvm_ept_adopt *q)
+{
+    struct kvm_ept_adopt_state *s;
+    struct dev_pagemap *pgmap;
+    u64 end;
+    int i;
+    if (kvm->arch.ept_adopt || kvm_dax_enabled() || !tdp_mmu_enabled ||
+        !kvm_ad_enabled() || q->bump || q->root || q->role ||
+        !IS_ALIGNED(q->base, KVM_EPT_ADOPT_BYTES) ||
+        !IS_ALIGNED(q->data_base, PAGE_SIZE) || !q->data_bytes ||
+        !IS_ALIGNED(q->data_bytes, PAGE_SIZE) ||
+        check_add_overflow(q->base, KVM_EPT_ADOPT_BYTES - 1, &end))
+        return -EINVAL;
+    pgmap = get_dev_pagemap(q->base >> PAGE_SHIFT, NULL);
+    if (!pgmap)
+        return -EXDEV;
+    if (pgmap->type != MEMORY_DEVICE_GENERIC || pgmap->vmemmap_shift)
+        goto bad;
+    for (i = 0; i < pgmap->nr_range; i++)
+        if (q->base >= pgmap->ranges[i].start && end <= pgmap->ranges[i].end)
+            break;
+    if (i == pgmap->nr_range)
+        goto bad;
+    for (i = 0; i < KVM_EPT_ADOPT_BYTES / PAGE_SIZE; i++) {
+        unsigned long pfn = (q->base >> PAGE_SHIFT) + i;
+        if (!pfn_valid(pfn) || !is_zone_device_page(pfn_to_page(pfn)) ||
+            !virt_addr_valid(__va(pfn << PAGE_SHIFT)))
+            goto bad;
+    }
+    if (check_add_overflow(q->data_base, q->data_bytes - 1, &end) ||
+        !(end < q->base || q->data_base >= q->base + KVM_EPT_ADOPT_BYTES))
+        goto bad;
+    s = kzalloc(sizeof(*s), GFP_KERNEL_ACCOUNT);
+    if (!s) { put_dev_pagemap(pgmap); return -ENOMEM; }
+    s->pgmap = pgmap;
+    s->base = q->base;
+    s->data_base = q->data_base;
+    s->data_bytes = q->data_bytes;
+    s->released = !!(q->flags & KVM_EPT_ADOPT_WAIT);
+    spin_lock_init(&s->lock);
+    INIT_LIST_HEAD(&s->pages);
+    /* This is the sole pre-sharing initialization. Old native tables may be
+     * zapped here; neither release nor adopt below uses the zap path. */
+    write_lock(&kvm->mmu_lock);
+    kvm_tdp_mmu_invalidate_all_roots(kvm);
+    write_unlock(&kvm->mmu_lock);
+    kvm_tdp_mmu_zap_invalidated_roots(kvm);
+    rcu_barrier();
+    kvm->arch.ept_adopt = s;
+    return 0;
+bad:
+    put_dev_pagemap(pgmap);
+    return -EXDEV;
+}
+
+static int ept_adopt_release(struct kvm *kvm, struct kvm_ept_adopt *q)
+{
+    struct kvm_ept_adopt_state *s = kvm->arch.ept_adopt;
+    struct kvm_mmu_page *root, *sp, *next;
+    LIST_HEAD(pages);
+    int i;
+    write_lock(&kvm->mmu_lock);
+    if (list_empty(&kvm->arch.tdp_mmu_roots) ||
+        !list_is_singular(&kvm->arch.tdp_mmu_roots)) {
+        write_unlock(&kvm->mmu_lock);
+        return -EOPNOTSUPP;
+    }
+    root = list_first_entry(&kvm->arch.tdp_mmu_roots, struct kvm_mmu_page, link);
+    if (root->role.invalid || root->ept_adopt != s ||
+        refcount_read(&root->tdp_mmu_root_count) != 1) {
+        write_unlock(&kvm->mmu_lock);
+        return -EBUSY;
+    }
+    q->base = s->base; q->bump = s->bump;
+    q->root = __pa(root->spt) - s->base; q->role = root->role.word;
+    q->data_base = s->data_base; q->data_bytes = s->data_bytes; q->flags = 0;
+    for (i = 0; i < KVM_NR_PAGE_SIZES; i++)
+        q->pages[i] = atomic64_xchg(&kvm->stat.pages[i], 0);
+    /* No SPTE store, dirty-bit harvest, zap, or shared-page free here. */
+    list_del_rcu(&root->link);
+    spin_lock(&s->lock);
+    list_splice_init(&s->pages, &pages);
+    spin_unlock(&s->lock);
+    list_for_each_entry(sp, &pages, ept_adopt_link)
+        if (sp->ptep)
+            tdp_unaccount_mmu_page(kvm, sp);
+    write_unlock(&kvm->mmu_lock);
+    synchronize_rcu();
+    list_for_each_entry_safe(sp, next, &pages, ept_adopt_link) {
+        set_page_private(virt_to_page(sp->spt), 0);
+        kmem_cache_free(mmu_page_header_cache, sp);
+    }
+    /* Prior ordinary unlinks can have callbacks. None may survive release. */
+    rcu_barrier();
+    return 0;
+}
+
+static int ept_adopt_import(struct kvm *kvm, struct kvm_ept_adopt *q)
+{
+    struct kvm_ept_adopt_state *s = kvm->arch.ept_adopt;
+    union kvm_mmu_page_role role = { .word = q->role };
+    struct kvm_mmu_page *sp, *next, *root;
+    unsigned long *seen;
+    LIST_HEAD(pages);
+    int ret, i;
+    if (q->flags || q->base != s->base || q->data_base != s->data_base ||
+        q->data_bytes != s->data_bytes || !q->bump ||
+        q->bump > KVM_EPT_ADOPT_BYTES || q->bump < s->bump ||
+        !IS_ALIGNED(q->bump, PAGE_SIZE) || !role.direct || role.invalid ||
+        role.guest_mode || role.smm || role.ad_disabled ||
+        role.level < PG_LEVEL_4K || role.level > PT64_ROOT_5LEVEL)
+        return -EINVAL;
+    seen = bitmap_zalloc(KVM_EPT_ADOPT_BYTES / PAGE_SIZE, GFP_KERNEL);
+    if (!seen)
+        return -ENOMEM;
+    s->bump = q->bump; /* Packet high-water mark; only the owner changes it. */
+    ret = ept_adopt_walk(s, q->root, role, 0, NULL, seen, &pages);
+    bitmap_free(seen);
+    if (ret)
+        goto fail;
+    root = list_first_entry(&pages, struct kvm_mmu_page, ept_adopt_link);
+    refcount_set(&root->tdp_mmu_root_count, 1); /* TDP reference only. */
+    write_lock(&kvm->mmu_lock);
+    if (!list_empty(&kvm->arch.tdp_mmu_roots)) {
+        write_unlock(&kvm->mmu_lock); ret = -EBUSY; goto fail;
+    }
+    list_for_each_entry(sp, &pages, ept_adopt_link) {
+        set_page_private(virt_to_page(sp->spt), (unsigned long)sp);
+        if (sp->ptep)
+            tdp_account_mmu_page(kvm, sp);
+    }
+    list_splice_init(&pages, &s->pages);
+    list_add_rcu(&root->link, &kvm->arch.tdp_mmu_roots);
+    for (i = 0; i < KVM_NR_PAGE_SIZES; i++)
+        atomic64_set(&kvm->stat.pages[i], q->pages[i]);
+    write_unlock(&kvm->mmu_lock);
+    kvm_ept_adopt_nested_sync(s->base + q->root);
+    s->released = false;
+    return 0;
+fail:
+    list_for_each_entry_safe(sp, next, &pages, ept_adopt_link)
+        kmem_cache_free(mmu_page_header_cache, sp);
+    return ret;
+}
+
+int kvm_ept_adopt_ioctl(struct kvm *kvm, unsigned int cmd, unsigned long arg)
+{
+    struct kvm_ept_adopt q;
+    struct kvm_vcpu *vcpus[KVM_DAX_MAX_VCPUS];
+    struct kvm_ept_adopt_state *s;
+    struct kvm_memory_slot *slot;
+    struct kvm_memslots *slots;
+    int ret = -EINVAL, nr, locked = 0, bkt, i;
+    if (!capable(CAP_SYS_ADMIN))
+        return -EPERM;
+    if (copy_from_user(&q, (void __user *)arg, sizeof(q)))
+        return -EFAULT;
+    mutex_lock(&kvm->slots_lock);
+    nr = atomic_read(&kvm->online_vcpus);
+    if (!nr || nr > KVM_DAX_MAX_VCPUS || kvm_dax_contains(kvm) ||
+        kvm->dirty_ring_size || kvm->manual_dirty_log_protect)
+        goto out;
+    for (i = 0; i < nr; i++) {
+        vcpus[i] = kvm_get_vcpu(kvm, i);
+        if (!mutex_trylock(&vcpus[i]->mutex)) { ret = -EBUSY; goto out; }
+        locked++;
+        if (is_guest_mode(vcpus[i]) || is_smm(vcpus[i]) ||
+            vcpus[i]->arch.root_mmu.root_role.guest_mode)
+            goto out;
+    }
+    slots = kvm_memslots(kvm);
+    kvm_for_each_memslot(slot, bkt, slots)
+        if (!(slot->flags & KVM_MEM_LOG_DIRTY_PAGES))
+            goto out;
+    s = kvm->arch.ept_adopt;
+    if (cmd == KVM_EPT_ADOPT && q.flags & KVM_EPT_ADOPT_INIT) {
+        if (q.flags & ~(KVM_EPT_ADOPT_INIT | KVM_EPT_ADOPT_WAIT))
+            goto out;
+    } else if (!s || s->failed ||
+               (cmd == KVM_EPT_RELEASE ? s->released : !s->released)) {
+        ret = -EIO; goto out;
+    }
+    if (cmd == KVM_EPT_ADOPT && !q.flags) {
+        for (i = 0; i < nr; i++)
+            if (vcpus[i]->arch.root_mmu.root_role.word != q.role)
+                goto out;
+    }
+    /* Slot operations and all RUNs are excluded. Drop each vCPU's roots using
+     * ordinary reference release; valid TDP roots retain their MMU reference. */
+    for (i = 0; i < nr; i++) {
+        kvm_mmu_free_roots(kvm, &vcpus[i]->arch.root_mmu, KVM_MMU_ROOTS_ALL);
+        kvm_mmu_free_roots(kvm, &vcpus[i]->arch.guest_mmu, KVM_MMU_ROOTS_ALL);
+    }
+    if (cmd == KVM_EPT_ADOPT && q.flags & KVM_EPT_ADOPT_INIT) {
+        ret = ept_adopt_init(kvm, &q);
+    } else if (cmd == KVM_EPT_RELEASE) {
+        s->released = true;
+        kvm_for_each_memslot(slot, bkt, slots)
+            if (!bitmap_empty(slot->dirty_bitmap, slot->npages)) {
+                ret = -EBUSY; goto failed;
+            }
+        ret = ept_adopt_release(kvm, &q);
+    } else {
+        kvm_for_each_memslot(slot, bkt, slots)
+            bitmap_zero(slot->dirty_bitmap, slot->npages * 2);
+        ret = ept_adopt_import(kvm, &q);
+    }
+failed:
+    s = kvm->arch.ept_adopt;
+    if (ret && s)
+        s->failed = true;
+    for (i = 0; i < nr; i++)
+        kvm_make_request(KVM_REQ_TLB_FLUSH_CURRENT, vcpus[i]);
+    if (!ret && copy_to_user((void __user *)arg, &q, sizeof(q))) {
+        if (s) s->failed = true;
+        ret = -EFAULT;
+    }
+out:
+    while (locked)
+        mutex_unlock(&vcpus[--locked]->mutex);
+    mutex_unlock(&kvm->slots_lock);
+    return ret;
+}
+#endif
