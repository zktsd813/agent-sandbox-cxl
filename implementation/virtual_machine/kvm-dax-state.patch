+			return -EBUSY;
+		if (!kvm_x86_ops.dax_handoff ||
+		    kvm->arch.nx_huge_page_recovery_thread || kvm->dirty_ring_size ||
+		    !list_empty(&kvm->irqfds.items) || !list_empty(&kvm->ioeventfds))
+			return -EOPNOTSUPP;
+		s->vm = (unsigned long)kvm;
+		s->vcpu = (unsigned long)vcpu;
+		s->kernel_code = (unsigned long)kvm_dax_vm_ioctl;
+		s->vmx_code = (unsigned long)kvm_x86_ops.dax_handoff;
+		s->vm_bytes = sizeof(*kvm);
+		s->vcpu_bytes = sizeof(*vcpu);
+		if (dax_handoff_mode > 3 || dax_handoff_mode == 1)
+			return -EINVAL;
+		s->handoff_mode = dax_handoff_mode;
+		{
+			struct kvm_memory_slot *slot = id_to_memslot(__kvm_memslots(kvm, 0), 0);
+			if (!slot || slot->base_gfn || slot->dirty_bitmap)
+				return -EOPNOTSUPP;
+			s->ram_hva = slot->userspace_addr;
+			s->ram_bytes = slot->npages << PAGE_SHIFT;
+			s->scattered = dax_scattered;
+			if (s->scattered) {
+				if (dax_handoff_mode != 3 || !dax_data_bytes ||
+				    (dax_data_base | dax_data_bytes) & ~PAGE_MASK ||
+				    dax_data_base > U64_MAX - dax_data_bytes)
+					return -EINVAL;
+				s->data_pfn_base = dax_data_base >> PAGE_SHIFT;
+				s->data_pages = dax_data_bytes >> PAGE_SHIFT;
+				s->ram_pfns = (unsigned long)kvm_dax_alloc(
+					array_size(slot->npages, sizeof(u64)), 64, "direct_data_pfns");
+				if (!s->ram_pfns)
+					return -ENOMEM;
+				r = kvm_dax_data_map(s, false);
+				if (r)
+					return r;
+			}
+			if (s->handoff_mode == 3) {
+				s->ram_pfn = hva_to_pfn(s->ram_hva, false, false, NULL, false, NULL);
+				if (is_error_noslot_pfn(s->ram_pfn))
+					return -EFAULT;
+				kvm_release_pfn_clean(s->ram_pfn);
+			}
+		}
+		s->owner = kvm_dax_node();
+		kvm_get_kvm(kvm); /* Retain the shared graph until this bounded lab ends. */
+		dax_local_active = true;
+		smp_store_release(&s->state, KVM_DAX_OWNED);
+		pr_info("KVM_DAX_EXPORT vm=%llx vcpu=%llx node=%u\n",
+			kvm_dax_offset(kvm), kvm_dax_offset(vcpu), s->owner);
+	} else {
+		if (!kvm_dax_access(kvm) || s->vm != (unsigned long)kvm)
+			return -EACCES;
+		if (!mutex_trylock(&vcpu->mutex))
+			return -EBUSY;
+		/* A userspace IO/MMIO exit is not yet a completed guest instruction. */
+		if (vcpu->arch.complete_userspace_io || vcpu->arch.apf.msr_en_val ||
+		    !list_empty(&kvm->devices) ||
+		    (!list_empty(&kvm->gpc_list) &&
+		     (!list_is_singular(&kvm->gpc_list) ||
+		      list_first_entry(&kvm->gpc_list, struct gfn_to_pfn_cache, list) != &vcpu->arch.pv_time))) {
+			r = -EOPNOTSUPP;
+			goto unlock;
+		}
+		if (cmpxchg(&s->state, KVM_DAX_OWNED, KVM_DAX_BUSY) != KVM_DAX_OWNED) {
+			r = -EBUSY;
+			goto unlock;
+		}
+		r = kvm_dax_data_map(s, false);
+		if (r) {
+			smp_store_release(&s->state, KVM_DAX_FAILED);
+			goto unlock;
+		}
+		if (dax_handoff_profile)
+			memset(profile->detach, 0, sizeof(profile->detach));
+		r = kvm_arch_dax_handoff(vcpu, false);
+		if (r) {
+			smp_store_release(&s->state, KVM_DAX_FAILED);
+			goto unlock;
+		}
+		dax_profile_step(profile->detach, 0, &profile_last);
+		binding_start = ktime_get_ns();
+		/* Stop native observers before publishing the shared object graph. */
+		kvm_destroy_pm_notifier(kvm);
+		kvm_destroy_vm_debugfs(kvm);
+		kvm->debugfs_dentry = ERR_PTR(-ENOENT);
+		kvm->debugfs_stat_data = NULL;
+		mutex_lock(&kvm_lock);
+		list_del_init(&kvm->vm_list);
+		mutex_unlock(&kvm_lock);
+		dax_profile_step(profile->detach, 1, &profile_last);
+		/* Preserve the notifier reader drain without idle-heuristic batching. */
+		if (s->handoff_mode >= 2)
+			rcu_expedite_gp();
+		mmu_notifier_unregister(&kvm->mmu_notifier, kvm->mm);
+		if (s->handoff_mode >= 2)
+			rcu_unexpedite_gp();
+		memset(&kvm->mmu_notifier, 0, sizeof(kvm->mmu_notifier));
+		dax_profile_step(profile->detach, 2, &profile_last);
+		/* Xarray's radix nodes belong to the old kernel, not to the vCPU. */
+		xa_destroy(&kvm->vcpu_array);
+		/* MMU root destruction can defer freeing pages/headers through RCU. */
+		/* Retired radix nodes do not dereference the shared VM.  DAX MMU
+		 * retirement only frees immutable, never-reused arena allocations. */
+		if (s->handoff_mode < 2)
+			rcu_barrier();
+		dax_profile_step(profile->detach, 3, &profile_last);
+		cleanup_srcu_struct(&kvm->irq_srcu);
+		cleanup_srcu_struct(&kvm->srcu);
+		dax_profile_step(profile->detach, 4, &profile_last);
+		pid = rcu_dereference_protected(vcpu->pid, 1);
+		RCU_INIT_POINTER(vcpu->pid, NULL);
+		if (pid)
+			synchronize_rcu_expedited();
+		put_pid(pid);
+		dax_profile_step(profile->detach, 5, &profile_last);
+		mmdrop(kvm->mm);
+		kvm->mm = NULL;
+		vcpu->cpu = -1;
+		vcpu->last_used_slot = NULL;
+		s->owner = 0;
+		s->generation++;
+		s->detach_ns = ktime_get_ns() - start;
+		s->binding_ns = ktime_get_ns() - binding_start;
+		mutex_unlock(&vcpu->mutex);
+		dax_profile_step(profile->detach, 6, &profile_last);
+		smp_store_release(&s->state, KVM_DAX_DETACHED);
+	}
+	kvm_dax_result(kvm, &out, ktime_get_ns() - start);
+	return copy_to_user((void __user *)arg, &out, sizeof(out)) ? -EFAULT : 0;
+unlock:
+	mutex_unlock(&vcpu->mutex);
+	return r;
+}
+
+static long kvm_dax_attach(unsigned long arg, struct kvm *reuse)
+{
+	struct kvm_dax_shared *s = kvm_dax_shared();
+	struct kvm_dax_handoff in, out;
+	struct kvm *kvm;
+	struct kvm_vcpu *vcpu;
+	u64 start = ktime_get_ns();
+	u64 profile_last = start;
+	struct kvm_dax_profile *profile = (void *)s + KVM_DAX_PROFILE_OFFSET;
+	int r, fd;
+	bool locked = false, mm_ready = false, srcu_ready = false;
+	bool irq_srcu_ready = false, notifier_ready = false, listed = false;
+	bool arch_ready = false;
+
+	if (!capable(CAP_SYS_ADMIN) || !s)
+		return -EPERM;
+	if (copy_from_user(&in, (void __user *)arg, sizeof(in)))
+		return -EFAULT;
+	if (smp_load_acquire(&s->state) != KVM_DAX_DETACHED)
+		return -EBUSY;
+	if (s->kernel_code != (unsigned long)kvm_dax_vm_ioctl ||
+	    s->vmx_code != (unsigned long)kvm_x86_ops.dax_handoff ||
+	    s->vm_bytes != sizeof(*kvm) || s->vcpu_bytes != sizeof(*vcpu) ||
+	    s->handoff_mode != dax_handoff_mode)
+		return -EXDEV;
+	kvm = (void *)(unsigned long)s->vm;
+	if (reuse && reuse != kvm)
+		return -EINVAL;
+	if (!kvm_dax_contains(kvm) || (in.vm_offset && in.vm_offset != kvm_dax_offset(kvm)))
+		return -EINVAL;
+	if (s->scattered) {
+		/* Bind device metadata to this exact ownership generation and graph. */
+		if (!dax_scattered || dax_data_base >> PAGE_SHIFT != s->data_pfn_base ||
+		    dax_data_bytes >> PAGE_SHIFT != s->data_pages ||
+		    in.generation != s->generation || in.vm_offset != kvm_dax_offset(kvm) ||
+		    in.vcpu_offset != kvm_dax_offset((void *)(unsigned long)s->vcpu) ||
+		    in.vmcs_offset != s->vmcs || in.ram_hva != s->ram_hva ||
+		    in.ram_bytes != s->ram_bytes)
+			return -EXDEV;
+		r = kvm_dax_data_map(s, true);
+		if (r)
+			return r;
+	} else if (s->handoff_mode == 3) {
+		kvm_pfn_t first, last;
+		/* Validate current->mm before installing any native observers into
+		 * the shared core. A rejected mapping leaves DETACHED untouched. */
+		first = hva_to_pfn(s->ram_hva, false, false, NULL, false, NULL);
+		last = hva_to_pfn(s->ram_hva + s->ram_bytes - PAGE_SIZE,
+				  false, false, NULL, false, NULL);
+		if (!is_error_noslot_pfn(first))
+			kvm_release_pfn_clean(first);
+		if (!is_error_noslot_pfn(last))
+			kvm_release_pfn_clean(last);
+		if (first != s->ram_pfn || last != first + (s->ram_bytes >> PAGE_SHIFT) - 1)
+			return -EXDEV;
+	}
+	fd = reuse ? -1 : get_unused_fd_flags(O_CLOEXEC);
+	if (!reuse && fd < 0)
+		return fd;
+	if (cmpxchg(&s->state, KVM_DAX_DETACHED, KVM_DAX_BUSY) != KVM_DAX_DETACHED) {
+		if (fd >= 0)
+			put_unused_fd(fd);
+		return -EBUSY;
+	}
+	if (dax_handoff_profile)
+		memset(profile->attach, 0, sizeof(profile->attach));
+	dax_profile_step(profile->attach, 0, &profile_last);
+	/* No KVM_CREATE_VM, arch VM initialization, or vCPU allocation here. */
+	if (!dax_local_active) {
+		r = hardware_enable_all();
+		if (r)
+			goto fail;
+		__module_get(kvm_chardev_ops.owner);
+		preempt_notifier_inc();
+		dax_local_active = true;
+	}
+	mmgrab(current->mm);
+	mm_ready = true;
+	kvm->mm = current->mm;
+	dax_profile_step(profile->attach, 1, &profile_last);
+	memset(&kvm->srcu, 0, sizeof(kvm->srcu));
+	memset(&kvm->irq_srcu, 0, sizeof(kvm->irq_srcu));
+	r = init_srcu_struct(&kvm->srcu);
+	if (r)
+		goto fail;
+	srcu_ready = true;
+	r = init_srcu_struct(&kvm->irq_srcu);
+	if (r)
+		goto fail;
+	irq_srcu_ready = true;
+	dax_profile_step(profile->attach, 2, &profile_last);
+	r = kvm_init_mmu_notifier(kvm);
+	if (r)
+		goto fail;
+	notifier_ready = true;
+	dax_profile_step(profile->attach, 3, &profile_last);
+	vcpu = (void *)(unsigned long)s->vcpu;
+	if (!kvm_dax_contains(vcpu) || vcpu->kvm != kvm) {
+		r = -EINVAL;
+		goto fail;
+	}
+	mutex_lock(&vcpu->mutex);
+	locked = true;
+	xa_init(&kvm->vcpu_array);
+	r = xa_err(xa_store(&kvm->vcpu_array, 0, vcpu, GFP_KERNEL));
+	if (r)
+		goto fail;
+	preempt_notifier_init(&vcpu->preempt_notifier, &kvm_preempt_ops);
+	dax_profile_step(profile->attach, 4, &profile_last);
+	r = kvm_arch_dax_handoff(vcpu, true);
+	if (r)
+		goto fail;
+	arch_ready = true;
+	dax_profile_step(profile->attach, 5, &profile_last);
+	mutex_lock(&kvm_lock);
+	list_add(&kvm->vm_list, &vm_list);
+	mutex_unlock(&kvm_lock);
+	kvm_init_pm_notifier(kvm);
+	listed = true;
+	if (!reuse) {
+		struct file *file;
+		kvm_get_kvm(kvm);
+		file = anon_inode_getfile("kvm-dax-vm", &kvm_vm_fops, kvm, O_RDWR);
+		if (IS_ERR(file)) {
+			kvm_put_kvm_no_destroy(kvm);
+			r = PTR_ERR(file);
+			goto fail;
+		}
+		fd_install(fd, file);
+	}
+	dax_profile_step(profile->attach, 6, &profile_last);
+	mutex_unlock(&vcpu->mutex);
+	locked = false;
+	kvm->userspace_pid = task_pid_nr(current);
+	{
+		struct kvm_dax_resume_profile *resume =
+			(void *)s + KVM_DAX_RESUME_PROFILE_OFFSET;
+
+		memset(resume, 0, sizeof(*resume));
+		resume->generation = s->generation;
+		resume->enabled = dax_resume_profile;
+	}
+	s->owner = kvm_dax_node();
+	smp_store_release(&s->state, KVM_DAX_OWNED);
+	s->attach_ns = ktime_get_ns() - start;
+	kvm_dax_result(kvm, &out, s->attach_ns);
+	dax_profile_step(profile->attach, 7, &profile_last);
+	if (copy_to_user((void __user *)arg, &out, sizeof(out))) {
+		smp_store_release(&s->state, KVM_DAX_FAILED);
+		if (fd >= 0)
+			close_fd(fd);
+		fd = -1;
+		r = -EFAULT;
+		goto fail;
+	}
+	return reuse ? 0 : fd;
+fail:
+	/* Fail closed. This experimental graph must not be run after partial attach. */
+	smp_store_release(&s->state, KVM_DAX_FAILED);
+	if (arch_ready)
+		kvm_arch_dax_handoff(vcpu, false);
+	if (locked)
+		mutex_unlock(&vcpu->mutex);
+	if (listed) {
+		kvm_destroy_pm_notifier(kvm);
+		mutex_lock(&kvm_lock);
+		list_del_init(&kvm->vm_list);
+		mutex_unlock(&kvm_lock);
+	}
+	if (notifier_ready)
+		mmu_notifier_unregister(&kvm->mmu_notifier, kvm->mm);
+	if (irq_srcu_ready)
+		cleanup_srcu_struct(&kvm->irq_srcu);
+	if (srcu_ready)
+		cleanup_srcu_struct(&kvm->srcu);
+	if (mm_ready) {
+		mmdrop(kvm->mm);
+		kvm->mm = NULL;
+	}
+	if (fd >= 0)
+		put_unused_fd(fd);
+	return r;
+}
