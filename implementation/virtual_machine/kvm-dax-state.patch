diff --git a/include/uapi/linux/kvm_dax.h b/include/uapi/linux/kvm_dax.h
new file mode 100644
--- /dev/null
+++ b/include/uapi/linux/kvm_dax.h
@@ -0,0 +1,72 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _UAPI_LINUX_KVM_DAX_H
+#define _UAPI_LINUX_KVM_DAX_H
+#include <linux/types.h>
+#include <linux/ioctl.h>
+
+/* Private laboratory ABI, CONFIG_KVM_DAX_POOL_TEST only. */
+#define KVM_DAX_ABI_VERSION 2
+#define KVM_DAX_MAX_VCPUS 8
+struct kvm_dax_vcpu_identity {
+	__u32 id, reserved;
+	__u64 vcpu_offset, vmcs_offset, run_offset, ept_root_offset;
+};
+struct kvm_dax_handoff {
+	__u64 vm_offset, vcpu_offset, vmcs_offset, run_offset;
+	__u64 generation, kernel_ns, pool_used;
+	__u64 vm_creates, vcpu_creates;
+	__u64 ram_hva, ram_bytes;
+	__u32 node, flags;
+	__u64 quiesce_ns, mmu_drain_ns, binding_ns;
+	__u64 ept_root_offset, ept_page_count;
+	__u32 abi_version, vcpu_count;
+	struct kvm_dax_vcpu_identity vcpus[KVM_DAX_MAX_VCPUS];
+};
+#define KVM_DAX_EXPORT _IOR(0xae, 0xf0, struct kvm_dax_handoff)
+#define KVM_DAX_ATTACH _IOWR(0xae, 0xf1, struct kvm_dax_handoff)
+#define KVM_DAX_DETACH _IOR(0xae, 0xf2, struct kvm_dax_handoff)
+#define KVM_DAX_VCPU _IO(0xae, 0xf3)
+#define KVM_DAX_PEEK _IOR(0xae, 0xf4, struct kvm_dax_handoff)
+#define KVM_DAX_REATTACH _IOWR(0xae, 0xf5, struct kvm_dax_handoff)
+/* Host-local cache maintenance receipts; not part of the shared VM graph. */
+struct kvm_dax_cache_stats {
+	__u64 wb_ns, invalidate_ns, wb_bytes, invalidate_bytes;
+	__u64 wb_lines, invalidate_lines, wb_verified, invalidate_verified;
+};
+/* Host-local administration. stage 0=query, 1=retire+invalidate, 2=arm reuse.
+ * Stage 2 requires controller ACKs from every participating host (lab A+B).
+ * No live wrapper or transferred fd may survive retirement. */
+struct kvm_dax_arena { __u64 offset, capacity, used, lines, stage, acknowledgements; };
+#define KVM_DAX_ARENA _IOWR(0xae, 0xf9, struct kvm_dax_arena)
+#define KVM_DAX_CACHE_STATS _IOR(0xae, 0xf8, struct kvm_dax_cache_stats)
+#define KVM_DAX_IRQFD_QUIESCE _IO(0xae, 0xf6)
+/* Scalar arg: 1 permits owner-local DRAM; 0 arms shared-only export. Paused owner only. */
+#define KVM_DAX_LOCAL_RAM _IO(0xae, 0xf7)
+/* Optional timing data in the reserved first arena page; not migration state. */
+#define KVM_DAX_PROFILE_OFFSET 2048
+struct kvm_dax_profile {
+	__u64 detach[8], attach[8];
+};
+#define KVM_DAX_RESUME_PROFILE_OFFSET 2176
+/* Destination-local clock samples, overwritten at each attach. Diagnostic only. */
+struct kvm_dax_resume_profile {
+	__u64 enabled, generation, run_ns, entry_ready;
+	__u64 entry_ns, guest_tsc, virtual_tsc_khz, sample_span_ns, entry_rip;
+	__u64 exit_ready, exit_ns, exit_reason, entry_failed;
+	__u64 entry_l1_tsc, last_exit_l1_tsc, l1_tsc_khz;
+};
+/* EPT-only mode. VM-fd ioctls, separate from the direct graph ABI.
+ * INIT registers this VM's private 16 MiB extent before shared execution.
+ * WAIT leaves a prepared receiver unable to run until an ADOPT succeeds. */
+#define KVM_EPT_ADOPT_INIT 1
+#define KVM_EPT_ADOPT_WAIT 2
+#define KVM_EPT_ADOPT_BYTES (16ULL << 20)
+struct kvm_ept_adopt {
+    __u64 base, bump, root; /* Physical extent base; byte offsets bump/root. */
+    __u64 data_base, data_bytes;
+    __u64 pages[3]; /* Local mapping gauges; avoid a leaf walk on import. */
+    __u32 role, flags;
+};
+#define KVM_EPT_RELEASE _IOWR(0xae, 0xfa, struct kvm_ept_adopt)
+#define KVM_EPT_ADOPT _IOWR(0xae, 0xfb, struct kvm_ept_adopt)
+#endif
