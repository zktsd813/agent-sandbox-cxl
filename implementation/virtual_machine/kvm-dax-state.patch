+/* Cooperative stopped VM: retire simple IRQFDs in the caller, with one GP.
+ * No worker scheduling and no global cleanup-workqueue flush are needed.
+ * Removing the active-list entry prevents HUP from queuing shutdown twice. */
+int kvm_dax_irqfd_quiesce(struct kvm *kvm)
+{
+	struct kvm_kernel_irqfd *fds[8], *irqfd;
+	struct kvm_vcpu *vcpu = kvm_get_vcpu(kvm, 0);
+	unsigned int count = 0, i;
+	int ret = 0;
+
+	if (!vcpu || atomic_read(&kvm->online_vcpus) != 1 ||
+	    !mutex_trylock(&vcpu->mutex))
+		return -EBUSY;
+	spin_lock_irq(&kvm->irqfds.lock);
+	list_for_each_entry(irqfd, &kvm->irqfds.items, list) {
+		if (count == ARRAY_SIZE(fds) || irqfd->resampler) {
+			ret = -EOPNOTSUPP;
+			goto unlock;
+		}
+#ifdef CONFIG_HAVE_KVM_IRQ_BYPASS
+		if (irqfd->producer) {
+			ret = -EOPNOTSUPP;
+			goto unlock;
+		}
+#endif
+		fds[count++] = irqfd;
+	}
+	for (i = 0; i < count; i++)
+		list_del_init(&fds[i]->list);
+unlock:
+	spin_unlock_irq(&kvm->irqfds.lock);
+	if (!ret && count) {
+		irqfd_synchronize_srcu(kvm);
+		for (i = 0; i < count; i++)
+			irqfd_shutdown_common(fds[i], true);
+	}
+	mutex_unlock(&vcpu->mutex);
+	return ret;
+}
