+/* Read faults must not break an immutable canonical mapping's CoW protection.
+ * Device writers and vCPUs are quiesced by the privileged userspace owner.
+ * check=true validates every target page before any native observer is bound. */
+static int kvm_dax_data_map(struct kvm_dax_shared *s, bool check)
+{
+	u64 i, count = s->ram_bytes >> PAGE_SHIFT;
+	u64 *pfns = (void *)(unsigned long)s->ram_pfns;
+
+	if (!s->scattered)
+		return 0;
+	if (!count || !s->data_pages || !kvm_dax_contains(pfns) ||
+	    !kvm_dax_contains(pfns + count - 1))
