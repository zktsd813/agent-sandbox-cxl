+static inline bool kvm_dax_data_pfn_valid(struct kvm_dax_shared *s,
+		unsigned long pfn, u64 pages)
+{
+	u64 first = s->scattered ? s->data_pfn_base : s->ram_pfn;
+	u64 count = s->scattered ? s->data_pages : s->ram_bytes >> PAGE_SHIFT;
+	return pages && pfn >= first && pfn - first < count &&
+		pages <= count - (pfn - first);
