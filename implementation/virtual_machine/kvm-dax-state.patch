+		if (!vcpu->arch.apic && !dax_noapic_key) {
+			static_branch_inc(&kvm_has_noapic_vcpu);
+			dax_noapic_key = true;
+		}
+		kvm_mmu_dax_rebind(vcpu);
+		if (kvm_dax_shared()->handoff_mode == 3) {
+			r = kvm_mmu_dax_ept_rebind(vcpu, true);
+			if (r)
