+#ifdef CONFIG_KVM_DAX_POOL_TEST
+int kvm_pit_dax_handoff(struct kvm *kvm, bool attach)
+{
+	/* One shared VM per kernel in this bounded lab; keep its local worker. */
+	static struct kthread_worker *dax_worker;
+	struct kvm_pit *pit = kvm->arch.vpit;
+	struct kvm_dax_shared *s = kvm_dax_shared();
+	s64 delta;
+	int i;
+
+	if (!pit)
+		return 0;
+	if (!attach) {
+		s->pit_remaining = ktime_to_ns(hrtimer_get_expires(&pit->pit_state.timer)) - s->host_clock_ns;
+		s->pit_active = hrtimer_cancel(&pit->pit_state.timer);
+		if (s->handoff_mode == 3) {
+			/* Only expired is queued on this worker; avoid waking an idle
+			 * worker for a synthetic barrier (same drain as timer teardown). */
+			kthread_flush_work(&pit->expired);
+			dax_worker = pit->worker;
+		} else {
+			kthread_destroy_worker(pit->worker);
+		}
+		pit->worker = NULL;
+		return 0;
+	}
+	pit->worker = s->handoff_mode == 3 && dax_worker ? dax_worker :
+		kthread_create_worker(0, "kvm-dax-pit/%d", task_pid_nr(current));
+	if (IS_ERR(pit->worker))
+		return PTR_ERR(pit->worker);
+	kthread_init_work(&pit->expired, pit_do_work);
+	delta = ktime_get_ns() - s->host_clock_ns;
+	for (i = 0; i < 3; i++)
+		pit->pit_state.channels[i].count_load_time = ktime_add_ns(pit->pit_state.channels[i].count_load_time, delta);
+	hrtimer_init(&pit->pit_state.timer, CLOCK_MONOTONIC, HRTIMER_MODE_ABS);
+	pit->pit_state.timer.function = pit_timer_fn;
+	if (s->pit_active)
+		hrtimer_start(&pit->pit_state.timer,
+			ktime_add_ns(ktime_get(), max_t(s64, 1, s->pit_remaining)), HRTIMER_MODE_ABS);
+	if (atomic_read(&pit->pit_state.pending))
+		kthread_queue_work(pit->worker, &pit->expired);
+	return 0;
+}
