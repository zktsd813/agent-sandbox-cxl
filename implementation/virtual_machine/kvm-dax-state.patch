+	u64 magic;
+	unsigned long raw;
+	size_t total;
+	u32 kind;
+};
+
+struct dax_kind {
+	const char *name;
+	unsigned long live;
+	unsigned long allocs;
+	unsigned long frees;
+	unsigned long bytes;
+};
+
+static struct gen_pool *dax_pool;
+static struct dev_pagemap *dax_pgmap;
+static phys_addr_t dax_phys;
+static size_t dax_size;
+static void *dax_base;
+static DEFINE_MUTEX(dax_config_lock);
+static DEFINE_SPINLOCK(dax_stats_lock);
+static struct dax_kind dax_kinds[DAX_KINDS];
+static unsigned int dax_nr_kinds;
+static unsigned long dax_failures;
+static unsigned int dax_shared_mode, dax_node;
+static unsigned int dax_owner_pid;
+module_param_named(dax_shared, dax_shared_mode, uint, 0600);
+module_param_named(dax_node, dax_node, uint, 0600);
+module_param_named(dax_owner_pid, dax_owner_pid, uint, 0600);
+MODULE_PARM_DESC(dax_owner_pid, "LAB: optional selected VMM TGID; ordinary peers retain native allocations (0 = legacy global)");
+MODULE_PARM_DESC(dax_shared, "LAB: 1 initializes a shared bump arena; 2 attaches without clearing; allocations retained until lab shutdown");
+
+struct kvm_dax_shared *kvm_dax_shared(void)
+{
+	return dax_shared_mode && dax_base ? dax_base : NULL;
+}
+EXPORT_SYMBOL_GPL(kvm_dax_shared);
+
+unsigned int kvm_dax_node(void) { return dax_node; }
+EXPORT_SYMBOL_GPL(kvm_dax_node);
+
+u64 kvm_dax_offset(const void *ptr)
+{
+	return kvm_dax_contains(ptr) ? (unsigned long)ptr - (unsigned long)dax_base : U64_MAX;
+}
+EXPORT_SYMBOL_GPL(kvm_dax_offset);
+
+bool kvm_dax_enabled(void)
+{
+	/* Pair with publication after the mapping and arena are initialized. */
+	return smp_load_acquire(&dax_pool) != NULL &&
+		(!READ_ONCE(dax_owner_pid) || task_tgid_nr(current) == READ_ONCE(dax_owner_pid));
+}
+EXPORT_SYMBOL_GPL(kvm_dax_enabled);
+
+bool kvm_dax_contains(const void *ptr)
+{
+	return dax_base && (unsigned long)ptr >= (unsigned long)dax_base &&
+		(unsigned long)ptr - (unsigned long)dax_base < dax_size;
+}
+EXPORT_SYMBOL_GPL(kvm_dax_contains);
+
+void *kvm_dax_alloc(size_t size, size_t align, const char *kind)
+{
+	/* Allocators may run on a different CPU from the configuring task. */
+	struct gen_pool *pool = smp_load_acquire(&dax_pool);
+	struct dax_alloc_header *header;
+	unsigned long raw, addr, flags;
+	size_t total;
+	unsigned int i;
+	bool first;
+
+	if (!pool || !size || !is_power_of_2(align) ||
+	    check_add_overflow(size, align + sizeof(*header), &total))
+		return NULL;
+	if (dax_shared_mode) {
+		struct kvm_dax_shared *s = dax_base;
+		u64 old, next;
+		do {
+			old = READ_ONCE(s->bump);
+			addr = ALIGN((unsigned long)dax_base + old + sizeof(*header), align);
+			next = addr - (unsigned long)dax_base + size;
+			if (next > dax_size)
+				return NULL;
+		} while (cmpxchg(&s->bump, old, next) != old);
+		header = (void *)(addr - sizeof(*header));
+		header->magic = DAX_ALLOC_MAGIC;
+		header->raw = (unsigned long)dax_base + old;
+		header->total = next - old;
+		header->kind = 0;
+		memset((void *)addr, 0, size);
+		return (void *)addr;
+	}
+	raw = gen_pool_alloc(pool, total);
+	if (!raw) {
+		spin_lock_irqsave(&dax_stats_lock, flags);
+		dax_failures++;
+		spin_unlock_irqrestore(&dax_stats_lock, flags);
+		return NULL;
+	}
+	addr = ALIGN(raw + sizeof(*header), align);
+	header = (void *)(addr - sizeof(*header));
+	spin_lock_irqsave(&dax_stats_lock, flags);
+	for (i = 0; i < dax_nr_kinds; i++)
+		if (!strcmp(dax_kinds[i].name, kind))
+			break;
+	if (i == DAX_KINDS) {
+		dax_failures++;
+		spin_unlock_irqrestore(&dax_stats_lock, flags);
+		gen_pool_free(pool, raw, total);
+		return NULL;
+	}
+	if (i == dax_nr_kinds) {
+		dax_kinds[i].name = kind;
+		dax_nr_kinds++;
+	}
+	first = !dax_kinds[i].allocs;
+	dax_kinds[i].live++;
+	dax_kinds[i].allocs++;
+	dax_kinds[i].bytes += total;
+	spin_unlock_irqrestore(&dax_stats_lock, flags);
+	header->magic = DAX_ALLOC_MAGIC;
+	header->raw = raw;
+	header->total = total;
+	header->kind = i;
+	memset((void *)addr, 0, size);
+	if (first) {
+		phys_addr_t pa = dax_phys + addr - (unsigned long)dax_base;
+
+		pr_info("KVM_DAX_ALLOC kind=%s kva=%px pa=%pa bytes=%zu\n",
+			kind, (void *)addr, &pa, size);
+	}
+	return (void *)addr;
+}
+EXPORT_SYMBOL_GPL(kvm_dax_alloc);
+
+bool kvm_dax_free(const void *ptr)
+{
+	struct dax_alloc_header *header;
+	unsigned long flags, raw;
+	size_t total;
+
+	if (!kvm_dax_contains(ptr))
+		return false;
+	/* Bounded experiment: no reuse, so neither node owns a private free bitmap. */
+	if (dax_shared_mode)
+		return true;
+	header = (void *)((unsigned long)ptr - sizeof(*header));
+	if (WARN_ON_ONCE(header->magic != DAX_ALLOC_MAGIC))
+		return true;
+	raw = header->raw;
+	total = header->total;
+	spin_lock_irqsave(&dax_stats_lock, flags);
+	dax_kinds[header->kind].live--;
+	dax_kinds[header->kind].frees++;
+	dax_kinds[header->kind].bytes -= total;
+	spin_unlock_irqrestore(&dax_stats_lock, flags);
+	header->magic = 0;
+	gen_pool_free(dax_pool, raw, total);
+	return true;
+}
+EXPORT_SYMBOL_GPL(kvm_dax_free);
+
+void kvm_dax_ref(const char *field, const void *ptr)
+{
+	if (kvm_dax_enabled())
+		pr_info("KVM_DAX_REF field=%s target=%s kva=%px offset=%lu\n",
+			field, !ptr ? "null" : kvm_dax_contains(ptr) ? "pool" : "host",
+			ptr, kvm_dax_contains(ptr) ?
+			(unsigned long)ptr - (unsigned long)dax_base : 0);
+}
+EXPORT_SYMBOL_GPL(kvm_dax_ref);
+
+void kvm_dax_field(const char *field, const void *storage, const void *ptr)
+{
+	if (kvm_dax_contains(storage))
+		pr_info("KVM_DAX_FIELD field=%s storage_offset=%lu value=%016lx target=%s\n",
+			field, (unsigned long)storage - (unsigned long)dax_base,
+			(unsigned long)ptr,
+			!ptr ? "null" : kvm_dax_contains(ptr) ? "pool" : "host");
+}
+EXPORT_SYMBOL_GPL(kvm_dax_field);
+
+static int dax_pool_set(const char *val, const struct kernel_param *kp)
+{
+	unsigned long long phys, size;
+	struct dev_pagemap *pgmap;
+	struct gen_pool *pool;
+	unsigned long pfn;
+	u64 end;
+	int rc = -EINVAL, i;
+	char tail;
+
+	if (sscanf(val, "%llx,%llx %c", &phys, &size, &tail) != 2 ||
+	    !size || !IS_ALIGNED(phys, PAGE_SIZE) || !IS_ALIGNED(size, PAGE_SIZE) ||
+	    check_add_overflow((u64)phys, (u64)size - 1, &end))
+		return -EINVAL;
+	if (!boot_cpu_has(X86_FEATURE_VMX) || !tdp_enabled)
+		return -EOPNOTSUPP;
+	mutex_lock(&dax_config_lock);
+	if (dax_pool) {
+		rc = -EBUSY;
+		goto out;
+	}
+	pgmap = get_dev_pagemap(PHYS_PFN(phys), NULL);
+	if (!pgmap)
+		goto out;
+	if (pgmap->type != MEMORY_DEVICE_GENERIC || pgmap->vmemmap_shift)
+		goto put_pgmap;
+	for (i = 0; i < pgmap->nr_range; i++)
+		if (phys >= pgmap->ranges[i].start && end <= pgmap->ranges[i].end)
+			break;
+	if (i == pgmap->nr_range)
+		goto put_pgmap;
+	for (pfn = PHYS_PFN(phys); pfn <= PHYS_PFN(end); pfn++)
+		if (!pfn_valid(pfn) || !is_zone_device_page(pfn_to_page(pfn)) ||
+		    !virt_addr_valid(__va(PFN_PHYS(pfn))))
+			goto put_pgmap;
+	pool = gen_pool_create(6, NUMA_NO_NODE);
+	if (!pool) {
+		rc = -ENOMEM;
+		goto put_pgmap;
+	}
+	rc = gen_pool_add_virt(pool, (unsigned long)__va(phys), phys, size,
+			       NUMA_NO_NODE);
+	if (rc) {
+		gen_pool_destroy(pool);
+		goto put_pgmap;
+	}
+	dax_base = __va(phys);
+	dax_phys = phys;
+	dax_size = size;
+	dax_pgmap = pgmap;
+	if (dax_shared_mode) {
+		struct kvm_dax_shared *s = dax_base;
+		if (!dax_node || dax_shared_mode > 2) {
+			rc = -EINVAL;
+			goto bad_shared;
+		}
+		if (dax_shared_mode == 1) {
+			memset(s, 0, PAGE_SIZE);
+			s->bump = PAGE_SIZE;
+			s->kva = (unsigned long)dax_base;
+			s->phys = phys;
+			smp_store_release(&s->magic, 0x43584c4b564d3031ULL);
+		} else if (smp_load_acquire(&s->magic) != 0x43584c4b564d3031ULL ||
+			   s->kva != (unsigned long)dax_base || s->phys != phys) {
+			rc = -EXDEV;
+			goto bad_shared;
+		}
+	}
+	/* Publish all immutable mapping fields before any allocator can run. */
+	smp_store_release(&dax_pool, pool);
+	pr_info("KVM_DAX_POOL pa=%pa bytes=%zu page_metadata=4K\n", &dax_phys, dax_size);
+	goto out;
+bad_shared:
+	gen_pool_destroy(pool);
+	dax_base = NULL;
+put_pgmap:
+	put_dev_pagemap(pgmap);
+out:
+	mutex_unlock(&dax_config_lock);
+	return rc;
+}
+
+static int dax_pool_get(char *buffer, const struct kernel_param *kp)
+{
+	unsigned long flags;
+	unsigned int i;
+	int n;
+
+	n = scnprintf(buffer, PAGE_SIZE,
+		      "enabled=%u phys=%llx bytes=%zu available=%zu failures=%lu\n",
+		      dax_pool != NULL, (unsigned long long)dax_phys, dax_size,
+		      dax_pool ? gen_pool_avail(dax_pool) : 0, dax_failures);
+	if (kvm_dax_shared())
+		n += scnprintf(buffer + n, PAGE_SIZE - n,
+			"shared=%u node=%u state=%u owner=%u used=%llu generation=%llu\n",
+			dax_shared_mode, dax_node, kvm_dax_shared()->state,
+			kvm_dax_shared()->owner, kvm_dax_shared()->bump,
+			kvm_dax_shared()->generation);
+	if (kvm_dax_shared())
+		n += scnprintf(buffer + n, PAGE_SIZE - n,
+			"vm_create_calls=%llu vcpu_create_calls=%llu\n",
+			kvm_dax_shared()->vm_create_calls, kvm_dax_shared()->vcpu_create_calls);
+	spin_lock_irqsave(&dax_stats_lock, flags);
+	for (i = 0; i < dax_nr_kinds; i++)
+		n += scnprintf(buffer + n, PAGE_SIZE - n,
+			       "%s live=%lu allocs=%lu frees=%lu bytes=%lu\n",
+			       dax_kinds[i].name, dax_kinds[i].live, dax_kinds[i].allocs,
+			       dax_kinds[i].frees, dax_kinds[i].bytes);
+	spin_unlock_irqrestore(&dax_stats_lock, flags);
+	return n;
+}
+
+static const struct kernel_param_ops dax_pool_ops = {
+	.set = dax_pool_set,
+	.get = dax_pool_get,
+};
+module_param_cb(dax_pool, &dax_pool_ops, NULL, 0600);
+MODULE_PARM_DESC(dax_pool,
+	"LAB ONLY: device-DAX physical start,size in hex; configure once before creating VMs");
+
+void kvm_dax_pool_exit(void)
+{
+	if (!dax_pool)
+		return;
+	WARN_ON(gen_pool_avail(dax_pool) != gen_pool_size(dax_pool));
+	gen_pool_destroy(dax_pool);
+	WRITE_ONCE(dax_pool, NULL);
+	put_dev_pagemap(dax_pgmap);
+	dax_base = NULL;
+}
