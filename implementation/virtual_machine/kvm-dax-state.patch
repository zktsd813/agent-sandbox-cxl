+		return -EBUSY;
+	if (in.abi_version != KVM_DAX_ABI_VERSION ||
+	    s->abi_version != KVM_DAX_ABI_VERSION ||
+	    !s->vcpu_count || s->vcpu_count > KVM_DAX_MAX_VCPUS ||
+	    in.vcpu_count != s->vcpu_count || in.generation != s->generation)
+		return -EXDEV;
+	if (s->kernel_code != (unsigned long)kvm_dax_vm_ioctl ||
+	    s->vmx_code != (unsigned long)kvm_x86_ops.dax_handoff ||
+	    s->vm_bytes != sizeof(*kvm) || s->vcpu_bytes != sizeof(*vcpu) ||
+	    s->handoff_mode != dax_handoff_mode)
+		return -EXDEV;
+	kvm = (void *)(unsigned long)s->vm;
+	if (reuse && reuse != kvm)
+		return -EINVAL;
+	if (!kvm_dax_contains(kvm) || (in.vm_offset && in.vm_offset != kvm_dax_offset(kvm)))
+		return -EINVAL;
+	{
+		struct kvm_dax_handoff expected;
+		kvm_dax_result(kvm, &expected, 0);
+		if (in.vm_offset != expected.vm_offset ||
+		    in.vcpu_offset != expected.vcpu_offset ||
+		    in.vmcs_offset != expected.vmcs_offset ||
+		    in.run_offset != expected.run_offset ||
+		    memcmp(in.vcpus, expected.vcpus, sizeof(in.vcpus)))
+			return -EXDEV;
+	}
+	for (i = 0; i < s->vcpu_count; i++) {
+		vcpus[i] = (void *)(unsigned long)s->vcpus[i].vcpu;
+		if (!kvm_dax_contains(vcpus[i]) || vcpus[i]->kvm != kvm ||
+		    vcpus[i]->vcpu_idx != i || vcpus[i]->vcpu_id != in.vcpus[i].id)
+			return -EXDEV;
+	}
+	if (s->scattered) {
+		/* Bind device metadata to this exact ownership generation and graph. */
+		if (!dax_scattered || dax_data_base >> PAGE_SHIFT != s->data_pfn_base ||
+		    dax_data_bytes >> PAGE_SHIFT != s->data_pages ||
+		    in.generation != s->generation || in.vm_offset != kvm_dax_offset(kvm) ||
+		    in.vcpu_offset != kvm_dax_offset((void *)(unsigned long)s->vcpu) ||
+		    in.vmcs_offset != s->vmcs || in.ram_hva != s->ram_hva ||
+		    in.ram_bytes != s->ram_bytes)
+			return -EXDEV;
