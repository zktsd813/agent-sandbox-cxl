+static long kvm_dax_vm_ioctl(struct kvm *kvm, unsigned int cmd, unsigned long arg)
+{
+	struct kvm_vcpu *vcpus[KVM_DAX_MAX_VCPUS];
+	struct kvm_dax_shared *s = kvm_dax_shared();
+	long r;
+	int nr = kvm_dax_lock_vcpus(kvm, vcpus);
+	if (nr < 0)
+		return nr;
+	r = kvm_dax_vm_ioctl_locked(kvm, cmd, arg, vcpus, nr);
+	kvm_dax_unlock_vcpus(vcpus, nr);
+	if (cmd == KVM_DAX_DETACH && READ_ONCE(s->state) == KVM_DAX_BUSY)
+		smp_store_release(&s->state, r ? KVM_DAX_FAILED : KVM_DAX_DETACHED);
+	if (cmd == KVM_DAX_DETACH && !r) {
+		r = kvm_dax_cache_sync(false);
+		if (r)
+			smp_store_release(&s->state, KVM_DAX_FAILED);
+        kvm_dax_set_local_owner(false);
+	}
+	return r;
+}
