+/* Only EPT tables are shared. All lifetime state below is host-local DRAM. */
+struct kvm_ept_adopt_state {
+    struct dev_pagemap *pgmap;
+    u64 base, bump, data_base, data_bytes;
+    bool released, failed;
+    spinlock_t lock;
+    struct list_head pages;
+};
+
+bool kvm_ept_adopt_can_run(struct kvm *kvm)
+{
+    struct kvm_ept_adopt_state *s = kvm->arch.ept_adopt;
+    return !s || (!READ_ONCE(s->released) && !READ_ONCE(s->failed));
+}
+
+static void *ept_adopt_alloc(struct kvm_ept_adopt_state *s)
+{
+    void *table = NULL;
+    unsigned long flags;
+    spin_lock_irqsave(&s->lock, flags);
+    if (!s->released && !s->failed && s->bump < KVM_EPT_ADOPT_BYTES) {
+        table = __va(s->base + s->bump);
+        s->bump += PAGE_SIZE;
+    } else {
+        s->failed = true;
+    }
+    spin_unlock_irqrestore(&s->lock, flags);
+    if (table)
+        clear_page(table);
+    return table;
+}
+
+static void ept_adopt_forget(struct kvm_mmu_page *sp)
+{
+    unsigned long flags;
+    if (!sp->ept_adopt)
+        return;
+    spin_lock_irqsave(&sp->ept_adopt->lock, flags);
+    list_del_init(&sp->ept_adopt_link);
+    spin_unlock_irqrestore(&sp->ept_adopt->lock, flags);
+}
+
+static bool ept_adopt_free(struct kvm_mmu_page *sp)
+{
+    if (!sp->ept_adopt)
+        return false;
+    ept_adopt_forget(sp);
+    set_page_private(virt_to_page(sp->spt), 0);
+    kmem_cache_free(mmu_page_header_cache, sp);
+    return true; /* The table is discarded, never freed or reused. */
+}
