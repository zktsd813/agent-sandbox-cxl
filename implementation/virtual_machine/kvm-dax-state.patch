+static long kvm_dax_attach(unsigned long arg, struct kvm *reuse)
+{
+	struct kvm_dax_shared *s = kvm_dax_shared();
+	struct kvm_dax_handoff in, out;
+	struct kvm *kvm;
+	struct kvm_vcpu *vcpu;
+	u64 start = ktime_get_ns();
+	u64 profile_last = start;
+	struct kvm_dax_profile *profile;
+	struct kvm_vcpu *vcpus[KVM_DAX_MAX_VCPUS];
+	unsigned int i, locked = 0;
+	int r, fd;
+	bool mm_ready = false, srcu_ready = false;
+	bool irq_srcu_ready = false, notifier_ready = false, listed = false;
+	unsigned int arch_ready = 0;
+
+    if (!capable(CAP_SYS_ADMIN) || !s) return -EPERM;
+    if (copy_from_user(&in,(void __user *)arg,sizeof(in))) return -EFAULT;
+    r=kvm_dax_select_vm(in.vm_offset);
+    if (r) return r;
+    s=kvm_dax_shared();
+    profile=(void *)s+KVM_DAX_PROFILE_OFFSET;
+    r=kvm_dax_cache_sync(true);
+    if (r) return r;
