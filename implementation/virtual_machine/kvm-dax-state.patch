+static long kvm_dax_vm_ioctl(struct kvm *kvm, unsigned int cmd, unsigned long arg)
+{
+	struct kvm_dax_shared *s = kvm_dax_shared();
+	struct kvm_dax_handoff out;
+	struct kvm_vcpu *vcpu = kvm_get_vcpu(kvm, 0);
+	struct pid *pid;
+	u64 start = ktime_get_ns();
+	u64 profile_last = start;
+	struct kvm_dax_profile *profile = (void *)s + KVM_DAX_PROFILE_OFFSET;
+	u64 binding_start;
+	int r;
+
+	if (!capable(CAP_SYS_ADMIN) || !s || !kvm_dax_contains(kvm) ||
+	    !vcpu || atomic_read(&kvm->online_vcpus) != 1 || !kvm_dax_contains(vcpu))
+		return -EOPNOTSUPP;
+	if (cmd == KVM_DAX_VCPU) {
+		kvm_get_kvm(kvm);
+		r = create_vcpu_fd(vcpu);
+		if (r < 0)
+			kvm_put_kvm_no_destroy(kvm);
+		return r;
+	}
+	if (cmd == KVM_DAX_LOCAL_RAM) {
+		if (!dax_scattered || arg > 1 || !kvm_dax_enabled() ||
+		    (s->state != KVM_DAX_EMPTY &&
+		     (s->vm != (unsigned long)kvm || s->state != KVM_DAX_OWNED)))
+			return -EPERM;
+		if (!mutex_trylock(&vcpu->mutex))
+			return -EBUSY;
+		/* Cooperative userspace keeps this vCPU paused until remapping ends. */
+		if (vcpu->arch.complete_userspace_io) {
