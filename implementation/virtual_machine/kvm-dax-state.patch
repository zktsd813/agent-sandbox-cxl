diff --git a/virt/kvm/dax_pool.c b/virt/kvm/dax_pool.c
new file mode 100644
index 0000000..eabcdd9
--- /dev/null
+++ b/virt/kvm/dax_pool.c
@@ -0,0 +1,430 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Single-owner laboratory allocator over an already bound device-DAX range. */
+#include <linux/io.h>
+#include <linux/bitmap.h>
+#include <linux/ktime.h>
+#include <asm/cpufeature.h>
+#include <linux/mm.h>
+#include <linux/kvm_dax.h>
+#include <linux/kvm_host.h>
+#include <linux/memremap.h>
+#include <linux/module.h>
+#include <linux/overflow.h>
+#include <linux/uaccess.h>
+#include <linux/capability.h>
+#include <linux/random.h>
+
+static struct dev_pagemap *dax_pgmap;
+static phys_addr_t dax_phys;
+static size_t dax_size;
+static void *dax_base;
+/* Global allocation is only used at VM creation. Descriptor + every KVM
+ * allocation thereafter live in one private, owner-written 16 MiB extent. */
+#define DAX_VM_BYTES (16UL << 20)
+#define DAX_VM_SLOTS 32
+static struct kvm_dax_shared *dax_vm;
+static struct kvm_dax_shared dax_vm_snapshot;
+static u64 dax_reuse_offset;
+static u64 dax_retired_offset;
+static struct { void *base; bool owner; } dax_bindings[DAX_VM_SLOTS];
+static DEFINE_SPINLOCK(dax_alloc_lock);
+static unsigned long dax_vm_limit_bytes = DAX_VM_BYTES;
+module_param(dax_vm_limit_bytes, ulong, 0600);
+static atomic64_t dax_nonowner_counts[16];
+static unsigned int dax_audit_index;
+module_param(dax_audit_index, uint, 0600);
+static int dax_audit_get(char *buffer, const struct kernel_param *kp)
+{
+    return scnprintf(buffer, PAGE_SIZE, "%lld\n", atomic64_read(&dax_nonowner_counts[min(dax_audit_index,15U)]));
+}
+static const struct kernel_param_ops dax_audit_ops = {.get=dax_audit_get};
+module_param_cb(dax_nonowner_count, &dax_audit_ops, NULL, 0400);
+
+bool kvm_dax_nonowner(const void *ptr, unsigned int path)
+{
+    unsigned int i;
+    if (!kvm_dax_contains(ptr)) return false;
+    for (i=0; i<DAX_VM_SLOTS; i++) {
+        unsigned long base=(unsigned long)READ_ONCE(dax_bindings[i].base);
+        if (base && (unsigned long)ptr>=base && (unsigned long)ptr-base<DAX_VM_BYTES) {
+            if (READ_ONCE(dax_bindings[i].owner)) return false;
+            atomic64_inc(&dax_nonowner_counts[min(path,15U)]);
+            return true;
+        }
+    }
+    atomic64_inc(&dax_nonowner_counts[min(path,15U)]);
+    return true; /* Unknown shared graph is never accessed speculatively. */
+}
+EXPORT_SYMBOL_GPL(kvm_dax_nonowner);
+void kvm_dax_set_local_owner(bool owner)
+{
+    unsigned int i;
+    if (!owner && dax_vm) memcpy(&dax_vm_snapshot,dax_vm,sizeof(dax_vm_snapshot));
+    for (i=0;i<DAX_VM_SLOTS;i++)
+        if (dax_bindings[i].base==dax_vm) WRITE_ONCE(dax_bindings[i].owner,owner);
+}
+int kvm_dax_select_vm(u64 offset)
+{
+    u64 base=round_down(offset,DAX_VM_BYTES);
+    unsigned int i;
+    if (!dax_base || base<DAX_VM_BYTES || base>dax_size || DAX_VM_BYTES>dax_size-base)
+        return -EINVAL;
+    for (i=0;i<DAX_VM_SLOTS;i++) {
+        if (dax_bindings[i].base==(char *)dax_base+base || !dax_bindings[i].base) {
+            dax_vm=(void *)((char *)dax_base+base);
+            dax_bindings[i].base=dax_vm;
+            return 0;
+        }
+    }
+    return -ENOSPC;
+}
+int kvm_dax_begin_vm(void)
+{
+    struct kvm_dax_shared *root=dax_base;
+    u64 old, first, next;
+    int ret;
+    if (!kvm_dax_enabled()) return -EPERM;
+    /* One active graph per lab host. Other VM descriptors remain separate. */
+    if (dax_vm) return -EBUSY;
+    if (dax_reuse_offset) {
+        first=dax_reuse_offset; dax_reuse_offset=0;
+    } else {
+        do {
+            old=READ_ONCE(root->bump);
+            if (old>dax_size || dax_size-old<DAX_VM_BYTES) return -ENOMEM;
+            first=ALIGN(old,DAX_VM_BYTES); next=first+DAX_VM_BYTES;
+            if (first<old || next<first || next>dax_size) return -ENOMEM;
+        } while (cmpxchg(&root->bump,old,next)!=old);
+    }
+    ret=kvm_dax_select_vm(first);
+    if (ret) return ret;
+    memset(dax_vm,0,PAGE_SIZE);
+    dax_vm->allocation_id=get_random_u64() ?: 1;
+    dax_vm->abi_version=KVM_DAX_ABI_VERSION;
+    dax_vm->bump=PAGE_SIZE;
+    dax_vm->kva=(unsigned long)dax_base;
+    kvm_dax_set_local_owner(true);
+    return 0;
+}
+static DEFINE_MUTEX(dax_config_lock);
+static bool dax_ready;
+static unsigned int dax_shared_mode, dax_node;
+static unsigned int dax_owner_pid;
+module_param_named(dax_shared, dax_shared_mode, uint, 0600);
+module_param_named(dax_node, dax_node, uint, 0600);
+module_param_named(dax_owner_pid, dax_owner_pid, uint, 0600);
+MODULE_PARM_DESC(dax_owner_pid, "LAB: optional selected VMM TGID; ordinary peers retain native allocations (0 = legacy global)");
+MODULE_PARM_DESC(dax_shared, "LAB: 1 initializes a shared bump arena; 2 attaches without clearing; allocations retained until lab shutdown");
+
+struct kvm_dax_shared *kvm_dax_shared(void)
+{
+	return dax_shared_mode && dax_base ? (dax_vm ? dax_vm : dax_base) : NULL;
+}
+EXPORT_SYMBOL_GPL(kvm_dax_shared);
+
+unsigned int kvm_dax_node(void) { return dax_node; }
+EXPORT_SYMBOL_GPL(kvm_dax_node);
+
+u64 kvm_dax_offset(const void *ptr)
+{
+	return kvm_dax_contains(ptr) ? (unsigned long)ptr - (unsigned long)dax_base : U64_MAX;
+}
+EXPORT_SYMBOL_GPL(kvm_dax_offset);
+
+bool kvm_dax_enabled(void)
+{
+	/* Pair with publication after the mapping and arena are initialized. */
+	return smp_load_acquire(&dax_ready) &&
+		(!READ_ONCE(dax_owner_pid) || task_tgid_nr(current) == READ_ONCE(dax_owner_pid));
+}
+EXPORT_SYMBOL_GPL(kvm_dax_enabled);
+
+bool kvm_dax_contains(const void *ptr)
+{
+	return dax_base && (unsigned long)ptr >= (unsigned long)dax_base &&
+		(unsigned long)ptr - (unsigned long)dax_base < dax_size;
+}
+EXPORT_SYMBOL_GPL(kvm_dax_contains);
+
+void *kvm_dax_alloc(size_t size, size_t align, const char *kind)
+{
+    struct kvm_dax_shared *shared=dax_vm;
+    unsigned long addr, flags;
+    u64 old, next;
+    size_t total;
+    if (!shared || !kvm_dax_enabled() || !size || !is_power_of_2(align) ||
+        check_add_overflow(size,align,&total) || kvm_dax_nonowner(shared,0)) return NULL;
+    /* Host-local lock: only this execution owner changes this VM's bump. */
+    spin_lock_irqsave(&dax_alloc_lock,flags);
+    old=READ_ONCE(shared->bump);
+    addr=ALIGN((unsigned long)shared+old,align);
+    if (addr<(unsigned long)shared || check_add_overflow((u64)(addr-(unsigned long)shared),(u64)size,&next) ||
+        next>min_t(u64,DAX_VM_BYTES,dax_vm_limit_bytes)) {
+        WRITE_ONCE(shared->state,KVM_DAX_FAILED);
+        spin_unlock_irqrestore(&dax_alloc_lock,flags);
+        return NULL; /* Never fall back to a local allocation or resume. */
+    }
+    WRITE_ONCE(shared->bump,next);
+    spin_unlock_irqrestore(&dax_alloc_lock,flags);
+    memset((void *)addr,0,size);
+    return (void *)addr;
+}
+EXPORT_SYMBOL_GPL(kvm_dax_alloc);
+
+bool kvm_dax_free(const void *ptr)
+{
+	/* Bounded arena: allocations remain until this owned lab shuts down. */
+	return kvm_dax_contains(ptr);
+}
+EXPORT_SYMBOL_GPL(kvm_dax_free);
+
+/* The current contract has one VM and one arena. Receipts live in this host's
+ * DRAM, so recording the elapsed time never dirties the just-published graph. */
+static bool dax_noncoherent, dax_cache_check;
+static long dax_cache_skip_line = -1;
+static struct kvm_dax_cache_stats dax_cache_receipt;
+module_param(dax_noncoherent, bool, 0600);
+module_param(dax_cache_check, bool, 0600);
+module_param(dax_cache_skip_line, long, 0600);
+
+int kvm_dax_cache_sync(bool invalidate)
+{
+	struct kvm_dax_shared *s = kvm_dax_shared();
+	unsigned long *covered = NULL;
+	u64 used, lines, i, start, elapsed, emitted = 0;
+	if (!dax_noncoherent)
+		return 0;
+	if (!s || !boot_cpu_has(X86_FEATURE_CLWB) ||
+	    !boot_cpu_has(X86_FEATURE_CLFLUSHOPT))
+		return -EOPNOTSUPP;
+	start = ktime_get_ns();
+	if (invalidate) {
+		/* Bump and all identity fields may themselves be stale. */
+		for (i = 0; i < PAGE_SIZE; i += 64) {
+			asm volatile("clflushopt (%0)" : : "r" ((char *)s + i) : "memory");
+            emitted++;
+        }
+		asm volatile("mfence" : : : "memory");
+	}
+	used = dax_vm ? READ_ONCE(s->bump) : PAGE_SIZE;
+	if (used < PAGE_SIZE || used > (dax_vm ? DAX_VM_BYTES : dax_size))
+		return -EINVAL;
+	lines = DIV_ROUND_UP_ULL(used, 64);
+	if (dax_cache_check) {
+		covered = bitmap_zalloc(lines, GFP_KERNEL);
+		if (!covered)
+			return -ENOMEM;
+	}
+	for (i = 0; i < lines; i++) {
+		if (unlikely(dax_cache_skip_line >= 0 && i == dax_cache_skip_line))
+			continue;
+		if (invalidate)
+			asm volatile("clflushopt (%0)" : : "r" ((char *)s + i * 64) : "memory");
+		else
+			asm volatile("clwb (%0)" : : "r" ((char *)s + i * 64) : "memory");
+        emitted++;
+		if (covered)
+			__set_bit(i, covered);
+	}
+	if (invalidate)
+		asm volatile("mfence" : : : "memory");
+	else
+		asm volatile("sfence" : : : "memory");
+	elapsed = ktime_get_ns() - start;
+	if (covered && !bitmap_full(covered, lines)) {
+		bitmap_free(covered);
+		return -EIO;
+	}
+	bitmap_free(covered);
+	if (invalidate) {
+		dax_cache_receipt.invalidate_ns = elapsed;
+		dax_cache_receipt.invalidate_bytes = used;
+		dax_cache_receipt.invalidate_lines = emitted;
+		dax_cache_receipt.invalidate_verified = dax_cache_check;
+	} else {
+		dax_cache_receipt.wb_ns = elapsed;
+		dax_cache_receipt.wb_bytes = used;
+		dax_cache_receipt.wb_lines = emitted;
+		dax_cache_receipt.wb_verified = dax_cache_check;
+	}
+	return 0;
+}
+void kvm_dax_cache_stats(struct kvm_dax_cache_stats *stats)
+{
+	*stats = dax_cache_receipt;
+}
+
+int kvm_dax_arena_ioctl(unsigned long arg)
+{
+    struct kvm_dax_arena q;
+    struct kvm_dax_shared *s;
+    u64 i;
+    if (!capable(CAP_SYS_ADMIN) || copy_from_user(&q,(void __user *)arg,sizeof(q))) return -EPERM;
+    if (q.stage>2 || q.offset<DAX_VM_BYTES || q.offset%DAX_VM_BYTES ||
+        q.offset>dax_size || DAX_VM_BYTES>dax_size-q.offset) return -EINVAL;
+    s=(void *)((char *)dax_base+q.offset);
+    q.capacity=DAX_VM_BYTES; q.lines=0;
+    if (q.stage==1) {
+        if (!kvm_dax_nonowner(s,12)) return -EBUSY;
+        /* detach drains timers/notifiers/irqfd. Flush all deferred MMU frees
+         * before the extent can be given to another VM. */
+        rcu_barrier();
+        for (i=0;i<DAX_VM_BYTES;i+=64) {
+            asm volatile("clflushopt (%0)" : : "r" ((char *)s+i) : "memory"); q.lines++;
+        }
+        asm volatile("mfence" : : : "memory");
+        if (s->state!=KVM_DAX_DETACHED) return -EBUSY;
+        { int ret=kvm_mmu_dax_retire(s,&q.lines); if (ret) return ret; }
+        dax_retired_offset=q.offset;
+        if (dax_vm==s) dax_vm=NULL;
+    } else if (q.stage==2) {
+        if (q.acknowledgements!=3 || dax_retired_offset!=q.offset || dax_vm) return -EPERM;
+        dax_reuse_offset=q.offset;
+    } else if (kvm_dax_nonowner(s,12)) return -EACCES;
+    q.used=READ_ONCE(s->bump);
+    return copy_to_user((void __user *)arg,&q,sizeof(q)) ? -EFAULT : 0;
+}
+
+static int dax_pool_set(const char *val, const struct kernel_param *kp)
+{
+	unsigned long long phys, size;
+	struct dev_pagemap *pgmap;
+	unsigned long pfn;
+	u64 end;
+	int rc = -EINVAL, i;
+	char tail;
+
+	if (sscanf(val, "%llx,%llx %c", &phys, &size, &tail) != 2 ||
+	    !size || dax_shared_mode < 1 || dax_shared_mode > 2 || !dax_node || !IS_ALIGNED(phys, PAGE_SIZE) || !IS_ALIGNED(size, PAGE_SIZE) ||
+	    check_add_overflow((u64)phys, (u64)size - 1, &end))
+		return -EINVAL;
+	if (!boot_cpu_has(X86_FEATURE_VMX) || !tdp_enabled)
+		return -EOPNOTSUPP;
+	mutex_lock(&dax_config_lock);
+	if (dax_ready) {
+		rc = -EBUSY;
+		goto out;
+	}
+	pgmap = get_dev_pagemap(PHYS_PFN(phys), NULL);
+	if (!pgmap)
+		goto out;
+	if (pgmap->type != MEMORY_DEVICE_GENERIC || pgmap->vmemmap_shift)
+		goto put_pgmap;
+	for (i = 0; i < pgmap->nr_range; i++)
+		if (phys >= pgmap->ranges[i].start && end <= pgmap->ranges[i].end)
+			break;
+	if (i == pgmap->nr_range)
+		goto put_pgmap;
+	for (pfn = PHYS_PFN(phys); pfn <= PHYS_PFN(end); pfn++)
+		if (!pfn_valid(pfn) || !is_zone_device_page(pfn_to_page(pfn)) ||
+		    !virt_addr_valid(__va(PFN_PHYS(pfn))))
+			goto put_pgmap;
+	dax_base = __va(phys);
+	dax_phys = phys;
+	dax_size = size;
+	dax_pgmap = pgmap;
+	{
+		struct kvm_dax_shared *s = dax_base;
+		if (dax_shared_mode == 1) {
+			memset(s, 0, PAGE_SIZE);
+			BUILD_BUG_ON(sizeof(*s) > KVM_DAX_PROFILE_OFFSET);
+			s->abi_version = KVM_DAX_ABI_VERSION;
+			s->bump = PAGE_SIZE;
+			s->kva = (unsigned long)dax_base;
+			s->phys = phys;
+			smp_store_release(&s->magic, 0x43584c4b564d3032ULL);
+		} else {
+			rc = kvm_dax_cache_sync(true);
+			if (rc)
+				goto bad_shared;
+		}
+		if (dax_shared_mode == 2 && (smp_load_acquire(&s->magic) != 0x43584c4b564d3032ULL ||
+			   s->abi_version != KVM_DAX_ABI_VERSION ||
+			   s->kva != (unsigned long)dax_base || s->phys != phys)) {
+			rc = -EXDEV;
+			goto bad_shared;
+		}
+	}
+	if (dax_shared_mode == 1) {
+		rc = kvm_dax_cache_sync(false);
+		if (rc)
+			goto bad_shared;
+	}
+	/* Publish all immutable mapping fields before any allocator can run. */
+	smp_store_release(&dax_ready, true);
+	rc = 0;
+	pr_info("KVM_DAX_POOL pa=%pa bytes=%zu page_metadata=4K\n", &dax_phys, dax_size);
+	goto out;
+bad_shared:
+	dax_base = NULL;
+put_pgmap:
+	put_dev_pagemap(pgmap);
+out:
+	mutex_unlock(&dax_config_lock);
+	return rc;
+}
+
+static int dax_pool_get(char *buffer, const struct kernel_param *kp)
+{
+	int n;
+    struct kvm_dax_shared *s=kvm_dax_shared();
+    if (dax_vm && kvm_dax_nonowner(dax_vm,13)) s=&dax_vm_snapshot;
+
+	n = scnprintf(buffer, PAGE_SIZE,
+		      "enabled=%u phys=%llx bytes=%zu\n",
+		      dax_ready, (unsigned long long)dax_phys, dax_size);
+	if (s)
+		n += scnprintf(buffer + n, PAGE_SIZE - n,
+			"shared=%u node=%u state=%u owner=%u used=%llu generation=%llu\n",
+			dax_shared_mode, dax_node, s->state,
+			s->owner, s->bump,
+			s->generation);
+	if (s)
+		n += scnprintf(buffer + n, PAGE_SIZE - n,
+			"vm_create_calls=%llu vcpu_create_calls=%llu\n",
+			s->vm_create_calls, s->vcpu_create_calls);
+    if (dax_vm) n += scnprintf(buffer+n,PAGE_SIZE-n,
+        "vm_base=%llu vm_bump=%llu vm_capacity=%lu allocation_id=%llu\n", kvm_dax_offset(dax_vm),s->bump,DAX_VM_BYTES,s->allocation_id);
+	return n;
+}
+
+static const struct kernel_param_ops dax_pool_ops = {
+	.set = dax_pool_set,
+	.get = dax_pool_get,
+};
+module_param_cb(dax_pool, &dax_pool_ops, NULL, 0600);
+MODULE_PARM_DESC(dax_pool,
+	"LAB ONLY: device-DAX physical start,size in hex; configure once before creating VMs");
+
+void kvm_dax_pool_exit(void)
+{
+	if (!dax_ready)
+		return;
+	smp_store_release(&dax_ready, false);
+	put_dev_pagemap(dax_pgmap);
+	dax_base = NULL;
+}
+
+/* Hold the entire stopped set, including halted/AP vCPUs. No partial detach. */
+int kvm_dax_lock_vcpus(struct kvm *kvm, struct kvm_vcpu **vcpus)
+{
+	unsigned int i, nr = atomic_read(&kvm->online_vcpus);
+	if (!nr || nr > KVM_DAX_MAX_VCPUS)
+		return -EOPNOTSUPP;
+	for (i = 0; i < nr; i++) {
+		vcpus[i] = kvm_get_vcpu(kvm, i);
+		if (!vcpus[i] || !kvm_dax_contains(vcpus[i]) ||
+		    !mutex_trylock(&vcpus[i]->mutex)) {
+			kvm_dax_unlock_vcpus(vcpus, i);
+			return -EBUSY;
+		}
+	}
+	return nr;
+}
+EXPORT_SYMBOL_GPL(kvm_dax_lock_vcpus);
+void kvm_dax_unlock_vcpus(struct kvm_vcpu **vcpus, unsigned int count)
+{
+	while (count)
+		mutex_unlock(&vcpus[--count]->mutex);
+}
+EXPORT_SYMBOL_GPL(kvm_dax_unlock_vcpus);
