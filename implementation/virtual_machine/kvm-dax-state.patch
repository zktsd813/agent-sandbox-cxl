+			(kvm->arch.use_master_clock ? kvm->arch.master_kernel_ns : get_kvmclock_base_ns());
+		return 0;
+	}
+	cancel_delayed_work_sync(&kvm->arch.kvmclock_sync_work);
+	cancel_delayed_work_sync(&kvm->arch.kvmclock_update_work);
+	s->host_clock_ns = ktime_get_ns();
+	s->guest_clock_ns = get_kvmclock_ns(kvm);
+	s->source_tsc = rdtsc();
+	s->host_tsc_khz = tsc_khz;
+	s->quiesce_ns = s->mmu_drain_ns = 0;
+	return kvm_pit_dax_handoff(kvm, false);
+}
+EXPORT_SYMBOL_GPL(kvm_arch_dax_vm_handoff);
+int kvm_arch_dax_vm_resume(struct kvm *kvm)
+{
+	return kvm_pit_dax_handoff(kvm, true);
+}
+EXPORT_SYMBOL_GPL(kvm_arch_dax_vm_resume);
