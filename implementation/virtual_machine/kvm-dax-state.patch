+#ifdef CONFIG_KVM_DAX_POOL_TEST
+static bool dax_nested_root_sync;
+module_param(dax_nested_root_sync, bool, 0600);
+MODULE_PARM_DESC(dax_nested_root_sync, "LAB: notify outer KVM of externally updated shared nested EPT");
+
+void kvm_mmu_dax_rebind(struct kvm_vcpu *vcpu)
+{
+	/* Objects in these caches are shared, slab allocator anchors are not. */
+	vcpu->arch.mmu_pte_list_desc_cache.kmem_cache = pte_list_desc_cache;
+	vcpu->arch.mmu_page_header_cache.kmem_cache = mmu_page_header_cache;
+	vcpu->kvm->arch.split_page_header_cache.kmem_cache = mmu_page_header_cache;
+	vcpu->kvm->arch.split_desc_cache.kmem_cache = pte_list_desc_cache;
+}
+
+void kvm_ept_adopt_nested_sync(u64 root)
+{
+    if (dax_nested_root_sync) {
+        u8 *byte = (u8 *)__va(root) + 1;
+        WRITE_ONCE(*byte, READ_ONCE(*byte));
+    }
+}
+
+static noinline void kvm_dax_nested_root_sync(struct kvm_vcpu *vcpu)
+{
+	/* Outer KVM cannot observe EPT writes made by a different L1 VM.
+	 * INVEPT drops local root references, but cached indirect shadow
+	 * pages can still survive through other L1 vCPUs. A non-entry-
+	 * aligned byte write invokes outer KVM's whole shadow-page zap.
+	 * Touch the retained root only; no RAM or EPT leaf walk. This is
+	 * an explicit nested-KVM lab accommodation, never a CXL flush.
+	 * The guest is paused and the previous owner has been fenced. */
+	u8 *root = (u8 *)__va(vcpu->arch.mmu->root.hpa) + 1;
+	WRITE_ONCE(*root, READ_ONCE(*root));
+}
+
+/* Nested lab only: the next VM can use different EPT page GPAs in the same
+ * extent. Touch the OLD tracked pages before overwriting them, otherwise a
+ * new root that outer KVM has never tracked cannot zap its old shadow cache.
+ * Both wrappers are dead; every dirtied test line is invalidated before ACK. */
+int kvm_mmu_dax_retire(struct kvm_dax_shared *s, u64 *lines)
+{
+    unsigned long first=(unsigned long)s, end=first+s->bump;
+    struct kvm_mmu_page *sp;
+    u64 p,count=0;
+    if (!dax_nested_root_sync) return 0;
+    if (s->bump<PAGE_SIZE || s->bump>16UL*1024*1024) return -EINVAL;
+    for (p=s->ept_pages;p;p=sp->dax_next) {
+        unsigned long table;
+        u8 *byte;
+        if (++count>s->ept_page_count || p<first || p>end-sizeof(*sp)) return -EXDEV;
+        sp=(void *)(unsigned long)p;
+        table=(unsigned long)sp->spt;
+        if (!IS_ALIGNED(table,PAGE_SIZE) || table<first || table>end-PAGE_SIZE) return -EXDEV;
+        byte=(u8 *)table+1;
+        WRITE_ONCE(*byte,READ_ONCE(*byte));
+        asm volatile("clflushopt (%0)" : : "r" ((void *)table) : "memory");
+        (*lines)++;
+    }
+    asm volatile("mfence" : : : "memory");
+    return 0;
+}
+
+int kvm_mmu_dax_ept_rebind(struct kvm_vcpu *vcpu, bool attach)
+{
+	/* Native metadata is stable in this kernel for never-reused DAX pages. */
+	static u64 seen_head, seen_vm, seen_allocation;
+	struct kvm_dax_shared *s = kvm_dax_shared();
+	struct kvm_mmu_page *sp;
+	u64 p, count = 0;
+
+	if (seen_vm != s->vm || seen_allocation != s->allocation_id) {
+		seen_head = 0;
+		seen_vm = s->vm;
+        seen_allocation = s->allocation_id;
+	}
+	if (!tdp_mmu_enabled || !VALID_PAGE(vcpu->arch.mmu->root.hpa) ||
+	    !kvm_dax_contains(__va(vcpu->arch.mmu->root.hpa)))
+		return -EOPNOTSUPP;
+	/* EXPORT captured this PFN; ATTACH checks current->mm before rebinding.
+	 * The cooperative ABI forbids VMA changes while this graph is exported.
+	 * Do not repeat GUP/PFN resolution during both detach and arch attach. */
+	for (p = s->ept_pages; p && (attach ? p != seen_head : !s->ept_validated);
+	     p = sp->dax_next) {
+		unsigned int i;
+		sp = (void *)(unsigned long)p;
+		if (++count > s->ept_page_count || !kvm_dax_contains(sp) ||
+		    !kvm_dax_contains(sp->spt) || !sp->tdp_mmu_page)
+			return -EXDEV;
+		if (attach) {
+			set_page_private(virt_to_page(sp->spt), (unsigned long)sp);
+			continue;
+		}
+		/* Refuse a retained translation to any source-private RAM. */
+		for (i = 0; i < SPTE_ENT_PER_PAGE; i++) {
+			u64 entry = READ_ONCE(sp->spt[i]);
+			kvm_pfn_t pfn = spte_to_pfn(entry);
+			if (!is_shadow_present_pte(entry))
+				continue;
+			if (is_last_spte(entry, sp->role.level)) {
+				u64 pages = KVM_PAGES_PER_HPAGE(sp->role.level);
+				if (!kvm_dax_data_pfn_valid(s, pfn, pages))
+					return -EXDEV;
+			} else if (!kvm_dax_contains(__va(pfn << PAGE_SHIFT))) {
+				return -EXDEV;
+			}
+		}
+	}
+	if (attach && dax_nested_root_sync)
+		kvm_dax_nested_root_sync(vcpu);
+	/* Local allocations set their struct-page backlink in tdp_mmu_init_sp()
+	 * before publishing dax_next. Imported pages were rebound on attach.
+	 * Remember both sets when leaving: returning to their original node
+	 * must not repeat the already completed native metadata initialization.
+	 * Remote additions are still walked, and nested-root synchronization
+	 * above still runs on every attach. The arena never reuses EPT pages. */
+	seen_head = s->ept_pages;
+	if (!attach)
+		s->ept_validated = 1;
+	if (!vcpu->vcpu_idx)
+		s->ept_root_hpa = vcpu->arch.mmu->root.hpa;
+	if (attach)
+		kvm_make_request(KVM_REQ_TLB_FLUSH_CURRENT, vcpu);
+	return 0;
+}
+
+void kvm_mmu_dax_invalidate(struct kvm *kvm)
+{
+	/* Zapping leaves alone retains the TDP MMU's root reference. Its
+	 * struct-page reverse mapping is node-local, so release roots too. */
+	if (!tdp_mmu_enabled)
+		return;
+	write_lock(&kvm->mmu_lock);
+	kvm_tdp_mmu_invalidate_all_roots(kvm);
+	write_unlock(&kvm->mmu_lock);
+	kvm_tdp_mmu_zap_invalidated_roots(kvm);
+	WARN_ON(atomic64_read(&kvm->arch.tdp_mmu_pages));
+	WARN_ON(!list_empty(&kvm->arch.tdp_mmu_roots));
+	/* The shared bump allocator never reuses retired EPT/header memory.
+	 * The RCU callback touches only that retired allocation, not @kvm.
+	 * Keep normal RCU retirement, but do not wait for callback execution. */
+}
