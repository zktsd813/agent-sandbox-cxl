+			return -EFAULT;
+		kvm_release_pfn_clean(pfn);
+		if (!kvm_dax_data_pfn_valid(s, pfn, 1) || (check && pfns[i] != pfn))
+			return -EXDEV;
+		if (!check)
+			pfns[i] = pfn;
+		cond_resched();
+	}
+	return 0;
