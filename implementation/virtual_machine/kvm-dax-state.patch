+/* VM work is stopped once, before touching any per-vCPU host binding. */
+int kvm_arch_dax_vm_handoff(struct kvm *kvm, bool attach)
+{
+	struct kvm_dax_shared *s = kvm_dax_shared();
+	if (attach) {
+		INIT_DELAYED_WORK(&kvm->arch.kvmclock_update_work, kvmclock_update_fn);
+		INIT_DELAYED_WORK(&kvm->arch.kvmclock_sync_work, kvmclock_sync_fn);
+		pvclock_update_vm_gtod_copy(kvm);
