+		vcpu->cpu = -1;
+		/* This sample and suspend correction belong to the old host. */
+		vcpu->arch.last_host_tsc = 0;
+		vcpu->arch.tsc_offset_adjustment = 0;
+		vcpu->arch.tsc_catchup = 0;
+		vcpu->arch.last_vmentry_cpu = -1;
+		vcpu->arch.mmio_gva = 0;
+		vcpu->arch.mmio_gfn = 0;
+		vcpu->arch.mmio_access = 0;
