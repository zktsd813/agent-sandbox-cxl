+static void kvm_dax_result(struct kvm *kvm, struct kvm_dax_handoff *out, u64 ns)
+{
+	struct kvm_dax_shared *s = kvm_dax_shared();
+	struct kvm_vcpu *vcpu = (void *)(unsigned long)s->vcpu;
+	memset(out, 0, sizeof(*out));
+	out->vm_offset = kvm_dax_offset(kvm);
+	out->vcpu_offset = kvm_dax_offset(vcpu);
+	out->run_offset = kvm_dax_offset(vcpu->run);
+	out->vmcs_offset = s->vmcs;
+	out->generation = s->generation;
+	out->kernel_ns = ns;
+	out->pool_used = s->bump;
+	out->vm_creates = s->vm_creates;
+	out->vcpu_creates = s->vcpu_creates;
+	out->node = kvm_dax_node();
+	out->flags = s->state;
+	out->ram_hva = s->ram_hva;
+	out->ram_bytes = s->ram_bytes;
+	out->quiesce_ns = s->quiesce_ns;
+	out->mmu_drain_ns = s->mmu_drain_ns;
+	out->binding_ns = s->binding_ns;
+	out->ept_root_offset = s->ept_root_hpa ? kvm_dax_offset(__va(s->ept_root_hpa)) : 0;
+	out->ept_page_count = s->ept_page_count;
