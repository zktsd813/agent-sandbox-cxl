  "outer_backing_smaps": ".local/runs/20261019T065649Z-1uw5rhl5/outer-cxl-smaps.json",
  "findings": {
    "polling": "Guest ACK timestamp to controller observation is ~50us p50 in reduced L1 trace, while the actual guest sample is ~3.670ms after resume API response. Most delay precedes guest acknowledgement.",
    "ept": "ACK-before L1 trace shows exactly23 faults and6 new EPT pages,22 level2(2MiB) leaf SPTEs and1 level1 APIC-access leaf, every measured round. Root/fault union p50 947us in reduced trace. Map538us is a nested subset.",
    "outer": "Lossless host trace shows166..245 outer EPT exits (p50182.5),25new MMU pages (direct and non-direct roles combined; role alone doesnot identify EPT root ownership) and only4KiB leaf mappings during launch-to-last-preACK-EPT-reflection window.",
    "backing": "QEMU CXL shared file VMA has4KiB kernel/MMU pages, zero FilePmdMapped/ShmemPmdMapped/AnonHugePages, and HVA is not2MiB aligned. Large L1 SPTEs do not imply large L0 shadow SPTEs.",
    "scheduling": "L1 vCPU off-CPU p50/p950; lossless outer critical windows have no target QEMU vCPU sched_switch. Initial API/wakeup preparation still exists outside these windows.",
    "scope": "EPT setup was absent from prior API-only breakdown, not negligible. Current nested environment adds EPT02 refill costs. Bare-metal cross-node CXL does not have this L0/EPT02 layer."
  },
  "method": {
    "l1": "trace_clock mono; kprobe/kretprobe root/fault/map spans plus KVM entry/exit/MMU/sched events; nonce+round trace markers gate LOAD_BEGIN through HEAP_VERIFIED",
    "guest_ack": "guest raw TSC sampled immediately before ACK publication; decode public KVM TSC offset with invariant unit scaling, calibrated against bracketed local CLOCK_MONOTONIC/RDTSC anchors",
    "ratio": "all-probe trace directly verifies guest\u2212host TSC equals offset for154+ paired reads per round; later traces use its hashed evidence plus explicit unit-ratio assumption. Cross-vCPU TSC synchronization remains an assumption.",
    "outer": "independent host trace instance filtered to snapshot QEMU CPU1 TIDs540114/540113; join by per-role launch ordinal and exact ordered reflected exit qualification prefix; never subtract L0/L1 absolute clocks",
    "outer_endpoint": "last pre-ACK reflected EPT return, not the complete guest ACK interval; lower bound to ACK. All10short-run rounds join exactly.",
    "latencies": "inclusive wall durations, not pure allocator CPU cycles. Trace clocks have1us output resolution. All percentile summaries use nearest-rank p95.",
    "overlap": "root/fault union avoids nesting; map is within fault. L1 MMU wall includes L0 handlers while L1 executes; do not add it to all L0 service time. Separate runs/medians are not additive.",
    "mmu_page_role_interpretation": "mmu_pages counts all kvm_mmu_get_page events. Role.direct is read only from the raw printed direct flag and does NOT identify EPT01 versus EPT02 ownership. Nested shadow EPT02 can contain direct lower-level child pages when splitting a guest huge-page mapping: see implementation/linux/arch/x86/kvm/mmu/paging_tmpl.h FNAME(fetch), kvm_mmu_get_child_sp(..., true, direct_access), around line735. The 25 total newly created MMU pages comprise19 direct-role and6 non-direct-role pages in all measured rounds. This trace text does not expose root identity, so root ownership remains undefined. leaf_spte_levels aggregates all traced pages; leaf_spte_levels_by_nested_context follows inferred L1/L2 execution state and does not prove page-table ownership."
  },
